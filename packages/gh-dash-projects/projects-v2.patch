+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestProjectFieldColumnsParseFromDefaultsLayout(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	contents := `
+prSections:
+  - title: Pull requests
+    filters: is:open
+issuesSections:
+  - title: Issues
+    filters: is:open
+defaults:
+  layout:
+    projects:
+      fields:
+        - name: Status
+          project: infrastructure
+          width: 20
+        - name: Priority
+          hidden: true
+`
+	if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	config, err := ParseConfig(path, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fields := config.Defaults.Layout.Projects.Fields
+	if len(fields) != 2 || fields[0].Name != "Status" || fields[0].Project != "infrastructure" || fields[0].Width == nil || *fields[0].Width != 20 || fields[1].Hidden == nil || !*fields[1].Hidden {
+		t.Fatalf("unexpected Project fields: %#v", fields)
+	}
+}
