diff --git a/ui/components/projecteditor/editor.go b/ui/components/projecteditor/editor.go
new file mode 100644
index 0000000..0a210f6
--- /dev/null
+++ b/ui/components/projecteditor/editor.go
@@ -0,0 +1,254 @@
+package projecteditor
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/charmbracelet/bubbles/textarea"
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/lipgloss"
+
+	"github.com/dlvhdr/gh-dash/v4/data"
+	"github.com/dlvhdr/gh-dash/v4/ui/components/inputbox"
+	"github.com/dlvhdr/gh-dash/v4/ui/context"
+)
+
+type mode int
+
+const (
+	modeProjects mode = iota
+	modeLoadingFields
+	modeFields
+	modeOptions
+	modeInput
+)
+
+type FieldsFetchedMsg struct {
+	ProjectID string
+	Fields    []data.ProjectField
+	Err       error
+}
+
+type ProjectFieldUpdatedMsg struct {
+	SectionType string
+	SectionID   int
+	ItemNumber  int
+	ProjectID   string
+	ItemID      string
+	FieldID     string
+	FieldName   string
+	Value       string
+	Err         error
+}
+
+type Model struct {
+	ctx         *context.ProgramContext
+	sectionType string
+	sectionID   int
+	itemNumber  int
+	items       []data.ProjectItem
+	fields      []data.ProjectField
+	project     int
+	field       int
+	option      int
+	mode        mode
+	input       inputbox.Model
+	width       int
+	status      string
+}
+
+func New(ctx *context.ProgramContext, sectionType string, sectionID, number int, items []data.ProjectItem) Model {
+	input := inputbox.NewModel(ctx)
+	input.SetHeight(4)
+	return Model{ctx: ctx, sectionType: sectionType, sectionID: sectionID, itemNumber: number, items: items, mode: modeProjects, input: input}
+}
+
+func (m Model) Active() bool { return m.ctx != nil && m.mode != mode(-1) }
+
+func (m *Model) Close() { m.mode = mode(-1); m.input.Blur() }
+
+func (m *Model) SetWidth(width int) { m.width = width; m.input.SetWidth(width) }
+
+func (m *Model) UpdateProgramContext(ctx *context.ProgramContext) {
+	m.ctx = ctx
+	m.input.UpdateProgramContext(ctx)
+}
+
+func (m Model) Update(msg tea.Msg) (Model, tea.Cmd) {
+	var cmd tea.Cmd
+	switch msg := msg.(type) {
+	case FieldsFetchedMsg:
+		if m.mode == modeLoadingFields && m.currentProject().Project.ID == msg.ProjectID {
+			if msg.Err != nil {
+				m.status = msg.Err.Error()
+				m.mode = modeProjects
+			} else {
+				m.fields, m.field, m.mode, m.status = msg.Fields, 0, modeFields, ""
+			}
+		}
+		return m, nil
+	case ProjectFieldUpdatedMsg:
+		if msg.Err != nil {
+			m.status = msg.Err.Error()
+			return m, nil
+		}
+		m.Close()
+		return m, nil
+	case tea.KeyMsg:
+		if m.mode == modeInput {
+			switch msg.Type {
+			case tea.KeyCtrlD:
+				value := strings.TrimSpace(m.input.Value())
+				if value == "" {
+					m.status = "Value cannot be empty"
+					return m, nil
+				}
+				m.input.Blur()
+				m.mode = modeLoadingFields
+				return m, m.update(value, value)
+			case tea.KeyEsc, tea.KeyCtrlC:
+				m.input.Blur()
+				m.mode = modeFields
+				return m, nil
+			}
+			m.input, cmd = m.input.Update(msg)
+			return m, cmd
+		}
+		switch msg.String() {
+		case "up", "k":
+			m.move(-1)
+		case "down", "j":
+			m.move(1)
+		case "esc", "q":
+			m.Close()
+		case "enter":
+			switch m.mode {
+			case modeProjects:
+				m.mode = modeLoadingFields
+				return m, m.fetchFields()
+			case modeFields:
+				field := m.fields[m.field]
+				if field.Type == "ProjectV2SingleSelectField" || field.Type == "SINGLE_SELECT" {
+					if len(field.Options) == 0 {
+						m.status = "This field has no selectable options"
+					} else {
+						m.mode, m.option = modeOptions, 0
+					}
+				} else if isEditable(field.Type) {
+					m.mode = modeInput
+					m.input.Reset()
+					m.input.SetPrompt(fmt.Sprintf("Set %s (Ctrl+d to submit)...", field.Name))
+					return m, tea.Sequence(textarea.Blink, m.input.Focus())
+				} else {
+					m.status = fmt.Sprintf("Field type %s is display-only", field.Type)
+				}
+			case modeOptions:
+				field := m.fields[m.field]
+				option := field.Options[m.option]
+				m.mode = modeLoadingFields
+				return m, m.update(option.ID, option.Name)
+			}
+		}
+	}
+	return m, nil
+}
+
+func (m *Model) move(delta int) {
+	var length int
+	switch m.mode {
+	case modeProjects:
+		length = len(m.items)
+	case modeFields:
+		length = len(m.fields)
+	case modeOptions:
+		length = len(m.fields[m.field].Options)
+	default:
+		return
+	}
+	if length == 0 {
+		return
+	}
+	switch m.mode {
+	case modeProjects:
+		m.project = (m.project + delta + length) % length
+	case modeFields:
+		m.field = (m.field + delta + length) % length
+	case modeOptions:
+		m.option = (m.option + delta + length) % length
+	}
+}
+
+func (m Model) currentProject() data.ProjectItem { return m.items[m.project] }
+
+func (m Model) fetchFields() tea.Cmd {
+	projectID := m.currentProject().Project.ID
+	return func() tea.Msg {
+		fields, err := data.FetchProjectFields(projectID)
+		return FieldsFetchedMsg{ProjectID: projectID, Fields: fields, Err: err}
+	}
+}
+
+func (m Model) update(value, displayValue string) tea.Cmd {
+	project := m.currentProject()
+	field := m.fields[m.field]
+	return func() tea.Msg {
+		err := data.UpdateProjectField(project.Project.ID, project.ID, field.ID, field.Type, value)
+		return ProjectFieldUpdatedMsg{SectionType: m.sectionType, SectionID: m.sectionID, ItemNumber: m.itemNumber, ProjectID: project.Project.ID, ItemID: project.ID, FieldID: field.ID, FieldName: field.Name, Value: displayValue, Err: err}
+	}
+}
+
+func isEditable(fieldType string) bool {
+	switch fieldType {
+	case "ProjectV2Field", "TEXT", "NUMBER", "DATE", "ProjectV2IterationField", "ITERATION":
+		return true
+	default:
+		return false
+	}
+}
+
+func (m Model) View() string {
+	if !m.Active() {
+		return ""
+	}
+	var title string
+	switch m.mode {
+	case modeProjects:
+		title = "Choose a Project"
+	case modeLoadingFields:
+		title = "Loading Project fields…"
+	case modeFields:
+		title = "Choose a Project field"
+	case modeOptions:
+		title = "Choose an option"
+	case modeInput:
+		return m.input.View()
+	}
+	lines := []string{lipgloss.NewStyle().Bold(true).Render("Edit Project field — " + title)}
+	var values []string
+	switch m.mode {
+	case modeProjects:
+		for _, item := range m.items {
+			values = append(values, fmt.Sprintf("%s (#%d)", item.Project.Title, item.Project.Number))
+		}
+	case modeFields:
+		for _, field := range m.fields {
+			values = append(values, fmt.Sprintf("%s [%s]", field.Name, field.Type))
+		}
+	case modeOptions:
+		for _, option := range m.fields[m.field].Options {
+			values = append(values, option.Name)
+		}
+	}
+	for i, value := range values {
+		prefix := "  "
+		if (m.mode == modeProjects && i == m.project) || (m.mode == modeFields && i == m.field) || (m.mode == modeOptions && i == m.option) {
+			prefix = "> "
+		}
+		lines = append(lines, prefix+value)
+	}
+	if m.status != "" {
+		lines = append(lines, lipgloss.NewStyle().Foreground(m.ctx.Theme.ErrorText).Render(m.status))
+	}
+	lines = append(lines, "↑/↓ select · Enter choose · Esc cancel")
+	return strings.Join(lines, "\n")
+}
