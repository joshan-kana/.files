@@ -0,0 +1,88 @@
+package data
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestProjectFieldsNormalizeAllSupportedDisplayTypes(t *testing.T) {
+	fieldRef := func(id, name string) ProjectFieldRef {
+		var ref ProjectFieldRef
+		ref.Common.ID, ref.Common.Name = id, name
+		return ref
+	}
+	item := ProjectItem{ID: "item-1", Project: Project{ID: "project-1", Number: 3, Title: "Roadmap"}}
+	item.FieldValues.Nodes = []ProjectFieldValue{
+		{Typename: "ProjectV2ItemFieldTextValue", TextValue: struct {
+			Field ProjectFieldRef
+			Text  string
+		}{fieldRef("text-1", "Notes"), "hello"}},
+		{Typename: "ProjectV2ItemFieldNumberValue", NumberValue: struct {
+			Field  ProjectFieldRef
+			Number float64
+		}{fieldRef("number-1", "Score"), 4.5}},
+		{Typename: "ProjectV2ItemFieldSingleSelectValue", SingleSelectValue: struct {
+			Field    ProjectFieldRef
+			Name     string
+			OptionID string
+		}{fieldRef("select-1", "Status"), "In Progress", "option-1"}},
+		{Typename: "ProjectV2ItemFieldRepositoryValue", RepositoryValue: struct {
+			Field      ProjectFieldRef
+			Repository struct{ NameWithOwner string }
+		}{fieldRef("repo-1", "Repository"), struct{ NameWithOwner string }{"owner/repo"}}},
+	}
+	fields := item.Fields()
+	if len(fields) != 4 {
+		t.Fatalf("got %d normalized fields, want 4", len(fields))
+	}
+	if field, ok := item.Field("Status"); !ok || field.Value != "In Progress" || field.OptionID != "option-1" {
+		t.Fatalf("single-select field was not normalized: %#v", field)
+	}
+	if field, ok := item.Field("Repository"); !ok || field.Value != "owner/repo" {
+		t.Fatalf("repository field was not normalized: %#v", field)
+	}
+}
+
+func TestProjectColumnsDisambiguateMultipleProjectsDeterministically(t *testing.T) {
+	items := []ProjectItem{
+		{Project: Project{Number: 9, Title: "Zeta"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Done"))},
+		{Project: Project{Number: 2, Title: "Alpha"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Todo"))},
+	}
+	got := FormatProjectField(items, ProjectColumn{Name: "Status"})
+	if got != "Alpha: Todo, Zeta: Done" {
+		t.Fatalf("got %q", got)
+	}
+	if got := FormatProjectField(items, ProjectColumn{Name: "Status", Project: "2"}); got != "Todo" {
+		t.Fatalf("project-specific value got %q", got)
+	}
+}
+
+func TestApplyProjectFieldValueUpdatesLocalSourceOfTruth(t *testing.T) {
+	item := ProjectItem{ID: "item-1", Project: Project{ID: "project-1"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Todo"))}
+	item.FieldValues.Nodes[0].SingleSelectValue.Field.Common.ID = "field-1"
+	updated := ApplyProjectFieldValue([]ProjectItem{item}, "project-1", "item-1", "field-1", "Status", "Done")
+	field, ok := updated[0].Field("Status")
+	if !ok || field.Value != "Done" {
+		t.Fatalf("updated field = %#v, ok=%v", field, ok)
+	}
+}
+
+func TestUpdateProjectFieldRejectsInvalidNumberBeforeNetwork(t *testing.T) {
+	if err := UpdateProjectField("project", "item", "field", "NUMBER", "not-a-number"); err == nil || !strings.Contains(err.Error(), "numeric") {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func singleSelect(name, value string) ProjectFieldValue {
+	var ref ProjectFieldRef
+	ref.Common.Name = name
+	return ProjectFieldValue{Typename: "ProjectV2ItemFieldSingleSelectValue", SingleSelectValue: struct {
+		Field    ProjectFieldRef
+		Name     string
+		OptionID string
+	}{ref, value, value + "-id"}}
+}
+
