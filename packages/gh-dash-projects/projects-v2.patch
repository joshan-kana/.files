@@ -0,0 +1,79 @@
+package data
+
+import (
+	"os"
+	"testing"
+)
+
+func TestAuthenticatedProjectFetchSmoke(t *testing.T) {
+	if os.Getenv("GH_DASH_PROJECTS_LIVE_TEST") == "" {
+		t.Skip("set GH_DASH_PROJECTS_LIVE_TEST=1 for an authenticated GitHub smoke test")
+	}
+	response, err := FetchIssues("repo:joshan-kana/.files is:issue 70", 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, issue := range response.Issues {
+		if issue.Number == 70 {
+			if len(issue.ProjectItems.Nodes) == 0 {
+				t.Fatal("issue #70 did not include ProjectV2 memberships")
+			}
+			return
+		}
+	}
+	t.Fatal("issue #70 was not returned by the search")
+}
+
+func TestAuthenticatedProjectFieldMutationSmoke(t *testing.T) {
+	if os.Getenv("GH_DASH_PROJECTS_LIVE_WRITE_TEST") == "" {
+		t.Skip("set GH_DASH_PROJECTS_LIVE_WRITE_TEST=1 for the reversible mutation smoke test")
+	}
+	response, err := FetchIssues("repo:joshan-kana/.files is:issue 70", 10, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var item ProjectItem
+	for _, issue := range response.Issues {
+		if issue.Number == 70 && len(issue.ProjectItems.Nodes) > 0 {
+			item = issue.ProjectItems.Nodes[0]
+			break
+		}
+	}
+	if item.ID == "" {
+		t.Fatal("could not find issue #70 ProjectV2 item")
+	}
+	fields, err := FetchProjectFields(item.Project.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var validation ProjectField
+	for _, field := range fields {
+		if field.Name == "Validation" {
+			validation = field
+			break
+		}
+	}
+	if validation.ID == "" || len(validation.Options) < 2 {
+		t.Fatal("could not discover a selectable Validation field")
+	}
+	original, temporary := "", ""
+	for _, option := range validation.Options {
+		if option.Name == "Not run" {
+			original = option.ID
+		}
+		if option.Name == "Eval only" {
+			temporary = option.ID
+		}
+	}
+	if original == "" || temporary == "" {
+		t.Fatal("expected reversible smoke-test options were not found")
+	}
+	if err := UpdateProjectField(item.Project.ID, item.ID, validation.ID, "ProjectV2SingleSelectField", temporary); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if restoreErr := UpdateProjectField(item.Project.ID, item.ID, validation.ID, "ProjectV2SingleSelectField", original); restoreErr != nil {
+			t.Errorf("failed to restore Validation field: %v", restoreErr)
+		}
+	})
+}
