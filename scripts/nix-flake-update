#!/usr/bin/env bash
# Backwards-compatible wrapper for the old sysfu alias:
#   scripts/nix-flake-update /path/to/flake <profile> [inputs...]

set -euo pipefail

flake_path=${1:-}
target=${2:-}

if [[ -z "$flake_path" || -z "$target" ]]; then
  echo "Usage: $0 /path/to/flake <target> [inputs...]"
  exit 1
fi

shift 2
cd "$flake_path"

exec "$(git rev-parse --show-toplevel)/scripts/flake-update" "$target" "$@"
