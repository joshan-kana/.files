#!/usr/bin/env bash
# Refresh container image digests in hosts/nixos-server/container-images.lock.
#
# Reads the final merged OCI container option from the evaluated NixOS config
# (virtualisation.oci-containers.containers), resolves each registry-backed
# source to its current immutable index digest with skopeo, verifies a
# linux/arm64 image is available, and atomically rewrites the lock.
#
# Requires: skopeo, jq, nix, git.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "error: not inside a Git repository" >&2
  exit 1
}
cd "$repo_root"

LOCK_FILE=hosts/nixos-server/container-images.lock
FLAKE_REF=${FLAKE_REF:-.}

dry_run=false
verbose=false

usage() {
  cat <<'EOF'
Usage: scripts/update-container-images [options]

Refreshes the immutable digest for every registry-backed server container in
hosts/nixos-server/container-images.lock.

Options:
  --dry-run   Resolve and report digests without writing the lock file.
  -v          Print per-container resolution details (digest and arm64 status).
  -h, --help  Show this help.

Environment:
  FLAKE_REF        Flake ref to read container definitions from. Defaults to ".".
  CONTAINER_SELECT Space-separated subset of containers to refresh. When set,
                   only those containers are resolved; all other lock entries are
                   preserved unchanged. A full refresh (no CONTAINER_SELECT)
                   rebuilds the lock exactly from the configured containers.

Requires the `skopeo` binary.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

for tool in skopeo jq nix git; do
  command -v "$tool" >/dev/null 2>&1 || die "required tool '$tool' not found on PATH"
done

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=true
      ;;
    -v)
      verbose=true
      ;;
    *)
      die "unknown option '$1'"
      ;;
  esac
  shift
done

[[ -f "$LOCK_FILE" ]] || die "lock file not found: $LOCK_FILE"

# Reduce the final merged OCI container option to per-container metadata. The
# Nix `apply` in container-image-locking.nix has already transformed registry
# images to `repository:tag@sha256:<digest>`; imageFile/imageStream containers
# are marked local and left alone. Evaluation is pure (no --impure, no getEnv).
containers_json=$(
  nix eval --json "${FLAKE_REF}#nixosConfigurations.nixos-server.config.virtualisation.oci-containers.containers" --apply '
    c: builtins.mapAttrs (name: container:
      if container.imageFile != null || container.imageStream != null then
        { local = true; image = container.image; }
      else
        { local = false; image = container.image; }
    ) c
  '
) || die "failed to evaluate virtualisation.oci-containers.containers for nixos-server"

[[ -n "$containers_json" ]] || die "container evaluation returned empty output"

# Parse each registry image `repository:tag@sha256:<digest>` into source and
# currentDigest, failing clearly on an unexpected shape.
containers_json=$(
  printf '%s' "$containers_json" | jq '
    map_values(. as $v
      | if $v.local then $v
        else
          ($v.image | split("@")) as $parts
          | if ($parts | length) != 2 then
              error("unexpected image shape: " + $v.image)
            else
              { local: false, source: $parts[0], currentDigest: $parts[1] }
            end
        end)
  '
) || die "failed to parse container images"

# Optional subset: only these containers are refreshed; all others are preserved.
selected_names=()
selected_names_json="null"
if [[ -n "${CONTAINER_SELECT:-}" ]]; then
  read -r -a selected_names <<<"$CONTAINER_SELECT"
  selected_names_json=$(printf '%s\n' "${selected_names[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')
  unknown=$(printf '%s' "$containers_json" | jq -r --argjson sel "$selected_names_json" '
    $sel[] as $k | select((has($k) | not)) | $k
  ')
  if [[ -n "$unknown" ]]; then
    die "unknown container(s) in CONTAINER_SELECT: $(printf '%s' "$unknown" | tr '\n' ' ')"
  fi
fi

current_locks=$(cat "$LOCK_FILE")

# The Nix apply above already yields `source` (repository:tag). Re-derive the
# registry-backed source list from the evaluated option.
registry_entries=$(
  printf '%s' "$containers_json" | jq -r --argjson sel "$selected_names_json" '
    to_entries[] as $e
    | select($e.value.local == false)
    | select($sel == null or ($sel | index($e.key)))
    | $e.key + "\t" + $e.value.source
  '
)

# Resolve the immutable top-level digest for a source and prove linux/arm64 is
# available. Prints: <digest>  <kind>  <arm64: yes|no>
resolve_image() {
  local name=$1 source=$2
  local metadata raw digest kind arm64 platform m_arch m_os

  metadata=$(
    skopeo inspect --no-tags --override-arch arm64 --override-os linux "docker://${source}"
  ) || die "${name}: failed to inspect ${source} (does it exist and is it reachable?)"

  digest=$(printf '%s' "$metadata" | jq -r '.Digest')
  [[ "$digest" == sha256:* ]] || die "${name}: no digest returned for ${source}"

  raw=$(skopeo inspect --raw "docker://${source}") || die "${name}: failed to read the raw manifest for ${source}"

  if printf '%s' "$raw" | jq -e '(.manifests | type) == "array"' >/dev/null 2>&1; then
    kind="index"
    arm64=$(printf '%s' "$raw" | jq -r '
      if ([.manifests[].platform | select(.os == "linux" and .architecture == "arm64")] | length) > 0
      then "yes" else "no" end
    ')
    if [[ "$arm64" != "yes" ]]; then
      die "${name}: ${source} is a multi-platform index but has no linux/arm64 manifest; refusing to update"
    fi
  else
    kind="single"
    m_arch=$(printf '%s' "$metadata" | jq -r '.Architecture')
    m_os=$(printf '%s' "$metadata" | jq -r '.Os')
    platform="$m_arch/$m_os"
    if [[ "$platform" == "arm64/linux" || "$platform" == "linux/arm64" ]]; then
      arm64="yes"
    else
      die "${name}: ${source} is a single ${platform} manifest; refusing to update (linux/arm64 unavailable)"
    fi
  fi

  printf '%s\t%s\t%s\n' "$digest" "$kind" "$arm64"
}

resolved=$(
  printf '%s\n' "$registry_entries" |
    while IFS=$'\t' read -r name source; do
      result=$(resolve_image "$name" "$source")
      printf '%s\t%s\t%s\n' "$name" "$source" "$result"
    done
)

[[ -n "$resolved" ]] || die "no registry containers resolved; refusing to rewrite lock"

if printf '%s\n' "$resolved" | awk -F '\t' 'NF != 5 || $4 == "" { exit 1 }'; then
  :
else
  die "incomplete container resolution output; refusing to rewrite lock"
fi

# Build the lock object. Full refresh rebuilds from configured containers only;
# a selected refresh merges into the current lock, preserving unselected entries.
if [[ "${#selected_names[@]}" -gt 0 ]]; then
  new_lock_json=$(
    {
      printf '%s' "$current_locks"
      printf '%s\n' "$resolved" |
        jq -Rrs '
          split("\n") | map(select(length > 0)) |
          map(split("\t") | {name: .[0], source: .[1], digest: .[2]}) |
          reduce .[] as $e ({}; .[$e.name] = {source: $e.source, digest: $e.digest})
        '
    } | jq -s 'add'
  )
else
  new_lock_json=$(
    printf '%s\n' "$resolved" |
      jq -Rrs '
        split("\n") | map(select(length > 0)) |
        map(split("\t") | {name: .[0], source: .[1], digest: .[2]}) |
        reduce .[] as $e ({}; .[$e.name] = {source: $e.source, digest: $e.digest})
      '
  )
fi

# Every configured registry container must have a lock entry.
configured_names=$(
  printf '%s' "$containers_json" | jq -r 'to_entries[] | select(.value.local == false) | .key'
)
missing=$(
  while IFS= read -r cname; do
    printf '%s' "$new_lock_json" | jq -e --arg k "$cname" 'has($k)' >/dev/null 2>&1 || printf '%s\n' "$cname"
  done <<<"$configured_names"
)
if [[ -n "$missing" ]]; then
  die "configured container(s) missing from lock: $(printf '%s' "$missing" | tr '\n' ' ')"
fi

if [[ "${#selected_names[@]}" -eq 0 ]]; then
  cfg_json=$(printf '%s' "$configured_names" | jq -Rsc 'split("\n") | map(select(length > 0))')
  stale=$(
    printf '%s' "$new_lock_json" | jq -r --argjson cfg "$cfg_json" '
      keys[] | select(($cfg | index(.)) | not)
    '
  )
  if [[ -n "$stale" ]]; then
    die "unexpected stale lock key(s) after full refresh: $(printf '%s' "$stale" | tr '\n' ' ')"
  fi
else
  # A selected refresh preserves unselected entries. Fail clearly if the lock
  # holds an entry for a container that is no longer configured.
  stale_preserved=$(
    printf '%s' "$new_lock_json" | jq -r --argjson src "$(printf '%s' "$containers_json" | jq 'with_entries(select(.value.local == false))')" '
      keys[] as $k | select(($src | has($k)) | not) | $k
    '
  )
  if [[ -n "$stale_preserved" ]]; then
    die "stale lock entries exist (not in configured containers): $(printf '%s' "$stale_preserved" | tr '\n' ' '); run a full container refresh (sysfu server --containers-only)"
  fi
fi

# Confirm every lock entry's recorded source matches the configured source.
source_mismatch=$(
  printf '%s' "$new_lock_json" | jq -r --argjson src "$(printf '%s' "$containers_json" | jq 'with_entries(select(.value.local == false))')" '
    to_entries[] as $e
    | select($src | has($e.key))
    | ($src[$e.key].source) as $expected
    | select($e.value.source != $expected)
    | $e.key + " (" + $e.value.source + " != " + $expected + ")"
  '
)
if [[ -n "$source_mismatch" ]]; then
  die "lock source mismatch(es): $(printf '%s' "$source_mismatch" | tr '\n' ' ')"
fi

# Verbose per-container report.
if [[ "$verbose" == true ]]; then
  printf '%-16s %-60s %s\n' "container" "source" "digest (kind, arm64)"
  printf '%s\n' "$resolved" | while IFS=$'\t' read -r name source digest kind arm64; do
    printf '%-16s %-60s %s (%s, %s)\n' "$name" "$source" "$digest" "$kind" "$arm64"
  done
fi

# Detect whether anything actually changed.
changed=false
if [[ "$(printf '%s' "$new_lock_json" | jq -S .)" != "$(printf '%s' "$current_locks" | jq -S .)" ]]; then
  changed=true
fi

if [[ "$changed" != true ]]; then
  if [[ "${#selected_names[@]}" -gt 0 ]]; then
    echo "Selected container images are up to date; ${LOCK_FILE} unchanged."
  else
    echo "All container images are up to date; ${LOCK_FILE} unchanged."
  fi
  exit 0
fi

if [[ "$dry_run" == true ]]; then
  echo "Dry run: the following changes would be written to ${LOCK_FILE}:"
  diff -u <(printf '%s\n' "$current_locks" | jq -S .) <(printf '%s\n' "$new_lock_json" | jq -S .) || true
  exit 0
fi

# Write atomically only after every image resolved and all validation passed.
tmp=$(mktemp "${LOCK_FILE}.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$new_lock_json" >"$tmp"
chmod 0644 "$tmp"
mv "$tmp" "$LOCK_FILE"

echo "Updated ${LOCK_FILE}:"
diff -u <(printf '%s\n' "$current_locks" | jq -S .) <(printf '%s\n' "$new_lock_json" | jq -S .) || true
