#!/usr/bin/env python3
import argparse
import collections
import datetime as dt
import gzip
import json
import os
import re
import tarfile
from pathlib import Path


SENSITIVE_KEY = re.compile(
    r"(secret|token|password|passwd|credential|authorization|auth|key|cert|"
    r"private|cookie|session|refresh|access|client_secret|api)",
    re.IGNORECASE,
)


SKIP_ADDON = re.compile(r"openclaw", re.IGNORECASE)


def human_size(size):
    value = float(size)
    for unit in ["B", "KiB", "MiB", "GiB", "TiB"]:
        if value < 1024 or unit == "TiB":
            if unit == "B":
                return f"{int(value)} {unit}"
            return f"{value:.1f} {unit}"
        value /= 1024


def safe_json_load(path):
    try:
        return json.loads(path.read_text())
    except Exception:
        return None


def redact(value, key=""):
    if SENSITIVE_KEY.search(key):
        return "REDACTED"
    if isinstance(value, dict):
        return {k: redact(v, k) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, key) for v in value]
    if isinstance(value, str):
        if len(value) > 80:
            return "REDACTED_LONG_VALUE"
        if re.search(r"(Bearer\s+|eyJ[A-Za-z0-9_-]+\.|[A-Fa-f0-9]{32,})", value):
            return "REDACTED"
    return value


def tar_members(path):
    try:
        with tarfile.open(path, "r:*") as tar:
            return [member for member in tar.getmembers() if member.isfile()]
    except (tarfile.TarError, gzip.BadGzipFile):
        return []


def tar_json_member(path, member_name):
    try:
        with tarfile.open(path, "r:*") as tar:
            names = [member_name]
            if member_name.startswith("./"):
                names.append(member_name.removeprefix("./"))
            else:
                names.append(f"./{member_name}")

            member = None
            for name in names:
                try:
                    member = tar.getmember(name)
                    break
                except KeyError:
                    continue
            if member is None:
                return None
            extracted = tar.extractfile(member)
            if extracted is None:
                return None
            return json.load(extracted)
    except Exception:
        return None


def summarize_homeassistant(backup_dir):
    archive = backup_dir / "homeassistant.tar.gz"
    members = tar_members(archive)
    by_top = collections.Counter()
    sizes = collections.Counter()
    storage_files = []

    for member in members:
        name = member.name.removeprefix("./")
        if not name.startswith("data/"):
            continue
        rel = name.removeprefix("data/")
        top = rel.split("/", 1)[0]
        by_top[top] += 1
        sizes[top] += member.size
        if rel.startswith(".storage/"):
            storage_files.append(rel)

    config_entries = tar_json_member(archive, "./data/.storage/core.config_entries")
    domains = collections.Counter()
    if isinstance(config_entries, dict):
        entries = config_entries.get("data", {}).get("entries", [])
        for entry in entries:
            domain = entry.get("domain")
            if domain:
                domains[domain] += 1

    device_registry = tar_json_member(archive, "./data/.storage/core.device_registry")
    entity_registry = tar_json_member(archive, "./data/.storage/core.entity_registry")

    device_count = 0
    entity_count = 0
    entity_platforms = collections.Counter()
    if isinstance(device_registry, dict):
        device_count = len(device_registry.get("data", {}).get("devices", []))
    if isinstance(entity_registry, dict):
        entities = entity_registry.get("data", {}).get("entities", [])
        entity_count = len(entities)
        for entity in entities:
            platform = entity.get("platform")
            if platform:
                entity_platforms[platform] += 1

    return {
        "archive_size": archive.stat().st_size if archive.exists() else 0,
        "top_level": by_top,
        "top_level_sizes": sizes,
        "storage_files": sorted(storage_files),
        "integration_domains": domains,
        "device_count": device_count,
        "entity_count": entity_count,
        "entity_platforms": entity_platforms,
    }


def summarize_addons(backup_dir):
    addons = []
    backup_json = safe_json_load(backup_dir / "backup.json") or {}
    for addon in backup_json.get("addons", []):
        slug = addon.get("slug", "")
        name = addon.get("name", slug)
        if SKIP_ADDON.search(slug) or SKIP_ADDON.search(name):
            continue
        addon_dir = backup_dir / slug
        addon_json = safe_json_load(addon_dir / "addon.json") or {}
        archive = backup_dir / f"{slug}.tar.gz"
        members = tar_members(archive)
        addons.append(
            {
                "slug": slug,
                "name": name,
                "version": addon.get("version", "unknown"),
                "archive_size": archive.stat().st_size if archive.exists() else 0,
                "member_count": len(members),
                "addon_json": redact(addon_json),
            }
        )
    return addons


def write_markdown(backup_dir, output):
    ha = summarize_homeassistant(backup_dir)
    addons = summarize_addons(backup_dir)
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

    lines = [
        "# Home Assistant Backup Inventory",
        "",
        f"Generated: {now}",
        f"Source: `{backup_dir.name}`",
        "",
        "This file is intentionally sanitized. It inventories migration-relevant",
        "structure, sizes, and integration domains without copying secret values.",
        "OpenClaw add-on data is intentionally ignored.",
        "",
        "## Home Assistant",
        "",
        f"- Archive size: {human_size(ha['archive_size'])}",
        f"- Device registry entries: {ha['device_count']}",
        f"- Entity registry entries: {ha['entity_count']}",
        "",
        "### Data Areas",
        "",
        "| Area | Files | Size |",
        "| --- | ---: | ---: |",
    ]

    for area, count in sorted(ha["top_level"].items()):
        lines.append(
            f"| `{area}` | {count} | {human_size(ha['top_level_sizes'][area])} |"
        )

    lines.extend(["", "### Integration Domains", "", "| Domain | Entries |", "| --- | ---: |"])
    for domain, count in sorted(ha["integration_domains"].items()):
        lines.append(f"| `{domain}` | {count} |")

    lines.extend(["", "### Entity Platforms", "", "| Platform | Entities |", "| --- | ---: |"])
    for platform, count in sorted(ha["entity_platforms"].items()):
        lines.append(f"| `{platform}` | {count} |")

    lines.extend(["", "### Storage Files", ""])
    for storage_file in ha["storage_files"]:
        lines.append(f"- `{storage_file}`")

    lines.extend(["", "## Add-ons", "", "| Add-on | Slug | Version | Archive | Files |", "| --- | --- | ---: | ---: | ---: |"])
    for addon in addons:
        lines.append(
            f"| {addon['name']} | `{addon['slug']}` | {addon['version']} | "
            f"{human_size(addon['archive_size'])} | {addon['member_count']} |"
        )

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text("\n".join(lines) + "\n")


def main():
    parser = argparse.ArgumentParser(description="Create a sanitized HA backup inventory.")
    parser.add_argument("backup_dir", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    if not args.backup_dir.exists():
        raise SystemExit(f"backup directory does not exist: {args.backup_dir}")
    write_markdown(args.backup_dir, args.output)


if __name__ == "__main__":
    main()
