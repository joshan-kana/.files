#!/usr/bin/env bash

# Script to update Plasma configuration using plasma-manager's rc2nix exporter.
# This script runs rc2nix directly from the upstream repo and replaces the
# content in plasma_hm.nix from line 3 onwards.

set -euo pipefail

# Define paths
PLASMA_CONFIG_FILE="$DOTFILES/desktop/plasma/plasma_hm.nix"
TEMP_FILE=$(mktemp)
ERR_FILE=$(mktemp)

cleanup() {
    rm -f "$TEMP_FILE" "$ERR_FILE" "${TEMP_FILE}.new"
}

trap cleanup EXIT

# Check if the plasma config file exists
if [[ ! -f "$PLASMA_CONFIG_FILE" ]]; then
    echo "Error: Plasma config file not found at $PLASMA_CONFIG_FILE"
    exit 1
fi

# Run the exporter and capture output.
# Keep stderr separate so warnings/errors don't corrupt the generated Nix.
if ! nix run github:nix-community/plasma-manager#rc2nix -- >"$TEMP_FILE" 2>"$ERR_FILE"; then
    echo "Error: Failed to export Plasma config"
    if [[ -s "$ERR_FILE" ]]; then
        echo "Error output:" >&2
        cat "$ERR_FILE" >&2
    fi
    exit 1
fi

if [[ -s "$ERR_FILE" ]]; then
    echo "Warning: exporter wrote to stderr (output still captured from stdout)." >&2
    cat "$ERR_FILE" >&2
fi

# Safety check: ensure we actually captured a plasma-manager module.
if ! grep -q "programs.plasma" "$TEMP_FILE"; then
    echo "Error: Export output did not contain programs.plasma (unexpected output)"
    echo "Output:"
    cat "$TEMP_FILE"
    exit 1
fi

echo "Updating $PLASMA_CONFIG_FILE..."

# Extract the first two lines (header) from the original file
head -n 2 "$PLASMA_CONFIG_FILE" > "${TEMP_FILE}.new"

# Append the output from plasma-manager to the new file
cat "$TEMP_FILE" >> "${TEMP_FILE}.new"

# Replace the original file with the updated content
mv "${TEMP_FILE}.new" "$PLASMA_CONFIG_FILE"

echo "Successfully updated $PLASMA_CONFIG_FILE"
echo "The file has been updated with the latest plasma-manager configuration."