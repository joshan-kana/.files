#!/usr/bin/env bash

# Update the Home Manager half of the unified Plasma semantic scope using
# plasma-manager's rc2nix exporter. The NixOS Plasma enable stays in the same
# scope and is preserved by rebuilding the small wrapper around the exporter.

set -euo pipefail

PLASMA_CONFIG_FILE="$DOTFILES/desktop/plasma/default.nix"
TEMP_FILE=$(mktemp)
ERR_FILE=$(mktemp)
NEW_FILE=$(mktemp)

cleanup() {
    rm -f "$TEMP_FILE" "$ERR_FILE" "$NEW_FILE"
}
trap cleanup EXIT

if [[ ! -f "$PLASMA_CONFIG_FILE" ]]; then
    echo "Error: Plasma config file not found at $PLASMA_CONFIG_FILE"
    exit 1
fi

if ! nix run github:nix-community/plasma-manager#rc2nix -- >"$TEMP_FILE" 2>"$ERR_FILE"; then
    echo "Error: Failed to export Plasma config"
    if [[ -s "$ERR_FILE" ]]; then
        cat "$ERR_FILE" >&2
    fi
    exit 1
fi

if [[ -s "$ERR_FILE" ]]; then
    echo "Warning: exporter wrote to stderr (output still captured from stdout)." >&2
    cat "$ERR_FILE" >&2
fi

if ! grep -q "programs.plasma" "$TEMP_FILE"; then
    echo "Error: Export output did not contain programs.plasma"
    cat "$TEMP_FILE"
    exit 1
fi

{
    cat <<'NIX'
_: {
  services.desktopManager.plasma6.enable = true;

  home =
NIX
    sed 's/^/    /' "$TEMP_FILE"
    cat <<'NIX'
  ;
}
NIX
} >"$NEW_FILE"

nix fmt "$NEW_FILE" >/dev/null
mv "$NEW_FILE" "$PLASMA_CONFIG_FILE"

echo "Successfully updated $PLASMA_CONFIG_FILE"
