#!/usr/bin/env bash
# Update flake inputs on a dedicated upgrade branch, build the selected target
# before and after the update, and evaluate the rest of the fleet before merging.

set -euo pipefail

MAIN_BRANCH=${MAIN_BRANCH:-main}
UPDATE_BRANCH=${UPDATE_BRANCH:-system-upgrade}
if [[ -v NIXOS_REBUILD_FLAGS ]]; then
  read -r -a nix_flags <<< "$NIXOS_REBUILD_FLAGS"
else
  nix_flags=()
fi

usage() {
  cat <<'EOF'
Usage: scripts/flake-update <target> [options] [inputs...]

Targets:
  linux-desktop       Alias for nixos
  nixos               Full x86_64 Linux desktop
  nixos-arm-parallels ARM Linux desktop VM
  nixos-orbstack      OrbStack Linux container
  all                 All current NixOS configurations

Inputs:
  If inputs are provided, only those inputs are updated.
  If no inputs are provided, all inputs are updated.

Options:
  --list-nixpkgs-commits [branch]
      Print recent nixpkgs commits on a branch. Defaults to nixos-unstable.

  --input-ref <input>=<flake-ref>
      Pin one input to a specific flake ref instead of updating it to latest.
      Can be repeated.

  --nixpkgs-ref <rev-or-ref>
      Shorthand for --input-ref nixpkgs=<ref>. Plain revisions or branch names
      are expanded to github:NixOS/nixpkgs/<rev-or-ref>.

  --choose-nixpkgs-ref [branch]
      Choose from recent nixpkgs commits on a branch. Defaults to nixos-unstable.

Examples:
  scripts/flake-update linux-desktop nixpkgs
  scripts/flake-update nixos home-manager stylix
  scripts/flake-update nixos --list-nixpkgs-commits
  scripts/flake-update nixos --nixpkgs-ref nixos-25.05
  scripts/flake-update nixos --nixpkgs-ref 331800de5053fce193d25d75f7c39b2b449c9a2f
  scripts/flake-update nixos --choose-nixpkgs-ref
  scripts/flake-update nixos --choose-nixpkgs-ref nixos-25.05
  scripts/flake-update nixos --input-ref nixpkgs=github:NixOS/nixpkgs/nixos-unstable
  scripts/flake-update all

Environment:
  MAIN_BRANCH          Branch to compare against. Defaults to main.
  UPDATE_BRANCH        Branch used for update work. Defaults to system-upgrade.
  NIXOS_REBUILD_FLAGS  Extra nix eval/build flags. Defaults to none.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository"
cd "$repo_root"

target=${1:-}
[[ -n "$target" ]] || {
  usage
  exit 1
}
shift

if [[ "$target" == "-h" || "$target" == "--help" ]]; then
  usage
  exit 0
fi

current_branch=$(git branch --show-current)
[[ -n "$current_branch" ]] || die "detached HEAD is not supported for update branches"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

normalize_nixpkgs_ref() {
  case "$1" in
    github:* | git+* | path:* | "flake:"* | "tarball:"*) echo "$1" ;;
    *) echo "github:NixOS/nixpkgs/$1" ;;
  esac
}

fetch_nixpkgs_commits() {
  local branch=${1:-nixos-unstable}
  local depth=${NIXPKGS_COMMIT_CHOOSER_DEPTH:-80}
  local repo_url=${NIXPKGS_COMMIT_CHOOSER_REPO:-https://github.com/NixOS/nixpkgs.git}
  local chooser_dir="$tmpdir/nixpkgs-chooser-${branch//[^a-zA-Z0-9_.-]/-}"

  echo "Fetching the latest ${depth} nixpkgs commits from ${branch}..." >&2
  mkdir -p "$chooser_dir"
  git -C "$chooser_dir" init --quiet
  if ! git -C "$chooser_dir" remote get-url origin >/dev/null 2>&1; then
    git -C "$chooser_dir" remote add origin "$repo_url"
  fi
  git -C "$chooser_dir" fetch --quiet --depth "$depth" origin "$branch"
  echo "$chooser_dir"
}

list_nixpkgs_commits() {
  local branch=${1:-nixos-unstable}
  local chooser_dir

  chooser_dir=$(fetch_nixpkgs_commits "$branch")
  git -C "$chooser_dir" log --format='%h %cs %s' FETCH_HEAD
}

choose_nixpkgs_ref() {
  local branch=${1:-nixos-unstable}
  local allow_back=${2:-false}
  local chooser_dir
  local chosen

  chooser_dir=$(fetch_nixpkgs_commits "$branch")

  if command -v fzf >/dev/null 2>&1; then
    chosen=$(
      {
        [[ "$allow_back" == true ]] && echo "__BACK__ Back"
        git -C "$chooser_dir" log --format='%H %h %cs %s' FETCH_HEAD
      } |
        fzf --height=60% --reverse --prompt="nixpkgs ${branch}> " || true
    )
    if [[ -z "$chosen" ]]; then
      [[ "$allow_back" == true ]] && {
        echo "__BACK__"
        return
      }
      die "no nixpkgs commit selected"
    fi
    if [[ "$chosen" == "__BACK__ "* ]]; then
      echo "__BACK__"
      return
    fi
    echo "${chosen%% *}"
    return
  fi

  if [[ "$allow_back" == true ]]; then
    echo " 0. Back" >&2
  fi
  git -C "$chooser_dir" log --format='%h %cs %s' FETCH_HEAD | nl -w2 -s'. ' >&2
  echo >&2
  read -r -p "Choose a nixpkgs commit number: " chosen </dev/tty
  if [[ "$allow_back" == true && "$chosen" == 0 ]]; then
    echo "__BACK__"
    return
  fi
  [[ "$chosen" =~ ^[0-9]+$ ]] || die "selection must be a number"

  chosen=$(git -C "$chooser_dir" log --format='%H' FETCH_HEAD | sed -n "${chosen}p")
  [[ -n "$chosen" ]] || die "selection is outside the fetched commit list"
  echo "$chosen"
}

select_menu_item() {
  local prompt=$1
  shift

  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$@" | fzf --height=40% --reverse --prompt="$prompt" || true
    return
  fi

  local item index=1 selected
  for item in "$@"; do
    printf '%2d. %s\n' "$index" "$item" >&2
    index=$((index + 1))
  done
  echo >&2
  read -r -p "$prompt" selected </dev/tty
  [[ "$selected" =~ ^[0-9]+$ ]] || die "selection must be a number"
  item=${@:$selected:1}
  [[ -n "$item" ]] || die "selection is outside the menu"
  echo "$item"
}

confirm() {
  local answer
  read -r -p "$1 [y/N] " answer </dev/tty
  [[ "$answer" == [Yy] || "$answer" == [Yy][Ee][Ss] ]]
}

run_interactive_menu() {
  local choice branch chosen selected

  while true; do
    choice=$(
      select_menu_item "sysfu> " \
        "Update all inputs to latest" \
        "Choose nixpkgs commit" \
        "List recent nixpkgs commits" \
        "Update selected inputs" \
        "Undo flake.lock changes from ${MAIN_BRANCH}" \
        "Help" \
        "Quit"
    )
    [[ -z "$choice" ]] && continue

    case "$choice" in
      "Update all inputs to latest")
        return
        ;;
      "Choose nixpkgs commit")
        branch=$(
          select_menu_item "nixpkgs branch> " \
            "nixos-unstable" \
            "nixos-25.05" \
            "nixos-24.11" \
            "Back"
        )
        [[ -z "$branch" || "$branch" == "Back" ]] && continue
        chosen=$(choose_nixpkgs_ref "$branch" true)
        [[ "$chosen" == "__BACK__" ]] && continue
        input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "$chosen")")
        return
        ;;
      "List recent nixpkgs commits")
        branch=$(
          select_menu_item "nixpkgs branch> " \
            "nixos-unstable" \
            "nixos-25.05" \
            "nixos-24.11" \
            "Back"
        )
        [[ -z "$branch" || "$branch" == "Back" ]] && continue
        list_nixpkgs_commits "$branch" | less -R
        ;;
      "Update selected inputs")
        if command -v fzf >/dev/null 2>&1; then
          selected=$(
            printf '%s\n' "__BACK__ Back" nixpkgs home-manager stylix spicetify-nix plasma-manager |
              fzf --multi --height=40% --reverse --prompt="inputs> " || true
          )
          [[ -n "$selected" ]] || continue
          [[ "$selected" == *"__BACK__ Back"* ]] && continue
          while IFS= read -r selected_input; do
            inputs+=("$selected_input")
          done <<< "$selected"
        else
          selected=$(
            select_menu_item "input> " \
              "nixpkgs" \
              "home-manager" \
              "stylix" \
              "spicetify-nix" \
              "plasma-manager" \
              "Back"
          )
          [[ "$selected" == "Back" ]] && continue
          inputs+=("$selected")
        fi
        return
        ;;
      "Undo flake.lock changes from ${MAIN_BRANCH}")
        undo_lock=true
        return
        ;;
      "Help")
        usage | less -R
        ;;
      "Quit")
        exit 0
        ;;
    esac
  done
}

input_refs=()
inputs=()
undo_lock=false
interactive_menu=false

if [[ "$#" -eq 0 && -t 0 && -t 1 ]]; then
  interactive_menu=true
fi

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --list-nixpkgs-commits)
      if [[ "${2:-}" != "" && "${2:-}" != -* ]]; then
        list_nixpkgs_commits "$2"
      else
        list_nixpkgs_commits
      fi
      exit 0
      ;;
    --list-nixpkgs-commits=*)
      list_nixpkgs_commits "${1#--list-nixpkgs-commits=}"
      exit 0
      ;;
    --input-ref)
      [[ "$#" -ge 2 ]] || die "--input-ref requires input=flake-ref"
      [[ "$2" == *=* ]] || die "--input-ref must be formatted as input=flake-ref"
      input_refs+=("$2")
      shift 2
      ;;
    --input-ref=*)
      input_ref=${1#--input-ref=}
      [[ "$input_ref" == *=* ]] || die "--input-ref must be formatted as input=flake-ref"
      input_refs+=("$input_ref")
      shift
      ;;
    --nixpkgs-ref)
      [[ "$#" -ge 2 ]] || die "--nixpkgs-ref requires a revision, branch, or flake ref"
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "$2")")
      shift 2
      ;;
    --nixpkgs-ref=*)
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "${1#--nixpkgs-ref=}")")
      shift
      ;;
    --choose-nixpkgs-ref)
      if [[ "${2:-}" != "" && "${2:-}" != -* ]]; then
        chosen_ref=$(choose_nixpkgs_ref "$2")
        shift 2
      else
        chosen_ref=$(choose_nixpkgs_ref)
        shift
      fi
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "$chosen_ref")")
      ;;
    --choose-nixpkgs-ref=*)
      chosen_ref=$(choose_nixpkgs_ref "${1#--choose-nixpkgs-ref=}")
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "$chosen_ref")")
      shift
      ;;
    --)
      shift
      inputs+=("$@")
      break
      ;;
    -*)
      die "unknown option '$1'"
      ;;
    *)
      inputs+=("$1")
      shift
      ;;
  esac
done

if [[ "$interactive_menu" == true ]]; then
  run_interactive_menu
fi

if [[ "$current_branch" != "$UPDATE_BRANCH" ]]; then
  if git show-ref --verify --quiet "refs/heads/${UPDATE_BRANCH}"; then
    echo "Switching to existing update branch ${UPDATE_BRANCH}..."
    git switch "$UPDATE_BRANCH"
  else
    echo "Creating update branch ${UPDATE_BRANCH}..."
    git switch -c "$UPDATE_BRANCH"
  fi
fi

if [[ "$undo_lock" == true ]]; then
  if confirm "Restore flake.lock from ${MAIN_BRANCH}?"; then
    git restore --source "$MAIN_BRANCH" -- flake.lock
    echo "flake.lock restored from ${MAIN_BRANCH}."
    exit 0
  fi
  echo "Undo cancelled."
  exit 0
fi

map_target() {
  case "$1" in
    linux-desktop) echo "nixos" ;;
    nixos | nixos-arm-parallels | nixos-orbstack) echo "$1" ;;
    *) return 1 ;;
  esac
}

all_profiles=(nixos nixos-arm-parallels nixos-orbstack)

if [[ "$target" == "all" ]]; then
  target_profiles=("${all_profiles[@]}")
else
  profile=$(map_target "$target") || die "unknown target '$target'"
  target_profiles=("$profile")
fi

main_flake="git+file://${repo_root}?ref=${MAIN_BRANCH}"
current_flake="."

system_attr() {
  local flake_ref=$1
  local profile=$2
  printf '%s#nixosConfigurations.%s.config.system.build.toplevel' "$flake_ref" "$profile"
}

eval_profile() {
  local flake_ref=$1
  local profile=$2
  echo "Evaluating ${profile} from ${flake_ref}..."
  nix eval "${nix_flags[@]}" --raw "$(system_attr "$flake_ref" "$profile").drvPath" >/dev/null
}

eval_profile_optional() {
  local flake_ref=$1
  local profile=$2
  local err_file="$tmpdir/eval-${profile}.err"

  if ! eval_profile "$flake_ref" "$profile" 2>"$err_file"; then
    cat "$err_file" >&2
    if grep -Eq "path '.*' does not exist|access to absolute path .* is forbidden" "$err_file"; then
      echo "warning: skipped ${profile}; it needs a local path that is not available on this machine" >&2
      return 0
    fi

    die "${profile} failed evaluation. This is not being skipped because it does not look like a local-path availability issue."
  else
    rm -f "$err_file"
    return 0
  fi
}

build_profile() {
  local flake_ref=$1
  local profile=$2
  local output=$3
  echo "Building ${profile} from ${flake_ref}..."
  nix build "${nix_flags[@]}" "$(system_attr "$flake_ref" "$profile")" -o "$output"
}

diff_closures() {
  local old_out=$1
  local new_out=$2

  if command -v nvd >/dev/null 2>&1; then
    nvd diff "$old_out" "$new_out"
  else
    nix store diff-closures "$old_out" "$new_out"
  fi
}

echo "Target profiles: ${target_profiles[*]}"

echo "Checking current ${MAIN_BRANCH} evaluations before updating..."
for profile in "${all_profiles[@]}"; do
  eval_profile_optional "$main_flake" "$profile"
done

echo "Checking selected target evaluations before updating..."
for profile in "${target_profiles[@]}"; do
  eval_profile "$main_flake" "$profile"
done

for profile in "${target_profiles[@]}"; do
  build_profile "$main_flake" "$profile" "$tmpdir/${profile}-old"
done

if [[ "${#inputs[@]}" -gt 0 ]]; then
  echo "Updating selected flake inputs: ${inputs[*]}"
  nix flake update "${inputs[@]}"
elif [[ "${#input_refs[@]}" -eq 0 ]]; then
  echo "Updating all flake inputs..."
  nix flake update
fi

for input_ref in "${input_refs[@]}"; do
  input_name=${input_ref%%=*}
  flake_ref=${input_ref#*=}
  echo "Pinning ${input_name} to ${flake_ref}..."
  nix flake lock --override-input "$input_name" "$flake_ref"
done

if [[ "${#inputs[@]}" -eq 0 && "${#input_refs[@]}" -gt 0 ]]; then
  echo "Only pinned inputs were changed; no full flake update was run."
fi

echo "Checking updated branch evaluations..."
for profile in "${all_profiles[@]}"; do
  eval_profile_optional "$current_flake" "$profile"
done

echo "Checking selected updated target evaluations..."
for profile in "${target_profiles[@]}"; do
  eval_profile "$current_flake" "$profile"
done

for profile in "${target_profiles[@]}"; do
  build_profile "$current_flake" "$profile" "$tmpdir/${profile}-new"
  echo
  echo "Diff for ${profile}:"
  diff_closures "$tmpdir/${profile}-old" "$tmpdir/${profile}-new"
done

cat <<EOF

Update branch is ready for review.

Useful inspection commands:
  git diff ${MAIN_BRANCH} -- flake.lock
  git diff ${MAIN_BRANCH}
  nix-tree result
  nix why-depends result /nix/store/...-package
EOF
