#!/usr/bin/env bash
set -euo pipefail

original_args=("$@")

MAIN_BRANCH=${MAIN_BRANCH:-main}
UPDATE_BRANCH=${UPDATE_BRANCH:-system-upgrade}

usage() {
  cat <<'EOF'
Usage: scripts/flake-update [all|<nixosConfiguration>] [options]

With no target, use the current $FLK_PROFILE.

Options:
  --containers-only   Refresh only the target's container lock.
  --container <name>  Refresh only one target container. Implies --containers-only.
  --no-containers     Update flake inputs without refreshing container locks.
  -h, --help          Show this help.

Examples:
  sysfu
  sysfu all
  sysfu <nixosConfiguration>
  sysfu <nixosConfiguration> --containers-only
  sysfu <nixosConfiguration> --container <name>
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository"
cd "$repo_root"

target=${FLK_PROFILE:-}
if [[ $# -gt 0 && $1 != -* ]]; then
  target=$1
  shift
fi
[[ -n "$target" ]] || die "specify 'all' or a nixosConfiguration"

containers_only=false
no_containers=false
container=""
updated_flake=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --containers-only)
      containers_only=true
      ;;
    --container)
      [[ $# -ge 2 ]] || die "--container requires a name"
      container=$2
      containers_only=true
      shift
      ;;
    --container=*)
      container=${1#--container=}
      containers_only=true
      ;;
    --no-containers)
      no_containers=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument '$1'"
      ;;
  esac
  shift
done

[[ "$containers_only" != true || "$no_containers" != true ]] || \
  die "--containers-only and --no-containers are mutually exclusive"
[[ -z "$container" || "$target" != all ]] || \
  die "--container requires a specific nixosConfiguration"

missing_tools=()
for tool in jq skopeo; do
  command -v "$tool" >/dev/null 2>&1 || missing_tools+=("$tool")
done
if ((${#missing_tools[@]})); then
  [[ "${FLAKE_UPDATE_RUNTIME:-}" != 1 ]] || \
    die "system-upgrade runtime is missing: ${missing_tools[*]}"
  echo "Loading system-upgrade runtime: ${missing_tools[*]}"
  exec env FLAKE_UPDATE_RUNTIME=1 \
    nix develop --no-update-lock-file .#system-upgrade --command \
    "$repo_root/scripts/flake-update" "${original_args[@]}"
fi

metadata=$(
  nix eval --no-update-lock-file --json .#nixosConfigurations --apply '
    configs: builtins.mapAttrs (_: cfg: cfg.upgrade) configs
  '
) || die "failed to read NixOS upgrade metadata"

if [[ "$target" != all ]] && ! jq -e --arg target "$target" 'has($target)' <<<"$metadata" >/dev/null; then
  die "unknown nixosConfiguration '$target'"
fi

# Preserve the generic helper before switching branches. The update branch can
# legitimately lag the current checkout while this updater itself is being tested.
container_updater=$(mktemp "${TMPDIR:-/tmp}/flake-update-containers.XXXXXX")
cp "$repo_root/scripts/update-container-images" "$container_updater"
chmod +x "$container_updater"
trap 'rm -f "$container_updater"' EXIT

current_branch=$(git branch --show-current)
[[ -n "$current_branch" ]] || die "detached HEAD is not supported"

if [[ "$current_branch" != "$UPDATE_BRANCH" ]]; then
  if ! git diff --quiet || ! git diff --cached --quiet; then
    die "commit or stash worktree changes before switching to $UPDATE_BRANCH"
  fi

  if git show-ref --verify --quiet "refs/heads/$UPDATE_BRANCH"; then
    git switch "$UPDATE_BRANCH"
    git merge --no-edit "$MAIN_BRANCH"
  else
    git switch -c "$UPDATE_BRANCH" "$MAIN_BRANCH"
  fi
fi

lock_paths=()
refresh_containers() {
  local profile=$1
  local lock_file=$2
  [[ -n "$lock_file" ]] || return 0

  echo "Refreshing container lock for $profile..."
  if [[ -n "$container" ]]; then
    NIXOS_CONFIGURATION="$profile" LOCK_FILE="$lock_file" CONTAINER_SELECT="$container" \
      "$container_updater"
  else
    NIXOS_CONFIGURATION="$profile" LOCK_FILE="$lock_file" \
      "$container_updater"
  fi
  lock_paths+=("$lock_file")
}

if [[ "$containers_only" != true ]]; then
  if [[ "$target" == all ]]; then
    echo "Updating all flake inputs..."
    nix flake update
    updated_flake=true
  else
    inputs=()
    while IFS= read -r input; do
      [[ -n "$input" ]] && inputs+=("$input")
    done < <(jq -r --arg target "$target" '.[$target].inputs[]' <<<"$metadata")
    ((${#inputs[@]})) || die "$target has no upgrade inputs"
    echo "Updating $target inputs: ${inputs[*]}"
    nix flake update "${inputs[@]}"
    updated_flake=true
  fi
fi

if [[ "$no_containers" != true ]]; then
  if [[ "$target" == all ]]; then
    while IFS=$'\t' read -r profile lock_file; do
      refresh_containers "$profile" "$lock_file"
    done < <(
      jq -r '
        to_entries[]
        | select(.value.containerLock != null)
        | [.key, .value.containerLock]
        | @tsv
      ' <<<"$metadata"
    )
  else
    lock_file=$(jq -r --arg target "$target" '.[$target].containerLock // empty' <<<"$metadata")
    if [[ "$containers_only" == true && -z "$lock_file" ]]; then
      die "$target has no managed container lock"
    fi
    refresh_containers "$target" "$lock_file"
  fi
fi

echo "Checking flake..."
nix flake check --no-update-lock-file

commit_paths=("${lock_paths[@]}")
[[ "$updated_flake" == true ]] && commit_paths=(flake.lock "${commit_paths[@]}")

if ((${#commit_paths[@]})); then
  git add -- "${commit_paths[@]}"
fi

if ((${#commit_paths[@]} == 0)) || git diff --cached --quiet -- "${commit_paths[@]}"; then
  echo "No upgrade changes."
else
  git commit -m "upgrade system" -- "${commit_paths[@]}"
fi
