#!/usr/bin/env bash
# Update flake inputs on a dedicated upgrade branch, build the selected target
# before and after the update, and evaluate the rest of the fleet before merging.

set -euo pipefail

MAIN_BRANCH=${MAIN_BRANCH:-main}
UPDATE_BRANCH=${UPDATE_BRANCH:-system-upgrade}
if [[ -v NIXOS_REBUILD_FLAGS ]]; then
  read -r -a nix_flags <<< "$NIXOS_REBUILD_FLAGS"
else
  nix_flags=()
fi

usage() {
  cat <<'EOF'
Usage: scripts/flake-update <target> [options] [inputs...]

Targets:
  linux-desktop       Alias for nixos
  nixos               Full x86_64 Linux desktop
  nixos-arm-parallels ARM Linux desktop VM
  nixos-orbstack      OrbStack Linux container
  all                 All current NixOS configurations

Inputs:
  If inputs are provided, only those inputs are updated.
  If no inputs are provided, all inputs are updated.

Options:
  --input-ref <input>=<flake-ref>
      Pin one input to a specific flake ref instead of updating it to latest.
      Can be repeated.

  --nixpkgs-ref <rev-or-ref>
      Shorthand for --input-ref nixpkgs=<ref>. Plain revisions or branch names
      are expanded to github:NixOS/nixpkgs/<rev-or-ref>.

Examples:
  scripts/flake-update linux-desktop nixpkgs
  scripts/flake-update nixos home-manager stylix
  scripts/flake-update nixos --nixpkgs-ref nixos-25.05
  scripts/flake-update nixos --nixpkgs-ref 331800de5053fce193d25d75f7c39b2b449c9a2f
  scripts/flake-update nixos --input-ref nixpkgs=github:NixOS/nixpkgs/nixos-unstable
  scripts/flake-update all

Environment:
  MAIN_BRANCH          Branch to compare against. Defaults to main.
  UPDATE_BRANCH        Branch used for update work. Defaults to system-upgrade.
  NIXOS_REBUILD_FLAGS  Extra nix eval/build flags. Defaults to none.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository"
cd "$repo_root"

target=${1:-}
[[ -n "$target" ]] || {
  usage
  exit 1
}
shift

if [[ "$target" == "-h" || "$target" == "--help" ]]; then
  usage
  exit 0
fi

current_branch=$(git branch --show-current)
[[ -n "$current_branch" ]] || die "detached HEAD is not supported for update branches"

if [[ "$current_branch" != "$UPDATE_BRANCH" ]]; then
  if git show-ref --verify --quiet "refs/heads/${UPDATE_BRANCH}"; then
    echo "Switching to existing update branch ${UPDATE_BRANCH}..."
    git switch "$UPDATE_BRANCH"
  else
    echo "Creating update branch ${UPDATE_BRANCH}..."
    git switch -c "$UPDATE_BRANCH"
  fi
fi

normalize_nixpkgs_ref() {
  case "$1" in
    github:* | git+* | path:* | "flake:"* | "tarball:"*) echo "$1" ;;
    *) echo "github:NixOS/nixpkgs/$1" ;;
  esac
}

input_refs=()
inputs=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --input-ref)
      [[ "$#" -ge 2 ]] || die "--input-ref requires input=flake-ref"
      [[ "$2" == *=* ]] || die "--input-ref must be formatted as input=flake-ref"
      input_refs+=("$2")
      shift 2
      ;;
    --input-ref=*)
      input_ref=${1#--input-ref=}
      [[ "$input_ref" == *=* ]] || die "--input-ref must be formatted as input=flake-ref"
      input_refs+=("$input_ref")
      shift
      ;;
    --nixpkgs-ref)
      [[ "$#" -ge 2 ]] || die "--nixpkgs-ref requires a revision, branch, or flake ref"
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "$2")")
      shift 2
      ;;
    --nixpkgs-ref=*)
      input_refs+=("nixpkgs=$(normalize_nixpkgs_ref "${1#--nixpkgs-ref=}")")
      shift
      ;;
    --)
      shift
      inputs+=("$@")
      break
      ;;
    -*)
      die "unknown option '$1'"
      ;;
    *)
      inputs+=("$1")
      shift
      ;;
  esac
done

map_target() {
  case "$1" in
    linux-desktop) echo "nixos" ;;
    nixos | nixos-arm-parallels | nixos-orbstack) echo "$1" ;;
    *) return 1 ;;
  esac
}

all_profiles=(nixos nixos-arm-parallels nixos-orbstack)

if [[ "$target" == "all" ]]; then
  target_profiles=("${all_profiles[@]}")
else
  profile=$(map_target "$target") || die "unknown target '$target'"
  target_profiles=("$profile")
fi

main_flake="git+file://${repo_root}?ref=${MAIN_BRANCH}"
current_flake="."

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

system_attr() {
  local flake_ref=$1
  local profile=$2
  printf '%s#nixosConfigurations.%s.config.system.build.toplevel' "$flake_ref" "$profile"
}

eval_profile() {
  local flake_ref=$1
  local profile=$2
  echo "Evaluating ${profile} from ${flake_ref}..."
  nix eval "${nix_flags[@]}" --raw "$(system_attr "$flake_ref" "$profile").drvPath" >/dev/null
}

eval_profile_optional() {
  local flake_ref=$1
  local profile=$2
  local err_file="$tmpdir/eval-${profile}.err"

  if ! eval_profile "$flake_ref" "$profile" 2>"$err_file"; then
    cat "$err_file" >&2
    if grep -Eq "path '.*' does not exist|access to absolute path .* is forbidden" "$err_file"; then
      echo "warning: skipped ${profile}; it needs a local path that is not available on this machine" >&2
      return 0
    fi

    die "${profile} failed evaluation. This is not being skipped because it does not look like a local-path availability issue."
  else
    rm -f "$err_file"
    return 0
  fi
}

build_profile() {
  local flake_ref=$1
  local profile=$2
  local output=$3
  echo "Building ${profile} from ${flake_ref}..."
  nix build "${nix_flags[@]}" "$(system_attr "$flake_ref" "$profile")" -o "$output"
}

diff_closures() {
  local old_out=$1
  local new_out=$2

  if command -v nvd >/dev/null 2>&1; then
    nvd diff "$old_out" "$new_out"
  else
    nix store diff-closures "$old_out" "$new_out"
  fi
}

echo "Target profiles: ${target_profiles[*]}"

echo "Checking current ${MAIN_BRANCH} evaluations before updating..."
for profile in "${all_profiles[@]}"; do
  eval_profile_optional "$main_flake" "$profile"
done

echo "Checking selected target evaluations before updating..."
for profile in "${target_profiles[@]}"; do
  eval_profile "$main_flake" "$profile"
done

for profile in "${target_profiles[@]}"; do
  build_profile "$main_flake" "$profile" "$tmpdir/${profile}-old"
done

if [[ "${#inputs[@]}" -gt 0 ]]; then
  echo "Updating selected flake inputs: ${inputs[*]}"
  nix flake update "${inputs[@]}"
elif [[ "${#input_refs[@]}" -eq 0 ]]; then
  echo "Updating all flake inputs..."
  nix flake update
fi

for input_ref in "${input_refs[@]}"; do
  input_name=${input_ref%%=*}
  flake_ref=${input_ref#*=}
  echo "Pinning ${input_name} to ${flake_ref}..."
  nix flake lock --override-input "$input_name" "$flake_ref"
done

if [[ "${#inputs[@]}" -eq 0 && "${#input_refs[@]}" -gt 0 ]]; then
  echo "Only pinned inputs were changed; no full flake update was run."
fi

echo "Checking updated branch evaluations..."
for profile in "${all_profiles[@]}"; do
  eval_profile_optional "$current_flake" "$profile"
done

echo "Checking selected updated target evaluations..."
for profile in "${target_profiles[@]}"; do
  eval_profile "$current_flake" "$profile"
done

for profile in "${target_profiles[@]}"; do
  build_profile "$current_flake" "$profile" "$tmpdir/${profile}-new"
  echo
  echo "Diff for ${profile}:"
  diff_closures "$tmpdir/${profile}-old" "$tmpdir/${profile}-new"
done

cat <<EOF

Update branch is ready for review.

Useful inspection commands:
  git diff ${MAIN_BRANCH} -- flake.lock
  git diff ${MAIN_BRANCH}
  nix-tree result
  nix why-depends result /nix/store/...-package
EOF
