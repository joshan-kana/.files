#!/usr/bin/env bash
set -euo pipefail

cmd_name="${NIX_OPTIONS_FZF_CMD_NAME:-${0##*/}}"

usage() {
  cat <<EOF
Usage:
  ${cmd_name} [host] [prefix] [--scope <scope>] [--refresh]
  ${cmd_name} [host] [prefix] [--scope <scope>] --list
  ${cmd_name} [host] --refresh --list
  ${cmd_name} [host] [prefix] --refresh --list
  ${cmd_name} [host] [--scope <scope>] --preview <option>
  ${cmd_name} [host] [--scope <scope>] --default <option>
  ${cmd_name} [host] [--scope <scope>] --value <option>
  ${cmd_name} [host] [--scope <scope>] --value-full <option>
  ${cmd_name} [host] [--scope <scope>] --value-items <option>
  ${cmd_name} [host] [--scope <scope>] --value-search <option>
  ${cmd_name} [host] [--scope <scope>] --definitions <option>
  ${cmd_name} [host] [--scope <scope>] --definition-items <option>
  ${cmd_name} [host] [--scope <scope>] --definition-item <option> <item>
  ${cmd_name} [host] --scopes
  ${cmd_name} --hosts
  ${cmd_name} --refresh-all
  ${cmd_name} --default-host
  ${cmd_name} --clear-default-host
  ${cmd_name} --clear-value-cache

Interactive fzf keys:
  Enter      zoom into the selected option area; never exits
  Ctrl-P     print selected option identity immediately and exit
  Ctrl-B     go back one level
  Ctrl-O     toggle flat/all-options mode and grouped/module mode
  Ctrl-J/K   move selection down/up one line
  Ctrl-U/D   move selection up/down half page
  Ctrl-V     show normal effective value in the right pane
  Ctrl-F     show full effective value in the right pane
  Ctrl-S     search evaluated values for the selected option
  Ctrl-I     show item-level definition origins for the selected option
  Ctrl-R     return right pane to docs only
  Alt-J/K    scroll preview down/up one line
  Alt-D/U    page preview down/up
  Alt-T/B    jump preview top/bottom
  Esc        quit/cancel current fzf

Default preview:
  Full effective value preview is enabled by default.
  Override with NIX_OPTIONS_FZF_DEFAULT_PREVIEW=docs, value, or full.

Preview debounce:
  Full/value previews can wait briefly before starting expensive evaluation.
  Default: 0 ms (disabled).
  Set NIX_OPTIONS_FZF_PREVIEW_DELAY_MS=150 or 250 to let fast scrolling cancel previews before nix eval starts.
  Set NIX_OPTIONS_FZF_PREVIEW_DELAY_MS=0 to disable the wait.

Prefixes:
  [prefix] is an option path prefix, not a file path.
  Examples: environment, environment.systemPackages, services, services.openssh, programs.zsh.
  Omit [prefix] to start at the root option list.
  Use a concrete option as [prefix] to jump near that option.

Scopes:
  System scopes are derived from the flake configuration output names.
  Each Home Manager user uses "home-manager:<user>". Omit --scope when
  an option name is unique; ambiguous
  names fail and list the available scopes. Interactive selections retain scope.
  Run "${cmd_name} <host-or-alias> --scopes" to list scopes for a host.

List modes:
  Flat mode shows all concrete options under the current prefix.
  Grouped mode shows module/group entries like services/ and programs/.
  Toggle during fzf with Ctrl-O.
  Override startup mode with NIX_OPTIONS_FZF_LIST_MODE=flat or grouped.

Hosts:
  Hosts are discovered from the flake configuration outputs.
  Aliases are derived from host names. Run:
    ${cmd_name} --hosts

Remembered host:
  First interactive/value/list run requires a host.
  Running an explicit host remembers it for this repo.
  Running another explicit host switches the remembered host.

Caches:
  Scoped option docs are cached per host.
  Rebuild docs for one host:
    ${cmd_name} <host-or-alias> --refresh --list
  Rebuild docs for one host and prefix:
    ${cmd_name} <host-or-alias> <prefix> --refresh --list
  Rebuild docs for all hosts:
    ${cmd_name} --refresh-all
  Evaluated values, definitions, and item origins are cached per host + scope + option + repo state.
  Refreshing docs does not clear evaluated caches.
  Use --clear-value-cache when you intentionally want cold value/definition/item-origin caches.
EOF
}

repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
flake="path:$repo"
nix_bin="${NIX_BIN:-nix}"

repo_cache_key="$(printf '%s\0' "$repo" | sha256sum | awk '{print substr($1, 1, 16)}')"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-options/$repo_cache_key"
preview_script="$cache_dir/preview-option"
hosts_cache="$cache_dir/hosts-v3.json"
value_cache_dir="$cache_dir/values-v3"
mkdir -p "$cache_dir" "$value_cache_dir"

default_host_file="${NIX_OPTIONS_FZF_DEFAULT_HOST_FILE:-$(git rev-parse --git-path dotfiles-options-default-host 2>/dev/null || printf '%s/default-host\n' "$cache_dir")}"
mkdir -p "$(dirname "$default_host_file")"

value_cache_host_dir() {
  local cache_host="$1"
  printf '%s/%s\n' "$value_cache_dir" "$cache_host"
}

safe_remove_cache_tree() {
  local target="$1"
  local base="$2"

  if [ -z "$target" ] || [ -z "$base" ]; then
    echo "ERROR: refusing to remove empty cache path." >&2
    return 1
  fi

  case "$target" in
    "$base"/*)
      rm -rf -- "$target"
      ;;
    *)
      echo "ERROR: refusing to remove cache path outside base: $target" >&2
      return 1
      ;;
  esac
}

clear_host_value_cache() {
  if [ -z "${host:-}" ]; then
    return 0
  fi

  safe_remove_cache_tree "$(value_cache_host_dir "$host")" "$value_cache_dir"
}

clear_all_value_cache() {
  if [ -z "${value_cache_dir:-}" ] || [ -z "${cache_dir:-}" ]; then
    echo "ERROR: refusing to clear value cache with empty cache path." >&2
    return 1
  fi

  case "$value_cache_dir" in
    "$cache_dir"/values-v3)
      safe_remove_cache_tree "$value_cache_dir" "$cache_dir"
      mkdir -p "$value_cache_dir"
      ;;
    *)
      echo "ERROR: refusing to clear unexpected value cache path: $value_cache_dir" >&2
      return 1
      ;;
  esac
}


host=""
host_explicit=0
prefix=""
refresh=0
list_only=0
refresh_all=0
print_cache=0
show_hosts=0
show_default_host=0
clear_default_host=0
clear_value_cache=0
show_scopes=0
requested_scope=""
preview_name=""
default_name=""
value_name=""
value_full=0
value_items_name=""
value_search_name=""
definition_name=""
definition_items_name=""
definition_item_name=""
definition_item_value=""

list_hosts() {
  local tmp

  if [ ! -s "$hosts_cache" ]; then
    tmp="$hosts_cache.tmp.$$"
    local flake_literal
    local scope_lib_literal
    flake_literal="$(jq -Rn --arg s "$flake" '$s')"
    scope_lib_literal="$(jq -Rn --arg s "$repo/scripts/nix-options-scopes.nix" '$s')"
    if "$nix_bin" eval --impure --json --expr "let scopes = import (builtins.toPath $scope_lib_literal) { flakeRef = $flake_literal; }; in scopes.hosts" > "$tmp"; then
      mv "$tmp" "$hosts_cache"
    else
      rm -f "$tmp"
      return 1
    fi
  fi

  jq -r '.[]' "$hosts_cache"
}

host_aliases() {
  local h="$1"
  local stripped="$h"
  local part
  local initials=""

  printf '%s\n' "$h"

  case "$stripped" in
    *-*)
      stripped="${stripped#*-}"
      printf '%s\n' "$stripped"
      ;;
  esac

  IFS='-' read -r -a parts <<< "$stripped"
  for part in "${parts[@]}"; do
    [ -n "$part" ] || continue
    printf '%s\n' "$part"
    initials="${initials}${part:0:1}"
  done

  if [ -n "$initials" ]; then
    printf '%s\n' "$initials"
  fi
}

resolve_host_arg() {
  local arg="$1"
  local h
  local alias
  local matches=""
  local count=0

  if list_hosts | grep -Fxq -- "$arg"; then
    printf '%s\n' "$arg"
    return 0
  fi

  while IFS= read -r h; do
    while IFS= read -r alias; do
      if [ "$alias" = "$arg" ]; then
        case "$matches" in
          *"
$h
"*)
            ;;
          *)
            matches="${matches}${h}
"
            count=$((count + 1))
            ;;
        esac
      fi
    done < <(host_aliases "$h")
  done < <(list_hosts)

  if [ "$count" -eq 1 ]; then
    printf '%s' "$matches" | sed '/^$/d'
    return 0
  fi

  if [ "$count" -gt 1 ]; then
    echo "ERROR: host alias is ambiguous: $arg" >&2
    printf '%s' "$matches" | sed '/^$/d' >&2
    return 2
  fi

  return 1
}

show_host_table() {
  local h
  while IFS= read -r h; do
    printf '%s\taliases: ' "$h"
    host_aliases "$h" | awk '!seen[$0]++ { if (out != "") out = out ", " $0; else out = $0 } END { print out }'
  done < <(list_hosts)
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --hosts)
      show_hosts=1
      ;;
    -r|--refresh)
      refresh=1
      ;;
    --list)
      list_only=1
      ;;
    --scope)
      shift
      requested_scope="${1:-}"
      [ -n "$requested_scope" ] || { echo "ERROR: --scope requires a scope." >&2; exit 2; }
      ;;
    --scopes)
      show_scopes=1
      ;;
    --refresh-all)
      refresh=1
      refresh_all=1
      ;;
    --cache-path)
      print_cache=1
      ;;
    --default-host)
      show_default_host=1
      ;;
    --clear-default-host)
      clear_default_host=1
      ;;
    --clear-value-cache)
      clear_value_cache=1
      ;;
    --preview)
      shift
      preview_name="${1:-}"
      [ -n "$preview_name" ] || { echo "ERROR: --preview requires an option name." >&2; exit 2; }
      ;;
    --default)
      shift
      default_name="${1:-}"
      [ -n "$default_name" ] || { echo "ERROR: --default requires an option name." >&2; exit 2; }
      ;;
    --value)
      shift
      value_name="${1:-}"
      [ -n "$value_name" ] || { echo "ERROR: --value requires an option name." >&2; exit 2; }
      ;;
    --value-full)
      shift
      value_name="${1:-}"
      value_full=1
      [ -n "$value_name" ] || { echo "ERROR: --value-full requires an option name." >&2; exit 2; }
      ;;
    --value-items)
      shift
      value_items_name="${1:-}"
      [ -n "$value_items_name" ] || { echo "ERROR: --value-items requires an option name." >&2; exit 2; }
      ;;
    --value-search)
      shift
      value_search_name="${1:-}"
      [ -n "$value_search_name" ] || { echo "ERROR: --value-search requires an option name." >&2; exit 2; }
      ;;
    --definitions)
      shift
      definition_name="${1:-}"
      [ -n "$definition_name" ] || { echo "ERROR: --definitions requires an option name." >&2; exit 2; }
      ;;
    --definition-items)
      shift
      definition_items_name="${1:-}"
      [ -n "$definition_items_name" ] || { echo "ERROR: --definition-items requires an option name." >&2; exit 2; }
      ;;
    --definition-item)
      shift
      [ "$#" -gt 0 ] || { echo "ERROR: --definition-item requires an option name." >&2; exit 2; }
      definition_item_name="$1"
      shift
      [ "$#" -gt 0 ] || { echo "ERROR: --definition-item requires an item value." >&2; exit 2; }
      definition_item_value="$1"
      ;;
    *)
      if resolved_host="$(resolve_host_arg "$1")"; then
        host="$resolved_host"
        host_explicit=1
      else
        status=$?
        if [ "$status" -eq 2 ]; then
          exit 2
        fi

        if [ -z "$prefix" ]; then
          prefix="${1%/}"
        else
          echo "ERROR: unexpected argument: $1" >&2
          usage >&2
          exit 2
        fi
      fi
      ;;
  esac
  shift
done

if [ "$show_hosts" -eq 1 ]; then
  show_host_table
  exit 0
fi

if [ "$clear_default_host" -eq 1 ]; then
  rm -f "$default_host_file"
  echo "Cleared remembered host for this repo."
  exit 0
fi

if [ "$clear_value_cache" -eq 1 ]; then
  clear_all_value_cache
  echo "Cleared evaluated value cache."
  exit 0
fi

if [ "$show_default_host" -eq 1 ]; then
  if [ -s "$default_host_file" ]; then
    cat "$default_host_file"
  else
    echo "<unset>"
  fi
  exit 0
fi

if [ "$refresh_all" -eq 0 ]; then
  if [ "$host_explicit" -eq 1 ]; then
    if [ "$print_cache" -eq 0 ]; then
      printf '%s\n' "$host" > "$default_host_file"
    fi
  elif [ -n "${NIX_OPTIONS_FZF_DEFAULT_HOST:-}" ]; then
    if ! host="$(resolve_host_arg "$NIX_OPTIONS_FZF_DEFAULT_HOST")"; then
      echo "ERROR: invalid NIX_OPTIONS_FZF_DEFAULT_HOST: $NIX_OPTIONS_FZF_DEFAULT_HOST" >&2
      exit 2
    fi
  elif [ -s "$default_host_file" ]; then
    host="$(cat "$default_host_file")"
  else
    cat >&2 <<EOF
ERROR: no default host remembered for this repo yet.

Choose a host once:
  ${cmd_name} <host-or-derived-alias>

Examples from discovered hosts:
$(show_host_table 2>/dev/null | sed 's/^/  /')

After that, bare "${cmd_name}" reuses the remembered host.
EOF
    exit 2
  fi
else
  host="${host:-$(list_hosts | head -n 1)}"
fi

cache="$cache_dir/option-scopes-v3-$host.json"
scope_lib_path="$repo/scripts/nix-options-scopes.nix"

nix_string() {
  jq -Rn --arg s "$1" '$s'
}

path_to_nix_list() {
  local dotted="$1"
  jq -Rrn --arg s "$dotted" '$s | split(".") | map(@json) | "[ " + join(" ") + " ]"'
}

repo_state_hash() {
  # Stable cache fingerprint:
  # - HEAD identifies the committed base.
  # - staged/unstaged diffs identify dirty tracked content.
  # - untracked file hashes identify dirty untracked content.
  # This is slower than mtime checks but stable across repeated cache reads.
  {
    git -C "$repo" rev-parse HEAD 2>/dev/null || true
    git -C "$repo" diff --no-ext-diff --binary 2>/dev/null || true
    git -C "$repo" diff --cached --no-ext-diff --binary 2>/dev/null || true

    while IFS= read -r -d '' f; do
      [ -f "$repo/$f" ] || continue
      printf 'UNTRACKED:%s
' "$f"
      sha256sum "$repo/$f" 2>/dev/null || true
    done < <(git -C "$repo" ls-files --others --exclude-standard -z 2>/dev/null || true)
  } | sha256sum | awk '{print $1}'
}

value_cache_file() {
  local kind="$1"
  local scope="$2"
  local option="$3"
  local extra="$4"
  local state
  local key

  state="$(repo_state_hash)"
  key="$(printf '%s\0%s\0%s\0%s\0%s\0%s\0%s' "$host" "$scope" "$kind" "$option" "$extra" "$state" "$nix_bin" | sha256sum | awk '{print $1}')"

  mkdir -p "$value_cache_dir/$host/$kind"
  printf '%s/%s/%s/%s.json\n' "$value_cache_dir" "$host" "$kind" "$key"
}

option_note() {
  local scope="$1"
  local option="$2"

  if [ ! -s "$cache" ]; then
    return 0
  fi

  jq -r --arg scope "$scope" --arg name "$option" '
    .[] | select(.scope == $scope and .name == $name) |
    if ((.declarations // []) | map(tostring | contains("/rename.nix")) | any) then
      "note: this option is declared by rename.nix, so it is likely a renamed/deprecated compatibility option. It may exist in system.options but not have a normal value in system.config."
    elif ((.type // "") == "unspecified value") then
      "note: this option has type \"unspecified value\". It may be a placeholder or compatibility option rather than a normal configured value."
    else
      empty
    end
  ' "$cache" 2>/dev/null || true
}

cat > "$preview_script" <<'PREVIEW'
#!/usr/bin/env bash
set -euo pipefail

mode="${1:-docs}"
host="${2:-}"
scope="${3:-}"
name="${4:-}"

esc="$(printf '\033')"
if [ -z "${NO_COLOR:-}" ]; then
  BOLD="${esc}[1m"
  DIM="${esc}[2m"
  RESET="${esc}[0m"
  CYAN="${esc}[36m"
  GREEN="${esc}[32m"
  YELLOW="${esc}[33m"
  MAGENTA="${esc}[35m"
  BLUE="${esc}[34m"
  RED="${esc}[31m"
else
  BOLD=""
  DIM=""
  RESET=""
  CYAN=""
  GREEN=""
  YELLOW=""
  MAGENTA=""
  BLUE=""
  RED=""
fi

hr() {
  printf '%b%s%b\n' "$DIM" "────────────────────────────────────────────────────────────────" "$RESET"
}

label() {
  printf '%b%s%b\n' "$BOLD$BLUE" "$1" "$RESET"
}

print_browser_keys() {
  printf '%bkeys%b\n' "$BOLD$MAGENTA" "$RESET"
  printf '  %bEnter%b    zoom into selected option area; never exits\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-P%b   print selected option identity and exit\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-B%b   go back one level\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-O%b   toggle flat/grouped list mode\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-J/K%b move selection lines\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-U/D%b move selection half pages\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-V%b   show normal effective value\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-F%b   show full effective value\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-S%b   search evaluated values\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-I%b   show item-level origins\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-R%b   return this pane to docs\n' "$YELLOW" "$RESET"
  printf '  %bAlt-J/K%b  scroll preview lines\n' "$YELLOW" "$RESET"
  printf '  %bAlt-D/U%b  scroll preview pages\n' "$YELLOW" "$RESET"
  printf '  %bAlt-T/B%b  jump preview top/bottom\n' "$YELLOW" "$RESET"
  printf '  %bEsc%b      close browser\n' "$YELLOW" "$RESET"
}

if [ "$name" = ".." ]; then
  printf '%b..%b\n\n' "$BOLD$CYAN" "$RESET"
  label "keys"
  printf '  %bEnter%b    go back one level\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-B%b   go back one level\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-J/K%b move selection lines\n' "$YELLOW" "$RESET"
  printf '  %bCtrl-U/D%b move selection half pages\n' "$YELLOW" "$RESET"
  printf '  %bEsc%b      close browser\n' "$YELLOW" "$RESET"
  exit 0
fi

if [[ "$name" == */ ]]; then
  group="${name%/}"
  count="$(jq -r --arg p "$group" --arg scope "${DOTFILES_OPTIONS_SCOPE_FILTER:-}" '
    [.[]
      | select($scope == "" or .scope == $scope)
      | .name
      | select(. == $p or startswith($p + "."))
    ] | length
  ' "$DOTFILES_OPTIONS_CACHE")"
  printf '%b# %s/%b\n\n' "$BOLD$CYAN" "$group" "$RESET"
  label "group/module"
  printf '  %s concrete options below this prefix\n\n' "$count"
  print_browser_keys
  exit 0
fi

doc_json="$(
  jq -c --arg scope "$scope" --arg name "$name" '.[] | select(.scope == $scope and .name == $name) | {
    name,
    scope,
    scopeLabel,
    type: (.type // "unknown"),
    description: (.description // ""),
    declarations: (.declarations // [])
  }' "$DOTFILES_OPTIONS_CACHE"
)"

if [ -z "$doc_json" ]; then
  printf '%bERROR%b: option not found: %s\n' "$RED" "$RESET" "$name"
  exit 0
fi

doc_name="$(printf '%s\n' "$doc_json" | jq -r '.name')"
doc_scope="$(printf '%s\n' "$doc_json" | jq -r '.scope')"
doc_scope_label="$(printf '%s\n' "$doc_json" | jq -r '.scopeLabel')"
doc_type="$(printf '%s\n' "$doc_json" | jq -r '.type')"
doc_description="$(printf '%s\n' "$doc_json" | jq -r '.description')"
doc_declarations="$(printf '%s\n' "$doc_json" | jq -r '.declarations[]?')"

printf '%b# %s%b\n\n' "$BOLD$CYAN" "$doc_name" "$RESET"

label "scope"
printf '  %b%s%b (%s)\n\n' "$GREEN" "$doc_scope_label" "$RESET" "$doc_scope"

label "type"
printf '  %b%s%b\n\n' "$GREEN" "$doc_type" "$RESET"

if [ -n "$doc_description" ]; then
  label "description"
  printf '%s\n\n' "$doc_description"
fi

label "declarations"
if [ -n "$doc_declarations" ]; then
  printf '%s\n' "$doc_declarations" | sed 's/^/  /'
else
  printf '  %b<none>%b\n' "$DIM" "$RESET"
fi

print_declared_default() {
  echo
  label "declared default"
  if declared_default="$("$DOTFILES_OPTIONS_REPO/scripts/nix-options-fzf" "$host" --scope "$scope" --default "$name" 2>/dev/null)"; then
    printf '  %b%s%b\n' "$GREEN" "$declared_default" "$RESET"
  else
    printf '  %b<unavailable>%b\n' "$DIM" "$RESET"
  fi
}

print_defined_by() {
  echo
  label "defined by"
  if definitions="$("$DOTFILES_OPTIONS_REPO/scripts/nix-options-fzf" "$host" --scope "$scope" --definitions "$name" 2>/dev/null)"; then
    if [ -n "$definitions" ]; then
      printf '%s\n' "$definitions" | sed 's/^/  /'
    else
      printf '  %b<none>%b\n' "$DIM" "$RESET"
    fi
  else
    printf '  %b<unavailable>%b\n' "$DIM" "$RESET"
  fi
}

case "$mode" in
  docs)
    print_declared_default
    print_defined_by
    echo
    hr
    print_browser_keys
    ;;

  value|full)
    if [ "$mode" = "full" ]; then
      flag="--value-full"
      value_label="full effective value"
    else
      flag="--value"
      value_label="normal effective value"
    fi

    echo
    hr
    print_browser_keys
    echo
    hr
    printf '%b%s%b\n' "$BOLD$MAGENTA" "$value_label" "$RESET"
    printf '  %bpreview debounce%b: %sms before value eval; set NIX_OPTIONS_FZF_PREVIEW_DELAY_MS=150 to enable debounce\n' "$YELLOW" "$RESET" "${NIX_OPTIONS_FZF_PREVIEW_DELAY_MS:-0}"
    printf '  %bevaluating or reading cache%b %s for %s...\n\n' "$YELLOW" "$RESET" "$name" "$host"

    preview_delay_ms="${NIX_OPTIONS_FZF_PREVIEW_DELAY_MS:-0}"
    case "$preview_delay_ms" in
      ''|*[!0-9]*)
        preview_delay_ms=0
        ;;
    esac

    if [ "$preview_delay_ms" -gt 0 ]; then
      sleep "$(awk -v ms="$preview_delay_ms" 'BEGIN { printf "%.3f", ms / 1000 }')"
    fi

    print_defined_by
    echo
    hr
    printf '%b%s%b\n' "$BOLD$MAGENTA" "$value_label" "$RESET"

    start="$(date +%s 2>/dev/null || printf 0)"

    if output="$("$DOTFILES_OPTIONS_REPO/scripts/nix-options-fzf" "$host" --scope "$scope" "$flag" "$name" 2>&1)"; then
      end="$(date +%s 2>/dev/null || printf "$start")"
      elapsed=$((end - start))
      printf '%belapsed%b: %ss\n\n' "$DIM" "$RESET" "$elapsed"
      printf '%s\n' "$output" | awk '
        /^current\/effective value:/ { show = 1; next }
        show { print }
      '
    else
      printf '%bERROR%b: value evaluation failed\n\n' "$RED" "$RESET"
      printf '%s\n' "$output"
    fi
    ;;

  *)
    echo "ERROR: unknown preview mode: $mode" >&2
    exit 2
    ;;
esac
PREVIEW

chmod +x "$preview_script"

write_docs_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_lib_literal="$4"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;

  cleanString = x:
    let forced = builtins.tryEval x;
    in if forced.success then builtins.unsafeDiscardStringContext (builtins.toString forced.value) else "";

  declaration = position:
    let
      source = scopeData.sourcePath position.file;
      suffix =
        if position ? line && position.line != null then
          ":" + builtins.toString position.line
          + (if position ? column && position.column != null then ":" + builtins.toString position.column else "")
        else
          "";
    in
    source.label + suffix;

  optionDoc = scope: scopeInfo: path: opt: {
    name = lib.concatStringsSep "." path;
    inherit scope;
    scopeLabel = scopeInfo.label;
    scopeKind = scopeInfo.kind;
    scopeUser = scopeInfo.user;
    type = opt.type.description or "unknown";
    description = cleanString (opt.description or "");
    declarations = builtins.map declaration (
      if opt ? declarationPositions then
        opt.declarationPositions
      else
        builtins.map (file: { inherit file; }) (opt.declarations or [ ])
    );
    readOnly = opt.readOnly or false;
  };

  collect = scope: scopeInfo: prefix: set:
    builtins.concatLists (
      builtins.map
        (
          name:
          let
            v = builtins.getAttr name set;
            path = prefix ++ [ name ];
          in
          if builtins.isAttrs v && v ? _type && v._type == "option" then
            if builtins.elem (v.visible or true) [ true "shallow" ] && !(v.internal or false) then
              [ (optionDoc scope scopeInfo path v) ]
            else
              [ ]
          else if builtins.isAttrs v then
            collect scope scopeInfo path v
          else
            [ ]
        )
        (builtins.attrNames set)
    );
  records = builtins.concatLists (
    lib.mapAttrsToList (scope: scopeInfo: collect scope scopeInfo [ ] scopeInfo.options) scopeData.scopes
  );
in
builtins.sort (a: b: a.name < b.name || (a.name == b.name && a.scope < b.scope)) records
NIX
}

write_value_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_literal="$4"
  local path_literal="$5"
  local scope_lib_literal="$6"
  local max_items="$7"
  local max_keys="$8"
  local max_chars="$9"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scope = $scope_literal;
  optionPath = $path_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;
  selectedScope = builtins.getAttr scope scopeData.scopes;

  found = lib.hasAttrByPath optionPath selectedScope.config;
  value = lib.attrByPath optionPath null selectedScope.config;

  truncate =
    text:
    if builtins.stringLength text > $max_chars then
      (builtins.substring 0 $max_chars text) + "\\n... <truncated>"
    else
      text;

  plainString = s: builtins.unsafeDiscardStringContext (builtins.toString s);

  render =
    v:
    if builtins.isNull v then
      "null"
    else if builtins.isBool v then
      if v then "true" else "false"
    else if builtins.isInt v then
      builtins.toString v
    else if (builtins ? isFloat) && builtins.isFloat v then
      builtins.toJSON v
    else if builtins.isString v then
      truncate (builtins.unsafeDiscardStringContext v)
    else if builtins.isPath v then
      plainString v
    else if builtins.isFunction v then
      "<function>"
    else if builtins.isList v then
      let
        lenEval = builtins.tryEval (builtins.length v);
        len = if lenEval.success then lenEval.value else 0;
        shown = lib.take $max_items v;
        sampleRaw = builtins.map (x: "  - " + render x) shown;
        sampleEval = builtins.tryEval (builtins.deepSeq sampleRaw sampleRaw);
        sample = if sampleEval.success then sampleEval.value else [ "  <unable to render list items>" ];
        suffix =
          if lenEval.success && len > $max_items then
            "\\n... " + builtins.toString (len - $max_items) + " more"
          else
            "";
      in
      "<list: "
      + (if lenEval.success then builtins.toString len else "unknown")
      + " items>"
      + (if sample == [ ] then "" else "\\n" + lib.concatStringsSep "\\n" sample)
      + suffix
    else if builtins.isAttrs v then
      let drvEval = builtins.tryEval (v ? type && v.type == "derivation" && v ? name);
      in
      if drvEval.success && drvEval.value then
        let nameEval = builtins.tryEval (plainString v.name);
        in if nameEval.success then nameEval.value else "<derivation: unknown>"
      else
        let
          namesEval = builtins.tryEval (builtins.attrNames v);
          names = if namesEval.success then namesEval.value else [ ];
          count = builtins.length names;
          shown = lib.take $max_keys names;
          suffix =
            if count > $max_keys then
              "\\n... " + builtins.toString (count - $max_keys) + " more"
            else
              "";
        in
        if namesEval.success then
          "<attrset: "
          + builtins.toString count
          + " keys>"
          + (if shown == [ ] then "" else "\\nkeys:\\n  " + lib.concatStringsSep "\\n  " shown)
          + suffix
        else
          "<attrset: unable to list keys>"
    else
      "<unsupported value type>";

  forced = if found then builtins.tryEval value else { success = false; value = null; };
  renderedRaw = if forced.success then render forced.value else "<unavailable>";
  rendered = builtins.tryEval (builtins.deepSeq renderedRaw renderedRaw);
  available = found && forced.success && rendered.success;
in
{
  option = builtins.concatStringsSep "." optionPath;
  inherit scope;
  available = available;
  value = if available then rendered.value else if found then "<unavailable>" else "<missing>";
}
NIX
}

write_default_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_literal="$4"
  local path_literal="$5"
  local scope_lib_literal="$6"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scope = $scope_literal;
  optionPath = $path_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;
  selectedScope = builtins.getAttr scope scopeData.scopes;
  opt = lib.attrByPath optionPath null selectedScope.options;

  candidate =
    if opt == null then
      { available = false; value = null; }
    else if opt ? defaultText then
      { available = true; value = opt.defaultText; }
    else if opt ? default then
      { available = true; value = opt.default; }
    else if
      (opt.type.getSubModules or null) == null
      && opt.type ? emptyValue
      && opt.type.emptyValue ? value
    then
      { available = true; value = opt.type.emptyValue.value; }
    else
      { available = false; value = null; };

  plainString = value: builtins.unsafeDiscardStringContext (builtins.toString value);
  render = value:
    if builtins.isNull value then
      "null"
    else if builtins.isBool value then
      if value then "true" else "false"
    else if builtins.isInt value then
      builtins.toString value
    else if (builtins ? isFloat) && builtins.isFloat value then
      builtins.toJSON value
    else if builtins.isString value || builtins.isPath value then
      plainString value
    else if builtins.isFunction value then
      "<function>"
    else if builtins.isList value then
      "<list: " + builtins.toString (builtins.length value) + " items>"
    else if builtins.isAttrs value && builtins.elem (value._type or null) [ "literalExpression" "literalMD" ] then
      plainString value.text
    else if builtins.isAttrs value then
      "<attrset: " + builtins.toString (builtins.length (builtins.attrNames value)) + " keys>"
    else
      "<unsupported>";

  forced = if candidate.available then builtins.tryEval candidate.value else { success = false; value = null; };
  renderedRaw = if forced.success then render forced.value else "<unavailable>";
  rendered = builtins.tryEval (builtins.deepSeq renderedRaw renderedRaw);
  available = candidate.available && forced.success && rendered.success;
in
{
  option = builtins.concatStringsSep "." optionPath;
  inherit scope available;
  value = if available then rendered.value else if candidate.available then "<unavailable>" else "<none>";
}
NIX
}

print_default() {
  local scope="$1"
  local option="$2"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_literal
  local scope_lib_literal
  local path_literal
  local cache_file
  local tmp

  cache_file="$(value_cache_file "default" "$scope" "$option" "default-v3")"

  if [ -s "$cache_file" ]; then
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache hit: $cache_file" >&2
  else
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache miss: $cache_file" >&2
    expr_file="$(mktemp "${TMPDIR:-/tmp}/no-option-default.XXXXXX")"
    tmp="$cache_file.tmp.$$"
    flake_ref_literal="$(nix_string "$flake")"
    host_literal="$(nix_string "$host")"
    scope_literal="$(nix_string "$scope")"
    path_literal="$(path_to_nix_list "$option")"
    scope_lib_literal="$(nix_string "$scope_lib_path")"
    write_default_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_literal" "$path_literal" "$scope_lib_literal"

    if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
      if jq -e . "$tmp" >/dev/null; then
        rm -f "$expr_file"
        mv "$tmp" "$cache_file"
      else
        rm -f "$expr_file" "$tmp"
        echo "ERROR: default eval produced invalid JSON for $option" >&2
        return 1
      fi
    else
      local status=$?
      rm -f "$expr_file" "$tmp"
      return "$status"
    fi
  fi

  jq -r '.value' "$cache_file"
}

write_items_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_literal="$4"
  local path_literal="$5"
  local scope_lib_literal="$6"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scope = $scope_literal;
  optionPath = $path_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;
  selectedScope = builtins.getAttr scope scopeData.scopes;

  found = lib.hasAttrByPath optionPath selectedScope.config;
  value = lib.attrByPath optionPath null selectedScope.config;
  plainString = s: builtins.unsafeDiscardStringContext (builtins.toString s);

  mkItem = kind: canonical: display: {
    id = builtins.hashString "sha256" (kind + "\\u0000" + canonical);
    inherit display kind;
  };

  renderOne =
    v:
    if builtins.isNull v then
      mkItem "null" "null" "null"
    else if builtins.isBool v then
      mkItem "bool" (if v then "true" else "false") (if v then "true" else "false")
    else if builtins.isInt v then
      mkItem "int" (builtins.toString v) (builtins.toString v)
    else if (builtins ? isFloat) && builtins.isFloat v then
      mkItem "float" (builtins.toJSON v) (builtins.toJSON v)
    else if builtins.isString v then
      let text = builtins.unsafeDiscardStringContext v;
      in mkItem "string" text text
    else if builtins.isPath v then
      let text = plainString v;
      in mkItem "path" text text
    else if builtins.isFunction v then
      mkItem "function" "function" "<function>"
    else if builtins.isAttrs v then
      let drvEval = builtins.tryEval (v ? type && v.type == "derivation" && v ? name);
      in
      if drvEval.success && drvEval.value then
        let nameEval = builtins.tryEval (plainString v.name);
            text = if nameEval.success then nameEval.value else "<derivation: unknown>";
        in mkItem "derivation" text text
      else
        let namesEval = builtins.tryEval (builtins.attrNames v);
            text = if namesEval.success then "<attrset: " + builtins.toString (builtins.length namesEval.value) + " keys>" else "<attrset>";
        in mkItem "attrset" text text
    else if builtins.isList v then
      let lenEval = builtins.tryEval (builtins.length v);
          text = "<list: " + (if lenEval.success then builtins.toString lenEval.value else "unknown") + " items>";
      in mkItem "list" text text
    else
      mkItem "unsupported" "unsupported" "<unsupported>";

  forced = if found then builtins.tryEval value else { success = false; value = null; };

  renderedRaw =
    if ! forced.success then
      [ (mkItem "unavailable" "unavailable" "<unavailable>") ]
    else if builtins.isList forced.value then
      builtins.map renderOne forced.value
    else if builtins.isAttrs forced.value then
      let
        namesEval = builtins.tryEval (builtins.attrNames forced.value);
        names = if namesEval.success then namesEval.value else [ ];
      in
      builtins.map (
        n:
        let item = renderOne (builtins.getAttr n forced.value);
        in mkItem "attribute:\${item.kind}" (n + "\\u0000" + item.id) (n + " = " + item.display)
      ) names
    else
      [ (renderOne forced.value) ];

  rendered = builtins.tryEval (builtins.deepSeq renderedRaw renderedRaw);
  available = found && forced.success && rendered.success;
in
{
  option = builtins.concatStringsSep "." optionPath;
  inherit scope;
  available = available;
  items =
    if available then
      rendered.value
    else
      [ (mkItem (if found then "unavailable" else "missing") "" (if found then "<unavailable>" else "<missing>")) ];
}
NIX
}


write_definitions_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_literal="$4"
  local path_literal="$5"
  local scope_lib_literal="$6"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scope = $scope_literal;
  optionPath = $path_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;
  selectedScope = builtins.getAttr scope scopeData.scopes;

  opt = lib.attrByPath optionPath null selectedScope.options;

  filesRaw =
    if opt == null then
      [ ]
    else
      let defsEval = builtins.tryEval (opt.definitionsWithLocations or [ ]);
      in
      if defsEval.success then
        builtins.map (def: scopeData.originPath (def.file or "<unknown-file>")) defsEval.value
      else
        [ ];

  filesEval = builtins.tryEval (builtins.deepSeq filesRaw filesRaw);
in
if filesEval.success then filesEval.value else [ ]
NIX
}


print_definitions() {
  local scope="$1"
  local option="$2"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_literal
  local scope_lib_literal
  local path_literal
  local cache_file
  local tmp

  cache_file="$(value_cache_file "definitions" "$scope" "$option" "definitions-v3")"

  if [ -s "$cache_file" ]; then
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache hit: $cache_file" >&2
  else
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache miss: $cache_file" >&2

    expr_file="$(mktemp "${TMPDIR:-/tmp}/no-option-definitions.XXXXXX")"
    tmp="$cache_file.tmp.$$"
    flake_ref_literal="$(nix_string "$flake")"
    host_literal="$(nix_string "$host")"
    scope_literal="$(nix_string "$scope")"
    path_literal="$(path_to_nix_list "$option")"
    scope_lib_literal="$(nix_string "$scope_lib_path")"

    write_definitions_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_literal" "$path_literal" "$scope_lib_literal"

    if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
      if jq -e . "$tmp" >/dev/null; then
        rm -f "$expr_file"
        mv "$tmp" "$cache_file"
      else
        rm -f "$expr_file" "$tmp"
        echo "ERROR: definition eval produced invalid JSON for $option" >&2
        return 1
      fi
    else
      local status=$?
      rm -f "$expr_file" "$tmp"
      return "$status"
    fi
  fi

  jq -r --arg repo "$repo" '
    def pretty:
      if $repo != "" and startswith($repo + "/") then
        ltrimstr($repo + "/")
      elif test("^/nix/store/[a-z0-9]+-source/") then
        sub("^/nix/store/[a-z0-9]+-source/"; "")
      else
        .
      end;

    group_by(.label)
    | map({ path: (.[0].label | pretty), count: length })
    | sort_by(.path)
    | .[]
    | if .count > 1 then
        .path + " ×" + (.count | tostring)
      else
        .path
      end
  ' "$cache_file"
}



write_definition_items_expr() {
  local expr_file="$1"
  local flake_ref_literal="$2"
  local host_literal="$3"
  local scope_literal="$4"
  local path_literal="$5"
  local scope_lib_literal="$6"

  cat > "$expr_file" <<NIX
let
  flakeRef = $flake_ref_literal;
  host = $host_literal;
  scope = $scope_literal;
  optionPath = $path_literal;
  scopeLibPath = $scope_lib_literal;
  scopeData = import (builtins.toPath scopeLibPath) { inherit flakeRef host; };
  inherit (scopeData) lib;
  selectedScope = builtins.getAttr scope scopeData.scopes;

  opt = lib.attrByPath optionPath null selectedScope.options;

  plainString = s: builtins.unsafeDiscardStringContext (builtins.toString s);

  mkItem = kind: canonical: display: {
    id = builtins.hashString "sha256" (kind + "\\u0000" + canonical);
    inherit display kind;
  };

  renderOne =
    v:
    if builtins.isNull v then
      mkItem "null" "null" "null"
    else if builtins.isBool v then
      mkItem "bool" (if v then "true" else "false") (if v then "true" else "false")
    else if builtins.isInt v then
      mkItem "int" (builtins.toString v) (builtins.toString v)
    else if (builtins ? isFloat) && builtins.isFloat v then
      mkItem "float" (builtins.toJSON v) (builtins.toJSON v)
    else if builtins.isString v then
      let text = builtins.unsafeDiscardStringContext v;
      in mkItem "string" text text
    else if builtins.isPath v then
      let text = plainString v;
      in mkItem "path" text text
    else if builtins.isFunction v then
      mkItem "function" "function" "<function>"
    else if builtins.isAttrs v then
      let drvEval = builtins.tryEval (v ? type && v.type == "derivation" && v ? name);
      in
      if drvEval.success && drvEval.value then
        let nameEval = builtins.tryEval (plainString v.name);
            text = if nameEval.success then nameEval.value else "<derivation: unknown>";
        in mkItem "derivation" text text
      else
        let namesEval = builtins.tryEval (builtins.attrNames v);
            text = if namesEval.success then "<attrset: " + builtins.toString (builtins.length namesEval.value) + " keys>" else "<attrset>";
        in mkItem "attrset" text text
    else if builtins.isList v then
      let lenEval = builtins.tryEval (builtins.length v);
          text = "<list: " + (if lenEval.success then builtins.toString lenEval.value else "unknown") + " items>";
      in mkItem "list" text text
    else
      mkItem "unsupported" "unsupported" "<unsupported>";

  renderDefinition =
    def:
    let
      origin = scopeData.originPath (def.file or "<unknown-file>");
      valueEval = builtins.tryEval (def.value or "<missing>");

      raw =
        if ! valueEval.success then
          [ { inherit origin; item = mkItem "unavailable" "unavailable" "<unavailable>"; } ]
        else if builtins.isList valueEval.value then
          builtins.map (item: { inherit origin; item = renderOne item; }) valueEval.value
        else if builtins.isAttrs valueEval.value then
          let
            namesEval = builtins.tryEval (builtins.attrNames valueEval.value);
            names = if namesEval.success then namesEval.value else [ ];
          in
          builtins.map (
            name:
            let item = renderOne (builtins.getAttr name valueEval.value);
            in {
              inherit origin;
              item = mkItem "attribute:\${item.kind}" (name + "\\u0000" + item.id) (name + " = " + item.display);
            }
          ) names
        else
          [ { inherit origin; item = renderOne valueEval.value; } ];

      rendered = builtins.tryEval (builtins.deepSeq raw raw);
    in
    if rendered.success then
      rendered.value
    else
      [ { inherit origin; item = mkItem "unavailable" "unavailable" "<unavailable>"; } ];

  defsRaw =
    if opt == null then
      [ ]
    else
      let defsEval = builtins.tryEval (opt.definitionsWithLocations or [ ]);
      in
      if defsEval.success then
        builtins.concatLists (builtins.map renderDefinition defsEval.value)
      else
        [ ];

  defsEval = builtins.tryEval (builtins.deepSeq defsRaw defsRaw);
in
{
  option = builtins.concatStringsSep "." optionPath;
  inherit scope;
  items = if defsEval.success then defsEval.value else [ ];
}
NIX
}


print_origin_keys() {
  cat <<EOF
keys
  Ctrl-I  show all item-level origins for this option
  Ctrl-S  search evaluated values; preview shows origins for the highlighted value
  Ctrl-R  return this pane to docs
  Ctrl-V  show normal effective value
  Ctrl-F  show full effective value
  Alt-J/K scroll preview lines
  Alt-D/U scroll preview pages
  Alt-T/B jump preview top/bottom
EOF
}

print_definition_items() {
  local scope="$1"
  local option="$2"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_literal
  local scope_lib_literal
  local path_literal
  local cache_file
  local tmp

  cache_file="$(value_cache_file "definition-items" "$scope" "$option" "definition-items-v3")"

  if [ -s "$cache_file" ]; then
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache hit: $cache_file" >&2
  else
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache miss: $cache_file" >&2

    expr_file="$(mktemp "${TMPDIR:-/tmp}/no-option-definition-items.XXXXXX")"
    tmp="$cache_file.tmp.$$"
    flake_ref_literal="$(nix_string "$flake")"
    host_literal="$(nix_string "$host")"
    scope_literal="$(nix_string "$scope")"
    path_literal="$(path_to_nix_list "$option")"
    scope_lib_literal="$(nix_string "$scope_lib_path")"

    write_definition_items_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_literal" "$path_literal" "$scope_lib_literal"

    if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
      if jq -e . "$tmp" >/dev/null; then
        rm -f "$expr_file"
        mv "$tmp" "$cache_file"
      else
        rm -f "$expr_file" "$tmp"
        echo "ERROR: definition item eval produced invalid JSON for $option" >&2
        return 1
      fi
    else
      local status=$?
      rm -f "$expr_file" "$tmp"
      return "$status"
    fi
  fi

  printf '# %s\n\n' "$option"
  printf 'scope\n  %s\n\n' "$scope"
  printf 'item-level origins\n\n'

  jq -r --arg repo "$repo" '
    def pretty:
      if $repo != "" and startswith($repo + "/") then
        ltrimstr($repo + "/")
      elif test("^/nix/store/[a-z0-9]+-source/") then
        sub("^/nix/store/[a-z0-9]+-source/"; "")
      else
        .
      end;

    .items
    | if length == 0 then
        [ "<none>" ]
      else
        group_by(.item.id)
        | map({
            item: (.[0].item.display + " [" + .[0].item.kind + "]"),
            count: length,
            sources: (
              group_by(.origin.label)
              | map({
                  path: (.[0].origin.label | pretty),
                  count: length
                })
              | sort_by(.path)
            )
          })
        | sort_by(-.count, .item)
        | map(
            [
              (.item + if .count > 1 then " ×" + (.count | tostring) else "" end),
              (
                .sources[]
                | "  " + .path + if .count > 1 then " ×" + (.count | tostring) else "" end
              ),
              ""
            ]
          )
        | flatten
      end
    | .[]
  ' "$cache_file"

  echo
  print_origin_keys
}

print_definition_item() {
  local scope="$1"
  local option="$2"
  local item="$3"
  local cache_file
  local item_cache_file

  cache_file="$(value_cache_file "definition-items" "$scope" "$option" "definition-items-v3")"
  item_cache_file="$(value_cache_file "items" "$scope" "$option" "items-v3")"

  if [ ! -s "$cache_file" ]; then
    print_definition_items "$scope" "$option" >/dev/null
  fi
  if [ ! -s "$item_cache_file" ]; then
    print_value_items "$scope" "$option" >/dev/null
  fi

  jq -r --slurpfile values "$item_cache_file" --arg repo "$repo" --arg scope "$scope" --arg option "$option" --arg item "$item" '
    def pretty:
      if $repo != "" and startswith($repo + "/") then
        ltrimstr($repo + "/")
      elif test("^/nix/store/[a-z0-9]+-source/") then
        sub("^/nix/store/[a-z0-9]+-source/"; "")
      else
        .
      end;

    (.items | map(select(.item.id == $item or .item.display == $item))) as $exact
    | ($values[0].items | map(select(.id == $item or .display == $item))) as $evaluated
    | (if ($exact | length) > 0 then $exact elif ($evaluated | length) > 0 then .items else [] end) as $matches
    | ($exact[0].item.display // $evaluated[0].display // $item) as $display
    | ($exact[0].item.kind // $evaluated[0].kind // "unknown") as $kind
    | [
        "# " + $option,
        "",
        "scope",
        "  " + $scope,
        "",
        "item",
        "  " + $display + " [" + $kind + "]",
        "",
        "defined by"
      ]
      + (
        if ($matches | length) == 0 then
          [ "  <none>" ]
        else
          (
            $matches
            | group_by(.origin.label)
            | map({
                path: (.[0].origin.label | pretty),
                count: length
              })
            | sort_by(.path)
            | map(
                "  " + .path + if .count > 1 then " ×" + (.count | tostring) else "" end
              )
          )
        end
      )
      | .[]
  ' "$cache_file"

  echo
  print_origin_keys
}


build_cache() {
  local build_host="$1"
  local build_cache="$cache_dir/option-scopes-v3-$build_host.json"
  local tmp="$build_cache.tmp.$$"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_lib_literal

  expr_file="$(mktemp "${TMPDIR:-/tmp}/no-options-docs.XXXXXX")"
  flake_ref_literal="$(nix_string "$flake")"
  host_literal="$(nix_string "$build_host")"
  scope_lib_literal="$(nix_string "$scope_lib_path")"

  echo "Building scoped option docs cache for $build_host using $nix_bin..." >&2
  write_docs_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_lib_literal"

  if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
    rm -f "$expr_file"
    mv "$tmp" "$build_cache"
  else
    local status=$?
    rm -f "$expr_file" "$tmp"
    return "$status"
  fi
}

ensure_docs_cache() {
  if [ "$refresh" -eq 1 ] || [ ! -s "$cache" ]; then
    build_cache "$host"
  fi
}

list_scopes() {
  jq -r '
    map({ scope, label: .scopeLabel })
    | unique_by(.scope)
    | sort_by(.scope)
    | .[]
    | .scope + "\t" + .label
  ' "$cache"
}

validate_scope() {
  local scope="$1"

  if ! jq -e --arg scope "$scope" 'any(.scope == $scope)' "$cache" >/dev/null; then
    echo "ERROR: invalid scope for $host: $scope" >&2
    echo "Available scopes:" >&2
    list_scopes | sed 's/^/  /' >&2
    return 2
  fi
}

resolve_option_scope() {
  local requested="$1"
  local option="$2"
  local scopes
  local count

  if [ -n "$requested" ]; then
    validate_scope "$requested" || return $?
    if ! jq -e --arg scope "$requested" --arg name "$option" \
      'any(.scope == $scope and .name == $name)' "$cache" >/dev/null; then
      echo "ERROR: option not found in scope $requested: $option" >&2
      return 2
    fi
    printf '%s\n' "$requested"
    return 0
  fi

  scopes="$(jq -r --arg name "$option" '[.[] | select(.name == $name) | .scope] | unique | .[]' "$cache")"
  count="$(printf '%s\n' "$scopes" | sed '/^$/d' | wc -l | tr -d ' ')"

  if [ "$count" -eq 1 ]; then
    printf '%s\n' "$scopes"
    return 0
  fi

  if [ "$count" -eq 0 ]; then
    echo "ERROR: option not found: $option" >&2
  else
    echo "ERROR: option is ambiguous across scopes: $option" >&2
    echo "Available scopes:" >&2
    printf '%s\n' "$scopes" | sed 's/^/  /' >&2
    echo "Choose one with --scope <scope>." >&2
  fi
  return 2
}

print_value() {
  local scope="$1"
  local option="$2"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_literal
  local scope_lib_literal
  local path_literal
  local max_items
  local max_keys
  local max_chars
  local kind
  local cache_file
  local tmp
  local note

  ensure_docs_cache

  if [ "$value_full" -eq 1 ]; then
    kind="value-full"
    max_items="${NIX_OPTIONS_FZF_VALUE_MAX_ITEMS:-10000}"
    max_keys="${NIX_OPTIONS_FZF_VALUE_MAX_KEYS:-10000}"
    max_chars="${NIX_OPTIONS_FZF_VALUE_MAX_CHARS:-200000}"
  else
    kind="value"
    max_items="${NIX_OPTIONS_FZF_VALUE_MAX_ITEMS:-80}"
    max_keys="${NIX_OPTIONS_FZF_VALUE_MAX_KEYS:-80}"
    max_chars="${NIX_OPTIONS_FZF_VALUE_MAX_CHARS:-20000}"
  fi

  cache_file="$(value_cache_file "$kind" "$scope" "$option" "$max_items:$max_keys:$max_chars")"

  if [ -s "$cache_file" ]; then
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache hit: $cache_file" >&2
  else
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache miss: $cache_file" >&2

    expr_file="$(mktemp "${TMPDIR:-/tmp}/no-option-value.XXXXXX")"
    tmp="$cache_file.tmp.$$"
    flake_ref_literal="$(nix_string "$flake")"
    host_literal="$(nix_string "$host")"
    scope_literal="$(nix_string "$scope")"
    path_literal="$(path_to_nix_list "$option")"
    scope_lib_literal="$(nix_string "$scope_lib_path")"

    write_value_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_literal" "$path_literal" "$scope_lib_literal" "$max_items" "$max_keys" "$max_chars"

    if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
      if jq -e . "$tmp" >/dev/null; then
        rm -f "$expr_file"
        mv "$tmp" "$cache_file"
      else
        rm -f "$expr_file" "$tmp"
        echo "ERROR: value eval produced invalid JSON for $option" >&2
        return 1
      fi
    else
      local status=$?
      rm -f "$expr_file" "$tmp"
      return "$status"
    fi
  fi

  jq -r '"# " + .option, "", "scope", "  " + .scope, "", "current/effective value:", (.value | tostring)' "$cache_file"

  if [ "$(jq -r '.available // false' "$cache_file")" != "true" ]; then
    note="$(option_note "$scope" "$option")"
    if [ -n "$note" ]; then
      echo
      printf '%s\n' "$note"
    fi
  fi
}

print_value_items() {
  local scope="$1"
  local option="$2"
  local expr_file
  local flake_ref_literal
  local host_literal
  local scope_literal
  local scope_lib_literal
  local path_literal
  local cache_file
  local tmp
  local note

  ensure_docs_cache

  cache_file="$(value_cache_file "items" "$scope" "$option" "items-v3")"

  if [ -s "$cache_file" ]; then
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache hit: $cache_file" >&2
  else
    [ "${NIX_OPTIONS_FZF_CACHE_DEBUG:-0}" = 1 ] && echo "cache miss: $cache_file" >&2

    expr_file="$(mktemp "${TMPDIR:-/tmp}/no-option-items.XXXXXX")"
    tmp="$cache_file.tmp.$$"
    flake_ref_literal="$(nix_string "$flake")"
    host_literal="$(nix_string "$host")"
    scope_literal="$(nix_string "$scope")"
    path_literal="$(path_to_nix_list "$option")"
    scope_lib_literal="$(nix_string "$scope_lib_path")"

    write_items_expr "$expr_file" "$flake_ref_literal" "$host_literal" "$scope_literal" "$path_literal" "$scope_lib_literal"

    if "$nix_bin" eval --impure --json --file "$expr_file" > "$tmp"; then
      if jq -e . "$tmp" >/dev/null; then
        rm -f "$expr_file"
        mv "$tmp" "$cache_file"
      else
        rm -f "$expr_file" "$tmp"
        echo "ERROR: item eval produced invalid JSON for $option" >&2
        return 1
      fi
    else
      local status=$?
      rm -f "$expr_file" "$tmp"
      return "$status"
    fi
  fi

  jq -r '.items[].display' "$cache_file"

  if [ "$(jq -r '.available // false' "$cache_file")" != "true" ]; then
    note="$(option_note "$scope" "$option")"
    if [ -n "$note" ]; then
      printf '%s\n' "$note" >&2
    fi
  fi
}


search_value_items() {
  local scope="$1"
  local option="$2"
  local selected
  local item_origin_preview
  local item_cache_file

  if [ "$option" = ".." ] || [[ "$option" == */ ]]; then
    echo "Select a concrete option first, not a group."
    exit 0
  fi

  print_value_items "$scope" "$option" >/dev/null
  item_cache_file="$(value_cache_file "items" "$scope" "$option" "items-v3")"
  item_origin_preview="'$repo/scripts/nix-options-fzf' '$host' --scope '$scope' --definition-item '$option' {1}"

  selected="$(
    jq -r '.items[] | [.id, (.display | gsub("\\n"; "\\\\n")), .kind] | @tsv' "$item_cache_file" |
      fzf \
        --ansi \
        --delimiter=$'\t' \
        --with-nth=2,3 \
        --prompt="$host $option values> " \
        --header="Search evaluated values | preview shows origins for highlighted value | Enter/Esc: return to options browser" \
        --preview="$item_origin_preview" \
        --preview-window=right:60%:wrap,border-left \
        --query="${NIX_OPTIONS_FZF_VALUE_SEARCH_QUERY:-}"
  )" || exit 0

  # Enter accepts the highlighted value and closes this nested search.
  # The selected value is intentionally not printed/copied; the preview is for inspection.
  : "${selected:-}"
}

if [ "$refresh_all" -eq 1 ]; then
  while IFS= read -r h; do
    build_cache "$h"
  done < <(list_hosts)
  exit 0
fi

if [ "$print_cache" -eq 1 ]; then
  printf '%s\n' "$cache"
  exit 0
fi

ensure_docs_cache

if [ "$show_scopes" -eq 1 ]; then
  list_scopes
  exit 0
fi

if [ -n "$requested_scope" ]; then
  validate_scope "$requested_scope"
fi

if [ -n "$default_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$default_name")"
  print_default "$resolved_scope" "$default_name"
  exit 0
fi

if [ -n "$value_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$value_name")"
  print_value "$resolved_scope" "$value_name"
  exit 0
fi

if [ -n "$value_items_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$value_items_name")"
  print_value_items "$resolved_scope" "$value_items_name"
  exit 0
fi

if [ -n "$value_search_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$value_search_name")"
  search_value_items "$resolved_scope" "$value_search_name"
  exit 0
fi

if [ -n "$definition_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$definition_name")"
  print_definitions "$resolved_scope" "$definition_name"
  exit 0
fi

if [ -n "$definition_items_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$definition_items_name")"
  print_definition_items "$resolved_scope" "$definition_items_name"
  exit 0
fi

if [ -n "$definition_item_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$definition_item_name")"
  print_definition_item "$resolved_scope" "$definition_item_name" "$definition_item_value"
  exit 0
fi

export DOTFILES_OPTIONS_CACHE="$cache"
export DOTFILES_OPTIONS_REPO="$repo"
export DOTFILES_OPTIONS_SCOPE_FILTER="$requested_scope"

list_entries() {
  local current_prefix="$1"
  local mode="${2:-flat}"

  {
    if [ -n "$current_prefix" ]; then
      printf '..\t\t-\n'
    fi

    if [ "$mode" = "grouped" ]; then
      jq -r --arg prefix "$current_prefix" --arg scope "$requested_scope" '
        reduce (
          .[]
          | select(($scope == "" or .scope == $scope)
              and ($prefix == "" or .name == $prefix or (.name | startswith($prefix + "."))))
        ) as $record (
          { groups: {}, records: [] };
          $record.name as $full
          | (if $prefix == "" then $full else ($full | ltrimstr($prefix + ".")) end) as $rest
          | if (($prefix == "" or $full != $prefix) and ($rest | contains("."))) then
              ((if $prefix == "" then "" else $prefix + "." end) + ($rest | split(".")[0]) + "/") as $group
              | .groups[$group] = true
            else
              .records += [$record]
            end
        )
        | ([.groups | keys[] | { name: ., group: true }] + .records)
        | sort_by(.name, (.scope // ""))
        | .[]
        | if .group then
            [.name, "", "-"] | @tsv
          else
            [.name, ("[" + .scopeLabel + "]"), .scope] | @tsv
          end
      ' "$cache"
    else
      jq -r --arg prefix "$current_prefix" --arg scope "$requested_scope" '
        .[]
        | select(($scope == "" or .scope == $scope)
            and ($prefix == "" or (.name | startswith($prefix + ".")) or .name == $prefix))
        | [.name, ("[" + .scopeLabel + "]"), .scope]
        | @tsv
      ' "$cache"
    fi
  }
}

prefix_parent() {
  local p="$1"
  if [[ "$p" == *.* ]]; then
    printf '%s\n' "${p%.*}"
  else
    printf '%s\n' ""
  fi
}

parent_prefix() {
  local item="$1"

  if [[ "$item" == *.* ]]; then
    printf '%s\n' "${item%.*}"
  else
    printf '%s\n' ""
  fi
}

zoom_prefix() {
  local current="$1"
  local selected="$2"
  local rest
  local first

  if [ -n "$current" ]; then
    rest="${selected#"$current."}"
  else
    rest="$selected"
  fi

  if [[ "$rest" == *.* ]]; then
    first="${rest%%.*}"
    if [ -n "$current" ]; then
      printf '%s\n' "$current.$first"
    else
      printf '%s\n' "$first"
    fi
  else
    printf '%s\n' "$selected"
  fi
}

list_options() {
  jq -r --arg prefix "$prefix" --arg scope "$requested_scope" '
    [
      .[]
      | select(($scope == "" or .scope == $scope)
          and ($prefix == "" or (.name | startswith($prefix))))
    ]
    | group_by(.name)
    | .[]
    | if length == 1 then
        .[0].name
      else
        .[] | [.name, .scope] | @tsv
      end
  ' "$cache"
}

if [ -n "$preview_name" ]; then
  resolved_scope="$(resolve_option_scope "$requested_scope" "$preview_name")"
  "$preview_script" docs "$host" "$resolved_scope" "$preview_name"
  exit 0
fi

if [ "$list_only" -eq 1 ]; then
  list_options
  exit 0
fi

current_prefix="$prefix"
browser_mode="${NIX_OPTIONS_FZF_LIST_MODE:-flat}"

while true; do
  case "$browser_mode" in
    flat|grouped)
      ;;
    *)
      echo "ERROR: invalid NIX_OPTIONS_FZF_LIST_MODE: $browser_mode" >&2
      echo "Use one of: flat, grouped" >&2
      exit 2
      ;;
  esac

  export NIX_OPTIONS_FZF_LIST_MODE="$browser_mode"
  preview_docs="'$preview_script' docs '$host' {3} {1}"
  preview_value="'$preview_script' value '$host' {3} {1}"
  preview_full="'$preview_script' full '$host' {3} {1}"
  value_search="'$repo/scripts/nix-options-fzf' '$host' --scope {3} --value-search {1}"
  definition_items="'$repo/scripts/nix-options-fzf' '$host' --scope {3} --definition-items {1}"

  case "${NIX_OPTIONS_FZF_DEFAULT_PREVIEW:-full}" in
    docs)
      default_preview="$preview_docs"
      ;;
    value)
      default_preview="$preview_value"
      ;;
    full)
      default_preview="$preview_full"
      ;;
    *)
      echo "ERROR: invalid NIX_OPTIONS_FZF_DEFAULT_PREVIEW: ${NIX_OPTIONS_FZF_DEFAULT_PREVIEW:-}" >&2
      echo "Use one of: docs, value, full" >&2
      exit 2
      ;;
  esac

  prompt_prefix="$current_prefix"
  if [ -z "$prompt_prefix" ]; then
    prompt_prefix="<root>"
  fi

  if [ "$browser_mode" = "grouped" ]; then
    mode_label="grouped"
  else
    mode_label="flat"
  fi

  header="Mode: $mode_label | Default preview: full value | Enter zoom | Ctrl-P print identity | Ctrl-B back | Ctrl-O toggle grouped | Ctrl-J/K line | Ctrl-U/D half-page | Ctrl-V normal | Ctrl-F full | Ctrl-S search values | Ctrl-I item origins | Ctrl-R docs | Alt-J/K preview line | Alt-D/U preview page | Esc quit"

  fzf_output="$(
    list_entries "$current_prefix" "$browser_mode" |
      fzf \
        --ansi \
        --delimiter=$'\t' \
        --with-nth=1,2 \
        --expect=ctrl-b,ctrl-p,ctrl-o \
        --header="$header" \
        --prompt="$host [$mode_label] $prompt_prefix> " \
        --preview-window=right:70%:wrap,border-left \
        --preview="$default_preview" \
        --bind="ctrl-v:change-preview($preview_value)" \
        --bind="ctrl-f:change-preview($preview_full)" \
        --bind="ctrl-s:execute($value_search)" \
        --bind="ctrl-i:change-preview($definition_items)" \
        --bind="ctrl-r:change-preview($preview_docs)" \
        --bind="ctrl-j:down" \
        --bind="ctrl-k:up" \
        --bind="ctrl-u:half-page-up" \
        --bind="ctrl-d:half-page-down" \
        --bind="alt-j:preview-down" \
        --bind="alt-k:preview-up" \
        --bind="alt-d:preview-page-down" \
        --bind="alt-u:preview-page-up" \
        --bind="alt-t:preview-top" \
        --bind="alt-b:preview-bottom"
  )" || exit 0

  mapfile -t fzf_lines <<< "$fzf_output"

  if [ "${#fzf_lines[@]}" -eq 1 ]; then
    key="enter"
    selected_record="${fzf_lines[0]:-}"
  else
    key="${fzf_lines[0]:-}"
    selected_record="${fzf_lines[1]:-}"
  fi

  IFS=$'\t' read -r selected _selected_label selected_scope <<< "$selected_record"

  if [ "$key" = "ctrl-b" ]; then
    current_prefix="$(prefix_parent "$current_prefix")"
    continue
  fi

  if [ "$key" = "ctrl-o" ]; then
    if [ "$browser_mode" = "grouped" ]; then
      browser_mode="flat"
    else
      browser_mode="grouped"
    fi
    continue
  fi

  if [ -z "$selected" ]; then
    exit 0
  fi

  if [ "$selected" = ".." ]; then
    current_prefix="$(prefix_parent "$current_prefix")"
    continue
  fi

  if [[ "$selected" == */ ]]; then
    current_prefix="${selected%/}"
    continue
  fi

  if [ -z "$selected_scope" ] || [ "$selected_scope" = "-" ]; then
    echo "ERROR: selected option lost its scope identity: $selected" >&2
    exit 2
  fi

  if [ "$key" = "ctrl-p" ]; then
    selected_scope_count="$(jq -r --arg name "$selected" '[.[] | select(.name == $name) | .scope] | unique | length' "$cache")"
    if [ "$selected_scope_count" -gt 1 ]; then
      printf '%s\t%s\n' "$selected" "$selected_scope"
    else
      printf '%s\n' "$selected"
    fi
    exit 0
  fi

  target_prefix="$(zoom_prefix "$current_prefix" "$selected")"

  if [ "$target_prefix" != "$selected" ] && [ "$target_prefix" != "$current_prefix" ]; then
    current_prefix="$target_prefix"
    continue
  fi

  selected_parent="$(parent_prefix "$selected")"
  if [ -n "$selected_parent" ] && [ "$selected_parent" != "$current_prefix" ] && [ "$selected" != "$current_prefix" ]; then
    current_prefix="$selected_parent"
    continue
  fi

  continue
done
