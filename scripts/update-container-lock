#!/usr/bin/env bash
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
cd "$repo"

: "${CONTAINER_SOURCES_FILE:?missing CONTAINER_SOURCES_FILE}"
: "${CONTAINER_LOCK_FILE:?missing CONTAINER_LOCK_FILE}"

lock_file=$CONTAINER_LOCK_FILE
[[ -f "$lock_file" ]] || {
  echo "error: container lock not found: $lock_file" >&2
  exit 1
}

current_lock=$(jq -S . "$lock_file")
if (($#)); then
  new_lock=$current_lock
  names=("$@")
else
  new_lock='{}'
  mapfile -t names < <(jq -r 'keys[]' "$CONTAINER_SOURCES_FILE")
fi

((${#names[@]})) || {
  echo "error: no registry-backed containers are configured" >&2
  exit 1
}

work_dir=$(mktemp -d)
lock_tmp=""
trap 'rm -rf "$work_dir"; [[ -z "$lock_tmp" ]] || rm -f "$lock_tmp"' EXIT

for name in "${names[@]}"; do
  source=$(jq -er --arg name "$name" '.[$name]' "$CONTAINER_SOURCES_FILE") || {
    echo "error: unknown container: $name" >&2
    exit 1
  }

  manifest="$work_dir/${name//[^a-zA-Z0-9_.-]/_}.json"
  skopeo inspect --raw "docker://$source" >"$manifest"
  digest=$(skopeo manifest-digest "$manifest")

  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || {
    echo "error: $name returned malformed digest: $digest" >&2
    exit 1
  }

  if jq -e '(.manifests | type) == "array"' "$manifest" >/dev/null 2>&1; then
    jq -e '[.manifests[].platform | select(.os == "linux" and .architecture == "arm64")] | length > 0' \
      "$manifest" >/dev/null || {
      echo "error: $source has no linux/arm64 image" >&2
      exit 1
    }
  else
    platform=$(skopeo inspect --no-tags "docker://$source@$digest" | jq -r '.Os + "/" + .Architecture')
    [[ "$platform" == "linux/arm64" ]] || {
      echo "error: $source is $platform, not linux/arm64" >&2
      exit 1
    }
  fi

  new_lock=$(jq -c \
    --arg name "$name" \
    --arg source "$source" \
    --arg digest "$digest" \
    '. + {($name): {source: $source, digest: $digest}}' <<<"$new_lock")
done

new_lock=$(jq -S . <<<"$new_lock")
if [[ "$new_lock" == "$current_lock" ]]; then
  echo "Container lock is up to date."
  exit 0
fi

lock_tmp=$(mktemp "${lock_file}.tmp.XXXXXX")
printf '%s\n' "$new_lock" >"$lock_tmp"
chmod 0644 "$lock_tmp"
mv "$lock_tmp" "$lock_file"
lock_tmp=""

echo "Updated $lock_file:"
diff -u <(printf '%s\n' "$current_lock") <(printf '%s\n' "$new_lock") || true
