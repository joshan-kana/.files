#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! git diff --cached --quiet -- '*.nix'; then
  echo "Checking staged Nix formatting..."
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix' | xargs -0 nix fmt -- --fail-on-change
fi

# Generated gh-dash downstream patches preserve upstream diff whitespace and
# are validated by gh-dash patch apply/source/build checks.
git diff --check --cached -- . ':(exclude)patches/**'
