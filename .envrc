# shellcheck shell=bash
sync_stamp="$(git rev-parse --git-path direnv-sync)"
sync_interval_seconds="${DOTFILES_DIRENV_GIT_SYNC_INTERVAL_SECONDS:-3600}"
now="$(date +%s)"
last=0
[ -r "$sync_stamp" ] && read -r last <"$sync_stamp"

if [ "${DOTFILES_DIRENV_DISABLE_GIT_SYNC:-0}" != "1" ] && [ "$((now - last))" -ge "$sync_interval_seconds" ]; then
  git fetch origin --prune --recurse-submodules=on-demand || true
  git rebase --autostash '@{u}' || true
  git submodule update --init --recursive || true
  printf '%s\n' "$now" >"$sync_stamp"
fi

use flake
