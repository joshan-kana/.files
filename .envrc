# shellcheck shell=bash
# Keep direnv lightweight: expensive git sync is throttled per clone.
sync_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-direnv"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo_key="$(printf "%s" "$repo_root" | tr -c "A-Za-z0-9_.-" "_")"
sync_stamp="$sync_cache_dir/git-sync-$repo_key"
sync_interval_seconds="${DOTFILES_DIRENV_GIT_SYNC_INTERVAL_SECONDS:-3600}"
now="$(date +%s)"
last="$(cat "$sync_stamp" 2>/dev/null || printf 0)"

if [ "${DOTFILES_DIRENV_DISABLE_GIT_SYNC:-0}" != "1" ] && [ "$((now - last))" -ge "$sync_interval_seconds" ]; then
  mkdir -p "$sync_cache_dir"
  git fetch --all --prune || true

  current="$(git branch --show-current 2>/dev/null || true)"

  git for-each-ref --format='%(refname)' refs/remotes/origin |
  while read -r remote_ref; do
    [ "$remote_ref" = "refs/remotes/origin/HEAD" ] && continue
    branch="${remote_ref#refs/remotes/origin/}"
    case "$branch" in ""|HEAD|origin|refs/*|heads/*|remotes/*) continue ;; esac

    if ! git show-ref --verify --quiet "refs/heads/$branch"; then
      echo "direnv: creating local branch $branch ← origin/$branch"
      git branch --track "$branch" "$remote_ref" || true
    fi
  done

  git for-each-ref --format='%(refname:strip=2) %(upstream:short)' refs/heads |
  while read -r branch upstream; do
    [ -z "$upstream" ] && continue
    [ "$branch" = "$current" ] && continue
    case "$branch" in ""|HEAD|origin|refs/*|heads/*|remotes/*) continue ;; esac

    if git merge-base --is-ancestor "$branch" "$upstream"; then
      echo "direnv: fast-forwarding $branch ← $upstream"
      git branch -f "$branch" "$upstream" || true
    else
      echo "direnv: $branch has local commits; update it when you switch to it"
    fi
  done

  git pull --rebase --autostash --recurse-submodules || true
  date +%s > "$sync_stamp"
fi

use flake
