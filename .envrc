git fetch --all --prune

current="$(git branch --show-current)"

# Create local tracking branches for new GitHub branches.
git for-each-ref --format='%(refname:short)' refs/remotes/origin |
while read -r remote_branch; do
  [ "$remote_branch" = "origin/HEAD" ] && continue

  branch="${remote_branch#origin/}"

  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    echo "direnv: creating local branch $branch ← $remote_branch"
    git branch --track "$branch" "$remote_branch" || true
  fi
done

# Fast-forward all non-current local branches that track a remote.
git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads |
while read -r branch upstream; do
  [ -z "$upstream" ] && continue
  [ "$branch" = "$current" ] && continue

  if git merge-base --is-ancestor "$branch" "$upstream"; then
    echo "direnv: fast-forwarding $branch ← $upstream"
    git branch -f "$branch" "$upstream" || true
  else
    echo "direnv: $branch has local commits; update it when you switch to it"
  fi
done

# Update the current branch, preserving local edits.
git pull --rebase --autostash --recurse-submodules || true

use flake