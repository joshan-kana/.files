{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["nixfmt"]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.nixos.options"
        },
        "nixos-server": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.nixos-server.options"
        },
        "home-manager-unstable": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []"
        },
        "home-manager-stable": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.nixos-server.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  },

  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },

  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.snippetSuggestions": "top",
  "editor.suggest.snippetsPreventQuickSuggestions": false
}
