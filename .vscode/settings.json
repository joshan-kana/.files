{
  "nix.enableLanguageServer": true,
  "nixEnvSelector.useFlakes": true,
  "nixEnvSelector.flakeShell": "vscode",
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixfmt"
        ]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"git+file://${workspaceFolder}\").nixosConfigurations.nixos.options"
        },
        "nixos-server": {
          "expr": "(builtins.getFlake \"git+file://${workspaceFolder}\").nixosConfigurations.nixos-server.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"git+file://${workspaceFolder}\").nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
