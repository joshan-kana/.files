#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mirror_native_sessions=false
if [[ ${1:-} == "--mirror-native-sessions" ]]; then
  mirror_native_sessions=true
  shift
fi
if (($#)); then
  echo "usage: ${0##*/} [--mirror-native-sessions]" >&2
  exit 2
fi

computer_python="$HOME/.local/share/uv/tools/cptr/bin/python"
computer_bin="$HOME/.local/bin/cptr"
computer_port=8000
server="joshan@192.168.1.3"
server_secret="/root/secrets/open-webui-mac-computer.env"

if [[ ! -x "$computer_python" || ! -x "$computer_bin" ]]; then
  echo "The existing uv-managed Open WebUI Computer is missing." >&2
  exit 1
fi

computer_version="$("$computer_python" -c 'from importlib.metadata import version; print(version("cptr"))' 2>/dev/null || true)"
if [[ "$computer_version" != "0.9.21" ]]; then
  echo "Expected the existing cptr 0.9.21 environment; found: ${computer_version:-unknown}" >&2
  exit 1
fi

if ! command -v sessionwiki >/dev/null 2>&1; then
  brew install youdie006/tap/sessionwiki
fi
sessionwiki_bin="$(command -v sessionwiki)"
sessionwiki sync >/dev/null

# Computer's stdio MCP support is optional. Add that extra to the existing uv
# tool environment only when it is missing; do not create another Computer.
if ! "$computer_python" -c 'import mcp' >/dev/null 2>&1; then
  uv tool install --python 3.12 --force 'cptr[all]==0.9.21'
fi

# Verify SessionWiki's own read-only MCP server before registering it.
SESSIONWIKI_BIN="$sessionwiki_bin" "$computer_python" <<'PY'
import asyncio
import os

from cptr.utils.mcp.client import MCPClient


async def main():
    client = MCPClient()
    await client.connect_stdio(os.environ["SESSIONWIKI_BIN"], ["mcp"], None, os.path.expanduser("~"))
    try:
        names = {tool["name"] for tool in await client.list_tool_specs()}
        required = {"search_sessions", "get_session_brief", "recent_sessions"}
        missing = required - names
        if missing:
            raise SystemExit(f"SessionWiki MCP is missing expected tools: {sorted(missing)}")
    finally:
        await client.disconnect()


asyncio.run(main())
PY

# Register SessionWiki directly as a local stdio MCP server in the existing
# Mac Computer. This replaces the old custom HTTP session bridge.
SESSIONWIKI_BIN="$sessionwiki_bin" CPTR_DATA_DIR="$HOME/.cptr" "$computer_python" <<'PY'
import asyncio
import os

from cptr.models import Config


async def main():
    managed = {
        "id": "sessionwiki",
        "type": "mcp_stdio",
        "url": "",
        "path": "",
        "auth_type": "none",
        "key": "",
        "name": "SessionWiki",
        "description": "Local read-only coding-session history",
        "headers": None,
        "enabled": True,
        "command": os.environ["SESSIONWIKI_BIN"],
        "args": ["mcp"],
        "env": None,
        "cwd": os.path.expanduser("~"),
    }
    servers = await Config.get("tool_servers") or []
    servers = [server for server in servers if server.get("id") != "sessionwiki"]
    servers.append(managed)
    await Config.upsert({"tool_servers": servers})


asyncio.run(main())
PY

# Restart the existing LaunchAgent so Computer drops its cached tool-server list.
computer_label=""
for plist in "$HOME"/Library/LaunchAgents/*.plist; do
  [[ -f "$plist" ]] || continue
  if /usr/libexec/PlistBuddy -c 'Print :ProgramArguments' "$plist" 2>/dev/null | grep -Fq "$computer_bin"; then
    computer_label="$(/usr/libexec/PlistBuddy -c 'Print :Label' "$plist" 2>/dev/null || true)"
    [[ -n "$computer_label" ]] && break
  fi
done
if [[ -z "$computer_label" ]]; then
  echo "Could not find the existing Open WebUI Computer LaunchAgent." >&2
  exit 1
fi
launchctl kickstart -k "gui/$(id -u)/$computer_label"

for _ in {1..30}; do
  if curl -fsS "http://127.0.0.1:${computer_port}/api/health" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
curl -fsS "http://127.0.0.1:${computer_port}/api/health" >/dev/null

mac_lan_ip=""
mac_tailscale_ip=""
default_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
if [[ -n "$default_interface" ]]; then
  mac_lan_ip="$(ipconfig getifaddr "$default_interface" 2>/dev/null || true)"
fi
if command -v tailscale >/dev/null 2>&1; then
  mac_tailscale_ip="$(tailscale ip -4 2>/dev/null | head -n 1 || true)"
fi
selected_mac_ip="${mac_tailscale_ip:-$mac_lan_ip}"
if [[ -z "$selected_mac_ip" ]]; then
  echo "Could not determine a routable Mac LAN or Tailscale IPv4 address." >&2
  exit 1
fi
mac_computer_base="http://${selected_mac_ip}:${computer_port}/v1"

gateway_key="$(security find-generic-password -w -s com.joshan.cptr.gateway)"
if [[ -z "$gateway_key" ]]; then
  echo "Mac Computer gateway key is missing from login Keychain service com.joshan.cptr.gateway." >&2
  exit 1
fi

{
  printf 'CPTR_BASE_URL=%s\n' "$mac_computer_base"
  printf 'CPTR_GATEWAY_API_KEY=%s\n' "$gateway_key"
} | ssh -A -o BatchMode=yes "$server" \
  "sudo install -m 0400 -o root -g root /dev/stdin '$server_secret' && sudo open-webui-sync sync"

printf 'Mac Computer registered: %s\n' "$mac_computer_base"
printf 'SessionWiki MCP registered locally in Mac Computer: %s mcp\n' "$sessionwiki_bin"

# Sidebar mirroring is deliberately opt-in. SessionWiki search/resume keeps
# working exactly the same when this block is never run or is removed later.
if $mirror_native_sessions; then
  python3 "$script_dir/open-webui-native-session-mirror.py" push \
    --server "$server" \
    --host mac \
    --limit "${OPEN_WEBUI_NATIVE_SESSION_MIRROR_LIMIT:-100}"
else
  printf '%s\n' 'Native-session sidebar mirroring left disabled (optional).'
fi
