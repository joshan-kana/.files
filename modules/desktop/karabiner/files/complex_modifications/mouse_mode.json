{
  "title": "Mouse Mode (Globe+Tab toggle)",
  "rules": [
    {
      "description": "Toggle Mouse Mode with Globe+Tab",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": ["fn"]
            }
          },
          "to_if_alone": [
            {
              "set_variable": {
                "name": "mouse_mode",
                "value": 0
              },
              "conditions": [
                {
                  "type": "variable_if",
                  "name": "mouse_mode",
                  "value": 1
                }
              ]
            },
            {
              "set_variable": {
                "name": "mouse_mode",
                "value": 1
              },
              "conditions": [
                {
                  "type": "variable_unless",
                  "name": "mouse_mode",
                  "value": 1
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Mouse actions while in Mouse Mode",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "escape",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "pointing_button": "button1" }],
          "conditions": [
            { "type": "variable_if", "name": "mouse_mode", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f1",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "pointing_button": "button3" }],
          "conditions": [
            { "type": "variable_if", "name": "mouse_mode", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f2",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "pointing_button": "button2" }],
          "conditions": [
            { "type": "variable_if", "name": "mouse_mode", "value": 1 }
          ]
        }
      ]
    }
  ]
}
