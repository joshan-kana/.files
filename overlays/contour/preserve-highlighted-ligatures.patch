+                                   gsl::span<vtbackend::RGBColor const> colors,
@@ -639 +639 @@
-    if (codepoints.empty())
+    if (codepoints.empty() || colors.empty())
@@ -653,0 +654,65 @@
+    auto const groupStartX = pen.x;
+    auto const colorCellWidth = cellWidth * advanceScale;
+    bool const uniformColor =
+        std::ranges::all_of(colors, [&](auto const& color) { return color == colors.front(); });
+
+    // HarfBuzz shapes the whole run. Tint each portion of the resulting glyph
+    // with the original foreground of the grid cell beneath it. Cropping the
+    // atlas quad preserves both the ligature and multi-colour syntax highlights.
+    auto const drawTile = [&](int x, int y, AtlasTileAttributes const& attributes) {
+        if (uniformColor)
+        {
+            renderTile(atlas::RenderTile::X { x },
+                       atlas::RenderTile::Y { y },
+                       colors.front(),
+                       attributes);
+            return;
+        }
+
+        auto tile = createRenderTile(atlas::RenderTile::X { x },
+                                     atlas::RenderTile::Y { y },
+                                     colors.front(),
+                                     attributes);
+        auto const width = unbox<int>(tile.targetSize.width) != 0
+                               ? unbox<int>(tile.targetSize.width)
+                               : unbox<int>(tile.bitmapSize.width);
+        if (width <= 0)
+            return;
+
+        auto const atlasLocation = tile.normalizedLocation;
+        auto const right = x + width;
+        for (int left = x; left < right;)
+        {
+            // Any glyph overhang outside the shaping run takes its edge colour.
+            auto const index = left < groupStartX
+                                   ? 0u
+                                   : std::min(static_cast<unsigned>((left - groupStartX) / colorCellWidth),
+                                              static_cast<unsigned>(colors.size() - 1));
+            auto end = index + 1 == colors.size()
+                           ? right
+                           : std::min(right, groupStartX + (static_cast<int>(index) + 1) * colorCellWidth);
+            if (end <= left)
+                end = right;
+
+            // Avoid redundant draw calls across adjacent cells of the same colour.
+            while (end < right)
+            {
+                auto const next = static_cast<size_t>((end - groupStartX) / colorCellWidth);
+                if (next >= colors.size() || colors[next] != colors[index])
+                    break;
+                end = next + 1 == colors.size()
+                          ? right
+                          : std::min(right, groupStartX + (static_cast<int>(next) + 1) * colorCellWidth);
+            }
+
+            tile.x.value = left;
+            tile.targetSize.width = vtbackend::Width(end - left);
+            tile.normalizedLocation.x =
+                atlasLocation.x + atlasLocation.width * static_cast<float>(left - x) / width;
+            tile.normalizedLocation.width =
+                atlasLocation.width * static_cast<float>(end - left) / width;
+            tile.color = atlas::normalize(colors[index], 1.0f);
+            textureScheduler().renderTile(tile);
+            left = end;
+        }
+    };
