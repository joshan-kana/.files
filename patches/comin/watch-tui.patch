index 0000000..d0018c5
--- /dev/null
+++ b/cmd/watch_panels_test.go
@@ -0,0 +1,133 @@
+package cmd
+
+import (
+	"github.com/charmbracelet/bubbles/help"
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/nlewo/comin/pkg/protobuf"
+	"strings"
+	"testing"
+)
+
+func TestWatchLogFormatting(t *testing.T) {
+	entry := parseServiceLog(`time="2026-11-17T10:20:03+08:00" level=error msg="nix: build failed"`)
+	if entry.when != "10:20:03" || entry.level != "error" || entry.message != "nix: build failed" {
+		t.Fatalf("log format unexpected: %#v", entry)
+	}
+	if got := normalizeLogMessage("\x1b[31mproblem\x1b[0m\roverride"); got != "override" {
+		t.Fatalf("terminal control bytes not removed: %q", got)
+	}
+}
+
+func TestWatchLogWindowAndScrolling(t *testing.T) {
+	var logs []logEntry
+	for i := 0; i < maxWatchLogs+30; i++ {
+		logs = appendLog(logs, logEntry{message: "line"})
+	}
+	if len(logs) != maxWatchLogs {
+		t.Fatalf("unbounded log buffer: %d", len(logs))
+	}
+	if got := adjustOffset(0, "k", maxWatchLogs, 10); got != 1 {
+		t.Fatalf("scrolling up expected 1 got %d", got)
+	}
+	if got := adjustOffset(1, "end", maxWatchLogs, 10); got != 0 {
+		t.Fatalf("end expected tail got %d", got)
+	}
+	view := (Model{logs: logs, width: 85, height: 25, panel: "logs"}).logsView()
+	if !strings.Contains(view, "COMIN · LOGS") {
+		t.Fatal("logs panel heading missing")
+	}
+}
+
+func TestWatchHistoryScroll(t *testing.T) {
+	if got := adjustHistoryOffset(0, "j", 40, 10); got != 1 {
+		t.Fatalf("history j should move down: %d", got)
+	}
+	if got := adjustHistoryOffset(1, "k", 40, 10); got != 0 {
+		t.Fatalf("history k should move up: %d", got)
+	}
+}
+
+func TestWatchPanelKeys(t *testing.T) {
+	model := Model{keys: keys}
+	press := func(key rune) {
+		updated, _ := model.Update(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{key}})
+		model = updated.(Model)
+	}
+	press('l')
+	if model.panel != "logs" {
+		t.Fatal("l must open logs")
+	}
+	press('h')
+	if model.panel != "history" {
+		t.Fatal("h must open history")
+	}
+	press('h')
+	if model.panel != "" {
+		t.Fatal("h must close history")
+	}
+	press('b')
+	if model.notice != "Not connected" {
+		t.Fatalf("b offline feedback: %q", model.notice)
+	}
+	press('d')
+	if model.notice != "Not connected" {
+		t.Fatalf("d offline feedback: %q", model.notice)
+	}
+}
+
+func TestWatcherActionDebounce(t *testing.T) {
+	var calls int
+	model := Model{keys: keys}
+	for i := 0; i < 100; i++ {
+		updated, cmd := model.startAction("retry", func() error { calls++; return nil })
+		model = updated.(Model)
+		if cmd == nil {
+			t.Fatal("first request should submit")
+		}
+		blocked, cmd2 := model.startAction("retry", func() error { t.Fatal("duplicate action executed"); return nil })
+		if cmd2 != nil {
+			t.Fatal("duplicate request queued")
+		}
+		model = blocked.(Model)
+		msg := cmd()
+		after, _ := model.Update(msg)
+		model = after.(Model)
+		if model.pendingAction != "" {
+			t.Fatal("pending action not released")
+		}
+	}
+	if calls != 100 {
+		t.Fatalf("expected 100 completed calls; got %d", calls)
+	}
+}
+
+func TestWatcherPersistedHistoryDedup(t *testing.T) {
+	gen := &protobuf.Generation{Source: &protobuf.Source{Source: &protobuf.Source_Git{Git: &protobuf.Git{SelectedCommitId: "123456abcdef"}}}}
+	d := &protobuf.Deployment{Uuid: "d1", Generation: gen, Status: "running"}
+	list := upsertDeployment(nil, d)
+	d2 := &protobuf.Deployment{Uuid: "d1", Generation: gen, Status: "done"}
+	list = upsertDeployment(list, d2)
+	if len(list) != 1 || list[0].Status != "done" {
+		t.Fatalf("history duplicated instead of updated: %v", list)
+	}
+	list = upsertDeployment(list, &protobuf.Deployment{Uuid: "dummy"})
+	if got := len(historyEntries(list)); got != 1 {
+		t.Fatalf("unexpected history entries: %d", got)
+	}
+	if got := adjustHistoryOffset(0, "end", len(historyEntries(list)), 8); got != 0 {
+		t.Fatalf("history scroll beyond bounds: %d", got)
+	}
+}
+
+func TestWatchControlsHaveTwoShortRows(t *testing.T) {
+	m := Model{keys: keys, help: help.New()}
+	first := ansi.Strip(m.helpRow(keys.Fetch, keys.Build, keys.Deploy, keys.Confirm))
+	second := ansi.Strip(m.helpRow(keys.Suspend, keys.Logs, keys.History, keys.Quit))
+	if first != "f fetch • b build • d deploy • c confirm" {
+		t.Fatalf("unexpected primary control row: %q", first)
+	}
+	if second != "s suspend • l logs • h history • q quit" {
+		t.Fatalf("unexpected secondary control row: %q", second)
+	}
+}
