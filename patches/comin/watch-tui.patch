--- /dev/null
+++ b/pkg/tui/tui_history_test.go
@@ -0,0 +1,38 @@
+package tui
+
+import (
+	"testing"
+	"time"
+
+	"github.com/nlewo/comin/pkg/protobuf"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+func TestRehydratePersistedGenerationAndDeployment(t *testing.T) {
+	gen := &protobuf.Generation{
+		Uuid:          "build-1",
+		EvalStatus:    "evaluated",
+		BuildStatus:   "built",
+		EvalStartedAt: timestamppb.New(time.Now()),
+		Source:        &protobuf.Source{Source: &protobuf.Source_Git{Git: &protobuf.Git{SelectedCommitId: "abcdef123456"}}},
+	}
+	deployment := &protobuf.Deployment{
+		Uuid: "deploy-1", Status: "done", Generation: gen,
+		CreatedAt: timestamppb.New(time.Now()),
+	}
+	event := &protobuf.Event{Type: &protobuf.Event_ManagerState_{ManagerState: &protobuf.Event_ManagerState{
+		State: &protobuf.State{
+			Builder:  &protobuf.Builder{Hostname: "example"},
+			Deployer: &protobuf.Deployer{},
+			Store:    &protobuf.Store{Generations: []*protobuf.Generation{gen}, Deployments: []*protobuf.Deployment{deployment}},
+		},
+	}}}
+	var model ManagerModel
+	UpdateManager(&model, event)
+	if model.Builder.Generation == nil || model.Builder.Generation.Uuid != gen.Uuid {
+		t.Fatal("saved build not restored after reconnection")
+	}
+	if model.Deployer.Deployment == nil || model.Deployer.Deployment.Uuid != deployment.Uuid {
+		t.Fatal("saved deployment not restored after reconnection")
+	}
+}
