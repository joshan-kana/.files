 		})
 	}
 }
+
+func TestUnitFileHashReadsUpdatedSymlink(t *testing.T) {
+	dir := t.TempDir()
+	first := filepath.Join(dir, "first.service")
+	second := filepath.Join(dir, "second.service")
+	link := filepath.Join(dir, "comin.service")
+	assert.NoError(t, os.WriteFile(first, []byte("ExecStart=/old/bin/comin"), 0644))
+	assert.NoError(t, os.WriteFile(second, []byte("ExecStart=/new/bin/comin"), 0644))
+	assert.NoError(t, os.Symlink(first, link))
+	before := hashUnitFile(link)
+	assert.NotEmpty(t, before)
+	assert.NoError(t, os.Remove(link))
+	assert.NoError(t, os.Symlink(second, link))
+	assert.NotEqual(t, before, hashUnitFile(link))
+}
