+func TestRepositoryUpdateHardResetMainAllowed(t *testing.T) {
+	t.Setenv("COMIN_ALLOW_FORCE_PUSH", "true")
+
+	remoteRepositoryDir := t.TempDir()
+	cominRepositoryDir := t.TempDir()
+	remoteRepository, err := initRemoteRepostiory(remoteRepositoryDir, true)
+	assert.Nil(t, err)
+
+	gitConfig := types.GitConfig{
+		Path: cominRepositoryDir,
+		Remotes: []types.Remote{
+			{
+				Name: "origin",
+				URL:  remoteRepositoryDir,
+				Branches: types.Branches{
+					Main: types.Branch{
+						Name: "main",
+					},
+					Testing: types.Branch{
+						Name: "testing",
+					},
+				},
+				Timeout: 30,
+			},
+		},
+	}
+	r, _ := New(gitConfig, "", prometheus.New())
+
+	r.Fetch([]string{"origin"})
+	_ = r.Update()
+
+	previousHash, _ := commitFile(remoteRepository, remoteRepositoryDir, "main", "file-4")
+	oldHead, _ := commitFile(remoteRepository, remoteRepositoryDir, "main", "file-5")
+	r.Fetch([]string{"origin"})
+	_ = r.Update()
+	assert.Equal(t, oldHead, r.RepositoryStatus.SelectedCommitId)
+
+	ref := plumbing.NewHashReference("refs/heads/main", plumbing.NewHash(previousHash))
+	assert.Nil(t, remoteRepository.Storer.SetReference(ref))
+	newHead, _ := commitFile(remoteRepository, remoteRepositoryDir, "main", "file-6")
+
+	r.Fetch([]string{"origin"})
+	_ = r.Update()
+
+	assert.Equal(t, newHead, r.RepositoryStatus.SelectedCommitId)
+	assert.Equal(t, "main", r.RepositoryStatus.SelectedBranchName)
+	assert.Equal(t, newHead, r.RepositoryStatus.MainCommitId)
+	assert.Empty(t, r.RepositoryStatus.Remotes[0].Main.ErrorMsg)
+	assert.Contains(t, r.RepositoryStatus.Remotes[0].Testing.ErrorMsg, "this branch has been hard reset")
+}
