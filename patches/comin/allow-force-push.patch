+func TestRepositoryUpdateHardResetMainAllowed(t *testing.T) {
+	t.Setenv("COMIN_ALLOW_FORCE_PUSH", "true")
+	remoteDir := t.TempDir()
+	localDir := t.TempDir()
+	remote, err := initRemoteRepostiory(remoteDir, true)
+	assert.NoError(t, err)
+	config := types.GitConfig{
+		Path: localDir,
+		Remotes: []types.Remote{{
+			Name: "origin", URL: remoteDir,
+			Branches: types.Branches{
+				Main:    types.Branch{Name: "main"},
+				Testing: types.Branch{Name: "testing"},
+			},
+			Timeout: 30,
+		}},
+	}
+	repository, err := New(config, "", prometheus.New())
+	assert.NoError(t, err)
+	repository.Fetch([]string{"origin"})
+	assert.NoError(t, repository.Update())
+	ancestor, _ := commitFile(remote, remoteDir, "main", "file-4")
+	_, _ = commitFile(remote, remoteDir, "main", "file-5")
+	repository.Fetch([]string{"origin"})
+	assert.NoError(t, repository.Update())
+	assert.NoError(t, remote.Storer.SetReference(plumbing.NewHashReference("refs/heads/main", plumbing.NewHash(ancestor))))
+	replacement, _ := commitFile(remote, remoteDir, "main", "file-6")
+	repository.Fetch([]string{"origin"})
+	assert.NoError(t, repository.Update())
+	assert.Equal(t, replacement, repository.RepositoryStatus.SelectedCommitId)
+	assert.Empty(t, repository.RepositoryStatus.Remotes[0].Main.ErrorMsg)
+	assert.NotEmpty(t, repository.RepositoryStatus.Remotes[0].Testing.ErrorMsg)
+}
