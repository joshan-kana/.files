+
+func TestWatchPanelKeys(t *testing.T) {
+	model := Model{keys: keys}
+	press := func(key rune) {
+		updated, _ := model.Update(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{key}})
+		model = updated.(Model)
+	}
+	press('l')
+	if model.panel != "logs" {
+		t.Fatal("l must open logs")
+	}
+	press('g')
+	if model.panel != "history" {
+		t.Fatal("g must open history")
+	}
+	press('g')
+	if model.panel != "" {
+		t.Fatal("g must close history")
+	}
+	press('b')
+	if model.notice != "Not connected" {
+		t.Fatalf("b offline feedback: %q", model.notice)
+	}
+	press('d')
+	if model.notice != "Not connected" {
+		t.Fatalf("d offline feedback: %q", model.notice)
+	}
+}
+
+func TestWatcherActionDebounce(t *testing.T) {
+	var calls int
+	model := Model{keys: keys}
+	for i := 0; i < 100; i++ {
+		updated, cmd := model.startAction("retry", func() error { calls++; return nil })
+		model = updated.(Model)
+		if cmd == nil {
+			t.Fatal("first request should submit")
+		}
+		blocked, cmd2 := model.startAction("retry", func() error { t.Fatal("duplicate action executed"); return nil })
+		if cmd2 != nil {
+			t.Fatal("duplicate request queued")
+		}
+		model = blocked.(Model)
+		msg := cmd()
+		after, _ := model.Update(msg)
+		model = after.(Model)
+		if model.pendingAction != "" {
+			t.Fatal("pending action not released")
+		}
+	}
+	if calls != 100 {
+		t.Fatalf("expected 100 completed calls; got %d", calls)
+	}
+}
+
+func TestWatcherPersistedHistoryDedup(t *testing.T) {
+	gen := &protobuf.Generation{Source: &protobuf.Source{Source: &protobuf.Source_Git{Git: &protobuf.Git{SelectedCommitId: "123456abcdef"}}}}
+	d := &protobuf.Deployment{Uuid: "d1", Generation: gen, Status: "running"}
+	list := upsertDeployment(nil, d)
+	d2 := &protobuf.Deployment{Uuid: "d1", Generation: gen, Status: "done"}
+	list = upsertDeployment(list, d2)
+	if len(list) != 1 || list[0].Status != "done" {
+		t.Fatalf("history duplicated instead of updated: %v", list)
+	}
+	list = upsertDeployment(list, &protobuf.Deployment{Uuid: "dummy"})
+	if got := len(historyEntries(list)); got != 1 {
+		t.Fatalf("unexpected history entries: %d", got)
+	}
+	if got := adjustHistoryOffset(0, "end", len(historyEntries(list)), 8); got != 0 {
+		t.Fatalf("history scroll beyond bounds: %d", got)
+	}
+}
