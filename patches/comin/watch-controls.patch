+// Retry restarts an unsuccessful generation through the normal build/deploy pipeline.
+func (m *Manager) Retry(_ context.Context) error {
+	// gRPC request contexts end when the RPC returns; builds and evaluations
+	// must instead use the daemon's lifetime context.
+	m.runContextMu.RLock()
+	ctx := m.runContext
+	m.runContextMu.RUnlock()
+	if ctx == nil {
+		return fmt.Errorf("manager is not running")
+	}
+	b := m.Builder.State()
+	if b.IsSuspended.GetValue() || m.isSuspended {
+		return fmt.Errorf("comin is suspended")
+	}
+	if b.IsEvaluating.GetValue() || b.IsBuilding.GetValue() {
+		return fmt.Errorf("builder is busy")
+	}
+	if b.Generation == nil {
+		return fmt.Errorf("no generation to retry")
+	}
+	generation := b.Generation
+	if generation.Source == nil || generation.Source.GetGit() == nil {
+		return fmt.Errorf("the current generation is not a Git generation")
+	}
+	current := m.Fetcher.GetState().GetGitRepositoryStatus()
+	if current == nil || current.SelectedCommitId != generation.Source.GetGit().SelectedCommitId {
+		return fmt.Errorf("the selected revision has changed; fetch again")
+	}
+	if generation.EvalStatus == store.EvalFailed.String() {
+		return m.Builder.Eval(ctx, generation)
+	}
+	return m.Builder.RetryBuild(ctx)
+}
