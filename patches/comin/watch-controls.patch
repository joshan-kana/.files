diff --git a/pkg/client/client_integration_test.go b/pkg/client/client_integration_test.go
new file mode 100644
index 0000000..615a926
--- /dev/null
+++ b/pkg/client/client_integration_test.go
@@ -0,0 +1,132 @@
+package client
+
+import (
+	"context"
+	"net"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/nlewo/comin/pkg/protobuf"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+type stubServer struct {
+	protobuf.UnimplementedCominServer
+	hostname    string
+	retries     atomic.Int32
+	deployments atomic.Int32
+	fetches     atomic.Int32
+}
+
+func (s *stubServer) Events(_ *emptypb.Empty, stream grpc.ServerStreamingServer[protobuf.Event]) error {
+	event := &protobuf.Event{Type: &protobuf.Event_ManagerState_{ManagerState: &protobuf.Event_ManagerState{State: &protobuf.State{Builder: &protobuf.Builder{Hostname: s.hostname}}}}}
+	if err := stream.Send(event); err != nil {
+		return err
+	}
+	<-stream.Context().Done()
+	return nil
+}
+func (s *stubServer) Retry(context.Context, *emptypb.Empty) (*emptypb.Empty, error) {
+	s.retries.Add(1)
+	return &emptypb.Empty{}, nil
+}
+func (s *stubServer) DeploymentLatestSubmit(context.Context, *protobuf.Operation) (*emptypb.Empty, error) {
+	s.deployments.Add(1)
+	return &emptypb.Empty{}, nil
+}
+func (s *stubServer) Fetch(context.Context, *emptypb.Empty) (*emptypb.Empty, error) {
+	s.fetches.Add(1)
+	return &emptypb.Empty{}, nil
+}
+
+func runStub(t *testing.T, path, name string) (*grpc.Server, *stubServer) {
+	t.Helper()
+	l, err := net.Listen("unix", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	svc := &stubServer{hostname: name}
+	server := grpc.NewServer()
+	protobuf.RegisterCominServer(server, svc)
+	go func() { _ = server.Serve(l) }()
+	return server, svc
+}
+func nextHost(t *testing.T, channel <-chan Streamer, name string) {
+	t.Helper()
+	timer := time.NewTimer(12 * time.Second)
+	defer timer.Stop()
+	for {
+		select {
+		case <-timer.C:
+			t.Fatalf("never recovered connection to %s", name)
+		case update, ok := <-channel:
+			if !ok {
+				t.Fatalf("stream closed before %s", name)
+			}
+			if update.Event == nil || update.Event.GetManagerState() == nil {
+				continue
+			}
+			state := update.Event.GetManagerState().State
+			if state != nil && state.Builder != nil && state.Builder.Hostname == name {
+				return
+			}
+		}
+	}
+}
+func TestStreamReconnectAcrossDaemonRestarts(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "comin.sock")
+	server, _ := runStub(t, path, "first")
+	c, err := New(ClientOpts{UnixSocketPath: path})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	channel := c.Stream(ctx)
+	nextHost(t, channel, "first")
+	for i := 0; i < 8; i++ {
+		server.Stop()
+		// ResetConnectBackoff is only needed to make the stress test fast;
+		// the normal client also reconnects with gRPC's backoff.
+		c.conn.ResetConnectBackoff()
+		name := time.Now().Format("150405.000000")
+		server, _ = runStub(t, path, name)
+		nextHost(t, channel, name)
+	}
+	server.Stop()
+	cancel()
+	select {
+	case _, ok := <-channel:
+		if ok {
+			for range channel {
+			}
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("stream goroutine did not stop on context cancellation")
+	}
+}
+func TestControlsUseNewRPCMethods(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "comin.sock")
+	server, svc := runStub(t, path, "test")
+	defer server.Stop()
+	c, err := New(ClientOpts{UnixSocketPath: path})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if err := c.Fetch(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Retry(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.DeploymentLatestSubmit(""); err != nil {
+		t.Fatal(err)
+	}
+	if svc.fetches.Load() != 1 || svc.retries.Load() != 1 || svc.deployments.Load() != 1 {
+		t.Fatalf("missing RPC calls fetch=%d retry=%d deploy=%d", svc.fetches.Load(), svc.retries.Load(), svc.deployments.Load())
+	}
+}
