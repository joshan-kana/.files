diff --git a/cmd/watch_panels.go b/cmd/watch_panels.go
new file mode 100644
index 0000000..92d3515
--- /dev/null
+++ b/cmd/watch_panels.go
@@ -0,0 +1,312 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"os/exec"
+	"regexp"
+	"runtime"
+	"sort"
+	"strings"
+	"time"
+
+	lipgloss "charm.land/lipgloss/v2"
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/nlewo/comin/pkg/protobuf"
+)
+
+// The log panel keeps a bounded, chronological window, including the recent
+// system service log and live events from Comin's existing gRPC stream.
+type logEntry struct {
+	when    string
+	stage   string
+	level   string
+	message string
+}
+
+const maxWatchLogs = 400
+
+var logrusLine = regexp.MustCompile(`time="([^"]+)" level=([a-z]+) msg="(.*)"`)
+
+func normalizeLogMessage(msg string) string {
+	msg = ansi.Strip(msg)
+	parts := strings.Split(msg, "\r")
+	msg = strings.TrimSpace(parts[len(parts)-1])
+	return strings.ReplaceAll(msg, "\t", "  ")
+}
+
+func appendLog(lines []logEntry, line logEntry) []logEntry {
+	if line.message == "" {
+		return lines
+	}
+	lines = append(lines, line)
+	if len(lines) > maxWatchLogs {
+		return lines[len(lines)-maxWatchLogs:]
+	}
+	return lines
+}
+
+func appendBounded(old, live []logEntry) []logEntry {
+	lines := append(old, live...)
+	if len(lines) > maxWatchLogs {
+		return lines[len(lines)-maxWatchLogs:]
+	}
+	return lines
+}
+
+func logEntryFromStream(event *protobuf.Event, line *protobuf.Event_Log_Line) logEntry {
+	when := time.Now().Format("15:04:05")
+	if event.CreatedAt != nil {
+		when = event.CreatedAt.AsTime().Local().Format("15:04:05")
+	}
+	level := "info"
+	if line.Source == "stderr" {
+		level = "stderr"
+	}
+	msg := normalizeLogMessage(line.Msg)
+	if strings.Contains(strings.ToLower(msg), "error") || strings.Contains(strings.ToLower(msg), "failed") {
+		level = "error"
+	}
+	return logEntry{when, event.GetLog().ObjectType, level, msg}
+}
+
+// A service log is also useful after a deployment: the gRPC event stream
+// cannot replay output emitted before the watcher connected.
+func readServiceLogs() tea.Msg {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var command *exec.Cmd
+	if runtime.GOOS == "darwin" {
+		command = exec.CommandContext(ctx, "/usr/bin/tail", "-n", "300", "/var/log/comin.log")
+	} else {
+		command = exec.CommandContext(ctx, "journalctl", "-u", "comin.service", "-n", "300", "--no-pager", "-o", "short-iso")
+	}
+	output, err := command.Output()
+	if err != nil {
+		return loadedLogs{err: err}
+	}
+	result := make([]logEntry, 0, 300)
+	for _, raw := range strings.Split(string(output), "\n") {
+		line := normalizeLogMessage(raw)
+		if line == "" {
+			continue
+		}
+		result = appendLog(result, parseServiceLog(line))
+	}
+	return loadedLogs{logs: result}
+}
+
+func parseServiceLog(line string) logEntry {
+	entry := logEntry{stage: "service", level: "info", message: line}
+	if m := logrusLine.FindStringSubmatch(line); m != nil {
+		if stamp, err := time.Parse(time.RFC3339, m[1]); err == nil {
+			entry.when = stamp.Format("15:04:05")
+		}
+		entry.level = m[2]
+		entry.message = strings.ReplaceAll(m[3], `\"`, `"`)
+		switch {
+		case strings.HasPrefix(entry.message, "builder:"), strings.HasPrefix(entry.message, "nix: running 'nix"):
+			entry.stage = "build"
+		case strings.HasPrefix(entry.message, "deployer:"), strings.Contains(entry.message, "activating"):
+			entry.stage = "deploy"
+		case strings.HasPrefix(entry.message, "fetcher:"), strings.HasPrefix(entry.message, "repository:"):
+			entry.stage = "fetch"
+		}
+	} else {
+		if len(line) >= 19 && line[4] == '-' && line[10] == 'T' {
+			entry.when = line[11:19]
+		}
+		lower := strings.ToLower(line)
+		if strings.Contains(lower, "error") || strings.Contains(lower, "failed") {
+			entry.level = "error"
+		}
+		if strings.Contains(lower, "warning") {
+			entry.level = "warn"
+		}
+		if strings.Contains(lower, "building '") {
+			entry.stage = "build"
+		}
+		if strings.Contains(lower, "setting up ") {
+			entry.stage = "deploy"
+		}
+	}
+	entry.message = normalizeLogMessage(entry.message)
+	return entry
+}
+
+func (m Model) logRows() int {
+	if m.height <= 0 {
+		return 18
+	}
+	return max(6, m.height-8)
+}
+
+func adjustOffset(offset int, key string, count int, rows int) int {
+	switch key {
+	case "j", "down":
+		offset--
+	case "k", "up":
+		offset++
+	case "pgup":
+		offset += rows
+	case "pgdown":
+		offset -= rows
+	case "home":
+		offset = count
+	case "end":
+		offset = 0
+	}
+	return min(max(0, offset), max(0, count-rows))
+}
+
+func adjustHistoryOffset(offset int, key string, count int, rows int) int {
+	switch key {
+	case "j", "down":
+		offset++
+	case "k", "up":
+		offset--
+	case "pgup":
+		offset -= rows
+	case "pgdown":
+		offset += rows
+	case "home":
+		offset = 0
+	case "end":
+		offset = count
+	}
+	return min(max(0, offset), max(0, count-rows))
+}
+
+func upsertDeployment(items []*protobuf.Deployment, item *protobuf.Deployment) []*protobuf.Deployment {
+	if item == nil || item.Uuid == "" {
+		return items
+	}
+	for i, old := range items {
+		if old != nil && old.Uuid == item.Uuid {
+			items[i] = item
+			return items
+		}
+	}
+	items = append(items, item)
+	if len(items) > 100 {
+		items = items[len(items)-100:]
+	}
+	return items
+}
+
+func historyEntries(items []*protobuf.Deployment) []*protobuf.Deployment {
+	sorted := append([]*protobuf.Deployment(nil), items...)
+	sort.SliceStable(sorted, func(i, j int) bool {
+		if sorted[i] == nil {
+			return false
+		}
+		if sorted[j] == nil {
+			return true
+		}
+		if sorted[i].CreatedAt == nil {
+			return false
+		}
+		if sorted[j].CreatedAt == nil {
+			return true
+		}
+		return sorted[i].CreatedAt.AsTime().After(sorted[j].CreatedAt.AsTime())
+	})
+	entries := make([]*protobuf.Deployment, 0, len(sorted))
+	for _, d := range sorted {
+		if d == nil || d.Generation == nil || d.Generation.Source == nil || d.Generation.Source.GetGit() == nil || d.Generation.Source.GetGit().SelectedCommitId == "" {
+			continue
+		}
+		entries = append(entries, d)
+	}
+	return entries
+}
+
+func (m Model) logsView() string {
+	var b strings.Builder
+	b.WriteString(lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color("6")).Render("COMIN · LOGS"))
+	b.WriteString(fmt.Sprintf("    %d recent lines", len(m.logs)))
+	if m.manager.ConnectionMsg != "" {
+		b.WriteString("    reconnecting…")
+	}
+	b.WriteString("\n")
+	b.WriteString(lipgloss.NewStyle().Foreground(lipgloss.Color("8")).Render("  Latest service output + live build/deploy logs"))
+	b.WriteString("\n\n")
+	rows := m.logRows()
+	start := max(0, len(m.logs)-rows-m.logOffset)
+	end := min(len(m.logs), start+rows)
+	width := m.width
+	if width < 30 {
+		width = 30
+	}
+	for _, line := range m.logs[start:end] {
+		stage := strings.ToUpper(line.stage)
+		if len(stage) > 7 {
+			stage = stage[:7]
+		}
+		stage = fmt.Sprintf("%-7s", stage)
+		detail := line.message
+		if detail == "" {
+			continue
+		}
+		detail = ansi.Truncate(detail, max(8, width-23), "…")
+		messageStyle := lipgloss.NewStyle()
+		switch line.level {
+		case "error", "fatal":
+			messageStyle = messageStyle.Foreground(lipgloss.Color("1"))
+		case "warn", "warning", "stderr":
+			messageStyle = messageStyle.Foreground(lipgloss.Color("3"))
+		}
+		b.WriteString(lipgloss.NewStyle().Foreground(lipgloss.Color("8")).Render(fmt.Sprintf("  %-8s", line.when)))
+		b.WriteString(lipgloss.NewStyle().Foreground(lipgloss.Color("6")).Render(stage + " "))
+		b.WriteString(messageStyle.Render(detail) + "\n")
+	}
+	if len(m.logs) == 0 {
+		b.WriteString("  No output yet. New output will appear here.\n")
+	}
+	if m.logOffset > 0 {
+		b.WriteString(fmt.Sprintf("\n  %d older lines above the live tail\n", m.logOffset))
+	}
+	b.WriteString("\n  j/k scroll · PgUp/PgDn · Home/End · l/Esc close")
+	return b.String()
+}
+
+func (m Model) historyView() string {
+	var b strings.Builder
+	b.WriteString(lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color("6")).Render("COMIN · DEPLOYMENT HISTORY"))
+	b.WriteString("\n")
+	entries := historyEntries(m.history)
+	rows := m.logRows()
+	start := min(m.historyOffset, max(0, len(entries)-rows))
+	for _, d := range entries[start:min(len(entries), start+rows)] {
+		git := d.Generation.Source.GetGit()
+		status := d.Status
+		statusStyle := lipgloss.NewStyle().Foreground(lipgloss.Color("2"))
+		if status == "failed" {
+			statusStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("1"))
+		}
+		if status == "running" {
+			statusStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("6"))
+		}
+		when := ""
+		if d.CreatedAt != nil {
+			when = d.CreatedAt.AsTime().Local().Format("Jan 02 15:04")
+		}
+		id := git.SelectedCommitId
+		if len(id) > 8 {
+			id = id[:8]
+		}
+		title := strings.Split(strings.TrimSpace(git.SelectedCommitMsg), "\n")[0]
+		if len(title) > 50 {
+			title = title[:49] + "…"
+		}
+		b.WriteString("\n  " + lipgloss.NewStyle().Foreground(lipgloss.Color("8")).Render(when) + "  ")
+		b.WriteString(statusStyle.Render(fmt.Sprintf("%-8s", status)))
+		b.WriteString(fmt.Sprintf("  %-6s  %s  %s", d.Operation, id, title))
+	}
+	if len(entries) == 0 {
+		b.WriteString("\n  No recorded deployments yet.")
+	}
+	b.WriteString("\n\n  j/k scroll · PgUp/PgDn · g/Esc close")
+	return b.String()
+}
diff --git a/cmd/watch_panels_test.go b/cmd/watch_panels_test.go
new file mode 100644
index 0000000..7a0bcb4
--- /dev/null
+++ b/cmd/watch_panels_test.go
@@ -0,0 +1,119 @@
+package cmd
+
+import (
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/nlewo/comin/pkg/protobuf"
+	"strings"
+	"testing"
+)
+
+func TestWatchLogFormatting(t *testing.T) {
+	entry := parseServiceLog(`time="2026-11-17T10:20:03+08:00" level=error msg="nix: build failed"`)
+	if entry.when != "10:20:03" || entry.level != "error" || entry.message != "nix: build failed" {
+		t.Fatalf("log format unexpected: %#v", entry)
+	}
+	if got := normalizeLogMessage("\x1b[31mproblem\x1b[0m\roverride"); got != "override" {
+		t.Fatalf("terminal control bytes not removed: %q", got)
+	}
+}
+
+func TestWatchLogWindowAndScrolling(t *testing.T) {
+	var logs []logEntry
+	for i := 0; i < maxWatchLogs+30; i++ {
+		logs = appendLog(logs, logEntry{message: "line"})
+	}
+	if len(logs) != maxWatchLogs {
+		t.Fatalf("unbounded log buffer: %d", len(logs))
+	}
+	if got := adjustOffset(0, "k", maxWatchLogs, 10); got != 1 {
+		t.Fatalf("scrolling up expected 1 got %d", got)
+	}
+	if got := adjustOffset(1, "end", maxWatchLogs, 10); got != 0 {
+		t.Fatalf("end expected tail got %d", got)
+	}
+	view := (Model{logs: logs, width: 85, height: 25, panel: "logs"}).logsView()
+	if !strings.Contains(view, "COMIN · LOGS") {
+		t.Fatal("logs panel heading missing")
+	}
+}
+
+func TestWatchHistoryScroll(t *testing.T) {
+	if got := adjustHistoryOffset(0, "j", 40, 10); got != 1 {
+		t.Fatalf("history j should move down: %d", got)
+	}
