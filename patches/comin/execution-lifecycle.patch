+// RetryBuild immediately retries the current failed build, cancelling a scheduled retry.
+func (b *Builder) RetryBuild(ctx context.Context) error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.isSuspended {
+		return fmt.Errorf("builder is suspended")
+	}
+	if b.isEvaluating.Load() || b.isBuilding.Load() {
+		return fmt.Errorf("builder is busy")
+	}
+	if b.GenerationUuid == "" {
+		return fmt.Errorf("no generation to retry")
+	}
+	generation, err := b.store.GenerationGet(b.GenerationUuid)
+	if err != nil {
+		return err
+	}
+	if generation.BuildStatus != store.BuildFailed.String() && generation.BuildStatus != store.BuildCanceled.String() {
+		return fmt.Errorf("current generation has no failed build")
+	}
+	b.cancelBuildRetryLocked()
+	return b.build(ctx, b.GenerationUuid)
+}
