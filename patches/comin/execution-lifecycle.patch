+func TestManualBuildRetry(t *testing.T) {
+	temp := t.TempDir()
+	bk := broker.New()
+	bk.Start()
+	storage, err := store.New(bk, temp+"/state.json", temp+"/gcroots", 1, 1, 1)
+	assert.NoError(t, err)
+	mock := NewExecutorMock(false)
+	builder := New(storage, mock, bk, "", "", "", "host", false, 5*time.Second, 120*time.Millisecond, 3, 30*time.Second, "")
+	generation := storage.NewGeneration("", "", "", &protobuf.GitRepositoryStatus{}, 3)
+	assert.NoError(t, builder.Eval(context.Background(), &generation))
+	mock.evalDone <- struct{}{}
+	uuid := <-builder.EvaluationDone
+	builder.SubmitBuild(context.Background(), uuid)
+	select {
+	case <-builder.BuildDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("failed build did not finish")
+	}
+	assert.Eventually(t, func() bool {
+		g, e := storage.GenerationGet(uuid)
+		return e == nil && g.BuildStatus == store.BuildFailed.String()
+	}, time.Second, 10*time.Millisecond)
+	builder.mu.Lock()
+	builder.isSuspended = true
+	builder.mu.Unlock()
+	assert.ErrorContains(t, builder.RetryBuild(context.Background()), "suspended")
+	builder.mu.Lock()
+	builder.isSuspended = false
+	builder.mu.Unlock()
+	assert.NoError(t, builder.RetryBuild(context.Background()))
+	mock.buildDone <- struct{}{}
+	select {
+	case <-builder.BuildDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("manual build did not finish")
+	}
+	assert.Eventually(t, func() bool {
+		g, e := storage.GenerationGet(uuid)
+		return e == nil && g.BuildStatus == store.Built.String() && g.AttemptNumber == 2
+	}, time.Second, 10*time.Millisecond)
+	builder.mu.Lock()
+	pendingRetry := builder.buildRetryAt
+	builder.mu.Unlock()
+	assert.Nil(t, pendingRetry)
+	assert.ErrorContains(t, builder.RetryBuild(context.Background()), "no failed build")
+}
