+func TestRelationshipActionsExposeAllApplicableOperations(t *testing.T) {
+	current := data.IssueRelationships{
+		Parent: &[]data.RelatedIssue{related("parent", "acme/app", 1, "Parent", "OPEN")}[0],
+		BlockedBy: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("blocked", "acme/app", 2, "Blocked", "OPEN")},
+		},
+		Blocking: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("blocking", "acme/app", 3, "Blocking", "CLOSED")},
+		},
+		SubIssues: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("child", "acme/app", 4, "Child", "OPEN")},
+		},
+	}
+
+	actions := relationshipActions(current)
+	mutations := make([]data.RelationshipMutation, 0, len(actions))
+	for _, item := range actions {
+		mutations = append(mutations, item.mutation)
+	}
+	require.ElementsMatch(t, []data.RelationshipMutation{
+		data.AddBlockedBy, data.AddBlocking, data.AddSubIssue, data.RemoveParent,
+		data.RemoveBlockedBy, data.RemoveBlocking, data.RemoveSubIssue,
+	}, mutations)
+	require.Equal(
+		t,
+		[]data.RelatedIssue{*current.Parent},
+		relationshipItems(current, data.RemoveParent),
+	)
+	require.Equal(t, current.BlockedBy.Nodes, relationshipItems(current, data.RemoveBlockedBy))
+	require.Equal(t, current.Blocking.Nodes, relationshipItems(current, data.RemoveBlocking))
+	require.Equal(t, current.SubIssues.Nodes, relationshipItems(current, data.RemoveSubIssue))
+}
