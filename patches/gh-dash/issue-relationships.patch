+func newIssueRelationshipsTestModel(t *testing.T) (Model, *issuessection.Model) {
+	t.Helper()
+	cfg, err := config.ParseConfig(config.Location{
+		ConfigFlag:       "../config/testdata/test-config.yml",
+		SkipGlobalConfig: true,
+	})
+	require.NoError(t, err)
+	cfg.Defaults.Preview.Open = true
+	cfg.Defaults.Preview.Position = "right"
+	cfg.Defaults.Preview.Width = 0.4
+
+	ctx := &context.ProgramContext{
+		Config:       &cfg,
+		View:         config.IssuesView,
+		ScreenWidth:  120,
+		ScreenHeight: 40,
+	}
+	ctx.Theme = theme.ParseTheme(ctx.Config)
+	ctx.Styles = context.InitStyles(ctx.Theme)
+
+	issueSection := issuessection.NewModel(
+		1,
+		ctx,
+		config.IssuesSectionConfig{},
+		time.Now(),
+		time.Now(),
+	)
+	issueSection.LastFetchTaskId = "task-1"
+	issueSection.Issues = []data.IssueData{
+		{
+			ID:         "issue-1",
+			Number:     1,
+			Title:      "Issue One",
+			Body:       "Issue body",
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+		{
+			ID:         "issue-2",
+			Number:     2,
+			Title:      "Issue Two",
+			Body:       "Second body",
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+	}
+	issueSection.Table.SetRows(issueSection.BuildRows())
+
+	dummySection := issuessection.NewModel(
+		0,
+		ctx,
+		config.IssuesSectionConfig{},
+		time.Now(),
+		time.Now(),
+	)
+	m := Model{
+		ctx:                           ctx,
+		keys:                          keys.Keys,
+		currSectionId:                 1,
+		issues:                        []section.Section{&dummySection, &issueSection},
+		sidebar:                       sidebar.NewModel(),
+		footer:                        footer.NewModel(ctx),
+		tabs:                          tabs.NewModel(ctx),
+		prView:                        prview.NewModel(ctx),
+		issueSidebar:                  issueview.NewModel(ctx),
+		branchSidebar:                 branchsidebar.NewModel(ctx),
+		notificationView:              notificationview.NewModel(ctx),
+		relationshipPreviewGeneration: 1,
+	}
+	m.sidebar.IsOpen = true
+	m.syncMainContentDimensions()
+	m.syncProgramContext()
+	return m, &issueSection
+}
