new file mode 100644
index 0000000..c642b3b
--- /dev/null
+++ b/internal/data/relationships.go
@@ -0,0 +1,34 @@
+package data
+
+import "fmt"
+
+// RelationshipIndicators returns a compact, stable list for issue rows. The
+// symbols are intentionally unobtrusive and do not imply workflow state.
+func (r IssueRelationships) Indicators() string {
+	indicators := ""
+	if r.Parent != nil {
+		indicators += "↳"
+	}
+	if r.SubIssues.TotalCount > 0 {
+		indicators += "⊞"
+	}
+	if r.BlockedBy.TotalCount > 0 {
+		indicators += "⇠"
+	}
+	if r.Blocking.TotalCount > 0 {
+		indicators += "⇢"
+	}
+	return indicators
+}
+
+func (r RelatedIssue) Identifier() string {
+	return fmt.Sprintf("%s#%d", r.Repository.NameWithOwner, r.Number)
+}
+
+func (r RelatedIssue) Summary() string {
+	state := "open"
+	if r.State == "CLOSED" {
+		state = "closed"
+	}
+	return fmt.Sprintf("%s %s — %s", r.Identifier(), r.Title, state)
+}
diff --git a/internal/data/relationships_test.go b/internal/data/relationships_test.go
new file mode 100644
index 0000000..f623501
--- /dev/null
+++ b/internal/data/relationships_test.go
@@ -0,0 +1,22 @@
+package data
+
+import "testing"
+
+func TestRelationshipIndicators(t *testing.T) {
+	r := IssueRelationships{
+		Parent:     &RelatedIssue{Number: 1},
+		SubIssues:  RelatedIssueConnection{TotalCount: 2},
+		BlockedBy:  RelatedIssueConnection{TotalCount: 1},
+		Blocking:   RelatedIssueConnection{TotalCount: 3},
+	}
+	if got, want := r.Indicators(), "↳⊞⇠⇢"; got != want {
+		t.Fatalf("Indicators() = %q, want %q", got, want)
+	}
+}
+
+func TestRelatedIssueSummaryIncludesRepositoryAndState(t *testing.T) {
+	r := RelatedIssue{Number: 7, Title: "Planning", State: "CLOSED", Repository: Repository{NameWithOwner: "org/repo"}}
+	if got, want := r.Summary(), "org/repo#7 Planning — closed"; got != want {
+		t.Fatalf("Summary() = %q, want %q", got, want)
+	}
+}
