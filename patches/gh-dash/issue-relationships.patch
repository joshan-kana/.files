+func TestIssueRelationshipsLifecycleTransitions(t *testing.T) {
+	m, issueSection := newIssueRelationshipsTestModel(t)
+	m.issueSidebar.SetRow(&issueSection.Issues[0])
+	m.issueSidebar.SetRelationshipPreviewLoading()
+
+	// 1. Initial pending state
+	require.Contains(t, m.issueSidebar.View(), "Relationships")
+	require.Contains(t, m.issueSidebar.View(), "Loading…")
+
+	// 2. Successful non-empty response
+	relNonEmpty := data.IssueRelationships{
+		Parent: &data.RelatedIssue{
+			Title:      "Epic Parent",
+			Number:     100,
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+		BlockedBy: data.RelatedIssueConnection{
+			TotalCount: 1,
+			Nodes: []data.RelatedIssue{
+				{
+					Title:      "Blocker",
+					Number:     101,
+					Repository: data.Repository{NameWithOwner: "owner/repo"},
+				},
+			},
+		},
+	}
+	updatedModel, _ := m.Update(issueRelationshipsMsg{
+		ContentID:     "issue-1",
+		Generation:    1,
+		Relationships: relNonEmpty,
+	})
+	m = updatedModel.(Model)
+	view := m.issueSidebar.View()
+	require.Contains(t, view, "Relationships")
+	require.NotContains(t, view, "Loading…")
+	require.Contains(t, view, "Epic Parent")
+	require.Contains(t, view, "Blocker")
+
+	// 3. Successful empty response
+	m.relationshipPreviewGeneration = 2
+	m.issueSidebar.SetRelationshipPreviewLoading()
+	require.Contains(t, m.issueSidebar.View(), "Loading…")
+
+	updatedModel, _ = m.Update(issueRelationshipsMsg{
+		ContentID:     "issue-1",
+		Generation:    2,
+		Relationships: data.IssueRelationships{},
+	})
+	m = updatedModel.(Model)
+	view = m.issueSidebar.View()
+	require.NotContains(t, view, "Relationships")
+	require.NotContains(t, view, "Loading…")
+	require.Contains(t, view, "Issue One")
+
+	// 4. Error response
+	m.relationshipPreviewGeneration = 3
+	m.issueSidebar.SetRelationshipPreviewLoading()
+	require.Contains(t, m.issueSidebar.View(), "Loading…")
+
+	updatedModel, _ = m.Update(issueRelationshipsMsg{
+		ContentID:  "issue-1",
+		Generation: 3,
+		Err:        errors.New("API unavailable"),
+	})
+	m = updatedModel.(Model)
+	view = m.issueSidebar.View()
+	require.Contains(t, view, "Relationships")
+	require.NotContains(t, view, "Loading…")
+	require.Contains(t, view, "Unavailable")
+	require.Contains(t, view, "Issue One")
+	require.Contains(t, view, "Issue")
+}
+
+func TestIssueRelationshipsStaleResponsesDoNotOverwriteCurrentSelection(t *testing.T) {
+	m, issueSection := newIssueRelationshipsTestModel(t)
+
+	// Issue 1 selected with Generation 1
+	m.issueSidebar.SetRow(&issueSection.Issues[0])
+	m.issueSidebar.SetRelationshipPreviewLoading()
+
+	// Switch quickly to Issue 2 with Generation 2
+	issueSection.NextRow()
+	m.relationshipPreviewGeneration = 2
+	m.issueSidebar.SetRow(&issueSection.Issues[1])
+	m.issueSidebar.SetRelationshipPreviewLoading()
+
+	// Late response for Issue 1 arrives with Generation 1
+	staleMsg := issueRelationshipsMsg{
+		ContentID:  "issue-1",
+		Generation: 1,
+		Relationships: data.IssueRelationships{
+			Parent: &data.RelatedIssue{
+				Title:      "Parent of One",
+				Number:     99,
+				Repository: data.Repository{NameWithOwner: "owner/repo"},
+			},
+		},
+	}
+	updatedModel, _ := m.Update(staleMsg)
+	m = updatedModel.(Model)
+
+	// Issue 2 must remain in loading state, and Issue 1's relationships must NOT appear
+	view := m.issueSidebar.View()
+	require.Contains(t, view, "Issue Two")
+	require.NotContains(t, view, "Issue One")
+	require.Contains(t, view, "Relationships")
+	require.Contains(t, view, "Loading…")
+	require.NotContains(t, view, "Parent of One")
+
+	// Late error response for Issue 1 arrives
+	staleErrMsg := issueRelationshipsMsg{
+		ContentID:  "issue-1",
+		Generation: 1,
+		Err:        errors.New("error for One"),
+	}
+	updatedModel, _ = m.Update(staleErrMsg)
+	m = updatedModel.(Model)
+
+	// Issue 2 must still remain in loading state, not error state
+	view = m.issueSidebar.View()
+	require.Contains(t, view, "Issue Two")
+	require.Contains(t, view, "Loading…")
+	require.NotContains(t, view, "Unavailable")
+}
