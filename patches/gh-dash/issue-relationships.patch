diff --git a/internal/tui/components/relationshipeditor/editor.go b/internal/tui/components/relationshipeditor/editor.go
new file mode 100644
index 0000000000000000000000000000000000000000..46049c760664442d6485b062fd69de4d2b40f989
--- /dev/null
+++ b/internal/tui/components/relationshipeditor/editor.go
@@ -0,0 +1,522 @@
+package relationshipeditor
+
+import (
+	"strings"
+	"sync/atomic"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/sahilm/fuzzy"
+
+	"charm.land/bubbles/v2/textinput"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/inputbox"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+)
+
+type mode uint8
+
+const (
+	modeActions mode = iota
+	modeLoadingRelationships
+	modeRelationships
+	modeLoadingCandidates
+	modeCandidates
+	modeApplying
+)
+
+type action struct {
+	label    string
+	mutation data.RelationshipMutation
+}
+
+type RelationshipUpdatedMsg struct {
+	SessionID     uint64
+	IssueID       string
+	Relationships data.IssueRelationships
+	Err           error
+}
+
+type candidatesFetchedMsg struct {
+	SessionID  uint64
+	Query      string
+	Version    uint64
+	Candidates []data.RelatedIssue
+	Err        error
+}
+
+type candidateSearchMsg struct {
+	SessionID uint64
+	Query     string
+	Version   uint64
+}
+
+type relationshipsFetchedMsg struct {
+	SessionID     uint64
+	Relationships data.IssueRelationships
+	Err           error
+}
+
+var relationshipEditorSession uint64
+
+type Model struct {
+	ctx           *context.ProgramContext
+	issueID       string
+	current       data.IssueRelationships
+	actions       []action
+	selected      int
+	removeItems   []data.RelatedIssue
+	candidates    []data.RelatedIssue
+	filtered      []data.RelatedIssue
+	query         inputbox.Model
+	selectedRel   int
+	pending       data.RelationshipMutation
+	mode          mode
+	status        string
+	width         int
+	active        bool
+	initialized   bool
+	sessionID     uint64
+	searchVersion uint64
+	filterMode    bool
+}
+
+func New(ctx *context.ProgramContext, issue data.IssueData) Model {
+	input := inputbox.NewModel(ctx, inputbox.ModelOpts{TextInput: func() *textinput.Model {
+		ti := inputbox.DefaultTextInput(ctx)
+		return &ti
+	}()})
+	return Model{
+		ctx: ctx, issueID: issue.ID, current: issue.NativeRelationships(),
+		actions: relationshipActions(issue.NativeRelationships()), query: input,
+		mode: modeActions, active: true, initialized: true,
+		sessionID: atomic.AddUint64(&relationshipEditorSession, 1),
+	}
+}
+
+func (m Model) Active() bool { return m.active }
+
+func (m Model) SessionID() uint64 { return m.sessionID }
+
+func (m *Model) Refresh() tea.Cmd {
+	if !m.active || m.issueID == "" {
+		return nil
+	}
+	m.mode = modeLoadingRelationships
+	m.status = ""
+	return fetchRelationships(m.sessionID, m.issueID)
+}
+
+func (m *Model) Close() {
+	m.active = false
+	if m.initialized {
+		m.query.Blur()
+	}
+}
+
+func (m *Model) SetWidth(width int) {
+	m.width = width
+	if m.initialized {
+		m.query.SetWidth(width)
+	}
+}
+
+func (m *Model) UpdateProgramContext(ctx *context.ProgramContext) {
+	m.ctx = ctx
+	if m.initialized {
+		m.query.UpdateProgramContext(ctx)
+	}
+}
+
+func (m Model) Update(msg tea.Msg) (Model, tea.Cmd) {
+	switch msg := msg.(type) {
+	case relationshipsFetchedMsg:
+		if m.mode != modeLoadingRelationships || msg.SessionID != m.sessionID {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.pending = ""
+			m.removeItems = nil
+			m.status, m.mode = msg.Err.Error(), modeActions
+			return m, nil
+		}
+		m.current = msg.Relationships
+		m.actions = relationshipActions(msg.Relationships)
+		m.selected = 0
+		m.status = ""
+		m.selectedRel = 0
+		if isRemoval(m.pending) {
+			m.removeItems = relationshipItems(msg.Relationships, m.pending)
+			if len(m.removeItems) == 0 {
+				m.pending = ""
+				m.mode = modeActions
+				m.status = "No live relationship is available"
+				return m, nil
+			}
+			m.mode = modeRelationships
+		} else {
+			m.removeItems = nil
+			m.mode = modeActions
+		}
+		return m, nil
+	case candidatesFetchedMsg:
+		if (m.mode != modeLoadingCandidates && m.mode != modeCandidates) ||
+			msg.SessionID != m.sessionID || msg.Version != m.searchVersion ||
+			msg.Query != strings.TrimSpace(m.query.Value()) {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.status, m.mode = msg.Err.Error(), modeActions
+			return m, nil
+		}
+		m.candidates, m.mode, m.status = msg.Candidates, modeCandidates, ""
+		m.filterCandidates()
+		return m, nil
+	case candidateSearchMsg:
+		if m.mode != modeCandidates || msg.SessionID != m.sessionID ||
+			msg.Version != m.searchVersion || msg.Query != strings.TrimSpace(m.query.Value()) {
+			return m, nil
+		}
+		return m, fetchCandidates(m.sessionID, msg.Version, msg.Query)
+	case RelationshipUpdatedMsg:
+		if msg.SessionID != m.sessionID || msg.IssueID != m.issueID {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.status, m.mode = msg.Err.Error(), modeActions
+			return m, nil
+		}
+		m.Close()
+		return m, nil
+	case tea.KeyMsg:
+		if m.mode == modeCandidates {
+			return m.updateCandidates(msg)
+		}
+		if m.mode == modeApplying {
+			return m, nil
+		}
+		switch msg.String() {
+		case "esc":
+			if m.mode == modeRelationships {
+				m.mode = modeActions
+				m.removeItems = nil
+				m.selectedRel = 0
+				m.pending = ""
+				return m, nil
+			}
+			m.Close()
+			return m, nil
+		case "q":
+			m.Close()
+			return m, nil
+		case "up", "k":
+			m.move(-1)
+		case "down", "j":
+			m.move(1)
+		case "enter":
+			switch m.mode {
+			case modeActions:
+				if len(m.actions) == 0 {
+					m.status = "No editable relationships are available"
+					return m, nil
+				}
+				selected := m.actions[m.selected]
+				m.pending = selected.mutation
+				if isRemoval(selected.mutation) {
+					m.mode = modeLoadingRelationships
+					return m, fetchRelationships(m.sessionID, m.issueID)
+				}
+				m.mode = modeLoadingCandidates
+				m.filterMode = false
+				m.query.Blur()
+				return m, fetchCandidates(m.sessionID, m.searchVersion, m.query.Value())
+			case modeRelationships:
+				if len(m.removeItems) == 0 {
+					m.status = "No live relationship is available"
+					return m, nil
+				}
+				target := m.removeItems[m.selectedRel]
+				m.mode = modeApplying
+				return m, applyMutation(m.sessionID, m.issueID, target.ID, m.pending)
+			}
+		}
+	}
+	return m, nil
+}
+
+func (m *Model) updateCandidates(msg tea.KeyMsg) (Model, tea.Cmd) {
+	if m.filterMode {
+		switch msg.String() {
+		case "esc":
+			m.filterMode = false
+			m.query.Blur()
+			return *m, nil
+		case "ctrl+c":
+			m.Close()
+			return *m, nil
+		case "up":
+			m.move(-1)
+			return *m, nil
+		case "down":
+			m.move(1)
+			return *m, nil
+		case "enter":
+			return m.selectCandidate()
+		}
+		return m.updateCandidateFilter(msg)
+	}
+	switch msg.String() {
+	case "esc":
+		m.mode, m.status = modeActions, ""
+		m.query.SetValue("")
+		m.query.Blur()
+		return *m, nil
+	case "/":
+		m.filterMode = true
+		return *m, m.query.Focus()
+	case "up", "k":
+		m.move(-1)
+		return *m, nil
+	case "down", "j":
+		m.move(1)
+		return *m, nil
+	case "enter":
+		return m.selectCandidate()
+	}
+	if msg.String() == "q" {
+		m.Close()
+		return *m, nil
+	}
+	return *m, nil
+}
+
+func (m *Model) updateCandidateFilter(msg tea.KeyMsg) (Model, tea.Cmd) {
+	var cmd tea.Cmd
+	m.query, cmd = m.query.Update(msg)
+	m.filterCandidates()
+	m.searchVersion++
+	version := m.searchVersion
+	query := strings.TrimSpace(m.query.Value())
+	searchCmd := tea.Tick(200*time.Millisecond, func(time.Time) tea.Msg {
+		return candidateSearchMsg{SessionID: m.sessionID, Query: query, Version: version}
+	})
+	return *m, tea.Batch(cmd, searchCmd)
+}
+
+func (m *Model) selectCandidate() (Model, tea.Cmd) {
+	if len(m.filtered) == 0 {
+		m.status = "No matching accessible issues"
+		return *m, nil
+	}
+	target := m.filtered[m.selectedRel]
+	m.mode = modeApplying
+	m.filterMode = false
+	m.query.Blur()
+	return *m, applyMutation(m.sessionID, m.issueID, target.ID, m.pending)
+}
+
+func (m *Model) filterCandidates() {
+	query := strings.TrimSpace(m.query.Value())
+	available := make([]data.RelatedIssue, 0, len(m.candidates))
+	for _, candidate := range m.candidates {
+		if candidate.ID == m.issueID || relationshipExists(m.current, candidate.ID, m.pending) {
+			continue
+		}
+		available = append(available, candidate)
+	}
+	if query == "" {
+		m.filtered = available
+		m.selectedRel = 0
+		return
+	}
+	values := make([]string, len(available))
+	for i, candidate := range available {
+		values[i] = candidate.Summary()
+	}
+	matches := fuzzy.Find(query, values)
+	m.filtered = make([]data.RelatedIssue, 0, len(matches))
+	for _, match := range matches {
+		filtered := available[match.Index]
+		m.filtered = append(m.filtered, filtered)
+	}
+	if m.selectedRel >= len(m.filtered) {
+		m.selectedRel = 0
+	}
+}
+
+func (m *Model) move(delta int) {
+	length := len(m.actions)
+	if m.mode == modeRelationships {
+		length = len(m.removeItems)
+	}
+	if m.mode == modeCandidates {
+		length = len(m.filtered)
+	}
+	if length == 0 {
+		return
+	}
+	if m.mode == modeCandidates || m.mode == modeRelationships {
+		m.selectedRel = (m.selectedRel + delta + length) % length
+	} else {
+		m.selected = (m.selected + delta + length) % length
+	}
+}
+
+func (m Model) View() string {
+	if !m.active {
+		return ""
+	}
+	lines := []string{"Edit relationships"}
+	switch m.mode {
+	case modeActions:
+		for i, item := range m.actions {
+			prefix := "  "
+			if i == m.selected {
+				prefix = "› "
+			}
+			lines = append(lines, prefix+item.label)
+		}
+	case modeRelationships:
+		lines = append(lines, "Select a live relationship to remove")
+		for i, item := range m.removeItems {
+			prefix := "  "
+			if i == m.selectedRel {
+				prefix = "› "
+			}
+			lines = append(lines, prefix+item.Summary())
+		}
+	case modeCandidates:
+		lines = append(lines, "Search accessible issues: "+m.query.View())
+		for i, item := range m.filtered {
+			prefix := "  "
+			if i == m.selectedRel {
+				prefix = "› "
+			}
+			lines = append(lines, prefix+item.Summary())
+		}
+	case modeLoadingRelationships, modeLoadingCandidates, modeApplying:
+		lines = append(lines, "Working…")
+	}
+	if m.status != "" {
+		lines = append(lines, m.status)
+	}
+	if m.mode == modeCandidates {
+		if m.filterMode {
+			lines = append(lines, "type to filter · ↑/↓ select · Enter choose · Esc stop filtering")
+		} else {
+			lines = append(lines, "j/k/↑/↓ select · / filter · Enter choose · Esc back")
+		}
+	} else {
+		lines = append(lines, "j/k/↑/↓ select · Enter choose · Esc back")
+	}
+	return lipgloss.NewStyle().Foreground(m.ctx.Theme.FaintText).Render(strings.Join(lines, "\n"))
+}
+
+func relationshipActions(r data.IssueRelationships) []action {
+	items := []action{
+		{"Add blocked by", data.AddBlockedBy},
+		{"Add blocking", data.AddBlocking},
+		{"Add sub-issue", data.AddSubIssue},
+	}
+	if r.Parent == nil {
+		items = append(items, action{"Set parent", data.SetParent})
+	} else {
+		items = append(items, action{"Remove parent", data.RemoveParent})
+	}
+	if len(r.BlockedBy.Nodes) > 0 {
+		items = append(items, action{"Remove blocked by", data.RemoveBlockedBy})
+	}
+	if len(r.Blocking.Nodes) > 0 {
+		items = append(items, action{"Remove blocking", data.RemoveBlocking})
+	}
+	if len(r.SubIssues.Nodes) > 0 {
+		items = append(items, action{"Remove sub-issue", data.RemoveSubIssue})
+	}
+	return items
+}
+
+func relationshipItems(
+	r data.IssueRelationships,
+	mutation data.RelationshipMutation,
+) []data.RelatedIssue {
+	switch mutation {
+	case data.RemoveParent:
+		if r.Parent != nil {
+			return []data.RelatedIssue{*r.Parent}
+		}
+	case data.RemoveBlockedBy:
+		return r.BlockedBy.Nodes
+	case data.RemoveBlocking:
+		return r.Blocking.Nodes
+	case data.RemoveSubIssue:
+		return r.SubIssues.Nodes
+	}
+	return nil
+}
+
+func relationshipExists(
+	r data.IssueRelationships,
+	id string,
+	mutation data.RelationshipMutation,
+) bool {
+	switch mutation {
+	case data.AddBlockedBy:
+		for _, item := range r.BlockedBy.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	case data.AddBlocking:
+		for _, item := range r.Blocking.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	case data.AddSubIssue:
+		for _, item := range r.SubIssues.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isRemoval(m data.RelationshipMutation) bool { return strings.HasPrefix(string(m), "remove-") }
+func fetchRelationships(sessionID uint64, id string) tea.Cmd {
+	return func() tea.Msg {
+		r, err := data.FetchIssueRelationships(id)
+		return relationshipsFetchedMsg{SessionID: sessionID, Relationships: r, Err: err}
+	}
+}
+
+func fetchCandidates(sessionID, version uint64, query string) tea.Cmd {
+	return func() tea.Msg {
+		query = strings.TrimSpace(query)
+		c, err := data.FetchRelationshipCandidates(query, 50)
+		return candidatesFetchedMsg{
+			SessionID:  sessionID,
+			Query:      query,
+			Version:    version,
+			Candidates: c,
+			Err:        err,
+		}
+	}
+}
+
+func applyMutation(
+	sessionID uint64,
+	issueID, targetID string,
+	mutation data.RelationshipMutation,
+) tea.Cmd {
+	return func() tea.Msg {
+		r, err := data.MutateIssueRelationship(issueID, targetID, mutation)
+		return RelationshipUpdatedMsg{
+			SessionID:     sessionID,
+			IssueID:       issueID,
+			Relationships: r,
+			Err:           err,
+		}
+	}
+}
