+package relationshipeditor
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+)
+
+func related(id, repo string, number int, title, state string) data.RelatedIssue {
+	return data.RelatedIssue{
+		ID: id, Number: number, Title: title, State: state,
+		Repository: data.Repository{NameWithOwner: repo},
+	}
+}
+
+func TestRelationshipActionsExposeAllApplicableOperations(t *testing.T) {
+	current := data.IssueRelationships{
+		Parent: &[]data.RelatedIssue{related("parent", "acme/app", 1, "Parent", "OPEN")}[0],
+		BlockedBy: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("blocked", "acme/app", 2, "Blocked", "OPEN")},
+		},
+		Blocking: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("blocking", "acme/app", 3, "Blocking", "CLOSED")},
+		},
+		SubIssues: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("child", "acme/app", 4, "Child", "OPEN")},
+		},
+	}
+
+	actions := relationshipActions(current)
+	mutations := make([]data.RelationshipMutation, 0, len(actions))
+	for _, item := range actions {
+		mutations = append(mutations, item.mutation)
+	}
+	require.ElementsMatch(t, []data.RelationshipMutation{
+		data.AddBlockedBy, data.AddBlocking, data.AddSubIssue, data.RemoveParent,
+		data.RemoveBlockedBy, data.RemoveBlocking, data.RemoveSubIssue,
+	}, mutations)
+	require.Equal(
+		t,
+		[]data.RelatedIssue{*current.Parent},
+		relationshipItems(current, data.RemoveParent),
+	)
+	require.Equal(t, current.BlockedBy.Nodes, relationshipItems(current, data.RemoveBlockedBy))
+	require.Equal(t, current.Blocking.Nodes, relationshipItems(current, data.RemoveBlocking))
+	require.Equal(t, current.SubIssues.Nodes, relationshipItems(current, data.RemoveSubIssue))
+}
+
+func TestRelationshipActionsOfferSetParentWhenAbsent(t *testing.T) {
+	actions := relationshipActions(data.IssueRelationships{})
+	require.Contains(t, mutationsOf(actions), data.SetParent)
+	require.NotContains(t, mutationsOf(actions), data.RemoveParent)
+}
+
+func TestFilterCandidatesIsFuzzyAndDoesNotMutateFetchedCandidates(t *testing.T) {
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "self"})
+	m.pending = data.AddBlockedBy
+	m.current = data.IssueRelationships{
+		BlockedBy: data.RelatedIssueConnection{
+			Nodes: []data.RelatedIssue{related("existing", "acme/app", 2, "Fix cache", "OPEN")},
+		},
+	}
+	m.candidates = []data.RelatedIssue{
+		related("self", "acme/app", 1, "Current issue", "OPEN"),
+		related("existing", "acme/app", 2, "Fix cache", "OPEN"),
+		related("candidate", "octo/tools", 42, "Cache cleanup", "CLOSED"),
+	}
+	m.query.SetValue("cache")
+	m.filterCandidates()
+	require.Len(t, m.candidates, 3)
+	require.Len(t, m.filtered, 1)
+	require.Equal(t, "octo/tools#42 Cache cleanup — closed", m.filtered[0].Summary())
+
+	m.query.SetValue("tool")
+	m.filterCandidates()
+	require.Len(t, m.filtered, 1)
+	require.Equal(t, "octo/tools#42 Cache cleanup — closed", m.filtered[0].Summary())
+}
+
+func TestRelationshipEditorZeroValueIsSafe(t *testing.T) {
+	var m Model
+	require.NotPanics(t, func() {
+		m.SetWidth(80)
+		m.UpdateProgramContext(&context.ProgramContext{})
+		m.Close()
+	})
+}
+
+func TestRelationshipEditorRejectsStaleMessagesByMode(t *testing.T) {
+	m := Model{mode: modeActions, status: "ready"}
+	updated, cmd := m.Update(relationshipsFetchedMsg{Relationships: data.IssueRelationships{}})
+	require.Nil(t, cmd)
+	require.Equal(t, modeActions, updated.mode)
+	require.Equal(t, "ready", updated.status)
+
+	updated, cmd = m.Update(RelationshipUpdatedMsg{Err: errors.New("write failed")})
+	require.Nil(t, cmd)
+	require.Equal(t, "write failed", updated.status)
+}
+
+func TestRelationshipEditorUpdateMessageClosesOnSuccess(t *testing.T) {
+	m := Model{active: true, initialized: false, mode: modeApplying}
+	updated, cmd := m.Update(RelationshipUpdatedMsg{Relationships: data.IssueRelationships{}})
+	require.Nil(t, cmd)
+	require.False(t, updated.active)
+}
+
+func TestRelationshipEditorRejectsStaleSessionSuccess(t *testing.T) {
+	m := Model{active: true, issueID: "issue", sessionID: 2, mode: modeApplying}
+	updated, cmd := m.Update(RelationshipUpdatedMsg{
+		SessionID: 1,
+		IssueID:   "issue",
+	})
+	require.Nil(t, cmd)
+	require.True(t, updated.active)
+}
+
+func TestRelationshipEditorCannotCancelInFlightMutation(t *testing.T) {
+	m := Model{active: true, mode: modeApplying}
+	updated, cmd := m.Update(tea.KeyPressMsg{Text: "q"})
+	require.Nil(t, cmd)
+	require.True(t, updated.active)
+}
+
+func TestCandidateSummaryIncludesRepositoryNumberTitleAndState(t *testing.T) {
+	summary := related("id", "octo/tools", 42, "Cache cleanup", "CLOSED").Summary()
+	require.True(t, strings.Contains(summary, "octo/tools#42"))
+	require.True(t, strings.Contains(summary, "Cache cleanup"))
+	require.True(t, strings.Contains(summary, "closed"))
+}
+
+func mutationsOf(actions []action) []data.RelationshipMutation {
+	mutations := make([]data.RelationshipMutation, 0, len(actions))
+	for _, item := range actions {
+		mutations = append(mutations, item.mutation)
+	}
+	return mutations
+}
