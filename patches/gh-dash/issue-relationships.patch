+	require.Contains(t, mutationsOf(actions), data.SetParent)
+	require.NotContains(t, mutationsOf(actions), data.RemoveParent)
+}
+
+func TestFilterCandidatesIsFuzzyAndDoesNotMutateFetchedCandidates(t *testing.T) {
