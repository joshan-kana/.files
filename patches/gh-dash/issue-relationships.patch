+++ b/internal/data/relationships_test.go
@@ -0,0 +1,22 @@
+package data
+
+import "testing"
+
+func TestRelationshipIndicators(t *testing.T) {
+	r := IssueRelationships{
+		Parent:    &RelatedIssue{Number: 1},
+		SubIssues: RelatedIssueConnection{TotalCount: 2},
+		BlockedBy: RelatedIssueConnection{TotalCount: 1},
+		Blocking:  RelatedIssueConnection{TotalCount: 3},
+	}
+	if got, want := r.Indicators(), "↳⊞⇠⇢"; got != want {
+		t.Fatalf("Indicators() = %q, want %q", got, want)
+	}
+}
+
+func TestRelatedIssueSummaryIncludesRepositoryAndState(t *testing.T) {
+	r := RelatedIssue{Number: 7, Title: "Planning", State: "CLOSED", Repository: Repository{NameWithOwner: "org/repo"}}
+	if got, want := r.Summary(), "org/repo#7 Planning — closed"; got != want {
+		t.Fatalf("Summary() = %q, want %q", got, want)
+	}
+}
