+	updated, _ := m.Update(tea.KeyPressMsg{Text: "p"})
+	updated, _ = updated.Update(tea.KeyPressMsg{Text: "j"})
+	updated, _ = updated.Update(tea.KeyPressMsg{Code: tea.KeyEsc})
+
+	require.Equal(t, modeCandidates, updated.mode)
+	require.Equal(t, 0, updated.projectIndex)
+	require.Equal(t, "project-a", updated.currentProjectID())
+	require.Equal(t, "a-issue", updated.filtered[0].ID)
+}
+
+func TestExactProjectChooserEnterCommitsAndRejectsStaleProjectResult(t *testing.T) {
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "issue"})
+	m.mode = modeCandidates
+	m.candidateScope = candidateScopeProject
+	m.projects = []data.Project{
+		{ID: "project-a", Title: "Project A"},
+		{ID: "project-b", Title: "Project B"},
+	}
+	m.projectIndex = 0
+
+	updated, _ := m.Update(tea.KeyPressMsg{Text: "p"})
+	updated, _ = updated.Update(tea.KeyPressMsg{Text: "j"})
+	updated, cmd := updated.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
+
+	require.NotNil(t, cmd)
+	require.Equal(t, 1, updated.projectIndex)
+	require.Equal(t, "project-b", updated.currentProjectID())
+	require.Equal(t, modeLoadingCandidates, updated.mode)
+	stale, staleCmd := updated.Update(candidatesFetchedMsg{
+		SessionID: updated.sessionID,
+		Version:   updated.searchVersion,
+		Scope:     candidateScopeProject,
+		ProjectID: "project-a",
+		Candidates: []data.RelatedIssue{
+			related("stale", "acme/app", 1, "Stale", "OPEN"),
+		},
+	})
+	require.Nil(t, staleCmd)
+	require.Empty(t, stale.candidates)
+}
+
+func TestAllScopeClearingQueryDropsStaleCandidatesAndCannotSubmit(t *testing.T) {
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "issue"})
+	m.mode = modeCandidates
+	m.candidateScope = candidateScopeAll
+	m.query.SetValue("gh-dash")
+	m.candidates = []data.RelatedIssue{
+		related("old", "acme/app", 1, "Old result", "OPEN"),
+	}
+	m.filterCandidates()
+	m.query.SetValue("")
+	m.filterMode = true
+	updated, _ := m.updateCandidateFilter(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	require.Empty(t, updated.candidates)
+	require.Empty(t, updated.filtered)
+	updated.mode = modeCandidates
+	updated, cmd := updated.selectCandidate()
+	require.Nil(t, cmd)
+	require.Empty(t, updated.candidates)
+}
+
+func TestCandidateFilterKeepsPJKQAsQueryText(t *testing.T) {
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "issue"})
+	m.mode = modeCandidates
+	m.filterMode = true
+	for _, char := range []string{"p", "j", "k", "q"} {
+		m, _ = m.Update(tea.KeyPressMsg{Text: char})
+	}
+	require.Equal(t, "pjkq", m.query.Value())
+}
+
+func TestVisibleRangeKeepsSelectionInViewport(t *testing.T) {
+	start, end := visibleRange(53, 52, candidateViewportSize)
+	require.Equal(t, 43, start)
+	require.Equal(t, 53, end)
+	start, end = visibleRange(3, 2, candidateViewportSize)
+	require.Equal(t, 0, start)
+	require.Equal(t, 3, end)
+}
+
+func TestCandidateProjectPickerUsesBoundedViewport(t *testing.T) {
+	projects := make([]data.Project, 15)
+	for index := range projects {
+		projects[index] = data.Project{
+			ID:     fmt.Sprintf("project-%d", index),
+			Title:  fmt.Sprintf("Project %d", index),
+			Number: index + 1,
+		}
+	}
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "issue"})
+	m.ctx = &context.ProgramContext{Theme: *theme.DefaultTheme}
+	m.mode = modeCandidateProjects
+	m.projects = projects
+	view := m.View()
+	require.Contains(t, view, "Project 0")
+	require.Contains(t, view, "Project 9")
+	require.NotContains(t, view, "Project 10")
+	require.Contains(t, view, "showing 1-10 of 15")
+}
+
+func TestRelationshipPickerTruncatesRowsToWidth(t *testing.T) {
+	m := New(&context.ProgramContext{}, data.IssueData{ID: "issue"})
+	m.ctx = &context.ProgramContext{Theme: *theme.DefaultTheme}
+	m.mode = modeCandidates
+	m.width = 24
+	row := m.renderIssueRow(
+		related(
+			"candidate",
+			"very-long-owner/very-long-repo",
+			123,
+			"A very long issue title",
+			"OPEN",
+		),
+		true,
+	)
+	require.LessOrEqual(t, lipgloss.Width(row), m.width)
+}
+
+func mutationsOf(actions []action) []data.RelationshipMutation {
+	mutations := make([]data.RelationshipMutation, 0, len(actions))
+	for _, item := range actions {
+		mutations = append(mutations, item.mutation)
+	}
+	return mutations
+}
