@@ -0,0 +1,34 @@
+package data
+
+import "fmt"
+
+// RelationshipIndicators returns a compact, stable list for issue rows. The
+// symbols are intentionally unobtrusive and do not imply workflow state.
+func (r IssueRelationships) Indicators() string {
+	indicators := ""
+	if r.Parent != nil {
+		indicators += "↳"
+	}
+	if r.SubIssues.TotalCount > 0 {
+		indicators += "⊞"
+	}
+	if r.BlockedBy.TotalCount > 0 {
+		indicators += "⇠"
+	}
+	if r.Blocking.TotalCount > 0 {
+		indicators += "⇢"
+	}
+	return indicators
+}
+
+func (r RelatedIssue) Identifier() string {
+	return fmt.Sprintf("%s#%d", r.Repository.NameWithOwner, r.Number)
+}
+
+func (r RelatedIssue) Summary() string {
+	state := "open"
+	if r.State == "CLOSED" {
+		state = "closed"
+	}
+	return fmt.Sprintf("%s %s — %s", r.Identifier(), r.Title, state)
+}
