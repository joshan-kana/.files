+
+	m := Model{
+		ctx:              ctx,
+		keys:             keys.Keys,
+		sidebar:          sidebar.NewModel(),
+		footer:           footer.NewModel(ctx),
+		tabs:             tabs.NewModel(ctx),
+		prView:           prview.NewModel(ctx),
+		issueSidebar:     issueview.NewModel(ctx),
+		branchSidebar:    branchsidebar.NewModel(ctx),
+		notificationView: notificationview.NewModel(ctx),
+	}
+	m.sidebar.IsOpen = true
+	m.syncMainContentDimensions()
+	m.syncProgramContext()
+
+	// 1. Successful notification issue with relationships
+	successIssue := data.IssueData{
+		ID:         "issue-1",
+		Number:     1,
+		Title:      "Notification Issue",
+		Body:       "Details",
+		Repository: data.Repository{NameWithOwner: "owner/repo"},
+		Parent: &data.RelatedIssue{
+			Title:      "Parent epic",
+			Number:     10,
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+	}
+	updatedModel, _ := m.Update(notificationIssueFetchedMsg{
+		NotificationId: "notif-1",
+		Issue:          successIssue,
+	})
+	m = updatedModel.(Model)
+	view := m.issueSidebar.View()
+	require.Contains(t, view, "Relationships")
+	require.Contains(t, view, "Parent epic")
+	require.NotContains(t, view, "Unavailable")
+
+	// 2. Notification issue with empty relationships -> omitted
+	emptyIssue := data.IssueData{
+		ID:         "issue-2",
+		Number:     2,
+		Title:      "Empty Notification Issue",
+		Body:       "Details",
+		Repository: data.Repository{NameWithOwner: "owner/repo"},
+	}
+	updatedModel, _ = m.Update(notificationIssueFetchedMsg{
+		NotificationId: "notif-2",
+		Issue:          emptyIssue,
+	})
+	m = updatedModel.(Model)
+	view = m.issueSidebar.View()
+	require.NotContains(t, view, "Relationships")
+	require.NotContains(t, view, "Unavailable")
+
+	// 3. Notification issue with relationship fetch error -> shows Unavailable
+	errIssue := data.IssueData{
+		ID:               "issue-3",
+		Number:           3,
+		Title:            "Error Notification Issue",
+		Body:             "Details",
+		Repository:       data.Repository{NameWithOwner: "owner/repo"},
+		RelationshipsErr: errors.New("relationships API timeout"),
+	}
+	updatedModel, _ = m.Update(notificationIssueFetchedMsg{
+		NotificationId: "notif-3",
+		Issue:          errIssue,
+	})
+	m = updatedModel.(Model)
+	view = m.issueSidebar.View()
+	require.Contains(t, view, "Relationships")
+	require.Contains(t, view, "Unavailable")
+	require.NotContains(t, view, "Loading…")
+	require.Contains(t, view, "Error Notification Issue")
+}
