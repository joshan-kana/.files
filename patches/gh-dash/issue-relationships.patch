new file mode 100644
index 0000000..4def9d7
--- /dev/null
+++ b/internal/tui/components/relationshipeditor/editor.go
@@ -0,0 +1,824 @@
+package relationshipeditor
+
+import (
+	"fmt"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/sahilm/fuzzy"
+
+	"charm.land/bubbles/v2/textinput"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/inputbox"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+)
+
+type mode uint8
+
+const (
+	modeActions mode = iota
+	modeLoadingRelationships
+	modeRelationships
+	modeLoadingCandidates
+	modeCandidates
+	modeCandidateProjects
+	modeApplying
+)
+
+type candidateScope uint8
+
+const (
+	candidateScopeRepo candidateScope = iota
+	candidateScopeProject
+	candidateScopeAll
+)
+
+const candidateViewportSize = 10
+
+type action struct {
+	label    string
+	mutation data.RelationshipMutation
+}
+
+type RelationshipUpdatedMsg struct {
+	SessionID     uint64
+	IssueID       string
+	Relationships data.IssueRelationships
+	Err           error
+}
+
+type candidatesFetchedMsg struct {
+	SessionID  uint64
+	Query      string
+	Version    uint64
+	Candidates []data.RelatedIssue
+	Scope      candidateScope
+	ProjectID  string
+	Err        error
+}
+
+type candidateSearchMsg struct {
+	SessionID uint64
+	Query     string
+	Version   uint64
+}
+
+type relationshipsFetchedMsg struct {
+	SessionID     uint64
+	Relationships data.IssueRelationships
+	Err           error
+}
+
+var relationshipEditorSession uint64
+
+type Model struct {
+	ctx            *context.ProgramContext
+	issueID        string
+	current        data.IssueRelationships
+	actions        []action
+	selected       int
+	removeItems    []data.RelatedIssue
+	candidates     []data.RelatedIssue
+	filtered       []data.RelatedIssue
+	query          inputbox.Model
+	selectedRel    int
+	pending        data.RelationshipMutation
+	mode           mode
+	status         string
+	width          int
+	active         bool
+	initialized    bool
+	sessionID      uint64
+	searchVersion  uint64
+	filterMode     bool
+	repository     string
+	candidateScope candidateScope
+	projects       []data.Project
+	projectIndex   int
+	projectCursor  int
+}
+
+func New(ctx *context.ProgramContext, issue data.IssueData) Model {
+	input := inputbox.NewModel(ctx, inputbox.ModelOpts{TextInput: func() *textinput.Model {
+		ti := inputbox.DefaultTextInput(ctx)
+		return &ti
+	}()})
+	projects := make([]data.Project, 0, len(issue.ProjectItems.Nodes))
+	seenProjects := make(map[string]struct{})
+	for _, item := range issue.ProjectItems.Nodes {
+		if item.Project.ID == "" {
+			continue
+		}
+		if _, ok := seenProjects[item.Project.ID]; ok {
+			continue
+		}
+		seenProjects[item.Project.ID] = struct{}{}
+		projects = append(projects, item.Project)
+	}
+	return Model{
+		ctx: ctx, issueID: issue.ID, current: issue.NativeRelationships(),
+		actions: relationshipActions(issue.NativeRelationships()), query: input,
+		mode: modeActions, active: true, initialized: true,
+		sessionID:  atomic.AddUint64(&relationshipEditorSession, 1),
+		repository: issue.Repository.NameWithOwner, projects: projects,
+		candidateScope: candidateScopeRepo,
+	}
+}
+
+func (m Model) Active() bool { return m.active }
+
+func (m Model) SessionID() uint64 { return m.sessionID }
+
+func (m *Model) Refresh() tea.Cmd {
+	if !m.active || m.issueID == "" {
+		return nil
+	}
+	m.mode = modeLoadingRelationships
+	m.status = ""
+	return fetchRelationships(m.sessionID, m.issueID)
+}
+
+func (m *Model) Close() {
+	m.active = false
+	if m.initialized {
+		m.query.Blur()
+	}
+}
+
+func (m *Model) SetWidth(width int) {
+	m.width = width
+	if m.initialized {
+		m.query.SetWidth(width)
+	}
+}
+
+func (m *Model) UpdateProgramContext(ctx *context.ProgramContext) {
+	m.ctx = ctx
+	if m.initialized {
+		m.query.UpdateProgramContext(ctx)
+	}
+}
+
+func (m Model) Update(msg tea.Msg) (Model, tea.Cmd) {
+	switch msg := msg.(type) {
+	case relationshipsFetchedMsg:
+		if m.mode != modeLoadingRelationships || msg.SessionID != m.sessionID {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.pending = ""
+			m.removeItems = nil
+			m.status, m.mode = msg.Err.Error(), modeActions
+			return m, nil
+		}
+		m.current = msg.Relationships
+		m.actions = relationshipActions(msg.Relationships)
+		m.selected = 0
+		m.status = ""
+		m.selectedRel = 0
+		if isRemoval(m.pending) {
+			m.removeItems = relationshipItems(msg.Relationships, m.pending)
+			if len(m.removeItems) == 0 {
+				m.pending = ""
+				m.mode = modeActions
+				m.status = "No live relationship is available"
+				return m, nil
+			}
+			m.mode = modeRelationships
+		} else {
+			m.removeItems = nil
+			m.mode = modeActions
+		}
+		return m, nil
+	case candidatesFetchedMsg:
+		if (m.mode != modeLoadingCandidates && m.mode != modeCandidates) ||
+			msg.SessionID != m.sessionID || msg.Version != m.searchVersion ||
+			msg.Query != strings.TrimSpace(m.query.Value()) || msg.Scope != m.candidateScope ||
+			(msg.Scope == candidateScopeProject && msg.ProjectID != m.currentProjectID()) {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.status = msg.Err.Error()
+			m.mode = modeCandidates
+			if m.filterMode {
+				return m, m.query.Focus()
+			}
+			return m, nil
+		}
+		m.candidates, m.mode, m.status = msg.Candidates, modeCandidates, ""
+		m.filterCandidates()
+		return m, nil
+	case candidateSearchMsg:
+		if m.mode != modeCandidates || msg.SessionID != m.sessionID ||
+			msg.Version != m.searchVersion || msg.Query != strings.TrimSpace(m.query.Value()) {
+			return m, nil
+		}
+		if m.candidateScope == candidateScopeAll && msg.Query == "" {
+			return m, nil
+		}
+		return m, fetchCandidates(
+			m.sessionID,
+			msg.Version,
+			msg.Query,
+			m.candidateScope,
+			m.currentProjectID(),
+			m.repository,
+		)
+	case RelationshipUpdatedMsg:
+		if msg.SessionID != m.sessionID || msg.IssueID != m.issueID {
+			return m, nil
+		}
+		if msg.Err != nil {
+			m.status, m.mode = msg.Err.Error(), modeActions
+			return m, nil
+		}
+		m.Close()
+		return m, nil
+	case tea.KeyMsg:
+		if m.mode == modeCandidateProjects {
+			return m.updateCandidateProjects(msg)
+		}
+		if m.mode == modeCandidates {
+			return m.updateCandidates(msg)
+		}
+		if m.mode == modeApplying {
+			return m, nil
+		}
+		switch msg.String() {
+		case "esc":
+			if m.mode == modeRelationships {
+				m.mode = modeActions
+				m.removeItems = nil
+				m.selectedRel = 0
+				m.pending = ""
+				return m, nil
+			}
+			m.Close()
+			return m, nil
+		case "q":
+			m.Close()
+			return m, nil
+		case "up", "k":
+			m.move(-1)
+		case "down", "j":
+			m.move(1)
+		case "enter":
+			switch m.mode {
+			case modeActions:
+				if len(m.actions) == 0 {
+					m.status = "No editable relationships are available"
+					return m, nil
+				}
+				selected := m.actions[m.selected]
+				m.pending = selected.mutation
+				if isRemoval(selected.mutation) {
+					m.mode = modeLoadingRelationships
+					return m, fetchRelationships(m.sessionID, m.issueID)
+				}
+				m.mode = modeLoadingCandidates
+				m.filterMode = false
+				m.query.Blur()
+				m.candidates, m.filtered = nil, nil
+				return m, m.startCandidateSearch()
+			case modeRelationships:
+				if len(m.removeItems) == 0 {
+					m.status = "No live relationship is available"
+					return m, nil
+				}
+				target := m.removeItems[m.selectedRel]
+				m.mode = modeApplying
+				return m, applyMutation(m.sessionID, m.issueID, target.ID, m.pending)
+			}
+		}
+	}
+	return m, nil
+}
+
+func (m *Model) updateCandidates(msg tea.KeyMsg) (Model, tea.Cmd) {
+	if m.filterMode {
+		switch msg.String() {
+		case "tab":
+			return m.cycleCandidateScope()
+		case "esc":
+			m.filterMode = false
+			m.query.Blur()
+			return *m, nil
+		case "ctrl+c":
+			m.Close()
+			return *m, nil
+		case "up":
+			m.move(-1)
+			return *m, nil
+		case "down":
+			m.move(1)
+			return *m, nil
+		case "enter":
+			return m.selectCandidate()
+		}
+		return m.updateCandidateFilter(msg)
+	}
+	switch msg.String() {
+	case "esc":
+		m.mode, m.status = modeActions, ""
+		m.query.SetValue("")
+		m.query.Blur()
+		return *m, nil
+	case "/":
+		m.filterMode = true
+		return *m, m.query.Focus()
+	case "tab":
+		return m.cycleCandidateScope()
+	case "p":
+		if m.candidateScope == candidateScopeProject && len(m.projects) > 1 {
+			m.projectCursor = m.projectIndex
+			m.mode = modeCandidateProjects
+			m.query.Blur()
+			return *m, nil
+		}
+	case "up", "k":
+		m.move(-1)
+		return *m, nil
+	case "down", "j":
+		m.move(1)
+		return *m, nil
+	case "enter":
+		return m.selectCandidate()
+	}
+	if msg.String() == "q" {
+		m.Close()
+		return *m, nil
+	}
+	return *m, nil
+}
+
+func (m *Model) cycleCandidateScope() (Model, tea.Cmd) {
+	m.candidateScope = (m.candidateScope + 1) % 3
+	m.searchVersion++
+	m.selectedRel = 0
+	m.candidates, m.filtered = nil, nil
+	if m.filterMode {
+		m.mode = modeCandidates
+		m.status = "Searching…"
+		return *m, fetchCandidates(
+			m.sessionID,
+			m.searchVersion,
+			strings.TrimSpace(m.query.Value()),
+			m.candidateScope,
+			m.currentProjectID(),
+			m.repository,
+		)
+	}
+	m.status = ""
+	return *m, m.startCandidateSearch()
+}
+
+func (m *Model) startCandidateSearch() tea.Cmd {
+	query := strings.TrimSpace(m.query.Value())
+	if m.candidateScope == candidateScopeAll && query == "" {
+		m.mode = modeCandidates
+		return nil
+	}
+	m.mode = modeLoadingCandidates
+	return fetchCandidates(
+		m.sessionID,
+		m.searchVersion,
+		query,
+		m.candidateScope,
+		m.currentProjectID(),
+		m.repository,
+	)
+}
+
+func (m Model) currentProjectID() string {
+	if m.candidateScope != candidateScopeProject || len(m.projects) == 0 ||
+		m.projectIndex >= len(m.projects) {
+		return ""
+	}
+	return m.projects[m.projectIndex].ID
+}
+
+func (m *Model) updateCandidateProjects(msg tea.KeyMsg) (Model, tea.Cmd) {
+	if len(m.projects) == 0 {
+		m.mode = modeCandidates
+		return *m, nil
+	}
+	switch msg.String() {
+	case "esc":
+		m.mode = modeCandidates
+	case "up", "k":
+		m.projectCursor = (m.projectCursor - 1 + len(m.projects)) % len(m.projects)
+	case "down", "j":
+		m.projectCursor = (m.projectCursor + 1) % len(m.projects)
+	case "enter":
+		m.projectIndex = m.projectCursor
+		m.mode = modeCandidates
+		m.searchVersion++
+		m.selectedRel = 0
+		m.candidates, m.filtered = nil, nil
+		return *m, m.startCandidateSearch()
+	}
+	return *m, nil
+}
+
+func (m *Model) updateCandidateFilter(msg tea.KeyMsg) (Model, tea.Cmd) {
+	var cmd tea.Cmd
+	m.query, cmd = m.query.Update(msg)
+	if m.candidateScope == candidateScopeAll && strings.TrimSpace(m.query.Value()) == "" {
+		m.candidates, m.filtered = nil, nil
+		m.selectedRel = 0
+		m.mode = modeCandidates
+		m.status = "Type / to search all accessible GitHub issues"
+	}
+	m.filterCandidates()
+	m.searchVersion++
+	version := m.searchVersion
+	query := strings.TrimSpace(m.query.Value())
+	searchCmd := tea.Tick(200*time.Millisecond, func(time.Time) tea.Msg {
+		return candidateSearchMsg{SessionID: m.sessionID, Query: query, Version: version}
+	})
+	return *m, tea.Batch(cmd, searchCmd)
+}
+
+func (m *Model) selectCandidate() (Model, tea.Cmd) {
+	if m.candidateScope == candidateScopeAll && strings.TrimSpace(m.query.Value()) == "" {
+		m.status = "Type / to search all accessible GitHub issues"
+		return *m, nil
+	}
+	if len(m.filtered) == 0 {
+		m.status = "No matching accessible issues"
+		return *m, nil
+	}
+	target := m.filtered[m.selectedRel]
+	m.mode = modeApplying
+	m.filterMode = false
+	m.query.Blur()
+	return *m, applyMutation(m.sessionID, m.issueID, target.ID, m.pending)
+}
+
+func (m *Model) filterCandidates() {
+	query := strings.TrimSpace(m.query.Value())
+	available := make([]data.RelatedIssue, 0, len(m.candidates))
+	for _, candidate := range m.candidates {
+		if candidate.ID == m.issueID || relationshipExists(m.current, candidate.ID, m.pending) {
+			continue
+		}
+		available = append(available, candidate)
+	}
+	if query == "" {
+		m.filtered = available
+		m.selectedRel = 0
+		return
+	}
+	values := make([]string, len(available))
+	for i, candidate := range available {
+		values[i] = candidate.Summary()
+	}
+	matches := fuzzy.Find(query, values)
+	m.filtered = make([]data.RelatedIssue, 0, len(matches))
+	for _, match := range matches {
+		filtered := available[match.Index]
+		m.filtered = append(m.filtered, filtered)
+	}
+	if m.selectedRel >= len(m.filtered) {
+		m.selectedRel = 0
+	}
+}
+
+func (m *Model) move(delta int) {
+	length := len(m.actions)
+	if m.mode == modeRelationships {
+		length = len(m.removeItems)
+	}
+	if m.mode == modeCandidates {
+		length = len(m.filtered)
+	}
+	if length == 0 {
+		return
+	}
+	if m.mode == modeCandidates || m.mode == modeRelationships {
+		m.selectedRel = (m.selectedRel + delta + length) % length
+	} else {
+		m.selected = (m.selected + delta + length) % length
+	}
+}
+
+func (m Model) View() string {
+	if !m.active {
+		return ""
+	}
+	lines := []string{"Edit relationships"}
+	switch m.mode {
+	case modeActions:
+		for i, item := range m.actions {
+			lines = append(lines, m.renderRow(item.label, "", i == m.selected))
+		}
+	case modeRelationships:
+		lines = append(lines, "Select a live relationship to remove")
+		start, end := visibleRange(len(m.removeItems), m.selectedRel, candidateViewportSize)
+		for i := start; i < end; i++ {
+			lines = append(lines, m.renderIssueRow(m.removeItems[i], i == m.selectedRel))
+		}
+	case modeCandidates:
+		lines = append(lines, "Scope: "+m.scopeLabel()+" · "+m.query.View())
+		if m.candidateScope == candidateScopeAll && strings.TrimSpace(m.query.Value()) == "" {
+			lines = append(
+				lines,
+				m.ctx.Styles.Common.FaintTextStyle.Render(
+					"Type / to search all accessible GitHub issues",
+				),
+			)
+		} else {
+			start, end := visibleRange(len(m.filtered), m.selectedRel, candidateViewportSize)
+			for i := start; i < end; i++ {
+				lines = append(lines, m.renderIssueRow(m.filtered[i], i == m.selectedRel))
+			}
+			if len(m.filtered) > candidateViewportSize {
+				lines = append(
+					lines,
+					m.ctx.Styles.Common.FaintTextStyle.Render(
+						fmt.Sprintf("showing %d-%d of %d", start+1, end, len(m.filtered)),
+					),
+				)
+			}
+		}
+	case modeCandidateProjects:
+		lines = append(lines, "Choose a Project")
+		start, end := visibleRange(len(m.projects), m.projectCursor, candidateViewportSize)
+		for i := start; i < end; i++ {
+			project := m.projects[i]
+			lines = append(
+				lines,
+				m.renderRow(
+					project.Title,
+					fmt.Sprintf("%s #%d", project.Owner.Login(), project.Number),
+					i == m.projectCursor,
+				),
+			)
+		}
+		if len(m.projects) > candidateViewportSize {
+			lines = append(
+				lines,
+				m.ctx.Styles.Common.FaintTextStyle.Render(
+					fmt.Sprintf("showing %d-%d of %d", start+1, end, len(m.projects)),
+				),
+			)
+		}
+	case modeLoadingRelationships, modeLoadingCandidates, modeApplying:
+		lines = append(lines, "Working…")
+	}
+	if m.status != "" {
+		lines = append(lines, m.status)
+	}
+	if m.mode == modeCandidates {
+		if m.filterMode {
+			lines = append(
+				lines,
+				"type to filter · ↑/↓ select · Tab scope · Enter choose · Esc stop filtering",
+			)
+		} else {
+			help := "j/k/↑/↓ select · / filter · Tab scope · Enter choose · Esc back"
+			if m.candidateScope == candidateScopeProject && len(m.projects) > 1 {
+				help += " · p choose Project"
+			}
+			lines = append(lines, help)
+		}
+	} else {
+		lines = append(lines, "j/k/↑/↓ select · Enter choose · Esc back")
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (m Model) renderRow(primary, secondary string, selected bool) string {
+	return m.renderPickerRow(primary, secondary, "", selected)
+}
+
+func (m Model) renderPickerRow(primary, secondary, trailing string, selected bool) string {
+	primaryStyle := lipgloss.NewStyle().Foreground(m.ctx.Theme.PrimaryText)
+	secondaryStyle := lipgloss.NewStyle().Foreground(m.ctx.Theme.SecondaryText)
+	faintStyle := lipgloss.NewStyle().Foreground(m.ctx.Theme.FaintText)
+	selectedBackground := m.ctx.Theme.SelectedBackground
+	hasSelectedBackground := selected &&
+		(selectedBackground.Light != nil || selectedBackground.Dark != nil)
+	backgroundStyle := lipgloss.NewStyle()
+	if hasSelectedBackground {
+		backgroundStyle = backgroundStyle.Background(selectedBackground)
+		primaryStyle = primaryStyle.Background(selectedBackground)
+		secondaryStyle = secondaryStyle.Background(selectedBackground)
+		faintStyle = faintStyle.Background(selectedBackground)
+	}
+	content := primaryStyle.Render(primary)
+	if secondary != "" {
+		content += backgroundStyle.Render("  ") + secondaryStyle.Render(secondary)
+	}
+	if trailing != "" {
+		content += backgroundStyle.Render("  ") + faintStyle.Render(trailing)
+	}
+	prefix := "  "
+	if selected {
+		prefix = m.ctx.Styles.Select.Pointer.
+			Background(selectedBackground).
+			Render("› ")
+		if !hasSelectedBackground {
+			prefix = m.ctx.Styles.Select.Pointer.Render("› ")
+		}
+	} else if hasSelectedBackground {
+		prefix = backgroundStyle.Render(prefix)
+	}
+	if m.width > 0 {
+		content = ansi.Truncate(content, max(0, m.width-lipgloss.Width(prefix)), "…")
+	}
+	row := prefix + content
+	if hasSelectedBackground && m.width > 0 {
+		padding := max(0, m.width-lipgloss.Width(row))
+		if padding > 0 {
+			row += backgroundStyle.Render(strings.Repeat(" ", padding))
+		}
+	}
+	return row
+}
+
+func (m Model) renderIssueRow(item data.RelatedIssue, selected bool) string {
+	state := strings.ToLower(item.State)
+	return m.renderPickerRow(
+		item.Title,
+		fmt.Sprintf("#%d  %s", item.Number, item.Repository.NameWithOwner),
+		state,
+		selected,
+	)
+}
+
+func (m Model) scopeLabel() string {
+	switch m.candidateScope {
+	case candidateScopeProject:
+		if len(m.projects) == 0 {
+			return "Project · No GitHub Project is available for this issue"
+		}
+		return "Project · " + m.projects[m.projectIndex].DisplayName(false)
+	case candidateScopeAll:
+		return "All"
+	default:
+		return "Repo · " + m.repository
+	}
+}
+
+func visibleRange(total, selected, size int) (int, int) {
+	if total <= 0 || size <= 0 {
+		return 0, 0
+	}
+	if selected < 0 {
+		selected = 0
+	}
+	if selected >= total {
+		selected = total - 1
+	}
+	if size > total {
+		size = total
+	}
+	start := selected - size/2
+	if start < 0 {
+		start = 0
+	}
+	end := start + size
+	if end > total {
+		end = total
+		start = end - size
+	}
+	return start, end
+}
+
+func relationshipActions(r data.IssueRelationships) []action {
+	items := []action{
+		{"Add blocked by", data.AddBlockedBy},
+		{"Add blocking", data.AddBlocking},
+		{"Add sub-issue", data.AddSubIssue},
+	}
+	if r.Parent == nil {
+		items = append(items, action{"Set parent", data.SetParent})
+	} else {
+		items = append(items, action{"Remove parent", data.RemoveParent})
+	}
+	if len(r.BlockedBy.Nodes) > 0 {
+		items = append(items, action{"Remove blocked by", data.RemoveBlockedBy})
+	}
+	if len(r.Blocking.Nodes) > 0 {
+		items = append(items, action{"Remove blocking", data.RemoveBlocking})
+	}
+	if len(r.SubIssues.Nodes) > 0 {
+		items = append(items, action{"Remove sub-issue", data.RemoveSubIssue})
+	}
+	return items
+}
+
+func relationshipItems(
+	r data.IssueRelationships,
+	mutation data.RelationshipMutation,
+) []data.RelatedIssue {
+	switch mutation {
+	case data.RemoveParent:
+		if r.Parent != nil {
+			return []data.RelatedIssue{*r.Parent}
+		}
+	case data.RemoveBlockedBy:
+		return r.BlockedBy.Nodes
+	case data.RemoveBlocking:
+		return r.Blocking.Nodes
+	case data.RemoveSubIssue:
+		return r.SubIssues.Nodes
+	}
+	return nil
+}
+
+func relationshipExists(
+	r data.IssueRelationships,
+	id string,
+	mutation data.RelationshipMutation,
+) bool {
+	switch mutation {
+	case data.AddBlockedBy:
+		for _, item := range r.BlockedBy.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	case data.AddBlocking:
+		for _, item := range r.Blocking.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	case data.AddSubIssue:
+		for _, item := range r.SubIssues.Nodes {
+			if item.ID == id {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isRemoval(m data.RelationshipMutation) bool { return strings.HasPrefix(string(m), "remove-") }
+func fetchRelationships(sessionID uint64, id string) tea.Cmd {
+	return func() tea.Msg {
+		r, err := data.FetchIssueRelationships(id)
+		return relationshipsFetchedMsg{SessionID: sessionID, Relationships: r, Err: err}
+	}
+}
+
+func fetchCandidates(
+	sessionID, version uint64,
+	query string,
+	scope candidateScope,
+	projectID, repository string,
+) tea.Cmd {
+	return func() tea.Msg {
+		query = strings.TrimSpace(query)
+		var c []data.RelatedIssue
+		var err error
+		switch scope {
+		case candidateScopeRepo:
+			c, err = data.FetchRelationshipCandidates("repo:"+repository+" in:title "+query, 25)
+		case candidateScopeProject:
+			c, err = data.FetchProjectRelationshipCandidates(projectID, query, 50)
+		case candidateScopeAll:
+			if query == "" {
+				return candidatesFetchedMsg{
+					SessionID: sessionID,
+					Query:     query,
+					Version:   version,
+					Scope:     scope,
+					ProjectID: projectID,
+				}
+			}
+			c, err = data.FetchRelationshipCandidates("in:title "+query, 50)
+		}
+		return candidatesFetchedMsg{
+			SessionID:  sessionID,
+			Query:      query,
+			Version:    version,
+			Candidates: c,
+			Scope:      scope,
+			ProjectID:  projectID,
+			Err:        err,
+		}
+	}
+}
+
+func applyMutation(
+	sessionID uint64,
+	issueID, targetID string,
+	mutation data.RelationshipMutation,
+) tea.Cmd {
+	return func() tea.Msg {
+		r, err := data.MutateIssueRelationship(issueID, targetID, mutation)
+		return RelationshipUpdatedMsg{
+			SessionID:     sessionID,
+			IssueID:       issueID,
+			Relationships: r,
+			Err:           err,
+		}
+	}
+}
