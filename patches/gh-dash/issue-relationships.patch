+	m.candidates = []data.RelatedIssue{
+		related("one", "acme/app", 1, "One", "OPEN"),
+		related("two", "acme/app", 2, "Two", "OPEN"),
+	}
+	m.filterCandidates()
+
+	m, _ = m.Update(tea.KeyPressMsg{Text: "j"})
+	require.Equal(t, 1, m.selectedRel)
+	m, _ = m.Update(tea.KeyPressMsg{Text: "k"})
+	require.Equal(t, 0, m.selectedRel)
+	m, _ = m.Update(tea.KeyPressMsg{Text: "/"})
+	require.True(t, m.filterMode)
+	m, _ = m.Update(tea.KeyPressMsg{Text: "j"})
+	require.Equal(t, "j", m.query.Value())
+	m, _ = m.Update(tea.KeyPressMsg{Code: tea.KeyEsc})
+	require.False(t, m.filterMode)
+	require.True(t, m.Active())
