+func TestIssueRelationshipsSessionCacheRevalidatesWithoutLoadingFlash(t *testing.T) {
+	m, issueSection := newIssueRelationshipsTestModel(t)
+	originalFetch := fetchIssueRelationships
+	t.Cleanup(func() { fetchIssueRelationships = originalFetch })
+
+	fetchCount := 0
+	first := data.IssueRelationships{
+		Parent: &data.RelatedIssue{
+			Title:      "Cached parent",
+			Number:     10,
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+	}
+	second := data.IssueRelationships{
+		Parent: &data.RelatedIssue{
+			Title:      "Refreshed parent",
+			Number:     11,
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+	}
+	fetchIssueRelationships = func(string) (data.IssueRelationships, error) {
+		fetchCount++
+		if fetchCount == 1 {
+			return first, nil
+		}
+		return second, nil
+	}
+
+	m.issueSidebar.SetRow(&issueSection.Issues[0])
+	m.onViewedRowChanged()
+	require.Contains(t, m.issueSidebar.View(), "Loading…")
+
+	updatedModel, cmd := m.Update(issueRelationshipsRequestMsg{
+		ContentID:  "issue-1",
+		Generation: m.relationshipPreviewGeneration,
+	})
+	m = updatedModel.(Model)
+	msg := cmd()
+	updatedModel, _ = m.Update(msg)
+	m = updatedModel.(Model)
+	require.Equal(t, 1, fetchCount)
+	require.Contains(t, m.issueSidebar.View(), "Cached parent")
+	require.Contains(t, m.relationshipCache, "issue-1")
+
+	m.onViewedRowChanged()
+	require.Contains(t, m.issueSidebar.View(), "Cached parent")
+	require.NotContains(t, m.issueSidebar.View(), "Loading…")
+
+	updatedModel, cmd = m.Update(issueRelationshipsRequestMsg{
+		ContentID:  "issue-1",
+		Generation: m.relationshipPreviewGeneration,
+	})
+	m = updatedModel.(Model)
+	msg = cmd()
+	updatedModel, _ = m.Update(msg)
+	m = updatedModel.(Model)
+	require.Equal(t, 2, fetchCount)
+	require.Contains(t, m.issueSidebar.View(), "Refreshed parent")
+}
