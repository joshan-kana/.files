new file mode 100644
index 0000000000000000000000000000000000000000..fbc203069ea8640e884466807fc69ab2ac60f6fe
--- /dev/null
+++ b/internal/data/relationship_mutations.go
@@ -0,0 +1,203 @@
+package data
+
+import (
+	"fmt"
+
+	gh "github.com/cli/go-gh/v2/pkg/api"
+)
+
+type RelationshipMutation string
+
+const (
+	AddBlockedBy    RelationshipMutation = "add-blocked-by"
+	RemoveBlockedBy RelationshipMutation = "remove-blocked-by"
+	AddBlocking     RelationshipMutation = "add-blocking"
+	RemoveBlocking  RelationshipMutation = "remove-blocking"
+	SetParent       RelationshipMutation = "set-parent"
+	RemoveParent    RelationshipMutation = "remove-parent"
+	AddSubIssue     RelationshipMutation = "add-sub-issue"
+	RemoveSubIssue  RelationshipMutation = "remove-sub-issue"
+)
+
+var relationshipGraphQLDo = func(client *gh.GraphQLClient, query string, variables map[string]interface{}, result interface{}) error {
+	return client.Do(query, variables, result)
+}
+
+var fetchIssueRelationshipsForMutation = FetchIssueRelationships
+
+// FetchRelationshipCandidates searches accessible GitHub issues for the
+// relationship editor. The search endpoint remains the authority for which
+// issues the current account can see.
+func FetchRelationshipCandidates(query string, limit int) ([]RelatedIssue, error) {
+	if limit < 1 {
+		limit = 25
+	}
+	response, err := FetchIssues(query, limit, nil, false)
+	if err != nil {
+		return nil, err
+	}
+	candidates := make([]RelatedIssue, 0, len(response.Issues))
+	for _, issue := range response.Issues {
+		candidates = append(candidates, RelatedIssue{
+			ID: issue.ID, Number: issue.Number, Title: issue.Title, State: issue.State,
+			URL: issue.Url, Repository: issue.Repository,
+		})
+	}
+	return candidates, nil
+}
+
+// MutateIssueRelationship performs one live-validated native relationship write
+// and returns the authoritative relationship state fetched after the write.
+func MutateIssueRelationship(
+	issueID, targetID string,
+	mutation RelationshipMutation,
+) (IssueRelationships, error) {
+	if issueID == "" || targetID == "" {
+		return IssueRelationships{}, fmt.Errorf(
+			"relationship mutation requires issue and target IDs",
+		)
+	}
+	if issueID == targetID {
+		return IssueRelationships{}, fmt.Errorf("an issue cannot relate to itself")
+	}
+	current, err := fetchIssueRelationshipsForMutation(issueID)
+	if err != nil {
+		return IssueRelationships{}, fmt.Errorf("live relationship validation failed: %w", err)
+	}
+	if err := validateRelationshipMutation(current, targetID, mutation); err != nil {
+		return IssueRelationships{}, err
+	}
+
+	client, err := relationshipGraphQLClient()
+	if err != nil {
+		return IssueRelationships{}, err
+	}
+	query, variables := relationshipMutationRequest(issueID, targetID, mutation)
+	if query == "" {
+		return IssueRelationships{}, fmt.Errorf("unsupported relationship mutation %q", mutation)
+	}
+	var response map[string]interface{}
+	if err := relationshipGraphQLDo(client, query, variables, &response); err != nil {
+		return IssueRelationships{}, err
+	}
+	updated, err := fetchIssueRelationshipsForMutation(issueID)
+	if err != nil {
+		return IssueRelationships{}, fmt.Errorf(
+			"relationship write succeeded but authoritative refetch failed: %w",
+			err,
+		)
+	}
+	return updated, nil
+}
+
+func relationshipGraphQLClient() (*gh.GraphQLClient, error) {
+	if client == nil {
+		var err error
+		client, err = gh.DefaultGraphQLClient()
+		if err != nil {
+			return nil, err
+		}
+	}
+	return client, nil
+}
+
+func validateRelationshipMutation(
+	current IssueRelationships,
+	targetID string,
+	mutation RelationshipMutation,
+) error {
+	contains := func(issues []RelatedIssue) bool {
+		for _, issue := range issues {
+			if issue.ID == targetID {
+				return true
+			}
+		}
+		return false
+	}
+	switch mutation {
+	case AddBlockedBy, AddBlocking, AddSubIssue:
+		if contains(current.BlockedBy.Nodes) && mutation == AddBlockedBy {
+			return fmt.Errorf("blocked-by relationship already exists")
+		}
+		if contains(current.Blocking.Nodes) && mutation == AddBlocking {
+			return fmt.Errorf("blocking relationship already exists")
+		}
+		if contains(current.SubIssues.Nodes) && mutation == AddSubIssue {
+			return fmt.Errorf("sub-issue relationship already exists")
+		}
+	case RemoveBlockedBy:
+		if !contains(current.BlockedBy.Nodes) {
+			return fmt.Errorf("blocked-by relationship is not present in live state")
+		}
+	case RemoveBlocking:
+		if !contains(current.Blocking.Nodes) {
+			return fmt.Errorf("blocking relationship is not present in live state")
+		}
+	case SetParent:
+		if current.Parent != nil {
+			return fmt.Errorf("parent already exists; remove it before setting another parent")
+		}
+	case RemoveParent:
+		if current.Parent == nil || current.Parent.ID != targetID {
+			return fmt.Errorf("requested parent is not present in live state")
+		}
+	case RemoveSubIssue:
+		if !contains(current.SubIssues.Nodes) {
+			return fmt.Errorf("sub-issue relationship is not present in live state")
+		}
+	default:
+		return fmt.Errorf("unsupported relationship mutation %q", mutation)
+	}
+	return nil
+}
+
+func relationshipMutationRequest(
+	issueID, targetID string,
+	mutation RelationshipMutation,
+) (string, map[string]interface{}) {
+	input := map[string]interface{}{}
+	switch mutation {
+	case AddBlockedBy:
+		input["issueId"], input["blockingIssueId"] = issueID, targetID
+		return `mutation AddBlockedBy($input: AddBlockedByInput!) { addBlockedBy(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case RemoveBlockedBy:
+		input["issueId"], input["blockingIssueId"] = issueID, targetID
+		return `mutation RemoveBlockedBy($input: RemoveBlockedByInput!) { removeBlockedBy(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case AddBlocking:
+		input["issueId"], input["blockingIssueId"] = targetID, issueID
+		return `mutation AddBlocking($input: AddBlockedByInput!) { addBlockedBy(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case RemoveBlocking:
+		input["issueId"], input["blockingIssueId"] = targetID, issueID
+		return `mutation RemoveBlocking($input: RemoveBlockedByInput!) { removeBlockedBy(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case SetParent:
+		input["issueId"], input["subIssueId"], input["replaceParent"] = targetID, issueID, true
+		return `mutation SetParent($input: AddSubIssueInput!) { addSubIssue(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case RemoveParent:
+		input["issueId"], input["subIssueId"] = targetID, issueID
+		return `mutation RemoveParent($input: RemoveSubIssueInput!) { removeSubIssue(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case AddSubIssue:
+		input["issueId"], input["subIssueId"] = issueID, targetID
+		return `mutation AddSubIssue($input: AddSubIssueInput!) { addSubIssue(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	case RemoveSubIssue:
+		input["issueId"], input["subIssueId"] = issueID, targetID
+		return `mutation RemoveSubIssue($input: RemoveSubIssueInput!) { removeSubIssue(input: $input) { clientMutationId } }`, map[string]interface{}{
+			"input": input,
+		}
+	default:
+		return "", nil
+	}
+}
