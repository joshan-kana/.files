+func TestRelationshipPreviewReadyEmptyOmitted(t *testing.T) {
+	ctx := newTestContext(t)
+	m := NewModel(ctx)
+	m.SetWidth(80)
+	m.SetRow(&data.IssueData{ID: "issue-1", Title: "Example issue", Body: "Details"})
