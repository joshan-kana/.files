+func TestIssueRelationshipsSessionCacheStoresEmptyResultsAndRetainsOnRefreshError(t *testing.T) {
+	m, issueSection := newIssueRelationshipsTestModel(t)
+	m.issueSidebar.SetRow(&issueSection.Issues[0])
+	m.relationshipPreviewGeneration = 1
+	m.issueSidebar.SetRelationshipPreviewLoading()
+
+	updatedModel, _ := m.Update(issueRelationshipsMsg{
+		ContentID:     "issue-1",
+		Generation:    1,
+		Relationships: data.IssueRelationships{},
+	})
+	m = updatedModel.(Model)
+	require.Contains(t, m.relationshipCache, "issue-1")
+	m.onViewedRowChanged()
+	require.NotContains(t, m.issueSidebar.View(), "Loading…")
+	require.NotContains(t, m.issueSidebar.View(), "Relationships")
+
+	relationships := data.IssueRelationships{
+		Parent: &data.RelatedIssue{
+			Title:      "Useful cached parent",
+			Number:     12,
+			Repository: data.Repository{NameWithOwner: "owner/repo"},
+		},
+	}
+	m.relationshipPreviewGeneration++
+	m.issueSidebar.SetRelationshipPreviewReady(relationships)
+	m.relationshipCache["issue-1"] = relationships
+	require.Contains(t, m.issueSidebar.View(), "Useful cached parent")
+	updatedModel, _ = m.Update(issueRelationshipsMsg{
+		ContentID:  "issue-1",
+		Generation: m.relationshipPreviewGeneration,
+		Err:        errors.New("refresh failed"),
+	})
+	m = updatedModel.(Model)
+	view := m.issueSidebar.View()
+	require.Contains(t, view, "Useful cached parent")
+	require.Contains(t, view, "Refresh unavailable")
+	require.NotContains(t, view, "Unavailable")
+}
