+
+func fetchSubIssuesRelationships(
+	client *gh.GraphQLClient,
+	issueID string,
+) (*RelatedIssue, SubIssuesSummary, RelatedIssueConnection, error) {
+	var all RelatedIssueConnection
+	var parent *RelatedIssue
+	var summary SubIssuesSummary
+	after := ""
+	seen := map[string]bool{}
+	seenCursors := map[string]bool{"": true}
+	for {
+		var result struct {
+			Node struct {
+				Issue struct {
+					Parent           *RelatedIssue
+					SubIssues        RelatedIssueConnection `graphql:"subIssues(first: 100, after: $after)"`
+					SubIssuesSummary SubIssuesSummary
+				} `graphql:"... on Issue"`
+			} `graphql:"node(id: $id)"`
+		}
+		if err := queryGraphQL(
+			client,
+			"FetchIssueRelationships",
+			&result,
+			relationshipVariables(issueID, after),
+		); err != nil {
+			return nil, SubIssuesSummary{}, RelatedIssueConnection{}, err
+		}
+		page := result.Node.Issue.SubIssues
+		if result.Node.Issue.Parent != nil {
+			parent = result.Node.Issue.Parent
+		}
+		if result.Node.Issue.SubIssuesSummary.Total > 0 ||
+			result.Node.Issue.SubIssuesSummary.Completed > 0 {
+			summary = result.Node.Issue.SubIssuesSummary
+		}
+		if all.TotalCount < page.TotalCount {
+			all.TotalCount = page.TotalCount
+		}
+		appendRelatedIssues(&all.Nodes, seen, page.Nodes)
+		if !page.PageInfo.HasNextPage {
+			all.PageInfo = page.PageInfo
+			return parent, summary, all, nil
+		}
+		if page.PageInfo.EndCursor == "" || page.PageInfo.EndCursor == after {
+			return nil, SubIssuesSummary{}, RelatedIssueConnection{}, fmt.Errorf(
+				"sub-issues pagination cursor did not advance",
+			)
+		}
+		if seenCursors[page.PageInfo.EndCursor] {
+			return nil, SubIssuesSummary{}, RelatedIssueConnection{}, fmt.Errorf(
+				"sub-issues pagination cursor repeated: %q",
+				page.PageInfo.EndCursor,
+			)
+		}
+		seenCursors[page.PageInfo.EndCursor] = true
+		after = page.PageInfo.EndCursor
+	}
+}
