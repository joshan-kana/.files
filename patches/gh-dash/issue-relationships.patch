+
+func TestIssueRelationshipEditorHasDiscoverableDefaultBinding(t *testing.T) {
+	require.Equal(t, []string{"i"}, IssueKeys.EditRelationships.Keys())
+	require.Equal(t, "edit relationships", IssueKeys.EditRelationships.Help().Desc)
+}
+
+func TestIssueRelationshipEditorCanBeRebound(t *testing.T) {
+	original := IssueKeys.EditRelationships
+	t.Cleanup(func() { IssueKeys.EditRelationships = original })
+
+	err := rebindIssueKeys(
+		[]config.Keybinding{
+			{Builtin: "editRelationships", Key: "gR", Name: "relationships"},
+		},
+	)
+	require.NoError(t, err)
+	require.Equal(t, []string{"gR"}, IssueKeys.EditRelationships.Keys())
+	require.Equal(t, "relationships", IssueKeys.EditRelationships.Help().Desc)
+}
