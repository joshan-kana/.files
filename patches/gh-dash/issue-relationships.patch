+func appendRelatedIssues(dst *[]RelatedIssue, seen map[string]bool, nodes []RelatedIssue) {
+	for _, node := range nodes {
+		key := node.ID
+		if key == "" {
+			key = node.Identifier()
+		}
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		*dst = append(*dst, node)
+	}
