+// FetchIssueRelationships is deliberately separate from the base issue read.
+// Relationship permissions, pagination, or API availability must not make an
+// otherwise renderable issue disappear from the UI.
+func FetchIssueRelationships(issueID string) (IssueRelationships, error) {
+	if issueID == "" {
+		return IssueRelationships{}, fmt.Errorf("issue relationship lookup requires an issue ID")
+	}
+	if client == nil {
+		var err error
+		client, err = gh.DefaultGraphQLClient()
+		if err != nil {
+			return IssueRelationships{}, err
+		}
+	}
+	parent, summary, subIssues, err := fetchSubIssuesRelationships(client, issueID)
+	if err != nil {
