+func (m *Model) renderRelationships() string {
+	if m.issue == nil {
+		return ""
+	}
+
+	primary := lipgloss.NewStyle().Foreground(m.ctx.Theme.PrimaryText)
+	secondary := lipgloss.NewStyle().Foreground(m.ctx.Theme.SecondaryText)
+	faint := lipgloss.NewStyle().Foreground(m.ctx.Theme.FaintText)
+	heading := primary.Bold(true)
+
+	switch m.relationshipState {
+	case relationshipPreviewLoading, relationshipPreviewIdle:
+		lines := []string{heading.Render("Relationships"), faint.Render("  Loading…")}
+		return strings.Join(lines, "\n")
+	case relationshipPreviewError:
+		lines := []string{
+			heading.Render("Relationships"),
+			faint.Render("  Unavailable"),
+		}
+		return strings.Join(lines, "\n")
+	case relationshipPreviewReady:
+		r := m.issue.Data.NativeRelationships()
+		if r.Parent == nil && r.SubIssues.TotalCount == 0 &&
+			r.BlockedBy.TotalCount == 0 &&
+			r.Blocking.TotalCount == 0 {
+			return ""
+		}
+
+		lines := []string{heading.Render("Relationships")}
+		renderIssue := func(issue data.RelatedIssue) string {
+			state := "open"
+			if issue.State == "CLOSED" {
+				state = "closed"
+			}
+			return lipgloss.JoinHorizontal(lipgloss.Top,
+				secondary.Render(issue.Identifier()),
+				" ",
+				primary.Render(issue.Title),
+				" ",
+				faint.Render("— "+state),
+			)
+		}
+		appendGroup := func(label string, issues []data.RelatedIssue, total int) {
+			if total == 0 {
+				return
+			}
+			if label == "Sub-issues" &&
+				(r.SubIssuesSummary.Total > 0 || r.SubIssuesSummary.Completed > 0) {
+				lines = append(
+					lines,
+					lipgloss.JoinHorizontal(
+						lipgloss.Top,
+						secondary.Render("  "+label),
+						faint.Render(
+							fmt.Sprintf(
+								"  %d / %d complete",
+								r.SubIssuesSummary.Completed,
+								r.SubIssuesSummary.Total,
+							),
+						),
+					),
+				)
+			} else {
+				lines = append(lines, secondary.Render("  "+label))
+			}
+			for _, issue := range issues {
+				lines = append(lines, "    "+renderIssue(issue))
+			}
+			if len(issues) < total {
+				lines = append(
+					lines,
+					faint.Render(fmt.Sprintf("    … and %d more", total-len(issues))),
+				)
+			}
+		}
+		if r.Parent != nil {
+			appendGroup("Parent", []data.RelatedIssue{*r.Parent}, 1)
+		}
+		appendGroup("Sub-issues", r.SubIssues.Nodes, r.SubIssues.TotalCount)
+		appendGroup("Blocked by", r.BlockedBy.Nodes, r.BlockedBy.TotalCount)
+		appendGroup("Blocking", r.Blocking.Nodes, r.Blocking.TotalCount)
+		return strings.Join(lines, "\n")
+	default:
+		return ""
+	}
