+
+func TestRelationshipPreviewErrorState(t *testing.T) {
+	ctx := newTestContext(t)
+	m := NewModel(ctx)
+	m.SetWidth(80)
+	m.SetRow(&data.IssueData{ID: "issue-1", Title: "Example issue", Body: "Details"})
+	m.SetRelationshipPreviewLoading()
+	m.SetRelationshipPreviewError(errors.New("API rate limit exceeded"))
+
+	preview := m.renderRelationships()
+	require.Contains(t, preview, "Relationships")
+	require.NotContains(t, preview, "Loading…")
+	require.Contains(t, preview, "Unavailable")
+
+	view := m.View()
+	require.Contains(t, view, "Relationships")
+	require.Contains(t, view, "Unavailable")
+	// Rest of the issue preview remains usable
+	require.Contains(t, view, "Example issue")
+	require.Contains(t, view, "Details")
+}
