+package data
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	gh "github.com/cli/go-gh/v2/pkg/api"
+)
+
+func TestValidateRelationshipMutationUsesLiveState(t *testing.T) {
+	current := IssueRelationships{
+		Parent:    &RelatedIssue{ID: "parent"},
+		SubIssues: RelatedIssueConnection{Nodes: []RelatedIssue{{ID: "child"}}},
+		BlockedBy: RelatedIssueConnection{Nodes: []RelatedIssue{{ID: "prereq"}}},
+		Blocking:  RelatedIssueConnection{Nodes: []RelatedIssue{{ID: "downstream"}}},
+	}
+	for _, test := range []struct {
+		name    string
+		id      string
+		mut     RelationshipMutation
+		wantErr bool
+	}{
+		{"duplicate prerequisite", "prereq", AddBlockedBy, true},
+		{"missing prerequisite removal", "missing", RemoveBlockedBy, true},
+		{"duplicate child", "child", AddSubIssue, true},
+		{"parent replacement", "other-parent", SetParent, true},
+		{"current parent removal", "parent", RemoveParent, false},
+		{"new dependency", "new", AddBlocking, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if err := validateRelationshipMutation(
+				current,
+				test.id,
+				test.mut,
+			); (err != nil) != test.wantErr {
+				t.Fatalf("validateRelationshipMutation() error = %v, wantErr %v", err, test.wantErr)
+			}
+		})
+	}
+}
+
+func TestRelationshipMutationRequestInvertsBlockingDirection(t *testing.T) {
+	_, variables := relationshipMutationRequest("issue", "target", AddBlocking)
+	input := variables["input"].(map[string]interface{})
+	if input["issueId"] != "target" || input["blockingIssueId"] != "issue" {
+		t.Fatalf("AddBlocking input = %#v, want target blocking issue", input)
+	}
+}
+
+func TestFetchProjectRelationshipCandidatesUsesGraphQLDecodePath(t *testing.T) {
+	originalClient := projectGraphQLClient
+	originalDo := projectGraphQLDo
+	defer func() {
+		projectGraphQLClient = originalClient
+		projectGraphQLDo = originalDo
+	}()
+	var requestCount int
+	server := httptest.NewServer(
+		http.HandlerFunc(func(response http.ResponseWriter, request *http.Request) {
+			requestCount++
+			if request.Method != http.MethodPost || request.URL.Path != "/graphql" {
+				t.Errorf(
+					"GraphQL request = %s %s, want POST /graphql",
+					request.Method,
+					request.URL.Path,
+				)
+			}
+			var body struct {
+				Query     string                 `json:"query"`
+				Variables map[string]interface{} `json:"variables"`
+			}
+			if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
