+
+func TestCandidateSummaryIncludesRepositoryNumberTitleAndState(t *testing.T) {
+	summary := related("id", "octo/tools", 42, "Cache cleanup", "CLOSED").Summary()
+	require.True(t, strings.Contains(summary, "octo/tools#42"))
+	require.True(t, strings.Contains(summary, "Cache cleanup"))
+	require.True(t, strings.Contains(summary, "closed"))
+}
