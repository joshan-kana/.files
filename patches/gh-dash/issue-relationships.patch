+func (m *Model) renderRelationships() string {
+	r := m.issue.Data.NativeRelationships()
+	if r.Parent == nil && r.SubIssues.TotalCount == 0 && r.BlockedBy.TotalCount == 0 && r.Blocking.TotalCount == 0 {
+		return ""
+	}
+
+	lines := []string{"Relationships"}
+	appendGroup := func(label string, issues []data.RelatedIssue, total int) {
+		if total == 0 {
+			return
+		}
+		if label == "Sub-issues" && (r.SubIssuesSummary.Total > 0 || r.SubIssuesSummary.Completed > 0) {
+			lines = append(lines, fmt.Sprintf("  %s  %d / %d complete", label, r.SubIssuesSummary.Completed, r.SubIssuesSummary.Total))
+		} else {
+			lines = append(lines, "  "+label)
+		}
+		for _, issue := range issues {
+			lines = append(lines, "    "+issue.Summary())
+		}
+		if len(issues) < total {
+			lines = append(lines, fmt.Sprintf("    … and %d more", total-len(issues)))
+		}
+	}
+	if r.Parent != nil {
+		appendGroup("Parent", []data.RelatedIssue{*r.Parent}, 1)
+	}
+	appendGroup("Sub-issues", r.SubIssues.Nodes, r.SubIssues.TotalCount)
+	appendGroup("Blocked by", r.BlockedBy.Nodes, r.BlockedBy.TotalCount)
+	appendGroup("Blocking", r.Blocking.Nodes, r.Blocking.TotalCount)
+	return lipgloss.NewStyle().Foreground(m.ctx.Theme.FaintText).Render(strings.Join(lines, "\n"))
+}
