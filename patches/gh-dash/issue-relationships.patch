+func relationshipVariables(issueID, after string) map[string]interface{} {
+	var cursor *graphql.String
+	if after != "" {
+		value := graphql.String(after)
+		cursor = &value
+	}
+	return map[string]interface{}{"id": graphql.ID(issueID), "after": cursor}
