+package data
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	gh "github.com/cli/go-gh/v2/pkg/api"
+	graphql "github.com/cli/shurcooL-graphql"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFetchIssueRelationshipsPaginatesAllConnections(t *testing.T) {
+	originalClient := client
+	originalQuery := queryGraphQL
+	defer func() {
+		client = originalClient
+		queryGraphQL = originalQuery
+	}()
+	client = &gh.GraphQLClient{}
+	queryGraphQL = func(_ *gh.GraphQLClient, _ string, result interface{}, variables map[string]interface{}) error {
+		after := ""
+		if cursor, ok := variables["after"].(*graphql.String); ok && cursor != nil {
+			after = string(*cursor)
+		}
+		page := 0
+		if after != "" {
+			page = 1
+		}
+		payload := map[string]interface{}{
+			"node": map[string]interface{}{"issue": map[string]interface{}{}},
+		}
+		issue := payload["node"].(map[string]interface{})["issue"].(map[string]interface{})
+		if page == 0 {
+			issue["parent"] = map[string]interface{}{
+				"id":         "parent-1",
+				"number":     1,
+				"title":      "Parent",
+				"state":      "OPEN",
+				"repository": map[string]interface{}{"nameWithOwner": "o/r"},
+			}
+			issue["subIssuesSummary"] = map[string]interface{}{"total": 101, "completed": 4}
+		}
+		field := "subIssues"
+		queryJSON := fmt.Sprintf("%T", result)
+		if strings.Contains(queryJSON, "BlockedBy") {
+			field = "blockedBy"
+		} else if strings.Contains(queryJSON, "Blocking") {
+			field = "blocking"
+		}
+		nodes := []map[string]interface{}{}
+		start := page * 100
+		end := start + 1
+		if page == 0 {
+			end = 100
+		}
+		for i := start; i < end; i++ {
+			nodes = append(nodes, map[string]interface{}{
+				"id": fmt.Sprintf("%s-%d", field, i), "number": i + 1,
+				"title": fmt.Sprintf("%s %d", field, i), "state": "OPEN",
+				"repository": map[string]interface{}{"nameWithOwner": "o/r"},
+			})
+		}
+		issue[field] = map[string]interface{}{
+			"nodes": nodes, "totalCount": 101,
+			"pageInfo": map[string]interface{}{"hasNextPage": page == 0, "endCursor": "cursor-100"},
+		}
+		encoded, err := json.Marshal(payload)
+		require.NoError(t, err)
+		return json.Unmarshal(encoded, result)
+	}
+
+	got, err := FetchIssueRelationships("issue-1")
+	require.NoError(t, err)
+	require.Len(t, got.SubIssues.Nodes, 101)
+	require.Len(t, got.BlockedBy.Nodes, 101)
+	require.Len(t, got.Blocking.Nodes, 101)
+	require.Equal(t, 101, got.SubIssues.TotalCount)
+	require.Equal(t, 101, got.BlockedBy.TotalCount)
+	require.Equal(t, 101, got.Blocking.TotalCount)
+	require.Equal(t, "parent-1", got.Parent.ID)
+}
+
+func TestFetchIssueRelationshipsRejectsStalledPagination(t *testing.T) {
+	originalClient := client
+	originalQuery := queryGraphQL
+	defer func() {
+		client = originalClient
+		queryGraphQL = originalQuery
+	}()
+	client = &gh.GraphQLClient{}
+	queryGraphQL = func(_ *gh.GraphQLClient, _ string, result interface{}, _ map[string]interface{}) error {
+		payload := map[string]interface{}{
+			"node": map[string]interface{}{"issue": map[string]interface{}{
+				"subIssues": map[string]interface{}{
+					"nodes": []interface{}{}, "totalCount": 1,
+					"pageInfo": map[string]interface{}{"hasNextPage": true, "endCursor": "same"},
+				},
+			}},
+		}
+		encoded, err := json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		return json.Unmarshal(encoded, result)
+	}
+	_, err := FetchIssueRelationships("issue-1")
+	require.ErrorContains(t, err, "pagination cursor did not advance")
+}
+
+func TestFetchIssueRelationshipsRejectsCursorCycle(t *testing.T) {
+	originalClient := client
+	originalQuery := queryGraphQL
+	defer func() {
+		client = originalClient
+		queryGraphQL = originalQuery
+	}()
+	client = &gh.GraphQLClient{}
+	queryGraphQL = func(_ *gh.GraphQLClient, _ string, result interface{}, variables map[string]interface{}) error {
+		after := ""
+		if cursor, ok := variables["after"].(*graphql.String); ok && cursor != nil {
+			after = string(*cursor)
+		}
+		endCursor := "cursor-a"
+		switch after {
+		case "cursor-a":
+			endCursor = "cursor-b"
+		case "cursor-b":
+			endCursor = "cursor-a"
+		}
+		payload := map[string]interface{}{
+			"node": map[string]interface{}{"issue": map[string]interface{}{
+				"subIssues": map[string]interface{}{
+					"nodes": []interface{}{}, "totalCount": 1,
+					"pageInfo": map[string]interface{}{"hasNextPage": true, "endCursor": endCursor},
+				},
+			}},
+		}
+		encoded, err := json.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		return json.Unmarshal(encoded, result)
+	}
+	_, err := FetchIssueRelationships("issue-1")
+	require.ErrorContains(t, err, "pagination cursor repeated")
+}
