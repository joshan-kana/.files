@@ -0,0 +1,231 @@
+package projecteditor
+
+import (
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/config"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/keys"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/theme"
+)
+
+func key(text string) tea.KeyPressMsg {
+	if text == "enter" {
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	}
+	if text == "backspace" {
+		return tea.KeyPressMsg{Code: tea.KeyBackspace}
+	}
+	runes := []rune(text)
+	return tea.KeyPressMsg{Code: runes[0], Text: text}
+}
+
+func newEditorTestContext(t *testing.T) *context.ProgramContext {
+	t.Helper()
+	cfg, err := config.ParseConfig(config.Location{
+		ConfigFlag:       "../../../config/testdata/test-config.yml",
+		SkipGlobalConfig: true,
+	})
+	require.NoError(t, err)
+	thm := theme.ParseTheme(&cfg)
+	return &context.ProgramContext{Config: &cfg, Theme: thm, Styles: context.InitStyles(thm)}
+}
+
+func TestEditorFlowChoosesProjectThenSingleSelectOption(t *testing.T) {
+	ctx := newEditorTestContext(t)
+	item := data.ProjectItem{
+		ID:      "item-1",
+		Project: data.Project{ID: "project-1", Number: 1, Title: "Roadmap"},
+	}
+	m := New(ctx, "issue", 3, 7, "issue-1", "owner/repo", []data.ProjectItem{item})
+
+	var cmd tea.Cmd
+	m, cmd = m.Update(tea.KeyPressMsg{Text: "enter"})
+	require.NotNil(t, cmd)
+	require.Equal(t, modeLoadingFields, m.mode)
+
+	m, _ = m.Update(FieldsFetchedMsg{
+		ProjectID: "project-1",
+		Fields: []data.ProjectField{{
+			ID: "field-1", Name: "Status", Type: "SINGLE_SELECT",
+			Options: []data.ProjectOption{{ID: "todo", Name: "Todo"}, {ID: "done", Name: "Done"}},
+		}},
+	})
+	require.Equal(t, modeFields, m.mode)
+
+	m, _ = m.Update(tea.KeyPressMsg{Text: "enter"})
+	require.Equal(t, modeOptions, m.mode)
+
+	m, cmd = m.Update(tea.KeyPressMsg{Text: "down"})
+	require.Nil(t, cmd)
+	require.Equal(t, 1, m.option)
+}
+
+func TestDefaultProjectEditorKeyIsF(t *testing.T) {
+	require.Equal(t, []string{"f"}, keys.PRKeys.EditProject.Keys())
+	require.Equal(t, []string{"f"}, keys.IssueKeys.EditProject.Keys())
+}
+
+func TestIterationFieldsAreDisplayOnly(t *testing.T) {
+	require.False(t, isEditable("ProjectV2IterationField"))
+	require.False(t, isEditable("ITERATION"))
+}
+
+func TestSingleSelectClearChoiceIsFilterableAndDistinct(t *testing.T) {
+	ctx := newEditorTestContext(t)
+	m := New(ctx, "issue", 1, 1, "issue-1", "owner/repo", []data.ProjectItem{{
+		Project: data.Project{ID: "project-1", Number: 1, Title: "Roadmap"},
+	}})
+	m.mode = modeOptions
+	m.fields = []data.ProjectField{{
+		ID: "status", Name: "Status", Type: "SINGLE_SELECT",
+		Options: []data.ProjectOption{{ID: "todo", Name: "Todo"}},
+	}}
+	m.optionField = 0
+	m.filter.SetValue("clear")
+	m.applyFilter()
+	require.Equal(t, []int{0}, m.filtered)
+	require.Equal(t, clearProjectOptionID, m.options()[m.filtered[0]].ID)
+	require.Contains(t, m.filterValues()[m.filtered[0]], "Clear value")
+}
+
+func TestSelectingClearChoiceDispatchesClearProjectField(t *testing.T) {
+	originalClear := clearProjectField
+	originalUpdate := updateProjectField
+	originalFetch := fetchProjectItemsFull
+	t.Cleanup(func() {
+		clearProjectField = originalClear
+		updateProjectField = originalUpdate
+		fetchProjectItemsFull = originalFetch
+	})
+	clearCalled := false
+	updateCalled := false
+	clearProjectField = func(string, string, string, string) error {
+		clearCalled = true
+		return nil
+	}
+	updateProjectField = func(string, string, string, string, string, string) error {
+		updateCalled = true
+		return nil
+	}
+	fetchProjectItemsFull = func(string) (data.ProjectItems, error) {
+		return data.ProjectItems{}, nil
+	}
+
+	ctx := newEditorTestContext(t)
+	m := New(ctx, "issue", 1, 1, "issue-1", "owner/repo", []data.ProjectItem{{
+		ID: "item-1", Project: data.Project{ID: "project-1", Number: 1, Title: "Roadmap"},
+	}})
+	m.mode = modeOptions
+	m.fields = []data.ProjectField{{
+		ID: "status", Name: "Status", Type: "SINGLE_SELECT",
+		Options: []data.ProjectOption{{ID: "todo", Name: "Todo"}},
+	}}
+	m.optionField = 0
+	m.filter.SetValue("clear")
+	m.applyFilter()
+	updated, cmd := m.Update(key("enter"))
+	require.Equal(t, modeLoadingFields, updated.mode)
+	require.NotNil(t, cmd)
+	msg := cmd()
+	require.NotNil(t, msg)
+	require.False(t, updateCalled)
+	require.True(t, clearCalled)
+}
+
+func TestEditorFiltersProjectsCaseInsensitivelyAndRestoresOnClear(t *testing.T) {
+	ctx := newEditorTestContext(t)
+	m := New(ctx, "issue", 1, 1, "issue-1", "owner/repo", []data.ProjectItem{
+		{Project: data.Project{ID: "one", Number: 1, Title: "Infrastructure"}},
+		{Project: data.Project{ID: "two", Number: 2, Title: "Priority"}},
+	})
+	m, _ = m.Update(key("/"))
+	m, _ = m.Update(key("INFRA"))
+	require.Equal(t, "INFRA", m.filter.Value())
+	require.Len(t, m.filtered, 1)
+	require.Equal(t, 0, m.filtered[0])
+	m, _ = m.Update(key("backspace"))
+	require.Equal(t, "INFR", m.filter.Value())
+	m.filter.SetValue("")
+	m.applyFilter()
+	require.Len(t, m.filtered, 2)
+}
+
+func TestEditorFiltersFieldsAndOptions(t *testing.T) {
+	ctx := newEditorTestContext(t)
+	m := New(ctx, "issue", 1, 1, "issue-1", "owner/repo", []data.ProjectItem{{
+		Project: data.Project{ID: "project-1", Number: 1, Title: "Roadmap"},
+	}})
+	m.mode = modeFields
+	m.fields = []data.ProjectField{
+		{
+			ID:      "status",
+			Name:    "Status",
+			Type:    "SINGLE_SELECT",
+			Options: []data.ProjectOption{{ID: "high", Name: "High"}, {ID: "low", Name: "Low"}},
+		},
