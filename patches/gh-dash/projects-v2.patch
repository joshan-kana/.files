+	first, err := FetchProjectItemsBatched([]string{"issue-a", "issue-a"})
+	require.NoError(t, err)
+	second, err := FetchProjectItemsBatched([]string{"issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+	firstField, ok := first["issue-a"].Nodes[0].Field("Status")
+	require.True(t, ok)
+	secondField, ok := second["issue-a"].Nodes[0].Field("Status")
+	require.True(t, ok)
+	require.Equal(t, "Inbox", firstField.Value)
+	require.Equal(t, "Inbox", secondField.Value)
+
+	BeginProjectRefreshGeneration()
+	refreshed, err := FetchProjectItemsBatched([]string{"issue-a", "issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+	refreshedField, ok := refreshed["issue-a"].Nodes[0].Field("Status")
+	require.True(t, ok)
+	require.Equal(t, "Review", refreshedField.Value)
