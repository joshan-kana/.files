+func TestNotificationIssueProjectPreviewCachesFullItemsBeforeSidebarSync(t *testing.T) {
+	m, issue := newNotificationProjectTestModel(t)
+	listOnly := notificationProjectItems("Status", "Inbox")
+	full := notificationProjectItems("Status", "Review", "Area", "Platform")
+	issue.ProjectItems = listOnly
+	m.notificationView.SetSubjectIssue(issue, "notification-1")
+	m.issueSidebar.SetRow(issue)
+	m.issueSidebar.SetProjectPreviewLoading()
+
+	updated, _ := m.Update(notificationProjectPreviewMsg{
+		NotificationId: "notification-1",
+		ContentID:      issue.ID,
+		Items:          full,
+	})
+	m = updated.(Model)
+
+	cached := m.notificationView.GetSubjectIssue()
+	require.NotNil(t, cached)
+	require.Equal(t, full, cached.ProjectItems,
+		"the notification cache must receive the authoritative Project items")
+	require.NotEmpty(t, cached.ProjectItems.Nodes,
+		"a Ready notification subject must retain its fetched Project items")
+
+	// Reinstall the cached notification subject through the normal sidebar path.
+	m.syncSidebar()
+	rendered := m.issueSidebar.View()
+	require.Contains(t, rendered, "Review")
+	require.Contains(t, rendered, "Platform")
+	require.NotContains(t, rendered, "Inbox")
+}
