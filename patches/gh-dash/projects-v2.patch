diff --git a/internal/data/projectlist.go b/internal/data/projectlist.go
new file mode 100644
index 0000000..b8369d9
--- /dev/null
+++ b/internal/data/projectlist.go
@@ -0,0 +1,676 @@
+package data
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"charm.land/log/v2"
+	gh "github.com/cli/go-gh/v2/pkg/api"
+)
+
+var projectGraphQLDo = func(client *gh.GraphQLClient, query string, variables map[string]interface{}, result interface{}) error {
+	return client.Do(query, variables, result)
+}
+
+var projectReadSleep = time.Sleep
+
+func projectGraphQLRead(client *gh.GraphQLClient, query string, variables map[string]interface{}, result interface{}) error {
+	for attempt := 1; attempt <= 3; attempt++ {
+		generation, err := projectEnrichmentAllowedGeneration()
+		if err != nil {
+			return err
+		}
+		err = projectGraphQLDo(client, query, variables, result)
+		if err == nil {
+			recordProjectNetworkSuccess(generation)
+			return nil
+		}
+		if classifyProjectFailure(err).class == projectTransient && attempt < 3 {
+			projectReadSleep(100 * time.Millisecond)
+			continue
+		}
+		recordProjectEnrichmentFailure(err)
+		return err
+	}
+	return fmt.Errorf("Project read exhausted retry attempts")
+}
+
+// projectColumnsKey identifies the shape of list metadata already held in the
+// process-local cache. It is intentionally not persisted: a new gh-dash
+// process always asks GitHub for current Project state.
+func projectColumnsKey(columns []ProjectColumn) string {
+	parts := make([]string, 0, len(columns))
+	for _, column := range columns {
+		parts = append(parts, column.Name+"\x00"+column.FieldID+"\x00"+column.Project)
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, "\x01")
+}
+
+type projectSchemaCache struct {
+	mu       sync.Mutex
+	fields   map[string][]ProjectField
+	inFlight map[string]*projectSchemaCall
+}
+
+type projectSchemaCall struct {
+	done   chan struct{}
+	fields []ProjectField
+	err    error
+}
+
+var projectSchemas = projectSchemaCache{fields: make(map[string][]ProjectField), inFlight: make(map[string]*projectSchemaCall)}
+
+// FetchProjectSchema fetches only stable field identity and type. Options are
+// deliberately excluded from list enrichment and are fetched live by the
+// editor when it opens.
+func FetchProjectSchema(projectID string) ([]ProjectField, error) {
+	log.Debug("Fetching Project schema", "projectID", projectID)
+	projectSchemas.mu.Lock()
+	if fields, ok := projectSchemas.fields[projectID]; ok {
+		projectSchemas.mu.Unlock()
+		return append([]ProjectField(nil), fields...), nil
+	}
+	if call, ok := projectSchemas.inFlight[projectID]; ok {
+		projectSchemas.mu.Unlock()
+		<-call.done
+		return append([]ProjectField(nil), call.fields...), call.err
+	}
+	call := &projectSchemaCall{done: make(chan struct{})}
+	projectSchemas.inFlight[projectID] = call
+	projectSchemas.mu.Unlock()
+
+	client, err := projectGraphQLClient()
+	if err != nil {
+		completeProjectSchemaCall(projectID, call, nil, err)
+		return nil, err
+	}
+	var fields []ProjectField
+	var after *string
+	for {
+		query := `query ProjectSchema($id: ID!, $after: String) {
+  node(id: $id) { ... on ProjectV2 {
+    fields(first: 100, after: $after) { nodes {
+      __typename
+      ... on ProjectV2Field { id name dataType }
+      ... on ProjectV2IterationField { id name }
+      ... on ProjectV2SingleSelectField { id name }
+    } pageInfo { hasNextPage endCursor } }
+  } }
+}`
+		var response struct {
+			Node struct {
+				Fields struct {
+					Nodes []struct {
+						Typename string `json:"__typename"`
+						ID       string `json:"id"`
+						Name     string `json:"name"`
+						DataType string `json:"dataType"`
+					} `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"fields"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(client, query, map[string]interface{}{"id": projectID, "after": after}, &response); err != nil {
+			completeProjectSchemaCall(projectID, call, nil, err)
+			return nil, err
+		}
+		for _, field := range response.Node.Fields.Nodes {
+			fieldType := field.Typename
+			if field.DataType != "" {
+				fieldType = field.DataType
+			}
+			fields = append(fields, ProjectField{ID: field.ID, Name: field.Name, Type: fieldType})
+		}
+		if !response.Node.Fields.PageInfo.HasNextPage {
+			break
+		}
+		cursor := response.Node.Fields.PageInfo.EndCursor
+		after = &cursor
+	}
+	sort.SliceStable(fields, func(i, j int) bool { return strings.ToLower(fields[i].Name) < strings.ToLower(fields[j].Name) })
+	projectSchemas.mu.Lock()
+	projectSchemas.fields[projectID] = append([]ProjectField(nil), fields...)
+	delete(projectSchemas.inFlight, projectID)
+	call.fields = append([]ProjectField(nil), fields...)
+	close(call.done)
+	projectSchemas.mu.Unlock()
+	return fields, nil
+}
+
+func completeProjectSchemaCall(projectID string, call *projectSchemaCall, fields []ProjectField, err error) {
+	projectSchemas.mu.Lock()
+	if projectSchemas.inFlight[projectID] == call {
+		delete(projectSchemas.inFlight, projectID)
+	}
+	call.fields = append([]ProjectField(nil), fields...)
+	call.err = err
+	close(call.done)
+	projectSchemas.mu.Unlock()
+}
+
+type projectListValueRequest struct {
+	Alias     string
+	Name      string
+	Field     ProjectField
+	ByFieldID bool
+}
+
+func projectValueFragments(fieldType string) string {
+	switch strings.ToUpper(fieldType) {
+	case "PROJECTV2FIELD", "TEXT":
+		return `... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }`
+	case "NUMBER":
+		return `... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }`
+	case "DATE":
+		return `... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }`
+	case "PROJECTV2SINGLESELECTFIELD", "SINGLE_SELECT":
+		return `... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }`
+	case "PROJECTV2ITERATIONFIELD", "ITERATION":
+		return `... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }`
+	case "USERS":
+		return `... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }`
+	case "LABELS":
+		return `... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }`
+	case "REPOSITORY":
+		return `... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }`
+	default:
+		return `... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }`
+	}
+}
+
+func projectValueFromJSON(raw json.RawMessage) (ProjectFieldValue, error) {
+	var value struct {
+		Typename string  `json:"__typename"`
+		Text     string  `json:"text"`
+		Number   float64 `json:"number"`
+		Date     string  `json:"date"`
+		Name     string  `json:"name"`
+		OptionID string  `json:"optionId"`
+		Title    string  `json:"title"`
+		IterID   string  `json:"iterationId"`
+		Field    struct {
+			ID   string `json:"id"`
+			Name string `json:"name"`
+		} `json:"field"`
+		Users struct {
+			Nodes []struct {
+				Login string `json:"login"`
+				Name  string `json:"name"`
+			} `json:"nodes"`
+		} `json:"users"`
+		Labels struct {
+			Nodes []struct {
+				Name string `json:"name"`
+			} `json:"nodes"`
+		} `json:"labels"`
+		Repository struct {
+			NameWithOwner string `json:"nameWithOwner"`
+		} `json:"repository"`
+	}
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return ProjectFieldValue{}, err
+	}
+	result := ProjectFieldValue{Typename: value.Typename}
+	common := ProjectFieldRef{Common: struct {
+		ID   string
+		Name string
+	}{ID: value.Field.ID, Name: value.Field.Name}}
+	switch value.Typename {
+	case "ProjectV2ItemFieldTextValue":
+		result.TextValue.Field, result.TextValue.Text = common, value.Text
+	case "ProjectV2ItemFieldNumberValue":
+		result.NumberValue.Field, result.NumberValue.Number = common, value.Number
+	case "ProjectV2ItemFieldDateValue":
+		result.DateValue.Field, result.DateValue.Date = common, value.Date
+	case "ProjectV2ItemFieldSingleSelectValue":
+		result.SingleSelectValue.Field = ProjectFieldRef{SingleSelect: struct {
+			ID   string
+			Name string
+		}{ID: value.Field.ID, Name: value.Field.Name}}
+		result.SingleSelectValue.Name, result.SingleSelectValue.OptionID = value.Name, value.OptionID
+	case "ProjectV2ItemFieldIterationValue":
+		result.IterationValue.Field = ProjectFieldRef{Iteration: struct {
+			ID   string
+			Name string
+		}{ID: value.Field.ID, Name: value.Field.Name}}
+		result.IterationValue.Title, result.IterationValue.IterationID = value.Title, value.IterID
+	case "ProjectV2ItemFieldUserValue":
+		result.UserValue.Field = common
+		for _, user := range value.Users.Nodes {
+			result.UserValue.Users.Nodes = append(result.UserValue.Users.Nodes, struct {
+				Login string
+				Name  string
+			}{Login: user.Login, Name: user.Name})
+		}
+	case "ProjectV2ItemFieldLabelValue":
+		result.LabelValue.Field = common
+		for _, label := range value.Labels.Nodes {
+			result.LabelValue.Labels.Nodes = append(result.LabelValue.Labels.Nodes, struct{ Name string }{Name: label.Name})
+		}
+	case "ProjectV2ItemFieldRepositoryValue":
+		result.RepositoryValue.Field = common
+		result.RepositoryValue.Repository.NameWithOwner = value.Repository.NameWithOwner
+	default:
+		return ProjectFieldValue{}, fmt.Errorf("unsupported Project field value type %q", value.Typename)
+	}
+	return result, nil
+}
+
+func fetchConfiguredProjectValues(itemIDs []string, fields []ProjectField, columns []ProjectColumn, project Project) (map[string][]ProjectFieldValue, error) {
+	requests := make([]projectListValueRequest, 0, len(columns))
+	for index, column := range columns {
+		if column.Project != "" && !projectMatchesSelector(project, column.Project) {
+			continue
+		}
+		matches := make([]ProjectField, 0, 1)
+		for _, field := range fields {
+			if (column.FieldID != "" && field.ID == column.FieldID) || (column.FieldID == "" && field.Name == column.Name) {
+				matches = append(matches, field)
+			}
+		}
+		if len(matches) != 1 {
+			continue
+		}
+		requests = append(requests, projectListValueRequest{
+			Alias: fmt.Sprintf("value%d", index), Name: matches[0].Name, Field: matches[0],
+			ByFieldID: column.FieldID != "" && countProjectFieldsByName(fields, matches[0].Name) > 1,
+		})
+	}
+	if len(requests) == 0 || len(itemIDs) == 0 {
+		return map[string][]ProjectFieldValue{}, nil
+	}
+	variables := map[string]interface{}{"ids": itemIDs}
+	var declarations []string
+	var selections []string
+	for index, request := range requests {
+		if request.ByFieldID {
+			selections = append(selections, fmt.Sprintf("%s: fieldValues(first: 100) { nodes { __typename %s } }", request.Alias, projectValueFragments(request.Field.Type)))
+			continue
+		}
+		variable := fmt.Sprintf("name%d", index)
+		declarations = append(declarations, "$"+variable+": String!")
+		variables[variable] = request.Name
+		selections = append(selections, fmt.Sprintf("%s: fieldValueByName(name: $%s) { __typename %s }", request.Alias, variable, projectValueFragments(request.Field.Type)))
+	}
+	declarationText := ""
+	if len(declarations) > 0 {
+		declarationText = ", " + strings.Join(declarations, ", ")
+	}
+	query := fmt.Sprintf("query ProjectColumnValues($ids: [ID!]!%s) { nodes(ids: $ids) { __typename ... on ProjectV2Item { id %s } } }", declarationText, strings.Join(selections, " "))
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	log.Debug("Fetching configured Project values", "projectID", project.ID, "items", len(itemIDs), "columns", len(requests))
+	var response struct {
+		Nodes []json.RawMessage `json:"nodes"`
+	}
+	if err := projectGraphQLRead(client, query, variables, &response); err != nil {
+		return nil, err
+	}
+	result := make(map[string][]ProjectFieldValue, len(response.Nodes))
+	for _, rawNode := range response.Nodes {
+		var node map[string]json.RawMessage
+		if err := json.Unmarshal(rawNode, &node); err != nil {
+			return nil, err
+		}
+		var itemID string
+		if err := json.Unmarshal(node["id"], &itemID); err != nil || itemID == "" {
+			continue
+		}
+		for _, request := range requests {
+			rawValue := node[request.Alias]
+			if request.ByFieldID {
+				var connection struct {
+					Nodes []json.RawMessage `json:"nodes"`
+				}
+				if err := json.Unmarshal(rawValue, &connection); err != nil {
+					return nil, err
+				}
+				for _, candidate := range connection.Nodes {
+					fieldValue, decodeErr := projectValueFromJSON(candidate)
+					if decodeErr == nil && projectValueFieldID(fieldValue) == request.Field.ID {
+						result[itemID] = append(result[itemID], fieldValue)
+					}
+				}
+				continue
+			}
+			if string(rawValue) == "null" || len(rawValue) == 0 {
+				continue
+			}
+			fieldValue, decodeErr := projectValueFromJSON(rawValue)
+			if decodeErr != nil {
+				return nil, decodeErr
+			}
+			result[itemID] = append(result[itemID], fieldValue)
+		}
+	}
+	return result, nil
+}
+
+func projectValueFieldID(value ProjectFieldValue) string {
+	switch value.Typename {
+	case "ProjectV2ItemFieldTextValue":
+		return value.TextValue.Field.IDNameID()
+	case "ProjectV2ItemFieldNumberValue":
+		return value.NumberValue.Field.IDNameID()
+	case "ProjectV2ItemFieldDateValue":
+		return value.DateValue.Field.IDNameID()
+	case "ProjectV2ItemFieldSingleSelectValue":
+		return value.SingleSelectValue.Field.IDNameID()
+	case "ProjectV2ItemFieldIterationValue":
+		return value.IterationValue.Field.IDNameID()
+	case "ProjectV2ItemFieldUserValue":
+		return value.UserValue.Field.IDNameID()
+	case "ProjectV2ItemFieldLabelValue":
+		return value.LabelValue.Field.IDNameID()
+	case "ProjectV2ItemFieldRepositoryValue":
+		return value.RepositoryValue.Field.IDNameID()
+	default:
+		return ""
+	}
+}
+
+func countProjectFieldsByName(fields []ProjectField, name string) int {
+	count := 0
+	for _, field := range fields {
+		if field.Name == name {
+			count++
+		}
+	}
+	return count
+}
+
+func fetchProjectItemsNetwork(contentIDs []string, columns []ProjectColumn) (map[string]ProjectItems, error) {
+	if len(contentIDs) == 0 {
+		return map[string]ProjectItems{}, nil
+	}
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	log.Debug("Fetching Project memberships", "contentIDs", len(contentIDs), "columns", len(columns))
+	query := `query ProjectMemberships($ids: [ID!]!) {
+  nodes(ids: $ids) {
+    __typename id
+    ... on Issue { projectItems(first: 20) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+	var response struct {
+		Nodes []struct {
+			ID           string `json:"id"`
+			ProjectItems struct {
+				Nodes []struct {
+					ID      string `json:"id"`
+					Project struct {
+						ID     string `json:"id"`
+						Number int    `json:"number"`
+						Title  string `json:"title"`
+						Owner  struct {
+							Login string `json:"login"`
+						} `json:"owner"`
+					} `json:"project"`
+				} `json:"nodes"`
+				PageInfo struct {
+					HasNextPage bool   `json:"hasNextPage"`
+					EndCursor   string `json:"endCursor"`
+				} `json:"pageInfo"`
+			} `json:"projectItems"`
+		} `json:"nodes"`
+	}
+	if err := projectGraphQLRead(client, query, map[string]interface{}{"ids": contentIDs}, &response); err != nil {
+		return nil, err
+	}
+	result := make(map[string]ProjectItems, len(response.Nodes))
+	type overflowMembership struct {
+		contentID string
+		after     string
+	}
+	var overflows []overflowMembership
+	for _, node := range response.Nodes {
+		for _, rawItem := range node.ProjectItems.Nodes {
+			result[node.ID] = appendProjectItem(result[node.ID], ProjectItem{
+				ID: rawItem.ID,
+				Project: Project{ID: rawItem.Project.ID, Number: rawItem.Project.Number, Title: rawItem.Project.Title,
+					Owner: ProjectOwner{User: struct{ Login string }{Login: rawItem.Project.Owner.Login}}},
+			})
+		}
+		if node.ProjectItems.PageInfo.HasNextPage {
+			if node.ProjectItems.PageInfo.EndCursor == "" {
+				return nil, fmt.Errorf("Project membership pagination returned an empty cursor for %s", node.ID)
+			}
+			overflows = append(overflows, overflowMembership{contentID: node.ID, after: node.ProjectItems.PageInfo.EndCursor})
+		}
+	}
+	for _, overflow := range overflows {
+		after := overflow.after
+		for {
+			query := `query ProjectMembershipOverflow($id: ID!, $after: String) {
+  node(id: $id) {
+    ... on Issue { projectItems(first: 20, after: $after) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20, after: $after) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+			var page struct {
+				Node struct {
+					ProjectItems struct {
+						Nodes []struct {
+							ID      string `json:"id"`
+							Project struct {
+								ID     string `json:"id"`
+								Number int    `json:"number"`
+								Title  string `json:"title"`
+								Owner  struct {
+									Login string `json:"login"`
+								} `json:"owner"`
+							} `json:"project"`
+						} `json:"nodes"`
+						PageInfo struct {
+							HasNextPage bool   `json:"hasNextPage"`
+							EndCursor   string `json:"endCursor"`
+						} `json:"pageInfo"`
+					} `json:"projectItems"`
+				} `json:"node"`
+			}
+			if err := projectGraphQLRead(client, query, map[string]interface{}{"id": overflow.contentID, "after": &after}, &page); err != nil {
+				return nil, err
+			}
+			for _, rawItem := range page.Node.ProjectItems.Nodes {
+				result[overflow.contentID] = appendProjectItem(result[overflow.contentID], ProjectItem{
+					ID: rawItem.ID,
+					Project: Project{ID: rawItem.Project.ID, Number: rawItem.Project.Number, Title: rawItem.Project.Title,
+						Owner: ProjectOwner{User: struct{ Login string }{Login: rawItem.Project.Owner.Login}}},
+				})
+			}
+			if !page.Node.ProjectItems.PageInfo.HasNextPage {
+				break
+			}
+			next := page.Node.ProjectItems.PageInfo.EndCursor
+			if next == "" || next == after {
+				return nil, fmt.Errorf("Project membership pagination returned a repeated cursor for %s", overflow.contentID)
+			}
+			after = next
+		}
+	}
+	if len(columns) == 0 {
+		return result, nil
+	}
+	type projectItemRef struct {
+		contentID string
+		index     int
+	}
+	byProject := make(map[string][]projectItemRef)
+	for contentID, projectItems := range result {
+		for index := range projectItems.Nodes {
+			byProject[projectItems.Nodes[index].Project.ID] = append(byProject[projectItems.Nodes[index].Project.ID], projectItemRef{contentID: contentID, index: index})
+		}
+	}
+	for projectID, refs := range byProject {
+		fields, schemaErr := FetchProjectSchema(projectID)
+		if schemaErr != nil {
+			return nil, schemaErr
+		}
+		itemIDs := make([]string, 0, len(refs))
+		var project Project
+		for _, ref := range refs {
+			item := result[ref.contentID].Nodes[ref.index]
+			itemIDs = append(itemIDs, item.ID)
+			project = item.Project
+		}
+		values, valuesErr := fetchConfiguredProjectValues(itemIDs, fields, columns, project)
+		if valuesErr != nil {
+			return nil, valuesErr
+		}
+		for _, ref := range refs {
+			projectItems := result[ref.contentID]
+			item := &projectItems.Nodes[ref.index]
+			for _, column := range columns {
+				if column.FieldID == "" && column.Project == "" && countProjectFieldsByName(fields, column.Name) > 1 && !containsString(item.AmbiguousFields, column.Name) {
+					item.AmbiguousFields = append(item.AmbiguousFields, column.Name)
+				}
+			}
+			item.FieldValues.Nodes = append(item.FieldValues.Nodes, values[item.ID]...)
+			result[ref.contentID] = projectItems
+		}
+	}
+	return result, nil
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
+
+func appendProjectItem(items ProjectItems, item ProjectItem) ProjectItems {
+	for index := range items.Nodes {
+		if items.Nodes[index].ID == item.ID {
+			return items
+		}
+	}
+	items.Nodes = append(items.Nodes, item)
+	return items
+}
