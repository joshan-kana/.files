+		previewDone <- err
+	}()
+	select {
+	case <-duplicate:
+		t.Fatal("membership request was not coalesced")
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	if err := <-listDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-previewDone; err != nil {
+		t.Fatal(err)
+	}
