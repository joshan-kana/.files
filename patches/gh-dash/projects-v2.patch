diff --git a/internal/data/projectcache.go b/internal/data/projectcache.go
new file mode 100644
index 0000000000000000000000000000000000000000..b17ea1bb7e00bbaa068af7fcb2883f163005ec9e
--- /dev/null
+++ b/internal/data/projectcache.go
@@ -0,0 +1,379 @@
+package data
+
+// Persistent Project cache. This file deliberately contains presentation data
+// only. It is a warm-start aid; every process and every refresh still performs
+// an authoritative GitHub membership/fingerprint read before cached data can
+// be marked verified or used for editing.
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"charm.land/log/v2"
+	gh "github.com/cli/go-gh/v2/pkg/api"
+)
+
+const (
+	projectCacheFormatVersion = 1
+	projectCacheRetention     = 30 * 24 * time.Hour
+)
+
+type projectCacheIdentity struct {
+	Host    string
+	Account string
+}
+
+type projectCacheEntry struct {
+	Host         string
+	Account      string
+	ContentID    string
+	ColumnsKey   string
+	Items        ProjectItems
+	FullPreview  bool
+	LastVerified time.Time
+	LastUsed     time.Time
+}
+
+type projectCacheFile struct {
+	Version int                 `json:"version"`
+	Entries []projectCacheEntry `json:"entries"`
+}
+
+var (
+	projectCacheMu             sync.Mutex
+	projectCacheIdentityFunc   = resolveProjectCacheIdentity
+	projectCacheUserCacheDir   = os.UserCacheDir
+	projectCacheNow            = time.Now
+	projectCacheLoadedIdentity *projectCacheIdentity
+	projectCacheLoaded         projectCacheFile
+)
+
+func ProjectCachePath() string {
+	base, err := projectCacheUserCacheDir()
+	if err != nil || base == "" {
+		return ""
+	}
+	return filepath.Join(base, "gh-dash", "projects", "cache-v1.json")
+}
+
+func resolveProjectCacheIdentity() (projectCacheIdentity, error) {
+	host := strings.TrimSpace(os.Getenv("GH_HOST"))
+	if host == "" {
+		host = "github.com"
+	}
+	if account := firstNonEmptyEnv("GH_USER", "GITHUB_USER", "GH_USERNAME"); account != "" {
+		return projectCacheIdentity{Host: host, Account: account}, nil
+	}
+	if account := ghConfigAccount(host); account != "" {
+		return projectCacheIdentity{Host: host, Account: account}, nil
+	}
+	// A token supplied outside gh's hosts.yml has no safe local account
+	// identity. Resolve it once from GitHub rather than mixing accounts.
+	client, err := gh.DefaultRESTClient()
+	if err != nil {
+		return projectCacheIdentity{}, err
+	}
+	var user struct {
+		Login string `json:"login"`
+	}
+	if err := client.Get("user", &user); err != nil {
+		return projectCacheIdentity{}, err
+	}
+	if user.Login == "" {
+		return projectCacheIdentity{}, errors.New("GitHub account identity was empty")
+	}
+	return projectCacheIdentity{Host: host, Account: user.Login}, nil
+}
+
+func firstNonEmptyEnv(names ...string) string {
+	for _, name := range names {
+		if value := strings.TrimSpace(os.Getenv(name)); value != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func ghConfigAccount(host string) string {
+	configDir, err := os.UserConfigDir()
+	if err != nil {
+		return ""
+	}
+	file, err := os.Open(filepath.Join(configDir, "gh", "hosts.yml"))
+	if err != nil {
+		return ""
+	}
+	defer file.Close()
+
+	currentHost := ""
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		if !strings.HasPrefix(scanner.Text(), "    ") && strings.HasSuffix(line, ":") {
+			currentHost = strings.TrimSuffix(line, ":")
+			continue
+		}
+		if currentHost == host && strings.HasPrefix(line, "user:") {
+			return strings.TrimSpace(strings.TrimPrefix(line, "user:"))
+		}
+	}
+	return ""
+}
+
+func loadProjectCache() (projectCacheIdentity, *projectCacheFile, error) {
+	identity, err := projectCacheIdentityFunc()
+	if err != nil || identity.Host == "" || identity.Account == "" {
+		return projectCacheIdentity{}, nil, fmt.Errorf(
+			"Project cache identity unavailable: %w",
+			err,
+		)
+	}
+	path := ProjectCachePath()
+	if path == "" {
+		return identity, &projectCacheFile{Version: projectCacheFormatVersion}, nil
+	}
+	projectCacheMu.Lock()
+	defer projectCacheMu.Unlock()
+	if projectCacheLoadedIdentity != nil && *projectCacheLoadedIdentity == identity {
+		copy := projectCacheLoaded
+		return identity, &copy, nil
+	}
+	cache := projectCacheFile{Version: projectCacheFormatVersion}
+	contents, readErr := os.ReadFile(path)
+	if readErr == nil {
+		if err := json.Unmarshal(
+			contents,
+			&cache,
+		); err != nil ||
+			cache.Version != projectCacheFormatVersion {
+			log.Debug("Ignoring corrupt or incompatible Project cache", "path", path)
+			cache = projectCacheFile{Version: projectCacheFormatVersion}
+		}
+	} else if !errors.Is(readErr, os.ErrNotExist) {
+		log.Debug("Ignoring unreadable Project cache", "path", path, "error", readErr)
+	}
+	filtered := cache.Entries[:0]
+	cutoff := projectCacheNow().Add(-projectCacheRetention)
+	for _, entry := range cache.Entries {
+		// Retention is housekeeping only. Keep every live host/account in the
+		// file so switching identities does not evict another account's warm
+		// entries when this process eventually writes the cache.
+		if entry.LastUsed.IsZero() || entry.LastUsed.After(cutoff) {
+			filtered = append(filtered, entry)
+		}
+	}
+	cache.Entries = filtered
+	projectCacheLoadedIdentity = &identity
+	projectCacheLoaded = cache
+	copy := cache
+	return identity, &copy, nil
+}
+
+func projectCacheEntryKey(contentID, columnsKey string) string {
+	return contentID + "\x00" + columnsKey
+}
+
+func cachedProjectItems(contentIDs []string, columns []ProjectColumn) map[string]ProjectItems {
+	identity, cache, err := loadProjectCache()
+	if err != nil {
+		return map[string]ProjectItems{}
+	}
+	wanted := make(map[string]struct{}, len(contentIDs))
+	for _, id := range uniqueContentIDs(contentIDs) {
+		wanted[id] = struct{}{}
+	}
+	columnsKey := projectColumnsKey(columns)
+	result := make(map[string]ProjectItems)
+	for index := range cache.Entries {
+		entry := cache.Entries[index]
+		if entry.Host != identity.Host || entry.Account != identity.Account {
+			continue
+		}
+		if _, ok := wanted[entry.ContentID]; !ok ||
+			(entry.ColumnsKey != columnsKey && !entry.FullPreview) {
+			continue
+		}
+		items := entry.Items
+		items.State = ProjectStateCachedUnverified
+		result[entry.ContentID] = items
+	}
+	return result
+}
+
+func HydrateProjectItems(contentIDs []string, columns []ProjectColumn) map[string]ProjectItems {
+	return cachedProjectItems(contentIDs, columns)
+}
+
+func cachedFullProjectItems(contentID string) (ProjectItems, bool) {
+	identity, cache, err := loadProjectCache()
+	if err != nil {
+		return ProjectItems{}, false
+	}
+	for index := range cache.Entries {
+		entry := cache.Entries[index]
+		if entry.Host == identity.Host && entry.Account == identity.Account &&
+			entry.ContentID == contentID &&
+			entry.FullPreview &&
+			entry.ColumnsKey == "" {
+			items := entry.Items
+			items.State = ProjectStateCachedUnverified
+			return items, true
+		}
+	}
+	return ProjectItems{}, false
+}
+
+// HydrateFullProjectItems returns the last complete selected-item preview, if
+// one exists. The returned presentation is deliberately unverified; callers
+// must start the live fingerprint/full-preview request immediately.
+func HydrateFullProjectItems(contentID string) (ProjectItems, bool) {
+	return cachedFullProjectItems(contentID)
+}
+
+func persistProjectItems(
+	contentID string,
+	columns []ProjectColumn,
+	items ProjectItems,
+	fullPreview bool,
+) {
+	if contentID == "" {
+		return
+	}
+	identity, cache, err := loadProjectCache()
+	if err != nil {
+		return
+	}
+	entry := projectCacheEntry{
+		Host: identity.Host, Account: identity.Account, ContentID: contentID,
+		ColumnsKey: projectColumnsKey(columns), Items: items, FullPreview: fullPreview,
+		LastVerified: projectCacheNow(), LastUsed: projectCacheNow(),
+	}
+	key := projectCacheEntryKey(contentID, entry.ColumnsKey)
+	found := false
+	for index := range cache.Entries {
+		if projectCacheEntryKey(
+			cache.Entries[index].ContentID,
+			cache.Entries[index].ColumnsKey,
+		) == key &&
+			cache.Entries[index].Host == identity.Host &&
+			cache.Entries[index].Account == identity.Account {
+			if cache.Entries[index].FullPreview && !fullPreview &&
+				projectItemsFingerprintEqual(items, cache.Entries[index].Items) {
+				cache.Entries[index].LastVerified = entry.LastVerified
+				cache.Entries[index].LastUsed = entry.LastUsed
+				found = true
+				break
+			}
+			cache.Entries[index] = entry
+			found = true
+			break
+		}
+	}
+	if !found {
+		cache.Entries = append(cache.Entries, entry)
+	}
+	writeProjectCache(identity, *cache)
+}
+
+func invalidatePersistentProjectItems(contentID string) {
+	identity, cache, err := loadProjectCache()
+	if err != nil {
+		return
+	}
+	filtered := cache.Entries[:0]
+	for _, entry := range cache.Entries {
+		if entry.Host == identity.Host && entry.Account == identity.Account &&
+			entry.ContentID == contentID {
+			continue
+		}
+		filtered = append(filtered, entry)
+	}
+	cache.Entries = filtered
+	writeProjectCache(identity, *cache)
+}
+
+func writeProjectCache(identity projectCacheIdentity, cache projectCacheFile) {
+	path := ProjectCachePath()
+	if path == "" {
+		return
+	}
+	projectCacheMu.Lock()
+	defer projectCacheMu.Unlock()
+	// Re-read immediately before replacement and preserve entries written by
+	// another gh-dash process. Current-identity entries are replaced as a
+	// coherent set so invalidation can remove them without deleting other
+	// hosts/accounts.
+	latest := projectCacheFile{Version: projectCacheFormatVersion}
+	if existing, readErr := os.ReadFile(path); readErr == nil {
+		if jsonErr := json.Unmarshal(existing, &latest); jsonErr != nil ||
+			latest.Version != projectCacheFormatVersion {
+			latest = projectCacheFile{Version: projectCacheFormatVersion}
+		}
+	}
+	merged := latest.Entries[:0]
+	for _, entry := range latest.Entries {
+		if entry.Host != identity.Host || entry.Account != identity.Account {
+			merged = append(merged, entry)
+		}
+	}
+	for _, entry := range cache.Entries {
+		if entry.Host == identity.Host && entry.Account == identity.Account {
+			merged = append(merged, entry)
+		}
+	}
+	cache.Version = projectCacheFormatVersion
+	cache.Entries = merged
+	contents, err := json.MarshalIndent(cache, "", "  ")
+	if err != nil {
+		return
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".cache-v1-*.tmp")
+	if err != nil {
+		return
+	}
+	temporaryName := temporary.Name()
+	defer os.Remove(temporaryName)
+	if err := temporary.Chmod(0o600); err != nil {
+		_ = temporary.Close()
+		return
+	}
+	if _, err := temporary.Write(contents); err != nil {
+		_ = temporary.Close()
+		return
+	}
+	if err := temporary.Sync(); err != nil {
+		_ = temporary.Close()
+		return
+	}
+	if err := temporary.Close(); err != nil {
+		return
+	}
+	if err := os.Rename(temporaryName, path); err != nil {
+		return
+	}
+	projectCacheLoadedIdentity = &identity
+	projectCacheLoaded = cache
+}
+
+func resetProjectCacheForTest() {
+	projectCacheMu.Lock()
+	projectCacheLoadedIdentity = nil
+	projectCacheLoaded = projectCacheFile{}
+	projectCacheMu.Unlock()
+	if path := ProjectCachePath(); path != "" {
+		_ = os.Remove(path)
+	}
+}
