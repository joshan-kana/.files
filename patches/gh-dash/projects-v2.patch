+package data
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func configureProjectCacheTest(t *testing.T) *projectCacheIdentity {
+	t.Helper()
+	oldDir, oldIdentity, oldNow := projectCacheUserCacheDir, projectCacheIdentityFunc, projectCacheNow
+	t.Cleanup(func() {
+		projectCacheUserCacheDir, projectCacheIdentityFunc, projectCacheNow = oldDir, oldIdentity, oldNow
+		resetProjectCacheForTest()
+	})
+	directory := t.TempDir()
+	identity := projectCacheIdentity{Host: "github.example", Account: "alice"}
+	projectCacheUserCacheDir = func() (string, error) { return directory, nil }
+	projectCacheIdentityFunc = func() (projectCacheIdentity, error) { return identity, nil }
+	projectCacheNow = func() time.Time { return time.Unix(100, 0) }
+	resetProjectCacheForTest()
+	return &identity
+}
+
+func cachedTestItems() ProjectItems {
+	return ProjectItems{
+		Nodes: []ProjectItem{
+			{
+				ID:        "item-1",
+				UpdatedAt: time.Unix(10, 0),
+				Project:   Project{ID: "project-1", UpdatedAt: time.Unix(11, 0)},
+			},
+		},
+	}
+}
+
+func TestProjectCacheRoundTripIsUnverifiedAndContainsNoSecrets(t *testing.T) {
+	configureProjectCacheTest(t)
+	persistProjectItems("issue-1", []ProjectColumn{{Name: "Status"}}, cachedTestItems(), false)
+
+	items := HydrateProjectItems([]string{"issue-1"}, []ProjectColumn{{Name: "Status"}})["issue-1"]
+	if items.State != ProjectStateCachedUnverified || len(items.Nodes) != 1 {
+		t.Fatalf("cached presentation = %#v", items)
+	}
+	contents, err := os.ReadFile(ProjectCachePath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(contents), "token") || strings.Contains(string(contents), "secret") {
+		t.Fatalf("cache contains credential-like data: %s", contents)
+	}
+	if _, err := os.Stat(
+		filepath.Join(filepath.Dir(ProjectCachePath()), ".cache-v1-test.tmp"),
+	); !os.IsNotExist(
+		err,
+	) {
+		t.Fatalf("unexpected temporary cache file: %v", err)
+	}
+}
+
+func TestProjectCacheCorruptAndVersionMismatchAreNonFatal(t *testing.T) {
+	configureProjectCacheTest(t)
+	if err := os.MkdirAll(filepath.Dir(ProjectCachePath()), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(ProjectCachePath(), []byte("not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := HydrateProjectItems([]string{"issue-1"}, nil); len(got) != 0 {
+		t.Fatalf("corrupt cache returned %#v", got)
+	}
+	if err := os.WriteFile(
+		ProjectCachePath(),
+		[]byte(`{"version":999,"entries":[]}`),
+		0o600,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if got := HydrateProjectItems([]string{"issue-1"}, nil); len(got) != 0 {
+		t.Fatalf("incompatible cache returned %#v", got)
+	}
+}
+
+func TestProjectCacheIsolatedByHostAndAccount(t *testing.T) {
+	identity := configureProjectCacheTest(t)
+	persistProjectItems("issue-1", nil, cachedTestItems(), false)
+
+	identity.Host = "other.example"
+	if got := HydrateProjectItems([]string{"issue-1"}, nil); len(got) != 0 {
+		t.Fatalf("cross-host cache returned %#v", got)
+	}
+	identity.Host = "github.example"
+	identity.Account = "bob"
+	if got := HydrateProjectItems([]string{"issue-1"}, nil); len(got) != 0 {
+		t.Fatalf("cross-account cache returned %#v", got)
+	}
+}
+
+func TestCachedFullProjectPreviewIsUnverifiedUntilLiveValidation(t *testing.T) {
+	configureProjectCacheTest(t)
+	persistProjectItems("issue-1", nil, cachedTestItems(), true)
+	items, ok := HydrateFullProjectItems("issue-1")
+	if !ok || items.State != ProjectStateCachedUnverified {
+		t.Fatalf("full preview = %#v, ok=%v", items, ok)
+	}
+}
+
+func TestProjectCacheHydrationDoesNotPersistLastUsed(t *testing.T) {
+	configureProjectCacheTest(t)
+	current := time.Unix(100, 0)
+	projectCacheNow = func() time.Time { return current }
+	persistProjectItems("issue-1", nil, cachedTestItems(), false)
+	before, err := os.ReadFile(ProjectCachePath())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	current = time.Unix(200, 0)
+	_ = HydrateProjectItems([]string{"issue-1"}, nil)
+
+	contents, err := os.ReadFile(ProjectCachePath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(contents) != string(before) {
+		t.Fatalf(
+			"cache hydration performed a synchronous write:\\nbefore=%s\\nafter=%s",
+			before,
+			contents,
+		)
+	}
+}
+
+func TestProjectCacheRetainsOtherAccountEntriesAcrossWrites(t *testing.T) {
+	identity := configureProjectCacheTest(t)
+	persistProjectItems("alice-issue", nil, cachedTestItems(), false)
+
+	identity.Account = "bob"
+	persistProjectItems("bob-issue", nil, cachedTestItems(), false)
+
+	contents, err := os.ReadFile(ProjectCachePath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var cache projectCacheFile
+	if err := json.Unmarshal(contents, &cache); err != nil {
+		t.Fatal(err)
+	}
+	accounts := make(map[string]bool)
+	for _, entry := range cache.Entries {
+		accounts[entry.Account] = true
+	}
+	if !accounts["alice"] || !accounts["bob"] {
+		t.Fatalf("account entries were not retained: %#v", cache.Entries)
+	}
+}
diff --git a/internal/data/projectlist.go b/internal/data/projectlist.go
new file mode 100644
index 0000000000000000000000000000000000000000..d8368cfc11687d589f471691e5fcca24e3163ab2
--- /dev/null
+++ b/internal/data/projectlist.go
@@ -0,0 +1,1163 @@
+package data
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"charm.land/log/v2"
+	gh "github.com/cli/go-gh/v2/pkg/api"
+)
+
+var projectGraphQLDo = func(client *gh.GraphQLClient, query string, variables map[string]interface{}, result interface{}) error {
+	return client.Do(query, variables, result)
+}
+
+var projectReadSleep = time.Sleep
+
+func projectGraphQLRead(
+	client *gh.GraphQLClient,
+	query string,
+	variables map[string]interface{},
+	result interface{},
+) error {
+	for attempt := 1; attempt <= 3; attempt++ {
+		generation, err := projectEnrichmentAllowedGeneration()
+		if err != nil {
+			return err
+		}
+		started := time.Now()
+		err = projectGraphQLDo(client, query, variables, result)
+		log.Debug(
+			"Project GraphQL query complete",
+			"operation",
+			projectQueryOperation(query),
+			"duration",
+			time.Since(started),
+			"attempt",
+			attempt,
+			"error",
+			err,
+		)
+		if err == nil {
+			recordProjectNetworkSuccess(generation)
+			return nil
+		}
+		if classifyProjectFailure(err).class == projectTransient && attempt < 3 {
+			projectReadSleep(100 * time.Millisecond)
+			continue
+		}
+		recordProjectEnrichmentFailure(err)
+		return err
+	}
+	return fmt.Errorf("Project read exhausted retry attempts")
+}
+
+func projectQueryOperation(query string) string {
+	fields := strings.Fields(query)
+	for index, field := range fields {
+		if field == "query" || field == "mutation" {
+			if index+1 < len(fields) {
+				return strings.TrimSuffix(fields[index+1], "(")
+			}
+		}
+	}
+	return "unknown"
+}
+
+// projectColumnsKey identifies the configured presentation shape. It is part
+// of the persistent cache key, while every process still asks GitHub for
+// current Project state before using cached values as verified.
+func projectColumnsKey(columns []ProjectColumn) string {
+	parts := make([]string, 0, len(columns))
+	for _, column := range columns {
+		parts = append(parts, column.Name+"\x00"+column.FieldID+"\x00"+column.Project)
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, "\x01")
+}
+
+type projectSchemaCache struct {
+	mu         sync.Mutex
+	fields     map[string][]ProjectField
+	inFlight   map[string]*projectSchemaCall
+	generation uint64
+}
+
+type projectSchemaCall struct {
+	done       chan struct{}
+	fields     []ProjectField
+	err        error
+	generation uint64
+}
+
+var projectSchemas = projectSchemaCache{
+	fields:   make(map[string][]ProjectField),
+	inFlight: make(map[string]*projectSchemaCall),
+}
+
+// FetchProjectSchema fetches only stable field identity and type. Options are
+// deliberately excluded from list enrichment and are fetched live by the
+// editor when it opens.
+func FetchProjectSchema(projectID string) ([]ProjectField, error) {
+	log.Debug("Fetching Project schema", "projectID", projectID)
+	projectSchemas.mu.Lock()
+	generation := projectSchemas.generation
+	if fields, ok := projectSchemas.fields[projectID]; ok {
+		projectSchemas.mu.Unlock()
+		return append([]ProjectField(nil), fields...), nil
+	}
+	if call, ok := projectSchemas.inFlight[projectID]; ok && call.generation == generation {
+		projectSchemas.mu.Unlock()
+		<-call.done
+		return append([]ProjectField(nil), call.fields...), call.err
+	}
+	call := &projectSchemaCall{done: make(chan struct{}), generation: generation}
+	projectSchemas.inFlight[projectID] = call
+	projectSchemas.mu.Unlock()
+
+	client, err := projectGraphQLClient()
+	if err != nil {
+		completeProjectSchemaCall(projectID, call, nil, err)
+		return nil, err
+	}
+	var fields []ProjectField
+	var after *string
+	for {
+		query := `query ProjectSchema($id: ID!, $after: String) {
+  node(id: $id) { ... on ProjectV2 {
+    fields(first: 100, after: $after) { nodes {
+      __typename
+      ... on ProjectV2Field { id name dataType }
+      ... on ProjectV2IterationField { id name }
+      ... on ProjectV2SingleSelectField { id name }
+      ... on ProjectV2MultiSelectField { id name }
+    } pageInfo { hasNextPage endCursor } }
+  } }
+}`
+		var response struct {
+			Node struct {
+				Fields struct {
+					Nodes []struct {
+						Typename string `json:"__typename"`
+						ID       string `json:"id"`
+						Name     string `json:"name"`
+						DataType string `json:"dataType"`
+					} `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"fields"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(
+			client,
+			query,
+			map[string]interface{}{"id": projectID, "after": after},
+			&response,
+		); err != nil {
+			completeProjectSchemaCall(projectID, call, nil, err)
+			return nil, err
+		}
+		for _, field := range response.Node.Fields.Nodes {
+			fieldType := field.Typename
+			if field.DataType != "" {
+				fieldType = field.DataType
+			}
+			fields = append(fields, ProjectField{ID: field.ID, Name: field.Name, Type: fieldType})
+		}
+		if !response.Node.Fields.PageInfo.HasNextPage {
+			break
+		}
+		cursor := response.Node.Fields.PageInfo.EndCursor
+		after = &cursor
+	}
+	sort.SliceStable(
+		fields,
+		func(i, j int) bool { return strings.ToLower(fields[i].Name) < strings.ToLower(fields[j].Name) },
+	)
+	projectSchemas.mu.Lock()
+	if projectSchemas.generation == call.generation {
+		projectSchemas.fields[projectID] = append([]ProjectField(nil), fields...)
+	}
+	if projectSchemas.inFlight[projectID] == call {
+		delete(projectSchemas.inFlight, projectID)
+	}
+	call.fields = append([]ProjectField(nil), fields...)
+	close(call.done)
+	projectSchemas.mu.Unlock()
+	return fields, nil
+}
+
+func completeProjectSchemaCall(
+	projectID string,
+	call *projectSchemaCall,
+	fields []ProjectField,
+	err error,
+) {
+	projectSchemas.mu.Lock()
+	if projectSchemas.inFlight[projectID] == call {
+		delete(projectSchemas.inFlight, projectID)
+	}
+	call.fields = append([]ProjectField(nil), fields...)
+	call.err = err
+	close(call.done)
+	projectSchemas.mu.Unlock()
+}
+
+type projectListValueRequest struct {
+	Alias     string
+	Name      string
+	Field     ProjectField
+	ByFieldID bool
+}
+
+func projectValueFragments(fieldType string) string {
+	switch strings.ToUpper(fieldType) {
+	case "PROJECTV2FIELD", "TEXT":
+		return `... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }`
+	case "NUMBER":
+		return `... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }`
+	case "DATE":
+		return `... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }`
+	case "PROJECTV2SINGLESELECTFIELD", "SINGLE_SELECT":
+		return `... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }`
+	case "PROJECTV2ITERATIONFIELD", "ITERATION":
+		return `... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }`
+	case "USERS":
+		return `... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }`
+	case "LABELS":
+		return `... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }`
+	case "REPOSITORY":
+		return `... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }`
+	case "MULTI_SELECT":
+		return `... on ProjectV2ItemFieldMultiSelectValue { value options { name } field { ... on ProjectV2Field { id name } ... on ProjectV2MultiSelectField { id name } } }`
+	case "REVIEWERS":
+		return `... on ProjectV2ItemFieldReviewerValue { reviewers(first: 20) { nodes { ... on User { login name } ... on Team { name } } } field { ... on ProjectV2Field { id name } } }`
+	case "MILESTONE":
+		return `... on ProjectV2ItemFieldMilestoneValue { milestone { title number url repository { nameWithOwner } } field { ... on ProjectV2Field { id name } } }`
+	case "PULL_REQUEST":
+		return `... on ProjectV2ItemFieldPullRequestValue { pullRequests(first: 20) { nodes { number title url repository { nameWithOwner } } } field { ... on ProjectV2Field { id name } } }`
+	default:
+		return `... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }
+... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }
+... on ProjectV2ItemFieldMultiSelectValue { value options { name } field { ... on ProjectV2Field { id name } ... on ProjectV2MultiSelectField { id name } } }
+... on ProjectV2ItemFieldPullRequestValue { pullRequests(first: 20) { nodes { number title url repository { nameWithOwner } } } field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldReviewerValue { reviewers(first: 20) { nodes { ... on User { login name } ... on Team { name } } } field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldMilestoneValue { milestone { title number url repository { nameWithOwner } } field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemIssueFieldValue { field { ... on ProjectV2Field { id name } } issueFieldValue { __typename ... on IssueFieldTextValue { value } ... on IssueFieldNumberValue { value } ... on IssueFieldDateValue { value } ... on IssueFieldSingleSelectValue { name optionId value } ... on IssueFieldMultiSelectValue { value options { name } } } }`
+	}
+}
+
+func projectValueFromJSON(raw json.RawMessage) (ProjectFieldValue, error) {
+	var value struct {
+		Typename string  `json:"__typename"`
+		Text     string  `json:"text"`
+		Number   float64 `json:"number"`
+		Date     string  `json:"date"`
+		Name     string  `json:"name"`
+		OptionID string  `json:"optionId"`
+		Title    string  `json:"title"`
+		IterID   string  `json:"iterationId"`
+		Field    struct {
+			ID   string `json:"id"`
+			Name string `json:"name"`
+		} `json:"field"`
+		Users struct {
+			Nodes []struct {
+				Login string `json:"login"`
+				Name  string `json:"name"`
+			} `json:"nodes"`
+		} `json:"users"`
+		Labels struct {
+			Nodes []struct {
+				Name string `json:"name"`
+			} `json:"nodes"`
+		} `json:"labels"`
+		Repository struct {
+			NameWithOwner string `json:"nameWithOwner"`
+		} `json:"repository"`
+		Value   string `json:"value"`
+		Options []struct {
+			Name string `json:"name"`
+		} `json:"options"`
+		PullRequests struct {
+			Nodes []struct {
+				Number     int    `json:"number"`
+				Title      string `json:"title"`
+				Url        string `json:"url"`
+				Repository struct {
+					NameWithOwner string `json:"nameWithOwner"`
+				} `json:"repository"`
+			} `json:"nodes"`
+		} `json:"pullRequests"`
+		Reviewers struct {
+			Nodes []struct {
+				Typename     string `json:"__typename"`
+				Login        string `json:"login"`
+				Name         string `json:"name"`
+				Slug         string `json:"slug"`
+				Organization struct {
+					Login string `json:"login"`
+				} `json:"organization"`
+				Team struct {
+					Name string `json:"name"`
+				} `json:"team"`
+			} `json:"nodes"`
+		} `json:"reviewers"`
+		Milestone struct {
+			Title      string `json:"title"`
+			Number     int    `json:"number"`
+			Url        string `json:"url"`
+			Repository struct {
+				NameWithOwner string `json:"nameWithOwner"`
+			} `json:"repository"`
+		} `json:"milestone"`
+		IssueFieldValue struct {
+			Typename string  `json:"__typename"`
+			Text     string  `json:"text"`
+			Number   float64 `json:"number"`
+			Date     string  `json:"date"`
+			Name     string  `json:"name"`
+			Value    string  `json:"value"`
+			Options  []struct {
+				Name string `json:"name"`
+			} `json:"options"`
+		} `json:"issueFieldValue"`
+	}
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return ProjectFieldValue{}, err
+	}
+	result := ProjectFieldValue{Typename: value.Typename}
+	common := ProjectFieldRef{Common: struct {
+		ID   string
+		Name string
+	}{ID: value.Field.ID, Name: value.Field.Name}}
+	switch value.Typename {
+	case "ProjectV2ItemFieldTextValue":
+		result.TextValue.Field, result.TextValue.Text = common, value.Text
+	case "ProjectV2ItemFieldNumberValue":
+		result.NumberValue.Field, result.NumberValue.Number = common, value.Number
+	case "ProjectV2ItemFieldDateValue":
+		result.DateValue.Field, result.DateValue.Date = common, value.Date
+	case "ProjectV2ItemFieldSingleSelectValue":
+		result.SingleSelectValue.Field = ProjectFieldRef{SingleSelect: struct {
+			ID   string
+			Name string
+		}{ID: value.Field.ID, Name: value.Field.Name}}
+		result.SingleSelectValue.Name, result.SingleSelectValue.OptionID = value.Name, value.OptionID
+	case "ProjectV2ItemFieldIterationValue":
+		result.IterationValue.Field = ProjectFieldRef{Iteration: struct {
+			ID   string
+			Name string
+		}{ID: value.Field.ID, Name: value.Field.Name}}
+		result.IterationValue.Title, result.IterationValue.IterationID = value.Title, value.IterID
+	case "ProjectV2ItemFieldUserValue":
+		result.UserValue.Field = common
+		for _, user := range value.Users.Nodes {
+			result.UserValue.Users.Nodes = append(result.UserValue.Users.Nodes, struct {
+				Login string
+				Name  string
+			}{Login: user.Login, Name: user.Name})
+		}
+	case "ProjectV2ItemFieldLabelValue":
+		result.LabelValue.Field = common
+		for _, label := range value.Labels.Nodes {
+			result.LabelValue.Labels.Nodes = append(
+				result.LabelValue.Labels.Nodes,
+				struct{ Name string }{Name: label.Name},
+			)
+		}
+	case "ProjectV2ItemFieldRepositoryValue":
+		result.RepositoryValue.Field = common
+		result.RepositoryValue.Repository.NameWithOwner = value.Repository.NameWithOwner
+	case "ProjectV2ItemFieldMultiSelectValue":
+		result.MultiSelectValue.Field = common
+		result.MultiSelectValue.Value = value.Value
+		for _, option := range value.Options {
+			result.MultiSelectValue.Options = append(
+				result.MultiSelectValue.Options,
+				struct{ Name string }{Name: option.Name},
+			)
+		}
+	case "ProjectV2ItemFieldPullRequestValue":
+		result.PullRequestValue.Field = common
+		for _, pr := range value.PullRequests.Nodes {
+			result.PullRequestValue.PullRequests.Nodes = append(
+				result.PullRequestValue.PullRequests.Nodes,
+				struct {
+					Number     int
+					Title      string
+					Url        string
+					Repository struct{ NameWithOwner string }
+				}{Number: pr.Number, Title: pr.Title, Url: pr.Url, Repository: struct{ NameWithOwner string }{NameWithOwner: pr.Repository.NameWithOwner}},
+			)
+		}
+	case "ProjectV2ItemFieldReviewerValue":
+		result.ReviewerValue.Field = common
+		for _, reviewer := range value.Reviewers.Nodes {
+			result.ReviewerValue.Reviewers.Nodes = append(
+				result.ReviewerValue.Reviewers.Nodes,
+				struct {
+					Typename     string `json:"__typename"`
+					Login        string
+					Name         string
+					Slug         string
+					Organization struct{ Login string }
+					Team         struct{ Name string }
+				}{Typename: reviewer.Typename, Login: reviewer.Login, Name: reviewer.Name, Slug: reviewer.Slug, Organization: struct{ Login string }{Login: reviewer.Organization.Login}, Team: struct{ Name string }{Name: reviewer.Team.Name}},
+			)
+		}
+	case "ProjectV2ItemFieldMilestoneValue":
+		result.MilestoneValue.Field = common
+		result.MilestoneValue.Milestone.Title, result.MilestoneValue.Milestone.Number, result.MilestoneValue.Milestone.Url = value.Milestone.Title, value.Milestone.Number, value.Milestone.Url
+		result.MilestoneValue.Milestone.Repository.NameWithOwner = value.Milestone.Repository.NameWithOwner
+	case "ProjectV2ItemIssueFieldValue":
+		result.IssueFieldValue.Field = common
+		result.IssueFieldValue.IssueFieldValue.Typename = value.IssueFieldValue.Typename
+		result.IssueFieldValue.IssueFieldValue.Text, result.IssueFieldValue.IssueFieldValue.Number, result.IssueFieldValue.IssueFieldValue.Date = value.IssueFieldValue.Text, value.IssueFieldValue.Number, value.IssueFieldValue.Date
+		result.IssueFieldValue.IssueFieldValue.Name, result.IssueFieldValue.IssueFieldValue.Value = value.IssueFieldValue.Name, value.IssueFieldValue.Value
+		for _, option := range value.IssueFieldValue.Options {
+			result.IssueFieldValue.IssueFieldValue.Options = append(
+				result.IssueFieldValue.IssueFieldValue.Options,
+				struct{ Name string }{Name: option.Name},
+			)
+		}
+	default:
+		log.Debug("Skipping unknown Project field value type", "typename", value.Typename)
+		result.Typename = value.Typename
+	}
+	return result, nil
+}
+
+func fetchConfiguredProjectValues(
+	itemIDs []string,
+	fields []ProjectField,
+	columns []ProjectColumn,
+	project Project,
+) (map[string][]ProjectFieldValue, error) {
+	requests := make([]projectListValueRequest, 0, len(columns))
+	for index, column := range columns {
+		if column.Project != "" && !projectMatchesSelector(project, column.Project) {
+			continue
+		}
+		matches := make([]ProjectField, 0, 1)
+		for _, field := range fields {
+			if (column.FieldID != "" && field.ID == column.FieldID) ||
+				(column.FieldID == "" && field.Name == column.Name) {
+				matches = append(matches, field)
+			}
+		}
+		if len(matches) != 1 {
+			continue
+		}
+		requests = append(requests, projectListValueRequest{
+			Alias: fmt.Sprintf("value%d", index),
+			Name:  matches[0].Name,
+			Field: matches[0],
+			ByFieldID: column.FieldID != "" &&
+				countProjectFieldsByName(fields, matches[0].Name) > 1,
+		})
+	}
+	if len(requests) == 0 || len(itemIDs) == 0 {
+		return map[string][]ProjectFieldValue{}, nil
+	}
+	variables := map[string]interface{}{"ids": itemIDs}
+	var declarations []string
+	var selections []string
+	for index, request := range requests {
+		if request.ByFieldID {
+			selections = append(
+				selections,
+				fmt.Sprintf(
+					"%s: fieldValues(first: 100) { nodes { __typename %s } }",
+					request.Alias,
+					projectValueFragments(request.Field.Type),
+				),
+			)
+			continue
+		}
+		variable := fmt.Sprintf("name%d", index)
+		declarations = append(declarations, "$"+variable+": String!")
+		variables[variable] = request.Name
+		selections = append(
+			selections,
+			fmt.Sprintf(
+				"%s: fieldValueByName(name: $%s) { __typename %s }",
+				request.Alias,
+				variable,
+				projectValueFragments(request.Field.Type),
+			),
+		)
+	}
+	declarationText := ""
+	if len(declarations) > 0 {
+		declarationText = ", " + strings.Join(declarations, ", ")
+	}
+	query := fmt.Sprintf(
+		"query ProjectColumnValues($ids: [ID!]!%s) { nodes(ids: $ids) { __typename ... on ProjectV2Item { id %s } } }",
+		declarationText,
+		strings.Join(selections, " "),
+	)
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	log.Debug(
+		"Fetching configured Project values",
+		"projectID",
+		project.ID,
+		"items",
+		len(itemIDs),
+		"columns",
+		len(requests),
+	)
+	var response struct {
+		Nodes []json.RawMessage `json:"nodes"`
+	}
+	if err := projectGraphQLRead(client, query, variables, &response); err != nil {
+		return nil, err
+	}
+	result := make(map[string][]ProjectFieldValue, len(response.Nodes))
+	for _, rawNode := range response.Nodes {
+		var node map[string]json.RawMessage
+		if err := json.Unmarshal(rawNode, &node); err != nil {
+			return nil, err
+		}
+		var itemID string
+		if err := json.Unmarshal(node["id"], &itemID); err != nil || itemID == "" {
+			continue
+		}
+		for _, request := range requests {
+			rawValue := node[request.Alias]
+			if request.ByFieldID {
+				var connection struct {
+					Nodes []json.RawMessage `json:"nodes"`
+				}
+				if err := json.Unmarshal(rawValue, &connection); err != nil {
+					return nil, err
+				}
+				for _, candidate := range connection.Nodes {
+					fieldValue, decodeErr := projectValueFromJSON(candidate)
+					if decodeErr == nil && projectValueFieldID(fieldValue) == request.Field.ID {
+						result[itemID] = append(result[itemID], fieldValue)
+					}
+				}
+				continue
+			}
+			if string(rawValue) == "null" || len(rawValue) == 0 {
+				continue
+			}
+			fieldValue, decodeErr := projectValueFromJSON(rawValue)
+			if decodeErr != nil {
+				return nil, decodeErr
+			}
+			result[itemID] = append(result[itemID], fieldValue)
+		}
+	}
+	return result, nil
+}
+
+func projectValueFieldID(value ProjectFieldValue) string {
+	switch value.Typename {
+	case "ProjectV2ItemFieldTextValue":
+		return value.TextValue.Field.IDNameID()
+	case "ProjectV2ItemFieldNumberValue":
+		return value.NumberValue.Field.IDNameID()
+	case "ProjectV2ItemFieldDateValue":
+		return value.DateValue.Field.IDNameID()
+	case "ProjectV2ItemFieldSingleSelectValue":
+		return value.SingleSelectValue.Field.IDNameID()
+	case "ProjectV2ItemFieldIterationValue":
+		return value.IterationValue.Field.IDNameID()
+	case "ProjectV2ItemFieldUserValue":
+		return value.UserValue.Field.IDNameID()
+	case "ProjectV2ItemFieldLabelValue":
+		return value.LabelValue.Field.IDNameID()
+	case "ProjectV2ItemFieldRepositoryValue":
+		return value.RepositoryValue.Field.IDNameID()
+	case "ProjectV2ItemFieldMultiSelectValue":
+		return value.MultiSelectValue.Field.IDNameID()
+	case "ProjectV2ItemFieldPullRequestValue":
+		return value.PullRequestValue.Field.IDNameID()
+	case "ProjectV2ItemFieldReviewerValue":
+		return value.ReviewerValue.Field.IDNameID()
+	case "ProjectV2ItemFieldMilestoneValue":
+		return value.MilestoneValue.Field.IDNameID()
+	case "ProjectV2ItemIssueFieldValue":
+		return value.IssueFieldValue.Field.IDNameID()
+	default:
+		return ""
+	}
+}
+
+func countProjectFieldsByName(fields []ProjectField, name string) int {
+	count := 0
+	for _, field := range fields {
+		if field.Name == name {
+			count++
+		}
+	}
+	return count
+}
+
+func fetchProjectItemsNetwork(
+	contentIDs []string,
+	columns []ProjectColumn,
+) (map[string]ProjectItems, error) {
+	started := time.Now()
+	if len(contentIDs) == 0 {
+		return map[string]ProjectItems{}, nil
+	}
+	// Capture the generation before the membership request. A refresh that
+	// begins while this request is blocked must not let its result populate the
+	// new generation's fingerprint cache.
+	requestGeneration := ProjectRefreshGeneration()
+	result, err := fetchProjectMembershipsShared(contentIDs, requestGeneration)
+	if err != nil {
+		return nil, err
+	}
+	log.Debug(
+		"Fetching Project memberships",
+		"contentIDs",
+		len(contentIDs),
+		"columns",
+		len(columns),
+	)
+	log.Debug(
+		"Project fingerprint validation complete",
+		"contentIDs",
+		len(contentIDs),
+		"duration",
+		time.Since(started),
+	)
+	// Membership and Project updatedAt values are the authoritative cheap
+	// fingerprint. A matching disk entry is still unverified until this live
+	// request succeeds, but it lets warm launches skip schema/value reads.
+	cached := cachedProjectItems(contentIDs, columns)
+	unchanged := make(map[string]bool, len(result))
+	for contentID, live := range result {
+		if warm, ok := cached[contentID]; ok && projectItemsFingerprintEqual(live, warm) {
+			warm.State = ProjectStateLiveVerified
+			result[contentID] = warm
+			unchanged[contentID] = true
+		}
+	}
+	if len(columns) == 0 {
+		for contentID, items := range result {
+			items.State = ProjectStateLiveVerified
+			result[contentID] = items
+			persistProjectItems(contentID, columns, items, false)
+		}
+		return result, nil
+	}
+	type projectItemRef struct {
+		contentID string
+		index     int
+	}
+	byProject := make(map[string][]projectItemRef)
+	for contentID, projectItems := range result {
+		if unchanged[contentID] {
+			continue
+		}
+		for index := range projectItems.Nodes {
+			byProject[projectItems.Nodes[index].Project.ID] = append(
+				byProject[projectItems.Nodes[index].Project.ID],
+				projectItemRef{contentID: contentID, index: index},
+			)
+		}
+	}
+	for projectID, refs := range byProject {
+		fields, schemaErr := FetchProjectSchema(projectID)
+		if schemaErr != nil {
+			return nil, schemaErr
+		}
+		itemIDs := make([]string, 0, len(refs))
+		var project Project
+		for _, ref := range refs {
+			item := result[ref.contentID].Nodes[ref.index]
+			itemIDs = append(itemIDs, item.ID)
+			project = item.Project
+		}
+		values, valuesErr := fetchConfiguredProjectValues(itemIDs, fields, columns, project)
+		if valuesErr != nil {
+			return nil, valuesErr
+		}
+		for _, ref := range refs {
+			projectItems := result[ref.contentID]
+			item := &projectItems.Nodes[ref.index]
+			for _, column := range columns {
+				if column.FieldID == "" && column.Project == "" &&
+					countProjectFieldsByName(fields, column.Name) > 1 &&
+					!containsString(item.AmbiguousFields, column.Name) {
+					item.AmbiguousFields = append(item.AmbiguousFields, column.Name)
+				}
+			}
+			item.FieldValues.Nodes = append(item.FieldValues.Nodes, values[item.ID]...)
+			result[ref.contentID] = projectItems
+		}
+	}
+	for contentID, items := range result {
+		items.State = ProjectStateLiveVerified
+		result[contentID] = items
+		// Hydration is read-only; refresh the access timestamp only after the
+		// authoritative membership read has completed.
+		persistProjectItems(contentID, columns, items, false)
+	}
+	return result, nil
+}
+
+func fetchProjectMembershipsShared(
+	contentIDs []string,
+	generation uint64,
+) (map[string]ProjectItems, error) {
+	contentIDs = uniqueContentIDs(contentIDs)
+	if len(contentIDs) == 0 {
+		return map[string]ProjectItems{}, nil
+	}
+
+	owners := make([]string, 0, len(contentIDs))
+	waiters := make(map[string]*projectFingerprintCall, len(contentIDs))
+	projectFingerprintState.mu.Lock()
+	for _, contentID := range contentIDs {
+		if call, ok := projectFingerprintState.inFlight[contentID]; ok &&
+			call.generation == generation {
+			waiters[contentID] = call
+			continue
+		}
+		call := &projectFingerprintCall{
+			done:       make(chan struct{}),
+			generation: generation,
+		}
+		projectFingerprintState.inFlight[contentID] = call
+		waiters[contentID] = call
+		owners = append(owners, contentID)
+	}
+	projectFingerprintState.mu.Unlock()
+
+	if len(owners) > 0 {
+		items, err := fetchProjectMembershipsNetwork(owners, generation)
+		projectFingerprintState.mu.Lock()
+		for _, contentID := range owners {
+			call := waiters[contentID]
+			call.items = items[contentID]
+			call.err = err
+			if projectFingerprintState.inFlight[contentID] == call {
+				delete(projectFingerprintState.inFlight, contentID)
+			}
+			close(call.done)
+		}
+		projectFingerprintState.mu.Unlock()
+	}
+
+	result := make(map[string]ProjectItems, len(contentIDs))
+	for _, contentID := range contentIDs {
+		call := waiters[contentID]
+		<-call.done
+		if call.err != nil {
+			return result, call.err
+		}
+		result[contentID] = call.items
+	}
+	return result, nil
+}
+
+func fetchProjectMembershipsNetwork(
+	contentIDs []string,
+	generation uint64,
+) (map[string]ProjectItems, error) {
+	started := time.Now()
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	log.Debug(
+		"Fetching Project membership fingerprints",
+		"contentIDs",
+		len(contentIDs),
+	)
+	query := `query ProjectMemberships($ids: [ID!]!) {
+  nodes(ids: $ids) {
+    __typename id
+    ... on Issue { projectItems(first: 20) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+	var response struct {
+		Nodes []struct {
+			ID           string `json:"id"`
+			ProjectItems struct {
+				Nodes []struct {
+					ID        string    `json:"id"`
+					UpdatedAt time.Time `json:"updatedAt"`
+					Project   struct {
+						ID        string    `json:"id"`
+						Number    int       `json:"number"`
+						Title     string    `json:"title"`
+						UpdatedAt time.Time `json:"updatedAt"`
+						Owner     struct {
+							Login string `json:"login"`
+						} `json:"owner"`
+					} `json:"project"`
+				} `json:"nodes"`
+				PageInfo struct {
+					HasNextPage bool   `json:"hasNextPage"`
+					EndCursor   string `json:"endCursor"`
+				} `json:"pageInfo"`
+			} `json:"projectItems"`
+		} `json:"nodes"`
+	}
+	if err := projectGraphQLRead(
+		client,
+		query,
+		map[string]interface{}{"ids": contentIDs},
+		&response,
+	); err != nil {
+		return nil, err
+	}
+	result := make(map[string]ProjectItems, len(response.Nodes))
+	type overflowMembership struct {
+		contentID string
+		after     string
+	}
+	var overflows []overflowMembership
+	for _, node := range response.Nodes {
+		for _, rawItem := range node.ProjectItems.Nodes {
+			result[node.ID] = appendProjectItem(result[node.ID], ProjectItem{
+				ID: rawItem.ID, UpdatedAt: rawItem.UpdatedAt,
+				Project: Project{
+					ID:        rawItem.Project.ID,
+					Number:    rawItem.Project.Number,
+					Title:     rawItem.Project.Title,
+					UpdatedAt: rawItem.Project.UpdatedAt,
+					Owner: ProjectOwner{
+						User: struct{ Login string }{Login: rawItem.Project.Owner.Login},
+					},
+				},
+			})
+		}
+		if node.ProjectItems.PageInfo.HasNextPage {
+			if node.ProjectItems.PageInfo.EndCursor == "" {
+				return nil, fmt.Errorf(
+					"Project membership pagination returned an empty cursor for %s",
+					node.ID,
+				)
+			}
+			overflows = append(
+				overflows,
+				overflowMembership{contentID: node.ID, after: node.ProjectItems.PageInfo.EndCursor},
+			)
+		}
+	}
+	for _, overflow := range overflows {
+		after := overflow.after
+		for {
+			query := `query ProjectMembershipOverflow($id: ID!, $after: String) {
+  node(id: $id) {
+    ... on Issue { projectItems(first: 20, after: $after) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20, after: $after) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+			var page struct {
+				Node struct {
+					ProjectItems struct {
+						Nodes []struct {
+							ID        string    `json:"id"`
+							UpdatedAt time.Time `json:"updatedAt"`
+							Project   struct {
+								ID        string    `json:"id"`
+								Number    int       `json:"number"`
+								Title     string    `json:"title"`
+								UpdatedAt time.Time `json:"updatedAt"`
+								Owner     struct {
+									Login string `json:"login"`
+								} `json:"owner"`
+							} `json:"project"`
+						} `json:"nodes"`
+						PageInfo struct {
+							HasNextPage bool   `json:"hasNextPage"`
+							EndCursor   string `json:"endCursor"`
+						} `json:"pageInfo"`
+					} `json:"projectItems"`
+				} `json:"node"`
+			}
+			if err := projectGraphQLRead(
+				client,
+				query,
+				map[string]interface{}{"id": overflow.contentID, "after": &after},
+				&page,
+			); err != nil {
+				return nil, err
+			}
+			for _, rawItem := range page.Node.ProjectItems.Nodes {
+				result[overflow.contentID] = appendProjectItem(
+					result[overflow.contentID],
+					ProjectItem{
+						ID: rawItem.ID, UpdatedAt: rawItem.UpdatedAt,
+						Project: Project{
+							ID:        rawItem.Project.ID,
+							Number:    rawItem.Project.Number,
+							Title:     rawItem.Project.Title,
+							UpdatedAt: rawItem.Project.UpdatedAt,
+							Owner: ProjectOwner{
+								User: struct{ Login string }{Login: rawItem.Project.Owner.Login},
+							},
+						},
+					},
+				)
+			}
+			if !page.Node.ProjectItems.PageInfo.HasNextPage {
+				break
+			}
+			next := page.Node.ProjectItems.PageInfo.EndCursor
+			if next == "" || next == after {
+				return nil, fmt.Errorf(
+					"Project membership pagination returned a repeated cursor for %s",
+					overflow.contentID,
+				)
+			}
+			after = next
+		}
+	}
+	log.Debug(
+		"Project fingerprint validation complete",
+		"contentIDs",
+		len(contentIDs),
+		"duration",
+		time.Since(started),
+	)
+	rememberProjectFingerprints(generation, contentIDs, result)
+	return result, nil
+}
+
+func projectItemsFingerprintEqual(live, cached ProjectItems) bool {
+	if len(live.Nodes) != len(cached.Nodes) {
+		return false
+	}
+	byID := make(map[string]ProjectItem, len(cached.Nodes))
+	for _, item := range cached.Nodes {
+		byID[item.ID] = item
+	}
+	for _, item := range live.Nodes {
+		old, ok := byID[item.ID]
+		if !ok || item.Project.ID != old.Project.ID || item.UpdatedAt != old.UpdatedAt ||
+			item.Project.UpdatedAt != old.Project.UpdatedAt {
+			return false
+		}
+	}
+	return true
+}
+
+func projectItemsFullPreviewFingerprintSafe(items ProjectItems) bool {
+	for _, item := range items.Nodes {
+		for _, value := range item.FieldValues.Nodes {
+			switch value.Typename {
+			case "ProjectV2ItemFieldTextValue",
+				"ProjectV2ItemFieldNumberValue",
+				"ProjectV2ItemFieldDateValue",
+				"ProjectV2ItemFieldSingleSelectValue",
+				"ProjectV2ItemFieldIterationValue":
+				// These values are owned by the Project and are covered by
+				// the Project item/project updatedAt fingerprint.
+			default:
+				// Linked users, labels, repositories, PRs, reviewers,
+				// milestones, issue fields, multi-select options, and
+				// unknown future values can change without that fingerprint.
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
+
+func appendProjectItem(items ProjectItems, item ProjectItem) ProjectItems {
+	for index := range items.Nodes {
+		if items.Nodes[index].ID == item.ID {
+			return items
+		}
+	}
+	items.Nodes = append(items.Nodes, item)
+	return items
+}
+
+// FetchProjectItemsFull is used only for the selected preview/editor path. It
+// follows both nested connections rather than imposing the list page sizes as
+// a silent metadata cap.
+func FetchProjectItemsFull(contentID string) (ProjectItems, error) {
+	if contentID == "" {
+		return ProjectItems{}, nil
+	}
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return ProjectItems{}, err
+	}
+	// Reuse the current generation's list validation when available. If the
+	// selected preview wins the race, it performs the one shared fingerprint
+	// request and publishes it for subsequent list/full callers.
+	fingerprint, fingerprintFound := projectFingerprint(contentID)
+	if !fingerprintFound {
+		fingerprints, fingerprintErr := fetchProjectItemsNetwork([]string{contentID}, nil)
+		if fingerprintErr != nil {
+			return ProjectItems{}, fingerprintErr
+		}
+		fingerprint = fingerprints[contentID]
+	}
+	if full, ok := cachedFullProjectItems(contentID); ok {
+		if projectItemsFullPreviewFingerprintSafe(full) &&
+			projectItemsFingerprintEqual(fingerprint, full) {
+			full.State = ProjectStateLiveVerified
+			// Live fingerprint validation completed, so access-time persistence
+			// no longer delays the initial cache hydration path.
+			persistProjectItems(contentID, nil, full, true)
+			return full, nil
+		}
+	}
+	log.Debug("Fetching full Project preview", "contentID", contentID)
+	result := ProjectItems{}
+	var after *string
+	for {
+		query := `query FullProjectMemberships($id: ID!, $after: String) {
+  node(id: $id) {
+    ... on Issue { projectItems(first: 20, after: $after) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20, after: $after) { nodes { id updatedAt project { id number title updatedAt owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+		var response struct {
+			Node struct {
+				ProjectItems struct {
+					Nodes []struct {
+						ID        string    `json:"id"`
+						UpdatedAt time.Time `json:"updatedAt"`
+						Project   struct {
+							ID        string    `json:"id"`
+							Number    int       `json:"number"`
+							Title     string    `json:"title"`
+							UpdatedAt time.Time `json:"updatedAt"`
+							Owner     struct {
+								Login string `json:"login"`
+							} `json:"owner"`
+						} `json:"project"`
+					} `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"projectItems"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(
+			client,
+			query,
+			map[string]interface{}{"id": contentID, "after": after},
+			&response,
+		); err != nil {
+			return ProjectItems{}, err
+		}
+		for _, rawItem := range response.Node.ProjectItems.Nodes {
+			item := ProjectItem{
+				ID:        rawItem.ID,
+				UpdatedAt: rawItem.UpdatedAt,
+				Project: Project{
+					ID:        rawItem.Project.ID,
+					Number:    rawItem.Project.Number,
+					Title:     rawItem.Project.Title,
+					UpdatedAt: rawItem.Project.UpdatedAt,
+					Owner: ProjectOwner{
+						User: struct{ Login string }{Login: rawItem.Project.Owner.Login},
+					},
+				},
+			}
+			values, valuesErr := fetchFullProjectFieldValues(client, rawItem.ID)
+			if valuesErr != nil {
+				return ProjectItems{}, valuesErr
+			}
+			item.FieldValues.Nodes = values
+			result.Nodes = appendProjectItem(result, item).Nodes
+		}
+		if !response.Node.ProjectItems.PageInfo.HasNextPage {
+			break
+		}
+		cursor := response.Node.ProjectItems.PageInfo.EndCursor
+		after = &cursor
+	}
+	result.State = ProjectStateLiveVerified
+	persistProjectItems(contentID, nil, result, true)
+	return result, nil
+}
+
+func fetchFullProjectFieldValues(
+	client *gh.GraphQLClient,
+	itemID string,
+) ([]ProjectFieldValue, error) {
+	var values []ProjectFieldValue
+	var after *string
+	for {
+		query := `query FullProjectFieldValues($id: ID!, $after: String) {
+  node(id: $id) { ... on ProjectV2Item {
+    fieldValues(first: 50, after: $after) { nodes {
+      __typename
+      ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }
+      ... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }
+      ... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }
+... on ProjectV2ItemFieldMultiSelectValue { value options { name } field { ... on ProjectV2Field { id name } ... on ProjectV2MultiSelectField { id name } } }
+      ... on ProjectV2ItemFieldPullRequestValue { pullRequests(first: 20) { nodes { number title url repository { nameWithOwner } } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldReviewerValue { reviewers(first: 20) { nodes { ... on User { login name } ... on Team { name } } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldMilestoneValue { milestone { title number url repository { nameWithOwner } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemIssueFieldValue { field { ... on ProjectV2Field { id name } } issueFieldValue { __typename ... on IssueFieldTextValue { value } ... on IssueFieldNumberValue { value } ... on IssueFieldDateValue { value } ... on IssueFieldSingleSelectValue { name optionId value } ... on IssueFieldMultiSelectValue { value options { name } } } }
+    } pageInfo { hasNextPage endCursor } }
+  } }
+}`
+		var response struct {
+			Node struct {
+				FieldValues struct {
+					Nodes    []json.RawMessage `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"fieldValues"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(
+			client,
+			query,
+			map[string]interface{}{"id": itemID, "after": after},
+			&response,
+		); err != nil {
+			return nil, err
+		}
+		for _, raw := range response.Node.FieldValues.Nodes {
+			value, err := projectValueFromJSON(raw)
+			if err != nil {
+				return nil, err
+			}
+			values = append(values, value)
+		}
+		if !response.Node.FieldValues.PageInfo.HasNextPage {
+			return values, nil
+		}
+		cursor := response.Node.FieldValues.PageInfo.EndCursor
+		after = &cursor
+	}
+}
