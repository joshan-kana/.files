+package projectcolumns
+
+import (
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+)
+
+// Configured returns the visible Project fields requested by the user's layout.
+// Hidden fields remain available to the selected-item/editor paths, but are not
+// fetched for list enrichment that cannot render them.
+func Configured(ctx *context.ProgramContext) []data.ProjectColumn {
+	fields := ctx.Config.Defaults.Layout.Projects.Fields
+	columns := make([]data.ProjectColumn, 0, len(fields))
+	for _, field := range fields {
+		if field.Hidden != nil && *field.Hidden {
+			continue
+		}
+		columns = append(
+			columns,
+			data.ProjectColumn{Name: field.Name, FieldID: field.FieldID, Project: field.Project},
+		)
+	}
+	return columns
+}
diff --git a/internal/tui/components/projecteditor/editor.go b/internal/tui/components/projecteditor/editor.go
new file mode 100644
index 0000000000000000000000000000000000000000..8efcddba93422aba0d27161c94fd79225acf5299
--- /dev/null
+++ b/internal/tui/components/projecteditor/editor.go
@@ -0,0 +1,529 @@
+package projecteditor
+
+import (
+	"fmt"
+	"strings"
+
+	"charm.land/bubbles/v2/textarea"
+	"charm.land/bubbles/v2/textinput"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/sahilm/fuzzy"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/inputbox"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+)
+
+type mode int
+
+const (
+	modeProjects mode = iota
+	modeLoadingFields
+	modeFields
+	modeOptions
+	modeInput
+)
+
+type FieldsFetchedMsg struct {
+	ProjectID string
+	Fields    []data.ProjectField
+	Err       error
+}
+
+type ProjectFieldUpdatedMsg struct {
+	SectionType  string
+	SectionID    int
+	ContentID    string
+	Repository   string
+	ItemNumber   int
+	ProjectID    string
+	ItemID       string
+	FieldID      string
+	FieldName    string
+	Value        string
+	ProjectItems data.ProjectItems
+	Err          error
+}
+
+var (
+	clearProjectField     = data.ClearProjectField
+	updateProjectField    = data.UpdateProjectField
+	fetchProjectItemsFull = data.FetchProjectItemsFull
+)
+
+type Model struct {
+	ctx         *context.ProgramContext
+	sectionType string
+	sectionID   int
+	itemNumber  int
+	contentID   string
+	repository  string
+	items       []data.ProjectItem
+	fields      []data.ProjectField
+	filtered    []int
+	filter      textinput.Model
+	project     int
+	field       int
+	option      int
+	optionField int
+	activeField int
+	mode        mode
+	filterMode  bool
+	input       inputbox.Model
+	width       int
+	status      string
+	active      bool
+}
+
+func New(
+	ctx *context.ProgramContext,
+	sectionType string,
+	sectionID, number int,
+	contentID, repository string,
+	items []data.ProjectItem,
+) Model {
+	input := inputbox.NewModel(ctx, inputbox.ModelOpts{TextArea: func() *textarea.Model {
+		ta := inputbox.DefaultTextArea(ctx)
+		return &ta
+	}()})
+	input.SetHeight(4)
+	filter := inputbox.DefaultTextInput(ctx)
+	filter.Prompt = "Filter: "
+	model := Model{
+		ctx:         ctx,
+		sectionType: sectionType,
+		sectionID:   sectionID,
+		itemNumber:  number,
+		contentID:   contentID,
+		repository:  repository,
+		items:       items,
+		filter:      filter,
+		mode:        modeProjects,
+		input:       input,
+		active:      true,
+	}
+	model.applyFilter()
+	return model
+}
+
+func (m Model) Active() bool { return m.active && m.mode != mode(-1) }
+
+func (m *Model) Close() {
+	m.mode = mode(-1)
+	m.active = false
+	m.input.Blur()
+}
+
+func (m *Model) SetWidth(width int) {
+	m.width = width
+	if m.active {
+		m.input.SetWidth(width)
+		m.filter.SetWidth(max(0, width))
+	}
+}
+
+func (m *Model) UpdateProgramContext(ctx *context.ProgramContext) {
+	m.ctx = ctx
+	if m.active {
+		m.input.UpdateProgramContext(ctx)
+		m.filter.SetStyles(inputbox.DefaultTextInput(ctx).Styles())
+	}
+}
+
+func (m Model) Update(msg tea.Msg) (Model, tea.Cmd) {
+	var cmd tea.Cmd
+	switch msg := msg.(type) {
+	case FieldsFetchedMsg:
+		if m.mode == modeLoadingFields && m.currentProject().Project.ID == msg.ProjectID {
+			if msg.Err != nil {
+				m.status = msg.Err.Error()
+				m.mode = modeProjects
+			} else {
+				m.fields, m.field, m.mode, m.status = msg.Fields, 0, modeFields, ""
+				m.filter.SetValue("")
+				m.applyFilter()
+			}
+		}
+		return m, nil
+	case ProjectFieldUpdatedMsg:
+		if msg.Err != nil {
+			m.status = msg.Err.Error()
+			return m, nil
+		}
+		m.Close()
+		return m, nil
+	case tea.KeyMsg:
+		if m.mode == modeInput {
+			switch msg.String() {
+			case "ctrl+d":
+				value := strings.TrimSpace(m.input.Value())
+				m.input.Blur()
+				m.mode = modeLoadingFields
+				return m, m.update(value, value)
+			case "esc", "ctrl+c":
+				m.filterMode = false
+				m.filter.Blur()
+				m.input.Blur()
+				m.mode = modeFields
+				return m, nil
+			}
+			m.input, cmd = m.input.Update(msg)
+			return m, cmd
+		}
+		if m.mode == modeProjects || m.mode == modeFields || m.mode == modeOptions {
+			if m.filterMode {
+				switch msg.String() {
+				case "up":
+					m.move(-1)
+				case "down":
+					m.move(1)
+				case "esc":
+					m.filterMode = false
+					m.filter.Blur()
+				case "ctrl+c":
+					m.Close()
+				case "enter":
+					return m.selectCurrent()
+				default:
+					var filterCmd tea.Cmd
+					m.filter, filterCmd = m.filter.Update(msg)
+					m.applyFilter()
+					return m, filterCmd
+				}
+				return m, nil
+			}
+		}
+		switch msg.String() {
+		case "/":
+			m.filterMode = true
+			return m, m.filter.Focus()
+		case "up", "k":
+			m.move(-1)
+		case "down", "j":
+			m.move(1)
+		case "ctrl+c":
+			m.Close()
+		case "esc":
+			switch m.mode {
+			case modeOptions:
+				m.mode = modeFields
+			case modeFields:
+				m.mode = modeProjects
+			default:
+				m.Close()
+			}
+			m.filter.SetValue("")
+			m.filter.Blur()
+			m.applyFilter()
+		case "enter":
+			return m.selectCurrent()
+		}
+	}
+	return m, nil
+}
+
+func (m *Model) selectCurrent() (Model, tea.Cmd) {
+	if m.selectedIndex() < 0 {
+		return *m, nil
+	}
+	switch m.mode {
+	case modeProjects:
+		m.mode = modeLoadingFields
+		m.filterMode = false
+		m.filter.Blur()
+		return *m, m.fetchFields()
+	case modeFields:
+		fieldIndex := m.filtered[m.field]
+		field := m.fields[fieldIndex]
+		if field.Type == "ProjectV2SingleSelectField" || field.Type == "SINGLE_SELECT" {
+			m.mode, m.option, m.optionField = modeOptions, 0, fieldIndex
+			m.filter.SetValue("")
+			m.filter.Blur()
+			m.applyFilter()
+		} else if isEditable(field.Type) {
+			m.activeField = fieldIndex
+			m.mode = modeInput
+			m.filter.Blur()
+			m.input.Reset()
+			m.input.SetPrompt(fmt.Sprintf("Set %s (Ctrl+d to submit)...", field.Name))
+			return *m, tea.Sequence(textarea.Blink, m.input.Focus())
+		} else {
+			m.status = fmt.Sprintf("Field type %s is display-only", field.Type)
+		}
+	case modeOptions:
+		option := m.options()[m.filtered[m.option]]
+		m.activeField = m.optionField
+		m.mode = modeLoadingFields
+		m.filterMode = false
+		m.filter.Blur()
+		return *m, m.update(option.ID, option.Name)
+	}
+	return *m, nil
+}
+
+func (m *Model) move(delta int) {
+	var length int
+	switch m.mode {
+	case modeProjects:
+		length = len(m.filtered)
+	case modeFields:
+		length = len(m.filtered)
+	case modeOptions:
+		length = len(m.filtered)
+	default:
+		return
+	}
+	if length == 0 {
+		return
+	}
+	switch m.mode {
+	case modeProjects:
+		m.project = (m.project + delta + length) % length
+	case modeFields:
+		m.field = (m.field + delta + length) % length
+	case modeOptions:
+		m.option = (m.option + delta + length) % length
+	}
+}
+
+func (m Model) selectedIndex() int {
+	if len(m.filtered) == 0 {
+		return -1
+	}
+	switch m.mode {
+	case modeProjects:
+		return m.filtered[m.project]
+	case modeLoadingFields:
+		return m.filtered[m.project]
+	case modeFields:
+		return m.filtered[m.field]
+	case modeOptions:
+		return m.filtered[m.option]
+	default:
+		return -1
+	}
+}
+
+func (m Model) currentProject() data.ProjectItem {
+	return m.items[m.selectedIndex()]
+}
+
+func (m *Model) applyFilter() {
+	values := m.filterValues()
+	query := strings.TrimSpace(m.filter.Value())
+	filtered := make([]int, 0, len(values))
+	if query == "" {
+		for index := range values {
+			filtered = append(filtered, index)
+		}
+	} else {
+		matches := fuzzy.Find(strings.ToLower(query), fuzzySource(values))
+		for _, match := range matches {
+			filtered = append(filtered, match.Index)
+		}
+	}
+	m.filtered = filtered
+	m.clampSelection()
+}
+
+type fuzzySource []string
+
+func (s fuzzySource) String(i int) string { return s[i] }
+func (s fuzzySource) Len() int            { return len(s) }
+
+func (m Model) filterValues() []string {
+	var values []string
+	switch m.mode {
+	case modeProjects:
+		values = make([]string, len(m.items))
+		for i, item := range m.items {
+			values[i] = data.ProjectDisplayName(m.items, item.Project)
+		}
+	case modeFields:
+		values = make([]string, len(m.fields))
+		for i, field := range m.fields {
+			values[i] = fmt.Sprintf("%s [%s]", field.Name, field.Type)
+		}
+	case modeOptions:
+		if m.optionField >= 0 && m.optionField < len(m.fields) {
+			options := m.options()
+			values = make([]string, len(options))
+			for i, option := range options {
+				values[i] = option.Name
+			}
+		}
+	}
+	return values
+}
+
+const clearProjectOptionID = "__ghdash_clear_project_value__"
+
+func (m Model) options() []data.ProjectOption {
+	if m.optionField < 0 || m.optionField >= len(m.fields) {
+		return nil
+	}
+	options := make([]data.ProjectOption, 0, len(m.fields[m.optionField].Options)+1)
+	options = append(options, data.ProjectOption{ID: clearProjectOptionID, Name: "— Clear value —"})
+	return append(options, m.fields[m.optionField].Options...)
+}
+
+func (m *Model) clampSelection() {
+	if len(m.filtered) == 0 {
+		m.project, m.field, m.option = 0, 0, 0
+		return
+	}
+	selected := m.project
+	switch m.mode {
+	case modeFields:
+		selected = m.field
+	case modeOptions:
+		selected = m.option
+	}
+	if selected >= len(m.filtered) {
+		selected = len(m.filtered) - 1
+	}
+	if selected < 0 {
+		selected = 0
+	}
+	switch m.mode {
+	case modeProjects:
+		m.project = selected
+	case modeFields:
+		m.field = selected
+	case modeOptions:
+		m.option = selected
+	}
+}
+
+func (m Model) fetchFields() tea.Cmd {
+	projectID := m.currentProject().Project.ID
+	return func() tea.Msg {
+		fields, err := data.FetchProjectFields(projectID)
+		return FieldsFetchedMsg{ProjectID: projectID, Fields: fields, Err: err}
+	}
+}
+
+func (m Model) update(value, displayValue string) tea.Cmd {
+	project := m.currentProject()
+	field := m.fields[m.activeField]
+	return func() tea.Msg {
+		var err error
+		if value == clearProjectOptionID || strings.TrimSpace(value) == "" {
+			err = clearProjectField(m.contentID, project.Project.ID, project.ID, field.ID)
+		} else {
+			err = updateProjectField(
+				m.contentID,
+				project.Project.ID,
+				project.ID,
+				field.ID,
+				field.Type,
+				value,
+			)
+		}
+		var projectItems data.ProjectItems
+		if err == nil {
+			refreshed, refreshErr := fetchProjectItemsFull(m.contentID)
+			if refreshErr != nil {
+				err = refreshErr
+			} else {
+				projectItems = refreshed
+			}
+		}
+		return ProjectFieldUpdatedMsg{
+			SectionType:  m.sectionType,
+			SectionID:    m.sectionID,
+			ContentID:    m.contentID,
+			Repository:   m.repository,
+			ItemNumber:   m.itemNumber,
+			ProjectID:    project.Project.ID,
+			ItemID:       project.ID,
+			FieldID:      field.ID,
+			FieldName:    field.Name,
+			Value:        displayValue,
+			ProjectItems: projectItems,
+			Err:          err,
+		}
+	}
+}
+
+func isEditable(fieldType string) bool {
+	switch fieldType {
+	case "ProjectV2Field", "TEXT", "NUMBER", "DATE":
+		return true
+	default:
+		return false
+	}
+}
+
+func (m Model) View() string {
+	if !m.Active() {
+		return ""
+	}
+	var title string
+	switch m.mode {
+	case modeProjects:
+		title = "Choose a Project"
+	case modeLoadingFields:
+		title = "Loading Project fields…"
+	case modeFields:
+		title = "Choose a Project field"
+	case modeOptions:
+		title = "Choose an option"
+	case modeInput:
+		return m.input.View()
+	}
+	if m.mode == modeLoadingFields {
+		return lipgloss.NewStyle().Bold(true).Render("Edit Project field — " + title)
+	}
+	lines := []string{lipgloss.NewStyle().Bold(true).Render("Edit Project field — " + title)}
+	if m.mode == modeProjects || m.mode == modeFields || m.mode == modeOptions {
+		lines = append(lines, m.filter.View())
+	}
+	values := m.filterValues()
+	for i, index := range m.filtered {
+		value := values[index]
+		prefix := "  "
+		if i == m.selectedIndexPosition() {
+			prefix = "> "
+		}
+		lines = append(lines, prefix+value)
+	}
+	if len(m.filtered) == 0 {
+		label := "items"
+		switch m.mode {
+		case modeProjects:
+			label = "projects"
+		case modeFields:
+			label = "fields"
+		case modeOptions:
+			label = "options"
+		}
+		lines = append(lines, "No matching "+label)
+	}
+	if m.status != "" {
+		lines = append(
+			lines,
+			lipgloss.NewStyle().Foreground(m.ctx.Theme.ErrorText).Render(m.status),
+		)
+	}
+	if m.filterMode {
+		lines = append(lines, "type to filter · ↑/↓ select · Enter choose · Esc stop filtering")
+	} else {
+		lines = append(lines, "j/k/↑/↓ select · / filter · Enter choose · Esc back")
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (m Model) selectedIndexPosition() int {
+	switch m.mode {
+	case modeProjects:
+		return m.project
+	case modeFields:
+		return m.field
+	case modeOptions:
+		return m.option
+	default:
+		return -1
+	}
+}
diff --git a/internal/tui/components/projecteditor/editor_test.go b/internal/tui/components/projecteditor/editor_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..83473c42cf216893c1425b988f7ac85b2d21c068
