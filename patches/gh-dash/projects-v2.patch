+		t.Fatalf("fingerprint was not reused: calls=%d items=%#v", membershipCalls, items)
+	}
+}
+
+func TestSelectedPreviewDoesNotFingerprintVerifyLinkedValues(t *testing.T) {
+	configureProjectCacheTest(t)
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := projectGraphQLDo
+	originalClient := projectGraphQLClient
+	defer func() { projectGraphQLDo = original }()
+	defer func() { projectGraphQLClient = originalClient }()
+	projectGraphQLClient = func() (*gh.GraphQLClient, error) { return &gh.GraphQLClient{}, nil }
+	fullMembershipCalls, valueCalls := 0, 0
+	projectGraphQLDo = func(_ *gh.GraphQLClient, query string, _ map[string]interface{}, result interface{}) error {
+		switch {
+		case strings.Contains(query, "FullProjectMemberships"):
+			fullMembershipCalls++
+			return json.Unmarshal([]byte(
+				`{"node":{"projectItems":{"nodes":[{"id":"item-1","updatedAt":"2026-01-01T00:00:00Z","project":{"id":"project-1","updatedAt":"2026-01-01T00:00:00Z"}}],"pageInfo":{"hasNextPage":false,"endCursor":""}}}}`,
+			), result)
+		case strings.Contains(query, "FullProjectFieldValues"):
+			valueCalls++
+			return json.Unmarshal([]byte(
+				`{"node":{"fieldValues":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":""}}}}`,
+			), result)
+		case strings.Contains(query, "ProjectMemberships"):
+			return json.Unmarshal([]byte(
+				`{"nodes":[{"id":"issue-1","projectItems":{"nodes":[{"id":"item-1","updatedAt":"2026-01-01T00:00:00Z","project":{"id":"project-1","updatedAt":"2026-01-01T00:00:00Z"}}],"pageInfo":{"hasNextPage":false,"endCursor":""}}}]}`,
+			), result)
+		default:
+			t.Fatalf("unexpected query: %s", query)
+			return nil
+		}
+	}
+
+	full := cachedTestItems()
+	full.Nodes[0].UpdatedAt = time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	full.Nodes[0].Project.UpdatedAt = time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	full.Nodes[0].FieldValues.Nodes = []ProjectFieldValue{{
+		Typename: "ProjectV2ItemFieldPullRequestValue",
+	}}
+	persistProjectItems("issue-1", nil, full, true)
+
+	items, err := FetchProjectItemsFull("issue-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fullMembershipCalls != 1 || valueCalls != 1 ||
+		len(items.Nodes) != 1 || len(items.Nodes[0].FieldValues.Nodes) != 0 {
+		t.Fatalf(
+			"linked-value preview was not read live: membership=%d values=%d items=%#v",
+			fullMembershipCalls,
+			valueCalls,
+			items,
+		)
+	}
+}
