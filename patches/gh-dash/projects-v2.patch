+
+func testIssuesSectionContext(t *testing.T, projects bool) *context.ProgramContext {
+	t.Helper()
+	cfg, err := config.ParseConfig(config.Location{
+		ConfigFlag:       "../../../config/testdata/test-config.yml",
+		SkipGlobalConfig: true,
+	})
+	require.NoError(t, err)
+	cfg.Defaults.Layout.Projects.Enabled = projects
+	ctx := &context.ProgramContext{Config: &cfg}
+	ctx.Theme = theme.ParseTheme(&cfg)
+	ctx.Styles = context.InitStyles(ctx.Theme)
+	ctx.StartTask = func(context.Task) tea.Cmd { return nil }
+	return ctx
+}
+
+func TestIssuePagesContinueLoadingAfterFirstPaint(t *testing.T) {
+	ctx := testIssuesSectionContext(t, false)
+	m := NewModel(1, ctx, config.IssuesSectionConfig{}, time.Now(), time.Now())
+	m.LastFetchTaskId = "page-1"
+
+	_, cmd := m.Update(SectionIssuesFetchedMsg{
+		Issues:     []data.IssueData{{ID: "issue-1", Number: 1}},
+		TotalCount: 26,
+		PageInfo:   data.PageInfo{HasNextPage: true, EndCursor: "cursor-1"},
+		TaskId:     "page-1",
+	})
+
+	require.NotNil(t, cmd)
+	require.NotEqual(t, "page-1", m.LastFetchTaskId,
+		"the next search page should be scheduled automatically")
+	require.Len(t, m.Issues, 1)
+}
+
+func TestProjectValidationIsIndependentFromOrdinaryPageTask(t *testing.T) {
+	ctx := testIssuesSectionContext(t, true)
+	m := NewModel(1, ctx, config.IssuesSectionConfig{}, time.Now(), time.Now())
+	m.LastFetchTaskId = "page-2"
+	m.Issues = []data.IssueData{{ID: "issue-1"}}
+	m.projectValidationByID["issue-1"] = 1
+
+	items := data.ProjectItems{Nodes: []data.ProjectItem{{
+		Project: data.Project{ID: "project-1", Title: "Roadmap"},
+	}}}
+	m.Update(SectionProjectsFetchedMsg{
+		Items:      map[string]data.ProjectItems{"issue-1": items},
+		ContentIDs: []string{"issue-1"},
+		RequestID:  1,
+		TaskId:     "page-1",
+		Generation: data.ProjectRefreshGeneration(),
+	})
+
+	require.Equal(t, data.ProjectStateLiveVerified, m.Issues[0].ProjectItems.State)
+	require.Len(t, m.Issues[0].ProjectItems.Nodes, 1)
+}
