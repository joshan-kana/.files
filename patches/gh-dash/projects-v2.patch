+type projectEnrichmentBreaker struct {
+	mu             sync.Mutex
+	failures       int
+	classification projectFailureClass
+	permanentlyOff bool
+	unavailableTil time.Time
+	generation     uint64
+}
+
+type projectFailureClass string
+
+const (
+	projectFailureNone    projectFailureClass = ""
+	projectPermission     projectFailureClass = "permission"
+	projectPrimaryQuota   projectFailureClass = "primary-quota"
+	projectSecondaryLimit projectFailureClass = "secondary-limit"
+	projectTransient      projectFailureClass = "transient"
+)
+
+var (
+	projectBreaker    projectEnrichmentBreaker
+	projectBreakerNow = time.Now
+)
+
+func projectEnrichmentAllowed() error {
+	_, err := projectEnrichmentAllowedGeneration()
+	return err
+}
+
+func projectEnrichmentAllowedGeneration() (uint64, error) {
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if projectBreaker.permanentlyOff {
+		return projectBreaker.generation, fmt.Errorf(
+			"%w: Project permission/auth failure disabled Project reads for this process",
+			ErrProjectEnrichmentUnavailable,
+		)
+	}
+	if projectBreakerNow().Before(projectBreaker.unavailableTil) {
+		return projectBreaker.generation, fmt.Errorf(
+			"%w: %s retry after %s",
+			ErrProjectEnrichmentUnavailable,
+			projectBreaker.classification,
+			projectBreaker.unavailableTil.Format(time.RFC3339),
+		)
+	}
+	return projectBreaker.generation, nil
+}
+
+func recordProjectEnrichmentFailure(err error) {
+	classification := classifyProjectFailure(err)
+	if classification.class == projectFailureNone {
+		return
+	}
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if classification.class == projectPermission {
+		projectBreaker.generation++
+		projectBreaker.permanentlyOff = true
+		projectBreaker.classification = classification.class
+		projectBreaker.unavailableTil = time.Time{}
+		return
+	}
+	projectBreaker.generation++
+	projectBreaker.failures++
+	projectBreaker.classification = classification.class
+	projectBreaker.unavailableTil = classification.retryAt
+	if projectBreaker.unavailableTil.IsZero() {
+		backoff := projectFailureBackoff(classification.class, projectBreaker.failures)
+		projectBreaker.unavailableTil = projectBreakerNow().Add(backoff)
+	}
+}
+
+func recordProjectNetworkSuccess(generations ...uint64) {
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if projectBreaker.permanentlyOff {
+		return
+	}
+	if len(generations) > 0 && generations[0] != projectBreaker.generation {
+		return
+	}
+	if projectBreakerNow().Before(projectBreaker.unavailableTil) {
+		return
+	}
+	projectBreaker.failures = 0
+	projectBreaker.classification = projectFailureNone
+	projectBreaker.unavailableTil = time.Time{}
+}
+
+type classifiedProjectFailure struct {
+	class   projectFailureClass
+	retryAt time.Time
+}
+
+func classifyProjectFailure(err error) classifiedProjectFailure {
+	if err == nil {
+		return classifiedProjectFailure{}
+	}
+	message := strings.ToLower(err.Error())
+	if strings.Contains(message, "secondary rate limit") ||
+		strings.Contains(message, "secondary rate") ||
+		strings.Contains(message, "abuse detection") ||
+		!projectRetryAfter(err).IsZero() {
+		return classifiedProjectFailure{
+			class:   projectSecondaryLimit,
+			retryAt: projectRetryAt(err, true),
+		}
+	}
+	if strings.Contains(message, "resource not accessible by personal access token") ||
+		strings.Contains(message, "projects scope required") ||
+		strings.Contains(message, "projects permission") {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if projectHasPrimaryQuotaMarker(err, message) {
+		return classifiedProjectFailure{
+			class:   projectPrimaryQuota,
+			retryAt: projectRetryAt(err, false),
+		}
+	}
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) &&
+		(httpErr.StatusCode == http.StatusUnauthorized || httpErr.StatusCode == http.StatusForbidden) {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if strings.Contains(message, "http 403") || strings.Contains(message, "status code 403") ||
+		strings.Contains(message, "forbidden") ||
+		strings.Contains(message, "unauthorized") {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	var networkErr net.Error
+	if errors.As(err, &networkErr) || strings.Contains(message, "status code: 5") ||
+		strings.Contains(message, "status 5") ||
+		strings.Contains(message, "timeout") ||
+		strings.Contains(message, "connection reset") ||
+		strings.Contains(message, "temporary network") ||
+		strings.Contains(message, "network is unreachable") {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	if errors.As(err, &httpErr) && httpErr.StatusCode >= 500 && httpErr.StatusCode <= 599 {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	return classifiedProjectFailure{}
+}
+
+func projectHasPrimaryQuotaMarker(err error, message string) bool {
+	if strings.Contains(message, "api rate limit exceeded") ||
+		strings.Contains(message, "rate limit exceeded") ||
+		strings.Contains(message, "primary rate limit") {
+		return true
+	}
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) && httpErr.Headers.Get("X-RateLimit-Remaining") == "0" {
+		return true
+	}
+	var graphQLErr *gh.GraphQLError
+	if errors.As(err, &graphQLErr) {
+		for _, item := range graphQLErr.Errors {
+			if strings.Contains(strings.ToLower(item.Type), "rate") ||
+				strings.Contains(strings.ToLower(item.Type), "quota") {
+				return true
+			}
+			for key, value := range item.Extensions {
+				text := strings.ToLower(fmt.Sprintf("%s=%v", key, value))
+				if strings.Contains(text, "rate_limit") || strings.Contains(text, "rate-limited") ||
+					strings.Contains(text, "primary") {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func projectRetryAt(err error, durationValue bool) time.Time {
+	if durationValue {
+		if retryAfter := projectRetryAfter(err); !retryAfter.IsZero() {
+			return retryAfter
+		}
+	} else if resetAt := projectResetAt(err); !resetAt.IsZero() {
+		return resetAt
+	}
+	return time.Time{}
+}
+
+func projectRetryAfter(err error) time.Time {
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) {
+		if value := httpErr.Headers.Get("Retry-After"); value != "" {
+			if seconds, parseErr := strconv.ParseFloat(
+				strings.TrimSpace(value),
+				64,
+			); parseErr == nil {
+				return projectBreakerNow().Add(time.Duration(seconds * float64(time.Second)))
+			}
+			if parsed, parseErr := http.ParseTime(value); parseErr == nil {
+				return parsed
+			}
+		}
+	}
+	return projectExtensionTime(err, []string{"retryAfter", "retry_after"}, true)
+}
+
+func projectResetAt(err error) time.Time {
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) {
+		if value := httpErr.Headers.Get("X-RateLimit-Reset"); value != "" {
+			if seconds, parseErr := strconv.ParseInt(
+				strings.TrimSpace(value),
+				10,
+				64,
+			); parseErr == nil {
+				return time.Unix(seconds, 0)
+			}
+		}
+	}
+	return projectExtensionTime(err, []string{"resetAt", "reset_at", "reset"}, false)
+}
+
+func projectExtensionTime(err error, keys []string, durationValue bool) time.Time {
+	keySet := make(map[string]struct{}, len(keys))
+	for _, key := range keys {
+		keySet[strings.ToLower(key)] = struct{}{}
+	}
+	var graphQLErr *gh.GraphQLError
+	if errors.As(err, &graphQLErr) {
+		for _, item := range graphQLErr.Errors {
+			for key, value := range item.Extensions {
+				if _, ok := keySet[strings.ToLower(key)]; ok {
+					if parsed := parseProjectTimeValue(value, durationValue); !parsed.IsZero() {
+						return parsed
+					}
+				}
+			}
+		}
+	}
+	return time.Time{}
+}
+
+func parseProjectTimeValue(value interface{}, durationValue bool) time.Time {
+	switch typed := value.(type) {
+	case float64:
+		if durationValue {
+			return projectBreakerNow().Add(time.Duration(typed * float64(time.Second)))
+		}
+		return time.Unix(int64(typed), 0)
+	case int:
+		if durationValue {
+			return projectBreakerNow().Add(time.Duration(typed) * time.Second)
+		}
+		return time.Unix(int64(typed), 0)
+	case string:
+		if durationValue {
+			if seconds, err := strconv.ParseFloat(strings.TrimSpace(typed), 64); err == nil {
+				return projectBreakerNow().Add(time.Duration(seconds * float64(time.Second)))
+			}
+		}
+		if parsed, err := time.Parse(time.RFC3339, typed); err == nil {
+			return parsed
+		}
+		if seconds, err := strconv.ParseInt(strings.TrimSpace(typed), 10, 64); err == nil {
+			return time.Unix(seconds, 0)
+		}
+	}
+	return time.Time{}
+}
+
+func projectFailureBackoff(class projectFailureClass, failures int) time.Duration {
+	if failures < 1 {
+		failures = 1
+	}
+	if class == projectPrimaryQuota {
+		return projectPrimaryFallback
+	}
+	initial, maximum := projectTransientInitialBackoff, projectTransientMaxBackoff
+	if class == projectSecondaryLimit {
+		initial, maximum = projectSecondaryFallback, projectSecondaryMaxBackoff
+	}
+	backoff := initial
+	for attempt := 1; attempt < failures; attempt++ {
+		backoff *= 2
+		if backoff >= maximum {
+			return maximum
+		}
+	}
+	if backoff > maximum {
+		return maximum
+	}
+	return backoff
+}
+
+func isProjectAvailabilityFailure(err error) bool {
+	return classifyProjectFailure(err).class != projectFailureNone
+}
+
+func resetProjectItemsState() {
+	resetProjectCacheForTest()
+	projectItemsState.mu.Lock()
+	projectItemsState.items = make(map[string]ProjectItems)
+	projectItemsState.columns = make(map[string]string)
+	projectItemsState.inFlight = make(map[string]*projectItemsCall)
+	projectItemsState.generation = 0
+	projectItemsState.contentGen = make(map[string]uint64)
+	projectItemsState.mu.Unlock()
+	projectFingerprints.mu.Lock()
+	projectFingerprints.items = make(map[string]ProjectItems)
+	projectFingerprints.generation = 0
+	projectFingerprints.mu.Unlock()
+	projectFingerprintState.mu.Lock()
+	projectFingerprintState.inFlight = make(map[string]*projectFingerprintCall)
+	projectFingerprintState.mu.Unlock()
+
+	projectBreaker.mu.Lock()
+	projectBreaker.failures = 0
+	projectBreaker.classification = projectFailureNone
+	projectBreaker.permanentlyOff = false
+	projectBreaker.unavailableTil = time.Time{}
+	projectBreaker.generation = 0
+	projectBreaker.mu.Unlock()
+	projectSchemas.mu.Lock()
+	projectSchemas.fields = make(map[string][]ProjectField)
+	projectSchemas.inFlight = make(map[string]*projectSchemaCall)
+	projectSchemas.generation = 0
+	projectSchemas.mu.Unlock()
+}
+
+// BeginProjectRefreshGeneration starts a new authoritative Project read
+// generation. Membership/value and schema results are deduplicated only within
+// this process-local generation. Breaker state is deliberately independent so
+// a refresh cannot turn an unavailable Project API back on prematurely.
+func BeginProjectRefreshGeneration() uint64 {
+	projectItemsState.mu.Lock()
+	projectItemsState.generation++
+	generation := projectItemsState.generation
+	projectItemsState.items = make(map[string]ProjectItems)
+	projectItemsState.columns = make(map[string]string)
+	projectItemsState.mu.Unlock()
+	projectFingerprints.mu.Lock()
+	projectFingerprints.items = make(map[string]ProjectItems)
+	projectFingerprints.generation = generation
+	projectFingerprints.mu.Unlock()
+	projectFingerprintState.mu.Lock()
+	for contentID, call := range projectFingerprintState.inFlight {
+		if call.generation != generation {
+			delete(projectFingerprintState.inFlight, contentID)
+		}
+	}
+	projectFingerprintState.mu.Unlock()
+
+	projectSchemas.mu.Lock()
+	projectSchemas.generation = generation
+	projectSchemas.fields = make(map[string][]ProjectField)
+	projectSchemas.mu.Unlock()
+	return generation
+}
+
+func rememberProjectFingerprints(
+	generation uint64,
+	contentIDs []string,
+	items map[string]ProjectItems,
+) {
+	projectFingerprints.mu.Lock()
+	defer projectFingerprints.mu.Unlock()
+	if projectFingerprints.generation != generation {
+		return
+	}
+	for _, contentID := range uniqueContentIDs(contentIDs) {
+		fingerprint := ProjectItems{}
+		for _, item := range items[contentID].Nodes {
+			fingerprint.Nodes = append(fingerprint.Nodes, ProjectItem{
+				ID: item.ID, UpdatedAt: item.UpdatedAt, Project: item.Project,
+			})
+		}
+		projectFingerprints.items[contentID] = fingerprint
+	}
+}
+
+func projectFingerprint(contentID string) (ProjectItems, bool) {
+	generation := ProjectRefreshGeneration()
+	projectFingerprints.mu.Lock()
+	defer projectFingerprints.mu.Unlock()
+	if projectFingerprints.generation != generation {
+		return ProjectItems{}, false
+	}
+	fingerprint, ok := projectFingerprints.items[contentID]
+	return fingerprint, ok
+}
+
+// ProjectRefreshGeneration reports the current process-local Project data
+// generation. It is useful for proving that native refresh paths advance the
+// authoritative-read boundary without exposing cached values.
+func ProjectRefreshGeneration() uint64 {
+	projectItemsState.mu.Lock()
+	defer projectItemsState.mu.Unlock()
+	return projectItemsState.generation
+}
+
+func uniqueContentIDs(contentIDs []string) []string {
+	unique := make([]string, 0, len(contentIDs))
+	seen := make(map[string]struct{}, len(contentIDs))
+	for _, contentID := range contentIDs {
+		if contentID == "" {
+			continue
+		}
+		if _, ok := seen[contentID]; ok {
+			continue
+		}
+		seen[contentID] = struct{}{}
+		unique = append(unique, contentID)
+	}
+	return unique
+}
+
+// NormalizedField is the UI-safe representation of a Project field value.
+// RawType is retained so editing can reject unsupported values explicitly.
+type NormalizedField struct {
+	ID       string
+	Name     string
+	RawType  string
+	Value    string
+	OptionID string
+}
+
+func (item ProjectItem) Fields() []NormalizedField {
+	fields := make([]NormalizedField, 0, len(item.FieldValues.Nodes))
+	for _, value := range item.FieldValues.Nodes {
+		field := NormalizedField{RawType: value.Typename}
+		var fieldID, fieldName string
+		switch value.Typename {
+		case "ProjectV2ItemFieldTextValue":
+			fieldID, fieldName = value.TextValue.Field.IDName()
+			field.Value = value.TextValue.Text
+		case "ProjectV2ItemFieldNumberValue":
+			fieldID, fieldName = value.NumberValue.Field.IDName()
+			field.Value = strconv.FormatFloat(value.NumberValue.Number, 'f', -1, 64)
+		case "ProjectV2ItemFieldDateValue":
+			fieldID, fieldName = value.DateValue.Field.IDName()
+			field.Value = value.DateValue.Date
+		case "ProjectV2ItemFieldSingleSelectValue":
+			fieldID, fieldName = value.SingleSelectValue.Field.IDName()
+			field.Value, field.OptionID = value.SingleSelectValue.Name, value.SingleSelectValue.OptionID
+		case "ProjectV2ItemFieldIterationValue":
+			fieldID, fieldName = value.IterationValue.Field.IDName()
+			field.Value = value.IterationValue.Title
+		case "ProjectV2ItemFieldUserValue":
+			fieldID, fieldName = value.UserValue.Field.IDName()
+			users := make([]string, 0, len(value.UserValue.Users.Nodes))
+			for _, user := range value.UserValue.Users.Nodes {
+				if user.Login != "" {
+					users = append(users, "@"+user.Login)
+				} else if user.Name != "" {
+					users = append(users, user.Name)
+				}
+			}
+			field.Value = strings.Join(users, ", ")
+		case "ProjectV2ItemFieldLabelValue":
+			fieldID, fieldName = value.LabelValue.Field.IDName()
+			labels := make([]string, 0, len(value.LabelValue.Labels.Nodes))
+			for _, label := range value.LabelValue.Labels.Nodes {
+				labels = append(labels, label.Name)
+			}
+			field.Value = strings.Join(labels, ", ")
+		case "ProjectV2ItemFieldRepositoryValue":
+			fieldID, fieldName = value.RepositoryValue.Field.IDName()
+			field.Value = value.RepositoryValue.Repository.NameWithOwner
+		case "ProjectV2ItemFieldMultiSelectValue":
+			fieldID, fieldName = value.MultiSelectValue.Field.IDName()
+			field.Value = value.MultiSelectValue.Value
+			if field.Value == "" {
+				names := make([]string, 0, len(value.MultiSelectValue.Options))
+				for _, option := range value.MultiSelectValue.Options {
+					names = append(names, option.Name)
+				}
+				field.Value = strings.Join(names, ", ")
+			}
+		case "ProjectV2ItemFieldPullRequestValue":
+			fieldID, fieldName = value.PullRequestValue.Field.IDName()
+			parts := make([]string, 0, len(value.PullRequestValue.PullRequests.Nodes))
+			for _, pr := range value.PullRequestValue.PullRequests.Nodes {
+				label := fmt.Sprintf("#%d %s", pr.Number, pr.Title)
+				if pr.Repository.NameWithOwner != "" {
+					label = pr.Repository.NameWithOwner + " " + label
+				}
+				parts = append(parts, label)
+			}
+			field.Value = strings.Join(parts, ", ")
+		case "ProjectV2ItemFieldReviewerValue":
+			fieldID, fieldName = value.ReviewerValue.Field.IDName()
+			parts := make([]string, 0, len(value.ReviewerValue.Reviewers.Nodes))
+			for _, reviewer := range value.ReviewerValue.Reviewers.Nodes {
+				name := reviewer.Login
+				if name == "" {
+					name = reviewer.Name
+				}
+				if name == "" {
+					name = reviewer.Slug
+				}
+				if name == "" {
+					name = reviewer.Organization.Login
+				}
+				if name == "" {
+					name = reviewer.Team.Name
+				}
+				if name != "" {
+					parts = append(parts, "@"+name)
+				}
+			}
+			field.Value = strings.Join(parts, ", ")
+		case "ProjectV2ItemFieldMilestoneValue":
+			fieldID, fieldName = value.MilestoneValue.Field.IDName()
+			field.Value = value.MilestoneValue.Milestone.Title
+			if field.Value == "" && value.MilestoneValue.Milestone.Number > 0 {
+				field.Value = fmt.Sprintf(
+					"%s #%d",
+					value.MilestoneValue.Milestone.Repository.NameWithOwner,
+					value.MilestoneValue.Milestone.Number,
+				)
+			}
+		case "ProjectV2ItemIssueFieldValue":
+			fieldID, fieldName = value.IssueFieldValue.Field.IDName()
+			field.Value = value.IssueFieldValue.IssueFieldValue.Text
+			if field.Value == "" {
+				field.Value = value.IssueFieldValue.IssueFieldValue.Value
+			}
+			if field.Value == "" {
+				field.Value = value.IssueFieldValue.IssueFieldValue.Name
+			}
+			if field.Value == "" && value.IssueFieldValue.IssueFieldValue.Date != "" {
+				field.Value = value.IssueFieldValue.IssueFieldValue.Date
+			}
+			if field.Value == "" && value.IssueFieldValue.IssueFieldValue.Number != 0 {
+				field.Value = strconv.FormatFloat(
+					value.IssueFieldValue.IssueFieldValue.Number,
+					'f',
+					-1,
+					64,
+				)
+			}
+			if field.Value == "" && value.IssueFieldValue.IssueFieldValue.Typename != "" {
+				field.Value = "unavailable (" + value.IssueFieldValue.IssueFieldValue.Typename + ")"
+			}
+		default:
+			log.Debug("Rendering unknown Project field value type", "typename", value.Typename)
+			fieldID, fieldName = "", "Project field"
+			field.Value = "unavailable (" + value.Typename + ")"
+		}
+		field.ID, field.Name = fieldID, fieldName
+		if field.Name != "" {
+			fields = append(fields, field)
+		}
+	}
+	return fields
+}
+
+func (item ProjectItem) Field(name string) (NormalizedField, bool) {
+	return item.FieldBySelector(name, "")
+}
+
+func (item ProjectItem) FieldBySelector(name, fieldID string) (NormalizedField, bool) {
+	var match NormalizedField
+	count := 0
+	for _, field := range item.Fields() {
+		if (fieldID != "" && field.ID == fieldID) || (fieldID == "" && field.Name == name) {
+			match = field
+			count++
+		}
+	}
+	return match, count == 1
+}
+
+func ApplyProjectFieldValue(
+	items []ProjectItem,
+	projectID, itemID, fieldID, fieldName, value string,
+) []ProjectItem {
+	for itemIndex := range items {
+		if items[itemIndex].ID != itemID || items[itemIndex].Project.ID != projectID {
+			continue
+		}
+		for valueIndex := range items[itemIndex].FieldValues.Nodes {
+			field := &items[itemIndex].FieldValues.Nodes[valueIndex]
+			switch field.Typename {
+			case "ProjectV2ItemFieldTextValue":
+				currentID, currentName := field.TextValue.Field.IDName()
+				if currentID == fieldID || currentName == fieldName {
+					field.TextValue.Text = value
+				}
+			case "ProjectV2ItemFieldNumberValue":
+				currentID, currentName := field.NumberValue.Field.IDName()
+				if currentID == fieldID || currentName == fieldName {
+					if number, err := strconv.ParseFloat(value, 64); err == nil {
+						field.NumberValue.Number = number
+					}
+				}
+			case "ProjectV2ItemFieldDateValue":
+				currentID, currentName := field.DateValue.Field.IDName()
+				if currentID == fieldID || currentName == fieldName {
+					field.DateValue.Date = value
+				}
+			case "ProjectV2ItemFieldSingleSelectValue":
+				currentID, currentName := field.SingleSelectValue.Field.IDName()
+				if currentID == fieldID || currentName == fieldName {
+					field.SingleSelectValue.Name = value
+				}
+			case "ProjectV2ItemFieldIterationValue":
+				currentID, currentName := field.IterationValue.Field.IDName()
+				if currentID == fieldID || currentName == fieldName {
+					field.IterationValue.Title = value
+				}
+			}
+		}
+	}
+	return items
+}
+
+func (item ProjectItem) String() string {
+	return item.string(false)
+}
+
+func (item ProjectItem) string(qualifyProjectOwner bool) string {
+	fields := item.Fields()
+	parts := make([]string, 0, len(fields))
+	fieldCounts := make(map[string]int)
+	for _, field := range fields {
+		fieldCounts[field.Name]++
+	}
+	for _, field := range fields {
+		value := field.Value
+		if value == "" {
+			value = "—"
+		}
+		name := field.Name
+		if fieldCounts[field.Name] > 1 && field.ID != "" {
+			name = fmt.Sprintf("%s [%s]", name, field.ID)
+		}
+		parts = append(parts, fmt.Sprintf("%s: %s", name, value))
+	}
+	sort.Strings(parts)
+	header := item.Project.DisplayName(qualifyProjectOwner)
+	if len(parts) == 0 {
+		return header
+	}
+	return header + "\n  " + strings.Join(parts, "\n  ")
+}
+
+func RenderProjectItems(items []ProjectItem) string {
+	if len(items) == 0 {
+		return ""
+	}
+	ordered := append([]ProjectItem(nil), items...)
+	sort.SliceStable(ordered, func(i, j int) bool {
+		if ordered[i].Project.Number == ordered[j].Project.Number {
+			if ordered[i].Project.Owner.Login() == ordered[j].Project.Owner.Login() {
+				if ordered[i].Project.Title == ordered[j].Project.Title {
+					return ordered[i].Project.ID < ordered[j].Project.ID
+				}
+				return ordered[i].Project.Title < ordered[j].Project.Title
+			}
+			return ordered[i].Project.Owner.Login() < ordered[j].Project.Owner.Login()
+		}
+		return ordered[i].Project.Number < ordered[j].Project.Number
+	})
+	numberCounts := make(map[int]int)
+	titleCounts := make(map[string]int)
+	for _, item := range ordered {
+		numberCounts[item.Project.Number]++
+		titleCounts[strings.ToLower(item.Project.Title)]++
+	}
+	parts := make([]string, 0, len(ordered))
+	for _, item := range ordered {
+		qualify := numberCounts[item.Project.Number] > 1 ||
+			titleCounts[strings.ToLower(item.Project.Title)] > 1
+		parts = append(parts, item.string(qualify))
+	}
+	return strings.Join(parts, "\n")
+}
+
+func RenderProjectPresentation(items ProjectItems) string {
+	if items.State == ProjectStateLoading {
+		return "Projects: loading…"
+	}
+	rendered := RenderProjectItems(items.Nodes)
+	if rendered == "" {
+		rendered = "none"
+	}
+	if items.State == ProjectStateCachedUnverified {
+		return "Projects (cached; verifying…)\n" + rendered
+	}
+	return "Projects\n" + rendered
+}
+
+func ProjectDisplayName(items []ProjectItem, project Project) string {
+	numberCount := 0
+	titleCount := 0
+	for _, item := range items {
+		if item.Project.Number == project.Number {
+			numberCount++
+		}
+		if strings.EqualFold(item.Project.Title, project.Title) {
+			titleCount++
+		}
+	}
+	return project.DisplayName(numberCount > 1 || titleCount > 1)
+}
+
+func FormatProjectField(items []ProjectItem, column ProjectColumn) string {
+	return FormatProjectFieldForItems(
+		ProjectItems{Nodes: items, State: ProjectStateLiveVerified},
+		column,
+	)
+}
+
+func FormatProjectFieldForItems(projectItems ProjectItems, column ProjectColumn) string {
+	items := projectItems.Nodes
+	if projectItems.State == ProjectStateLoading && len(items) == 0 {
+		return "…"
+	}
+	selected, err := SelectProjectItems(items, column.Project)
+	if err != nil {
+		return err.Error()
+	}
+	values := make([]string, 0, len(selected))
+	for _, item := range selected {
+		if column.FieldID == "" && slices.Contains(item.AmbiguousFields, column.Name) {
+			return fmt.Sprintf(
+				"ambiguous Project field %q in %s; use fieldId",
+				column.Name,
+				item.Project.DisplayName(true),
+			)
+		}
+		field, ok := item.FieldBySelector(column.Name, column.FieldID)
+		if !ok {
+			if column.FieldID == "" && countFieldsByName(item.Fields(), column.Name) > 1 {
+				return fmt.Sprintf(
+					"ambiguous Project field %q in %s; use fieldId",
+					column.Name,
+					item.Project.DisplayName(true),
+				)
+			}
+			continue
+		}
+		value := field.Value
+		if value == "" {
+			value = "—"
+		}
+		if column.Project == "" && len(selected) > 1 {
+			value = fmt.Sprintf("%s: %s", projectColumnLabel(selected, item.Project), value)
+		}
+		values = append(values, value)
+	}
+	sort.Strings(values)
+	if len(values) == 0 && projectItems.State == ProjectStateCachedUnverified {
+		return "…"
+	}
+	formatted := strings.Join(values, ", ")
+	if projectItems.State == ProjectStateCachedUnverified && formatted != "" {
+		// Keep cached values useful on a warm launch while making it impossible
+		// to mistake them for live-verified GitHub data in the table.
+		return "~" + formatted
+	}
+	return formatted
+}
+
+type ProjectColumn struct {
+	Name    string
+	FieldID string
+	Project string
+}
+
+func countFieldsByName(fields []NormalizedField, name string) int {
+	count := 0
+	for _, field := range fields {
+		if field.Name == name {
+			count++
+		}
+	}
+	return count
+}
+
+func projectColumnLabel(items []ProjectItem, project Project) string {
+	count := 0
+	for _, item := range items {
+		if strings.EqualFold(item.Project.Title, project.Title) {
+			count++
+		}
+	}
+	if count > 1 && project.Owner.Login() != "" {
+		return project.Owner.Login() + " / " + project.Title
+	}
+	return project.Title
+}
+
+// SelectProjectItems resolves a user-facing Project selector against the
+// memberships on one content item. Unqualified selectors are accepted only
+// when they identify one membership; owner/number and node ID are explicit
+// collision-safe forms.
+func SelectProjectItems(items []ProjectItem, selector string) ([]ProjectItem, error) {
+	if selector == "" {
+		return items, nil
+	}
+	matches := make([]ProjectItem, 0)
+	for _, item := range items {
+		if projectMatchesSelector(item.Project, selector) {
+			matches = append(matches, item)
+		}
+	}
+	if len(matches) > 1 {
+		return nil, fmt.Errorf(
+			"ambiguous Project selector %q; use owner/number, owner/title, or the Project node ID",
+			selector,
+		)
+	}
+	return matches, nil
+}
+
+func projectMatchesSelector(project Project, selector string) bool {
+	if selector == project.ID {
+		return true
+	}
+	owner := project.Owner.Login()
+	if strings.Contains(selector, "/") {
+		parts := strings.SplitN(selector, "/", 2)
+		if parts[0] != owner {
+			return false
+		}
+		if number, err := strconv.Atoi(parts[1]); err == nil {
+			return number == project.Number
+		}
+		return strings.EqualFold(parts[1], project.Title)
+	}
+	if number, err := strconv.Atoi(selector); err == nil {
+		return number == project.Number
+	}
+	return strings.EqualFold(selector, project.Title)
+}
+
+func FetchProjectFields(projectID string) ([]ProjectField, error) {
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	query := `query ProjectFields($id: ID!, $after: String) {
+  node(id: $id) { ... on ProjectV2 { fields(first: 100, after: $after) { nodes {
+    __typename
+    ... on ProjectV2Field { id name dataType }
+    ... on ProjectV2IterationField { id name }
+    ... on ProjectV2SingleSelectField { id name options { id name } }
+    ... on ProjectV2MultiSelectField { id name multiSelectOptions { id name } }
+  } pageInfo { hasNextPage endCursor } } } }
+}`
+	var response struct {
+		Node struct {
+			Fields struct {
+				Nodes []struct {
+					Typename           string          `json:"__typename"`
+					ID                 string          `json:"id"`
+					Name               string          `json:"name"`
+					DataType           string          `json:"dataType"`
+					Options            []ProjectOption `json:"options"`
+					MultiSelectOptions []ProjectOption `json:"multiSelectOptions"`
+				} `json:"nodes"`
+				PageInfo struct {
+					HasNextPage bool   `json:"hasNextPage"`
+					EndCursor   string `json:"endCursor"`
+				} `json:"pageInfo"`
+			} `json:"fields"`
+		} `json:"node"`
+	}
+	fields := make([]ProjectField, 0)
+	var after *string
+	for {
+		err = projectGraphQLRead(
+			client,
+			query,
+			map[string]interface{}{"id": projectID, "after": after},
+			&response,
+		)
+		if err != nil {
+			return nil, err
+		}
+		for _, field := range response.Node.Fields.Nodes {
+			fieldType := field.Typename
+			if field.DataType != "" {
+				fieldType = field.DataType
+			}
+			options := field.Options
+			if len(options) == 0 {
+				options = field.MultiSelectOptions
+			}
+			fields = append(
+				fields,
+				ProjectField{ID: field.ID, Name: field.Name, Type: fieldType, Options: options},
+			)
+		}
+		if !response.Node.Fields.PageInfo.HasNextPage {
+			break
+		}
+		cursor := response.Node.Fields.PageInfo.EndCursor
+		after = &cursor
+	}
+	sort.SliceStable(
+		fields,
+		func(i, j int) bool { return strings.ToLower(fields[i].Name) < strings.ToLower(fields[j].Name) },
+	)
+	return fields, nil
+}
+
+func UpdateProjectField(contentID, projectID, itemID, fieldID, fieldType, value string) error {
+	fieldValue := map[string]interface{}{}
+	switch fieldType {
+	case "ProjectV2SingleSelectField", "SINGLE_SELECT":
+		if value == "" {
+			return fmt.Errorf("single-select fields must use ClearProjectField to clear a value")
+		}
+		fieldValue["singleSelectOptionId"] = value
+	case "ProjectV2Field", "TEXT":
+		fieldValue["text"] = value
+	case "NUMBER":
+		number, err := strconv.ParseFloat(value, 64)
+		if err != nil {
+			return fmt.Errorf("number field requires a numeric value: %w", err)
+		}
+		fieldValue["number"] = number
+	case "DATE":
+		fieldValue["date"] = value
+	case "ProjectV2IterationField", "ITERATION":
+		fieldValue["iterationId"] = value
+	default:
+		return fmt.Errorf("Project field type %q is not editable", fieldType)
+	}
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return err
+	}
+	mutation := `mutation UpdateProjectField($input: UpdateProjectV2ItemFieldValueInput!) {
+  updateProjectV2ItemFieldValue(input: $input) { projectV2Item { id } }
+}`
+	var response struct {
+		UpdateProjectV2ItemFieldValue struct {
+			ProjectV2Item struct {
+				ID string `json:"id"`
+			} `json:"projectV2Item"`
+		} `json:"updateProjectV2ItemFieldValue"`
+	}
+	variables := map[string]interface{}{"input": map[string]interface{}{
+		"projectId": projectID, "itemId": itemID, "fieldId": fieldID, "value": fieldValue,
+	}}
+	err = client.Do(mutation, variables, &response)
+	if err == nil {
+		InvalidateProjectItems(contentID)
+	}
+	return err
+}
+
+// ClearProjectField removes the authoritative Project value for an item.
+// GitHub requires a dedicated mutation for clearing a previously-set value.
+func ClearProjectField(contentID, projectID, itemID, fieldID string) error {
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return err
+	}
+	mutation := `mutation ClearProjectField($input: ClearProjectV2ItemFieldValueInput!) {
+  clearProjectV2ItemFieldValue(input: $input) { projectV2Item { id } }
+}`
+	var response struct {
+		ClearProjectV2ItemFieldValue struct {
+			ProjectV2Item struct {
+				ID string `json:"id"`
+			} `json:"projectV2Item"`
+		} `json:"clearProjectV2ItemFieldValue"`
+	}
+	variables := map[string]interface{}{"input": map[string]interface{}{
+		"projectId": projectID, "itemId": itemID, "fieldId": fieldID,
+	}}
+	err = client.Do(mutation, variables, &response)
+	if err == nil {
+		InvalidateProjectItems(contentID)
+	}
+	return err
+}
+
+// FetchProjectItems fetches Project memberships for content node IDs in one
+// request. It is deliberately separate from the normal issue/PR queries so a
+// token without Project access can still use the rest of gh-dash normally.
+func fetchProjectItemsNetworkLegacy(contentIDs []string) (map[string]ProjectItems, error) {
+	if len(contentIDs) == 0 {
+		return map[string]ProjectItems{}, nil
+	}
+	projectClient, err := projectGraphQLClient()
+	if err != nil {
+		return nil, err
+	}
+	query := `query ProjectItems($ids: [ID!]!) {
+  nodes(ids: $ids) {
+    __typename
+    ... on Issue { id projectItems(first: 20) { nodes {
+      id project { id number title owner { ... on User { login } ... on Organization { login } } }
+      fieldValues(first: 50) { nodes {
+        __typename
+        ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }
+        ... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }
+        ... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }
+      } }
+    } } }
+    ... on PullRequest { id projectItems(first: 20) { nodes {
+      id project { id number title owner { ... on User { login } ... on Organization { login } } }
+      fieldValues(first: 50) { nodes {
+        __typename
+        ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }
+        ... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }
+        ... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }
+        ... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }
+      } }
+    } } }
+  }
+}`
+	type projectFieldRefJSON struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+	}
+	type projectFieldValueJSON struct {
+		Typename    string              `json:"__typename"`
+		Text        string              `json:"text"`
+		Number      float64             `json:"number"`
+		Date        string              `json:"date"`
+		Name        string              `json:"name"`
+		OptionID    string              `json:"optionId"`
+		Title       string              `json:"title"`
+		IterationID string              `json:"iterationId"`
+		Field       projectFieldRefJSON `json:"field"`
+		Users       struct {
+			Nodes []struct {
+				Login string `json:"login"`
+				Name  string `json:"name"`
+			} `json:"nodes"`
+		} `json:"users"`
+		Labels struct {
+			Nodes []struct {
+				Name string `json:"name"`
+			} `json:"nodes"`
+		} `json:"labels"`
+		Repository struct {
+			NameWithOwner string `json:"nameWithOwner"`
+		} `json:"repository"`
+	}
+	type projectItemJSON struct {
+		ID      string `json:"id"`
+		Project struct {
+			ID     string `json:"id"`
+			Number int    `json:"number"`
+			Title  string `json:"title"`
+			Owner  struct {
+				Login string `json:"login"`
+			} `json:"owner"`
+		} `json:"project"`
+		FieldValues struct {
+			Nodes []projectFieldValueJSON `json:"nodes"`
+		} `json:"fieldValues"`
+	}
+	var response struct {
+		Nodes []struct {
+			Typename     string `json:"__typename"`
+			ID           string `json:"id"`
+			ProjectItems struct {
+				Nodes []projectItemJSON `json:"nodes"`
+			} `json:"projectItems"`
+		} `json:"nodes"`
+	}
+	if err := projectGraphQLRead(
+		projectClient,
+		query,
+		map[string]interface{}{"ids": contentIDs},
+		&response,
+	); err != nil {
+		return nil, err
+	}
+	result := make(map[string]ProjectItems, len(response.Nodes))
+	for _, node := range response.Nodes {
+		if node.ID != "" {
+			items := ProjectItems{Nodes: make([]ProjectItem, 0, len(node.ProjectItems.Nodes))}
+			for _, rawItem := range node.ProjectItems.Nodes {
+				item := ProjectItem{
+					ID: rawItem.ID,
+					Project: Project{
+						ID:     rawItem.Project.ID,
+						Number: rawItem.Project.Number,
+						Title:  rawItem.Project.Title,
+						Owner: ProjectOwner{User: struct {
+							Login string
+						}{Login: rawItem.Project.Owner.Login}},
+					},
+					FieldValues: struct {
+						Nodes []ProjectFieldValue
+					}{Nodes: make([]ProjectFieldValue, 0, len(rawItem.FieldValues.Nodes))},
+				}
+				for _, rawValue := range rawItem.FieldValues.Nodes {
+					value := ProjectFieldValue{Typename: rawValue.Typename}
+					field := ProjectFieldRef{Common: struct {
+						ID   string
+						Name string
+					}{ID: rawValue.Field.ID, Name: rawValue.Field.Name}}
+					switch rawValue.Typename {
+					case "ProjectV2ItemFieldTextValue":
+						value.TextValue.Field = field
+						value.TextValue.Text = rawValue.Text
+					case "ProjectV2ItemFieldNumberValue":
+						value.NumberValue.Field = field
+						value.NumberValue.Number = rawValue.Number
+					case "ProjectV2ItemFieldDateValue":
+						value.DateValue.Field = field
+						value.DateValue.Date = rawValue.Date
+					case "ProjectV2ItemFieldSingleSelectValue":
+						field = ProjectFieldRef{SingleSelect: struct {
+							ID   string
+							Name string
+						}{ID: rawValue.Field.ID, Name: rawValue.Field.Name}}
+						value.SingleSelectValue.Field = field
+						value.SingleSelectValue.Name = rawValue.Name
+						value.SingleSelectValue.OptionID = rawValue.OptionID
+					case "ProjectV2ItemFieldIterationValue":
+						field = ProjectFieldRef{Iteration: struct {
+							ID   string
+							Name string
+						}{ID: rawValue.Field.ID, Name: rawValue.Field.Name}}
+						value.IterationValue.Field = field
+						value.IterationValue.Title = rawValue.Title
+						value.IterationValue.IterationID = rawValue.IterationID
+					case "ProjectV2ItemFieldUserValue":
+						value.UserValue.Field = field
+						for _, user := range rawValue.Users.Nodes {
+							value.UserValue.Users.Nodes = append(
+								value.UserValue.Users.Nodes,
+								struct {
+									Login string
+									Name  string
+								}{Login: user.Login, Name: user.Name},
+							)
+						}
+					case "ProjectV2ItemFieldLabelValue":
+						value.LabelValue.Field = field
+						for _, label := range rawValue.Labels.Nodes {
+							value.LabelValue.Labels.Nodes = append(
+								value.LabelValue.Labels.Nodes,
+								struct{ Name string }{Name: label.Name},
+							)
+						}
+					case "ProjectV2ItemFieldRepositoryValue":
+						value.RepositoryValue.Field = field
+						value.RepositoryValue.Repository.NameWithOwner = rawValue.Repository.NameWithOwner
+					default:
+						continue
+					}
+					item.FieldValues.Nodes = append(item.FieldValues.Nodes, value)
+				}
+				items.Nodes = append(items.Nodes, item)
+			}
+			result[node.ID] = items
+		}
+	}
+	return result, nil
+}
+
+var fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+	return fetchProjectItemsNetwork(contentIDs, nil)
+}
+
+var fetchProjectItemsBatchWithColumns = func(contentIDs []string, columns []ProjectColumn) (map[string]ProjectItems, error) {
+	return fetchProjectItemsNetwork(contentIDs, columns)
+}
+
+func fetchProjectItemsCached(
+	contentIDs []string,
+	projectColumns ...[]ProjectColumn,
+) (map[string]ProjectItems, error) {
+	var columns []ProjectColumn
+	if len(projectColumns) > 0 {
+		columns = projectColumns[0]
+	}
+	contentIDs = uniqueContentIDs(contentIDs)
+	result := make(map[string]ProjectItems, len(contentIDs))
+	if len(contentIDs) == 0 {
+		return result, nil
+	}
+
+	projectItemsState.mu.Lock()
+	owners := make([]string, 0, len(contentIDs))
+	waiters := make(map[string]*projectItemsCall)
+	contentGenerations := make(map[string]uint64)
+	refreshGeneration := projectItemsState.generation
+	for _, contentID := range contentIDs {
+		if items, ok := projectItemsState.items[contentID]; ok &&
+			projectItemsState.columns[contentID] == projectColumnsKey(columns) {
+			result[contentID] = items
+			continue
+		}
+		if call, ok := projectItemsState.inFlight[contentID]; ok &&
+			call.generation == refreshGeneration {
+			waiters[contentID] = call
+			continue
+		}
+		call := &projectItemsCall{done: make(chan struct{}), generation: refreshGeneration}
+		projectItemsState.inFlight[contentID] = call
+		contentGenerations[contentID] = projectItemsState.contentGen[contentID]
+		owners = append(owners, contentID)
+		waiters[contentID] = call
+	}
+	projectItemsState.mu.Unlock()
+
+	if len(owners) > 0 {
+		if err := projectEnrichmentAllowed(); err != nil {
+			completeProjectItemsCall(
+				owners,
+				waiters,
+				refreshGeneration,
+				contentGenerations,
+				nil,
+				err,
+				columns,
+			)
+		} else {
+			var items map[string]ProjectItems
+			var err error
+			if len(columns) == 0 {
+				items, err = fetchProjectItemsBatch(owners)
+			} else {
+				items, err = fetchProjectItemsBatchWithColumns(owners, columns)
+			}
+			completeProjectItemsCall(
+				owners,
+				waiters,
+				refreshGeneration,
+				contentGenerations,
+				items,
+				err,
+				columns,
+			)
+		}
+	}
+
+	for contentID, call := range waiters {
+		<-call.done
+		if items, ok := call.items[contentID]; ok {
+			result[contentID] = items
+		}
+		if call.err != nil {
+			return result, call.err
+		}
+	}
+	return result, nil
+}
+
+func completeProjectItemsCall(
+	owners []string,
+	waiters map[string]*projectItemsCall,
+	refreshGeneration uint64,
+	contentGenerations map[string]uint64,
+	items map[string]ProjectItems,
+	err error,
+	columns []ProjectColumn,
+) {
+	if items == nil {
+		items = make(map[string]ProjectItems)
+	}
+	projectItemsState.mu.Lock()
+	for _, contentID := range owners {
+		call := waiters[contentID]
+		call.items = items
+		call.err = err
+		if err == nil {
+			if _, ok := items[contentID]; !ok {
+				items[contentID] = ProjectItems{}
+			}
+			if projectItemsState.generation == refreshGeneration &&
+				projectItemsState.contentGen[contentID] == contentGenerations[contentID] {
+				projectItemsState.items[contentID] = items[contentID]
+				projectItemsState.columns[contentID] = projectColumnsKey(columns)
+			}
+		}
+		if projectItemsState.inFlight[contentID] == call {
+			delete(projectItemsState.inFlight, contentID)
+		}
+		close(call.done)
+	}
+	projectItemsState.mu.Unlock()
+}
+
+// FetchProjectItems returns cached Project memberships when available and
+// coalesces concurrent requests for the same content node IDs.
+func FetchProjectItems(contentIDs []string) (map[string]ProjectItems, error) {
+	return fetchProjectItemsCached(contentIDs)
+}
+
+// InvalidateProjectItems removes cached metadata for a content node. The
+// generation prevents an older in-flight request from repopulating stale data
+// after a Project mutation.
+func InvalidateProjectItems(contentID string) {
+	if contentID == "" {
+		return
+	}
+	projectItemsState.mu.Lock()
+	projectItemsState.contentGen[contentID]++
+	delete(projectItemsState.items, contentID)
+	delete(projectItemsState.columns, contentID)
+	delete(projectItemsState.inFlight, contentID)
+	projectItemsState.mu.Unlock()
+	// Advance the authoritative generation so an in-flight fingerprint or
+	// full-preview read from before the mutation cannot repopulate live state.
+	BeginProjectRefreshGeneration()
+	invalidatePersistentProjectItems(contentID)
+}
+
+// FetchProjectItemsBatched keeps ProjectV2's nested connection cost out of the
+// normal issue/PR search query and bounds each enrichment request separately.
+func FetchProjectItemsBatched(
+	contentIDs []string,
+	projectColumns ...[]ProjectColumn,
+) (map[string]ProjectItems, error) {
+	var columns []ProjectColumn
+	if len(projectColumns) > 0 {
+		columns = projectColumns[0]
+	}
+	contentIDs = uniqueContentIDs(contentIDs)
+	result := make(map[string]ProjectItems)
+	for start := 0; start < len(contentIDs); start += projectItemsBatchSize {
+		end := start + projectItemsBatchSize
+		if end > len(contentIDs) {
+			end = len(contentIDs)
+		}
+		items, err := fetchProjectItemsCached(contentIDs[start:end], columns)
+		if err != nil {
+			log.Warn(
+				"Project enrichment batch failed; retaining earlier Project metadata",
+				"batchStart",
+				start,
+				"batchSize",
+				end-start,
+				"remaining",
+				len(contentIDs)-end,
+				"error",
+				err,
+			)
+			for contentID, projectItems := range items {
+				result[contentID] = projectItems
+			}
+			return result, err
+		}
+		for contentID, projectItems := range items {
+			result[contentID] = projectItems
+		}
+	}
+	return result, nil
+}
+
+func RevalidateProjectItems(
+	contentIDs []string,
+	columns []ProjectColumn,
+) (map[string]ProjectItems, error) {
+	return FetchProjectItemsBatched(contentIDs, columns)
+}
+
+var projectGraphQLClient = func() (*gh.GraphQLClient, error) {
+	if client != nil {
+		return client, nil
+	}
+	return gh.DefaultGraphQLClient()
+}
+
+func ReplaceProjectItems(current []ProjectItem, authoritative ProjectItems) []ProjectItem {
+	return append([]ProjectItem(nil), authoritative.Nodes...)
+}
+
+func ProjectUpdateTargets(
+	contentID, repository string,
+	number int,
+	currentID, currentRepository string,
+	currentNumber int,
+) bool {
+	if contentID != "" {
+		return contentID == currentID
+	}
+	return repository != "" && repository == currentRepository && number == currentNumber
+}
