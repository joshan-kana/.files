+++ b/internal/config/parser_projects_test.go
@@ -0,0 +1,44 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestProjectFieldColumnsParseFromDefaultsLayout(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yml")
+	contents := `
+prSections:
+  - title: Pull requests
+    filters: is:open
+issuesSections:
+  - title: Issues
+    filters: is:open
+defaults:
+  layout:
+    projects:
+      enabled: true
+      fields:
+        - name: Status
+          project: infrastructure
+          width: 20
+        - name: Priority
+          hidden: true
+        - fieldId: PVTF_example
+`
+	if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	config, err := ParseConfig(Location{ConfigFlag: path, SkipGlobalConfig: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	fields := config.Defaults.Layout.Projects.Fields
+	if !config.Defaults.Layout.Projects.Enabled {
+		t.Fatal("Project enrichment should be enabled by config")
+	}
+	if len(fields) != 3 || fields[0].Name != "Status" || fields[0].Project != "infrastructure" || fields[0].Width == nil || *fields[0].Width != 20 || fields[1].Hidden == nil || !*fields[1].Hidden || fields[2].FieldID != "PVTF_example" {
+		t.Fatalf("unexpected Project fields: %#v", fields)
+	}
+}
