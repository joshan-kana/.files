+func TestProjectItemsInvalidationForcesAuthoritativeRefetch(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	var mu sync.Mutex
+	calls := 0
+	fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+		mu.Lock()
+		calls++
+		version := calls
+		mu.Unlock()
+		items := projectItemsFor(contentIDs)
+		for contentID := range items {
+			items[contentID].Nodes[0].Project.Title = fmt.Sprintf("Version %d", version)
+		}
+		return items, nil
+	}
+	first, err := FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	_, err = FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+	InvalidateProjectItems("issue-a")
+	authoritative, err := FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+	require.Equal(t, "Version 1", first["issue-a"].Nodes[0].Project.Title)
+	require.Equal(t, "Version 2", authoritative["issue-a"].Nodes[0].Project.Title)
+}
