+func notificationProjectItems(values ...string) data.ProjectItems {
+	item := data.ProjectItem{Project: data.Project{Number: 1, Title: "Roadmap"}}
+	for index := 0; index < len(values); index += 2 {
+		field := data.ProjectFieldValue{Typename: "ProjectV2ItemFieldSingleSelectValue"}
+		field.SingleSelectValue.Field.Common.Name = values[index]
+		field.SingleSelectValue.Name = values[index+1]
+		item.FieldValues.Nodes = append(item.FieldValues.Nodes, field)
+	}
+	return data.ProjectItems{Nodes: []data.ProjectItem{item}}
