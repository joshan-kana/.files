+	previewCmd := fetchNotificationProjectPreview("notification-1", issue.ID)
+	require.NotNil(t, previewCmd)
+	_ = previewCmd()
+	require.Equal(t, 1, fullFetches,
+		"the full Project read belongs to the opened-subject preview path")
+}
