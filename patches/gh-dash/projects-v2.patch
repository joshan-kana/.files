+func TestProjectFailureClassificationUsesGitHubTimingMetadata(t *testing.T) {
+	now := time.Date(2026, 8, 16, 4, 0, 0, 0, time.UTC)
+	originalNow := projectBreakerNow
+	projectBreakerNow = func() time.Time { return now }
+	defer func() { projectBreakerNow = originalNow }()
+
+	primary := &gh.HTTPError{
+		StatusCode: 403,
+		Headers: http.Header{
+			"X-Ratelimit-Remaining": []string{"0"},
+			"X-Ratelimit-Reset":     []string{fmt.Sprint(now.Add(11 * time.Minute).Unix())},
+		},
+	}
+	secondary := &gh.HTTPError{
+		StatusCode: 403,
+		Message:    "secondary rate limit",
+		Headers:    http.Header{"Retry-After": []string{"17"}},
+	}
+	tests := []struct {
+		name      string
+		err       error
+		class     projectFailureClass
+		retryAt   time.Time
+		wantRetry bool
+	}{
+		{
+			name:  "permission",
+			err:   errors.New("Resource not accessible by personal access token"),
+			class: projectPermission,
+		},
+		{
+			name:      "primary quota",
+			err:       primary,
+			class:     projectPrimaryQuota,
+			retryAt:   now.Add(11 * time.Minute),
+			wantRetry: true,
+		},
+		{
+			name:      "secondary rate limit",
+			err:       secondary,
+			class:     projectSecondaryLimit,
+			retryAt:   now.Add(17 * time.Second),
+			wantRetry: true,
+		},
+		{
+			name:  "transient network",
+			err:   errors.New("temporary network failure"),
+			class: projectTransient,
+		},
+	}
+	for _, testCase := range tests {
+		t.Run(testCase.name, func(t *testing.T) {
+			got := classifyProjectFailure(testCase.err)
+			if got.class != testCase.class {
+				t.Fatalf("class = %q, want %q", got.class, testCase.class)
+			}
+			if testCase.wantRetry && !got.retryAt.Equal(testCase.retryAt) {
+				t.Fatalf("retryAt = %s, want %s", got.retryAt, testCase.retryAt)
+			}
+		})
+	}
+}
