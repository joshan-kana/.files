@@ -0,0 +1,117 @@
+package prview
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/config"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/projecteditor"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/prrow"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/theme"
+)
+
+func newProjectPreviewTestContext(t *testing.T) *context.ProgramContext {
+	t.Helper()
+	cfg, err := config.ParseConfig(
+		config.Location{
+			ConfigFlag:       "../../../config/testdata/test-config.yml",
+			SkipGlobalConfig: true,
+		},
+	)
+	require.NoError(t, err)
+	cfg.Defaults.Layout.Projects.Enabled = true
+	thm := theme.ParseTheme(&cfg)
+	return &context.ProgramContext{Config: &cfg, Theme: thm, Styles: context.InitStyles(thm)}
+}
+
+func TestSelectedPRProjectPreviewHasExplicitLoadingAndErrorStates(t *testing.T) {
+	ctx := newProjectPreviewTestContext(t)
+	m := NewModel(ctx)
+	primary := &data.PullRequestData{ID: "pr-1", Url: "https://github.com/o/r/pull/1"}
+	m.SetRow(&prrow.Data{Primary: primary})
+	m.SetProjectPreviewLoading()
+	listOnly := data.ProjectItems{
+		Nodes: []data.ProjectItem{{Project: data.Project{Title: "Roadmap", Number: 1}}},
+	}
+	m.pr.Data.Primary.ProjectItems = listOnly
+	require.Contains(t, stripANSI(m.renderProjectPreview()), "Projects: loading…")
+
+	m.SetProjectPreviewError(errors.New("temporary network failure"))
+	require.Contains(
+		t,
+		stripANSI(m.renderProjectPreview()),
+		"Projects unavailable: temporary network failure",
+	)
+
+	full := data.ProjectItems{
+		Nodes: []data.ProjectItem{{Project: data.Project{Title: "Roadmap", Number: 1}}},
+	}
+	m.SetProjectPreviewReady(full)
+	require.True(t, strings.Contains(stripANSI(m.renderProjectPreview()), "Projects"))
+}
+
+func TestProjectEditorTakesOverPRPreview(t *testing.T) {
+	ctx := newProjectPreviewTestContext(t)
+	m := NewModel(ctx)
+	m.SetWidth(80)
+	m.SetRow(&prrow.Data{Primary: &data.PullRequestData{
+		ID: "pr-1", Url: "https://github.com/o/r/pull/1", Title: "Long pull request",
+	}, Enriched: data.EnrichedPullRequestData{Body: strings.Repeat("summary ", 200)}})
+	m.projectEditor = projecteditor.New(
+		ctx,
+		"pullRequest",
+		1,
+		1,
+		"pr-1",
+		"owner/repo",
+		[]data.ProjectItem{{
+			ID: "item-1", Project: data.Project{ID: "project-1", Title: "Roadmap"},
+		}},
+	)
+
+	view := m.View()
+	require.Contains(t, view, "Edit Project field")
+	require.NotContains(t, view, "Long pull request")
+	require.NotContains(t, view, "summary summary")
+}
+
+func TestAlreadyEnrichedPRRevisitStartsIndependentProjectPreview(t *testing.T) {
+	ctx := newProjectPreviewTestContext(t)
+	m := NewModel(ctx)
+
+	pr := func(id string) *prrow.Data {
+		return &prrow.Data{
+			Primary:    &data.PullRequestData{ID: id, Url: "https://github.com/o/r/pull/" + id},
+			IsEnriched: true,
+		}
+	}
+
+	m.SetRow(pr("a"))
+	m.SetProjectPreviewLoading()
+	require.NotNil(
+		t,
+		m.EnrichCurrRow(),
+		"an already-enriched PR still needs a Project preview request",
+	)
+	firstGeneration := m.enrichGeneration
+	require.True(t, m.AcceptsProjectPreview("a", firstGeneration))
+
+	m.SetRow(pr("b"))
+	m.SetProjectPreviewLoading()
+	require.NotNil(t, m.EnrichCurrRow())
+	m.SetRow(pr("a"))
+	m.SetProjectPreviewLoading()
+	require.NotNil(t, m.EnrichCurrRow(), "returning to an enriched PR must not stick in loading")
+	require.Greater(t, m.enrichGeneration, firstGeneration)
+	require.False(t, m.AcceptsProjectPreview("b", m.enrichGeneration))
+	require.True(t, m.AcceptsProjectPreview("a", m.enrichGeneration))
+}
+
+func stripANSI(value string) string {
+	return value
+}
