+
+	recordProjectEnrichmentFailure(errors.New("projects scope required"))
+	if err := projectEnrichmentAllowed(); !errors.Is(err, ErrProjectEnrichmentUnavailable) {
+		t.Fatalf("permission breaker error = %v", err)
+	}
+	projectBreaker.mu.Lock()
+	permanentlyOff := projectBreaker.permanentlyOff
+	projectBreaker.mu.Unlock()
+	if !permanentlyOff {
+		t.Fatal("permission failure did not permanently disable Project reads")
+	}
+
+	resetProjectItemsState()
+	recordProjectEnrichmentFailure(errors.New("temporary network failure"))
+	if err := projectEnrichmentAllowed(); !errors.Is(err, ErrProjectEnrichmentUnavailable) {
+		t.Fatalf("transient breaker error = %v", err)
+	}
+	now = now.Add(time.Minute)
+	if err := projectEnrichmentAllowed(); err != nil {
+		t.Fatalf("transient breaker did not reopen after backoff: %v", err)
+	}
+}
