+package notificationssection
+
+import (
+	"testing"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/notificationrow"
+)
+
+func TestNotificationBackgroundCommentFetchDisablesProjectEnrichment(t *testing.T) {
+	originalPR := fetchNotificationPullRequest
+	originalIssue := fetchNotificationIssue
+	defer func() { fetchNotificationPullRequest = originalPR }()
+	defer func() { fetchNotificationIssue = originalIssue }()
+	calls := 0
+	fetchNotificationPullRequest = func(_ string) (data.EnrichedPullRequestData, error) {
+		calls++
+		return data.EnrichedPullRequestData{}, nil
+	}
+	fetchNotificationIssue = func(_ string) (data.IssueData, error) {
+		calls++
+		return data.IssueData{}, nil
+	}
+	m := Model{}
+	notifications := []notificationrow.Data{
+		{
+			Notification: data.NotificationData{
+				Id: "pr",
+				Subject: data.NotificationSubject{
+					Type: "PullRequest",
+					Url:  "https://github.com/owner/repo/pull/1",
+				},
+			},
+		},
+		{
+			Notification: data.NotificationData{
+				Id: "issue",
+				Subject: data.NotificationSubject{
+					Type: "Issue",
+					Url:  "https://github.com/owner/repo/issues/2",
+				},
+			},
+		},
+	}
+	cmds := m.fetchCommentCountsForNotifications(notifications)
+	if len(cmds) != 2 {
+		t.Fatalf("background commands = %d, want 2", len(cmds))
+	}
+	for _, cmd := range cmds {
+		if cmd == nil {
+			t.Fatal("background comment command is nil")
+		}
+		if msg := cmd(); msg == nil {
+			t.Fatal("background comment command returned nil")
+		}
+	}
+	if calls != 2 {
+		t.Fatalf("background ordinary fetches = %d, want 2", calls)
+	}
+}
