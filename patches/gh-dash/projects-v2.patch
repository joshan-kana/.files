+++ b/internal/data/projects.go
@@ -0,0 +1,1274 @@
+package data
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"charm.land/log/v2"
+	gh "github.com/cli/go-gh/v2/pkg/api"
+	graphql "github.com/cli/shurcooL-graphql"
+)
+
+var queryGraphQL = func(client *gh.GraphQLClient, name string, result interface{}, variables map[string]interface{}) error {
+	return client.Query(name, result, variables)
+}
+
+func queryWithOptionalProjects(client *gh.GraphQLClient, name string, result interface{}, variables map[string]interface{}, enrichProjects bool) error {
+	var generation uint64
+	if enrichProjects {
+		var err error
+		generation, err = projectEnrichmentAllowedGeneration()
+		if err != nil {
+			variables["includeProjects"] = graphql.Boolean(false)
+			return queryGraphQL(client, name, result, variables)
+		}
+	}
+	err := queryGraphQL(client, name, result, variables)
+	if err != nil && enrichProjects {
+		recordProjectEnrichmentFailure(err)
+		variables["includeProjects"] = graphql.Boolean(false)
+		err = queryGraphQL(client, name, result, variables)
+	} else if err == nil && enrichProjects {
+		recordProjectNetworkSuccess(generation)
+	}
+	return err
+}
+
+// ProjectItems is deliberately modeled as a collection instead of a single
+// project. An issue or pull request can be in more than one ProjectV2.
+type ProjectItems struct {
+	Nodes []ProjectItem
+}
+
+type ProjectItem struct {
+	ID              string
+	Project         Project
+	AmbiguousFields []string
+	FieldValues     struct {
+		Nodes []ProjectFieldValue
+	} `graphql:"fieldValues(first: 50)"`
+}
+
+type Project struct {
+	ID     string
+	Number int
+	Title  string
+	Owner  ProjectOwner
+}
+
+// ProjectOwner is a GraphQL union in GitHub's schema. Both users and
+// organizations expose the same login, but keeping the union branches here
+// lets the typed GraphQL queries remain valid for either owner type.
+type ProjectOwner struct {
+	User struct {
+		Login string
+	} `graphql:"... on User"`
+	Organization struct {
+		Login string
+	} `graphql:"... on Organization"`
+}
+
+func (owner ProjectOwner) Login() string {
+	if owner.User.Login != "" {
+		return owner.User.Login
+	}
+	return owner.Organization.Login
+}
+
+func (project Project) DisplayName(qualifyOwner bool) string {
+	name := fmt.Sprintf("%s (#%d)", project.Title, project.Number)
+	if qualifyOwner && project.Owner.Login() != "" {
+		return project.Owner.Login() + " / " + name
+	}
+	return name
+}
+
+type ProjectFieldRef struct {
+	Common struct {
+		ID   string
+		Name string
+	} `graphql:"... on ProjectV2Field"`
+	Iteration struct {
+		ID   string
+		Name string
+	} `graphql:"... on ProjectV2IterationField"`
+	SingleSelect struct {
+		ID   string
+		Name string
+	} `graphql:"... on ProjectV2SingleSelectField"`
+}
+
+func (field ProjectFieldRef) IDName() (string, string) {
+	if field.Common.ID != "" || field.Common.Name != "" {
+		return field.Common.ID, field.Common.Name
+	}
+	if field.Iteration.ID != "" {
+		return field.Iteration.ID, field.Iteration.Name
+	}
+	return field.SingleSelect.ID, field.SingleSelect.Name
+}
+
+func (field ProjectFieldRef) IDNameID() string {
+	id, _ := field.IDName()
+	return id
+}
+
+type ProjectFieldValue struct {
+	Typename  string `graphql:"__typename" json:"__typename"`
+	TextValue struct {
+		Field ProjectFieldRef
+		Text  string
+	} `graphql:"... on ProjectV2ItemFieldTextValue"`
+	NumberValue struct {
+		Field  ProjectFieldRef
+		Number float64
+	} `graphql:"... on ProjectV2ItemFieldNumberValue"`
+	DateValue struct {
+		Field ProjectFieldRef
+		Date  string
+	} `graphql:"... on ProjectV2ItemFieldDateValue"`
+	SingleSelectValue struct {
+		Field    ProjectFieldRef
+		Name     string
+		OptionID string
+	} `graphql:"... on ProjectV2ItemFieldSingleSelectValue"`
+	IterationValue struct {
+		Field       ProjectFieldRef
+		Title       string
+		IterationID string
+	} `graphql:"... on ProjectV2ItemFieldIterationValue"`
+	UserValue struct {
+		Field ProjectFieldRef
+		Users struct {
+			Nodes []struct {
+				Login string
+				Name  string
+			}
+		} `graphql:"users(first: 20)"`
+	} `graphql:"... on ProjectV2ItemFieldUserValue"`
+	LabelValue struct {
+		Field  ProjectFieldRef
+		Labels struct {
+			Nodes []struct{ Name string }
+		} `graphql:"labels(first: 20)"`
+	} `graphql:"... on ProjectV2ItemFieldLabelValue"`
+	RepositoryValue struct {
+		Field      ProjectFieldRef
+		Repository struct{ NameWithOwner string }
+	} `graphql:"... on ProjectV2ItemFieldRepositoryValue"`
+}
+
+type ProjectField struct {
+	ID      string
+	Name    string
+	Type    string
+	Options []ProjectOption
+}
+
+type ProjectOption struct {
+	ID   string
+	Name string
+}
+
+const projectItemsBatchSize = 20
+
+var ErrProjectEnrichmentUnavailable = errors.New("Project enrichment unavailable")
+
+const (
+	projectTransientInitialBackoff = 2 * time.Second
+	projectTransientMaxBackoff     = 30 * time.Second
+	projectSecondaryFallback       = 30 * time.Second
+	projectSecondaryMaxBackoff     = 5 * time.Minute
+	projectPrimaryFallback         = time.Hour
+)
+
+type projectItemsCall struct {
+	done  chan struct{}
+	items map[string]ProjectItems
+	err   error
+}
+
+type projectItemsCache struct {
+	mu         sync.Mutex
+	items      map[string]ProjectItems
+	columns    map[string]string
+	inFlight   map[string]*projectItemsCall
+	generation map[string]uint64
+}
+
+var projectItemsState = projectItemsCache{
+	items:      make(map[string]ProjectItems),
+	columns:    make(map[string]string),
+	inFlight:   make(map[string]*projectItemsCall),
+	generation: make(map[string]uint64),
+}
+
+type projectEnrichmentBreaker struct {
+	mu             sync.Mutex
+	failures       int
+	classification projectFailureClass
+	permanentlyOff bool
+	unavailableTil time.Time
+	generation     uint64
+}
+
+type projectFailureClass string
+
+const (
+	projectFailureNone    projectFailureClass = ""
+	projectPermission     projectFailureClass = "permission"
+	projectPrimaryQuota   projectFailureClass = "primary-quota"
+	projectSecondaryLimit projectFailureClass = "secondary-limit"
+	projectTransient      projectFailureClass = "transient"
+)
+
+var projectBreaker projectEnrichmentBreaker
+var projectBreakerNow = time.Now
+
+func projectEnrichmentAllowed() error {
+	_, err := projectEnrichmentAllowedGeneration()
+	return err
+}
+
+func projectEnrichmentAllowedGeneration() (uint64, error) {
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if projectBreaker.permanentlyOff {
+		return projectBreaker.generation, fmt.Errorf("%w: Project permission/auth failure disabled Project reads for this process", ErrProjectEnrichmentUnavailable)
+	}
+	if projectBreakerNow().Before(projectBreaker.unavailableTil) {
+		return projectBreaker.generation, fmt.Errorf("%w: %s retry after %s", ErrProjectEnrichmentUnavailable, projectBreaker.classification, projectBreaker.unavailableTil.Format(time.RFC3339))
+	}
+	return projectBreaker.generation, nil
+}
+
+func recordProjectEnrichmentFailure(err error) {
+	classification := classifyProjectFailure(err)
+	if classification.class == projectFailureNone {
+		return
+	}
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if classification.class == projectPermission {
+		projectBreaker.generation++
+		projectBreaker.permanentlyOff = true
+		projectBreaker.classification = classification.class
+		projectBreaker.unavailableTil = time.Time{}
+		return
+	}
+	projectBreaker.generation++
+	projectBreaker.failures++
+	projectBreaker.classification = classification.class
+	projectBreaker.unavailableTil = classification.retryAt
+	if projectBreaker.unavailableTil.IsZero() {
+		backoff := projectFailureBackoff(classification.class, projectBreaker.failures)
+		projectBreaker.unavailableTil = projectBreakerNow().Add(backoff)
+	}
+}
+
+func recordProjectNetworkSuccess(generations ...uint64) {
+	projectBreaker.mu.Lock()
+	defer projectBreaker.mu.Unlock()
+	if projectBreaker.permanentlyOff {
+		return
+	}
+	if len(generations) > 0 && generations[0] != projectBreaker.generation {
+		return
+	}
+	if projectBreakerNow().Before(projectBreaker.unavailableTil) {
+		return
+	}
+	projectBreaker.failures = 0
+	projectBreaker.classification = projectFailureNone
+	projectBreaker.unavailableTil = time.Time{}
+}
+
+type classifiedProjectFailure struct {
+	class   projectFailureClass
+	retryAt time.Time
+}
+
+func classifyProjectFailure(err error) classifiedProjectFailure {
+	if err == nil {
+		return classifiedProjectFailure{}
+	}
+	message := strings.ToLower(err.Error())
+	if strings.Contains(message, "secondary rate limit") || strings.Contains(message, "secondary rate") || strings.Contains(message, "abuse detection") || !projectRetryAfter(err).IsZero() {
+		return classifiedProjectFailure{class: projectSecondaryLimit, retryAt: projectRetryAt(err, true)}
+	}
+	if strings.Contains(message, "resource not accessible by personal access token") || strings.Contains(message, "projects scope required") || strings.Contains(message, "projects permission") {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if projectHasPrimaryQuotaMarker(err, message) {
+		return classifiedProjectFailure{class: projectPrimaryQuota, retryAt: projectRetryAt(err, false)}
+	}
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) && (httpErr.StatusCode == http.StatusUnauthorized || httpErr.StatusCode == http.StatusForbidden) {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if strings.Contains(message, "http 403") || strings.Contains(message, "status code 403") || strings.Contains(message, "forbidden") || strings.Contains(message, "unauthorized") {
+		return classifiedProjectFailure{class: projectPermission}
+	}
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	var networkErr net.Error
+	if errors.As(err, &networkErr) || strings.Contains(message, "status code: 5") || strings.Contains(message, "status 5") || strings.Contains(message, "timeout") || strings.Contains(message, "connection reset") || strings.Contains(message, "temporary network") || strings.Contains(message, "network is unreachable") {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	if errors.As(err, &httpErr) && httpErr.StatusCode >= 500 && httpErr.StatusCode <= 599 {
+		return classifiedProjectFailure{class: projectTransient}
+	}
+	return classifiedProjectFailure{}
+}
+
+func projectHasPrimaryQuotaMarker(err error, message string) bool {
+	if strings.Contains(message, "api rate limit exceeded") || strings.Contains(message, "rate limit exceeded") || strings.Contains(message, "primary rate limit") {
+		return true
+	}
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) && httpErr.Headers.Get("X-RateLimit-Remaining") == "0" {
+		return true
+	}
+	var graphQLErr *gh.GraphQLError
+	if errors.As(err, &graphQLErr) {
+		for _, item := range graphQLErr.Errors {
+			if strings.Contains(strings.ToLower(item.Type), "rate") || strings.Contains(strings.ToLower(item.Type), "quota") {
+				return true
+			}
+			for key, value := range item.Extensions {
+				text := strings.ToLower(fmt.Sprintf("%s=%v", key, value))
+				if strings.Contains(text, "rate_limit") || strings.Contains(text, "rate-limited") || strings.Contains(text, "primary") {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func projectRetryAt(err error, durationValue bool) time.Time {
+	if durationValue {
+		if retryAfter := projectRetryAfter(err); !retryAfter.IsZero() {
+			return retryAfter
+		}
+	} else if resetAt := projectResetAt(err); !resetAt.IsZero() {
+		return resetAt
+	}
+	return time.Time{}
+}
+
+func projectRetryAfter(err error) time.Time {
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) {
+		if value := httpErr.Headers.Get("Retry-After"); value != "" {
+			if seconds, parseErr := strconv.ParseFloat(strings.TrimSpace(value), 64); parseErr == nil {
+				return projectBreakerNow().Add(time.Duration(seconds * float64(time.Second)))
+			}
+			if parsed, parseErr := http.ParseTime(value); parseErr == nil {
+				return parsed
+			}
+		}
+	}
+	return projectExtensionTime(err, []string{"retryAfter", "retry_after"}, true)
+}
+
+func projectResetAt(err error) time.Time {
+	var httpErr *gh.HTTPError
+	if errors.As(err, &httpErr) {
+		if value := httpErr.Headers.Get("X-RateLimit-Reset"); value != "" {
+			if seconds, parseErr := strconv.ParseInt(strings.TrimSpace(value), 10, 64); parseErr == nil {
+				return time.Unix(seconds, 0)
+			}
+		}
+	}
+	return projectExtensionTime(err, []string{"resetAt", "reset_at", "reset"}, false)
+}
+
+func projectExtensionTime(err error, keys []string, durationValue bool) time.Time {
+	keySet := make(map[string]struct{}, len(keys))
+	for _, key := range keys {
+		keySet[strings.ToLower(key)] = struct{}{}
+	}
+	var graphQLErr *gh.GraphQLError
+	if errors.As(err, &graphQLErr) {
+		for _, item := range graphQLErr.Errors {
+			for key, value := range item.Extensions {
+				if _, ok := keySet[strings.ToLower(key)]; ok {
+					if parsed := parseProjectTimeValue(value, durationValue); !parsed.IsZero() {
+						return parsed
+					}
+				}
+			}
+		}
+	}
+	return time.Time{}
+}
+
+func parseProjectTimeValue(value interface{}, durationValue bool) time.Time {
+	switch typed := value.(type) {
+	case float64:
+		if durationValue {
+			return projectBreakerNow().Add(time.Duration(typed * float64(time.Second)))
+		}
+		return time.Unix(int64(typed), 0)
+	case int:
+		if durationValue {
+			return projectBreakerNow().Add(time.Duration(typed) * time.Second)
+		}
+		return time.Unix(int64(typed), 0)
+	case string:
+		if durationValue {
+			if seconds, err := strconv.ParseFloat(strings.TrimSpace(typed), 64); err == nil {
+				return projectBreakerNow().Add(time.Duration(seconds * float64(time.Second)))
+			}
+		}
+		if parsed, err := time.Parse(time.RFC3339, typed); err == nil {
+			return parsed
+		}
+		if seconds, err := strconv.ParseInt(strings.TrimSpace(typed), 10, 64); err == nil {
+			return time.Unix(seconds, 0)
+		}
+	}
+	return time.Time{}
+}
+
+func projectFailureBackoff(class projectFailureClass, failures int) time.Duration {
+	if failures < 1 {
+		failures = 1
+	}
+	if class == projectPrimaryQuota {
+		return projectPrimaryFallback
+	}
+	initial, maximum := projectTransientInitialBackoff, projectTransientMaxBackoff
+	if class == projectSecondaryLimit {
+		initial, maximum = projectSecondaryFallback, projectSecondaryMaxBackoff
+	}
+	backoff := initial
+	for attempt := 1; attempt < failures; attempt++ {
+		backoff *= 2
+		if backoff >= maximum {
+			return maximum
+		}
+	}
+	if backoff > maximum {
+		return maximum
+	}
+	return backoff
+}
+
+func isProjectAvailabilityFailure(err error) bool {
+	return classifyProjectFailure(err).class != projectFailureNone
+}
