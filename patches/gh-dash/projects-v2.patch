--- /dev/null
+++ b/internal/data/issueapi_test.go
@@ -0,0 +1,65 @@
+package data
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestFetchAllIssuesFollowsActualSearchTotal(t *testing.T) {
+	original := fetchIssuesPage
+	defer func() { fetchIssuesPage = original }()
+	for _, total := range []int{20, 21, 50, 100, 101, 237} {
+		t.Run(fmt.Sprint(total), func(t *testing.T) {
+			calls := 0
+			var cursors []string
+			fetchIssuesPage = func(_ string, limit int, pageInfo *PageInfo, _ bool, _ ...[]ProjectColumn) (IssuesResponse, error) {
+				calls++
+				cursor := ""
+				if pageInfo != nil {
+					cursor = pageInfo.EndCursor
+				}
+				cursors = append(cursors, cursor)
+				start := (calls - 1) * limit
+				if start >= total {
+					return IssuesResponse{TotalCount: total, PageInfo: PageInfo{}}, nil
+				}
+				end := start + limit
+				if end > total {
+					end = total
+				}
+				issues := make([]IssueData, end-start)
+				for index := range issues {
+					issues[index].Number = start + index + 1
+				}
+				return IssuesResponse{
+					Issues:     issues,
+					TotalCount: total,
+					PageInfo: PageInfo{
+						HasNextPage: end < total,
+						EndCursor:   fmt.Sprintf("cursor-%d", end),
+					},
+				}, nil
+			}
+			response, err := FetchAllIssues("is:open", 20, false, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(response.Issues) != total || response.TotalCount != total ||
+				response.PageInfo.HasNextPage {
+				t.Fatalf(
+					"got %d issues, total %d, pageInfo %#v",
+					len(response.Issues),
+					response.TotalCount,
+					response.PageInfo,
+				)
+			}
+			wantCalls := (total + 19) / 20
+			if calls != wantCalls {
+				t.Fatalf("page calls = %d, want %d", calls, wantCalls)
+			}
+			if len(cursors) > 1 && cursors[1] != "cursor-20" {
+				t.Fatalf("second page cursor = %q", cursors[1])
+			}
+		})
+	}
+}
