+func TestProjectFieldsNormalizeAllSupportedDisplayTypes(t *testing.T) {
+	fieldRef := func(id, name string) ProjectFieldRef {
+		var ref ProjectFieldRef
+		ref.Common.ID, ref.Common.Name = id, name
+		return ref
+	}
+	item := ProjectItem{ID: "item-1", Project: Project{ID: "project-1", Number: 3, Title: "Roadmap"}}
+	item.FieldValues.Nodes = []ProjectFieldValue{
+		{Typename: "ProjectV2ItemFieldTextValue", TextValue: struct {
+			Field ProjectFieldRef
+			Text  string
+		}{fieldRef("text-1", "Notes"), "hello"}},
+		{Typename: "ProjectV2ItemFieldNumberValue", NumberValue: struct {
+			Field  ProjectFieldRef
+			Number float64
+		}{fieldRef("number-1", "Score"), 4.5}},
+		{Typename: "ProjectV2ItemFieldSingleSelectValue", SingleSelectValue: struct {
+			Field    ProjectFieldRef
+			Name     string
+			OptionID string
+		}{fieldRef("select-1", "Status"), "In Progress", "option-1"}},
+		{Typename: "ProjectV2ItemFieldRepositoryValue", RepositoryValue: struct {
+			Field      ProjectFieldRef
+			Repository struct{ NameWithOwner string }
+		}{fieldRef("repo-1", "Repository"), struct{ NameWithOwner string }{"owner/repo"}}},
+	}
+	fields := item.Fields()
+	if len(fields) != 4 {
+		t.Fatalf("got %d normalized fields, want 4", len(fields))
+	}
+	if field, ok := item.Field("Status"); !ok || field.Value != "In Progress" || field.OptionID != "option-1" {
+		t.Fatalf("single-select field was not normalized: %#v", field)
+	}
+	if field, ok := item.Field("Repository"); !ok || field.Value != "owner/repo" {
+		t.Fatalf("repository field was not normalized: %#v", field)
+	}
+}
+
+func TestProjectColumnsDisambiguateMultipleProjectsDeterministically(t *testing.T) {
+	items := []ProjectItem{
+		{Project: Project{Number: 9, Title: "Zeta"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Done"))},
+		{Project: Project{Number: 2, Title: "Alpha"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Todo"))},
+	}
+	got := FormatProjectField(items, ProjectColumn{Name: "Status"})
+	if got != "Alpha: Todo, Zeta: Done" {
+		t.Fatalf("got %q", got)
+	}
+	if got := FormatProjectField(items, ProjectColumn{Name: "Status", Project: "2"}); got != "Todo" {
+		t.Fatalf("project-specific value got %q", got)
+	}
+}
+
+func TestProjectSelectorsRejectUnqualifiedCollisions(t *testing.T) {
+	items := []ProjectItem{
+		{Project: Project{ID: "alice-project", Number: 1, Title: "Roadmap", Owner: projectOwner("alice")}},
+		{Project: Project{ID: "org-project", Number: 1, Title: "Roadmap", Owner: projectOwner("example-org")}},
+	}
+	if _, err := SelectProjectItems(items, "1"); err == nil {
+		t.Fatal("unqualified duplicate Project number should be ambiguous")
+	}
+	if _, err := SelectProjectItems(items, "Roadmap"); err == nil {
+		t.Fatal("unqualified duplicate Project title should be ambiguous")
+	}
+	selected, err := SelectProjectItems(items, "example-org/1")
+	require.NoError(t, err)
+	require.Len(t, selected, 1)
+	require.Equal(t, "org-project", selected[0].Project.ID)
+	selected, err = SelectProjectItems(items, "alice/Roadmap")
+	require.NoError(t, err)
+	require.Len(t, selected, 1)
+	require.Equal(t, "alice-project", selected[0].Project.ID)
+	selected, err = SelectProjectItems(items, "org-project")
+	require.NoError(t, err)
+	require.Len(t, selected, 1)
+}
+
+func TestDuplicateFieldNamesRequireFieldID(t *testing.T) {
+	item := ProjectItem{Project: Project{ID: "project-1", Number: 1, Title: "Roadmap"}}
+	first := singleSelect("Status", "Todo")
+	second := singleSelect("Status", "Done")
+	first.SingleSelectValue.Field.Common.ID = "field-1"
+	second.SingleSelectValue.Field.Common.ID = "field-2"
+	item.FieldValues.Nodes = []ProjectFieldValue{first, second}
+	if _, ok := item.Field("Status"); ok {
+		t.Fatal("duplicate field name should not use first-match semantics")
+	}
+	field, ok := item.FieldBySelector("", "field-2")
+	require.True(t, ok)
+	require.Equal(t, "Done", field.Value)
+	formatted := FormatProjectField([]ProjectItem{item}, ProjectColumn{Name: "Status"})
+	require.Contains(t, formatted, "ambiguous Project field")
+	require.Equal(t, "Done", FormatProjectField([]ProjectItem{item}, ProjectColumn{FieldID: "field-2"}))
+}
+
+func TestProjectPreviewQualifiesOwnerWhenMembershipsCollide(t *testing.T) {
+	items := []ProjectItem{
+		{Project: Project{ID: "alice-project", Number: 1, Title: "Roadmap", Owner: projectOwner("alice")}},
+		{Project: Project{ID: "org-project", Number: 1, Title: "Roadmap", Owner: projectOwner("example-org")}},
+	}
+	preview := RenderProjectItems(items)
+	require.Contains(t, preview, "alice / Roadmap (#1)")
+	require.Contains(t, preview, "example-org / Roadmap (#1)")
+}
+
+func TestApplyProjectFieldValueUpdatesLocalSourceOfTruth(t *testing.T) {
+	item := ProjectItem{ID: "item-1", Project: Project{ID: "project-1"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Todo"))}
+	item.FieldValues.Nodes[0].SingleSelectValue.Field.Common.ID = "field-1"
+	updated := ApplyProjectFieldValue([]ProjectItem{item}, "project-1", "item-1", "field-1", "Status", "Done")
+	field, ok := updated[0].Field("Status")
+	if !ok || field.Value != "Done" {
+		t.Fatalf("updated field = %#v, ok=%v", field, ok)
+	}
+}
+
+func TestReplaceProjectItemsHandlesPreviouslyUnsetField(t *testing.T) {
+	old := []ProjectItem{{ID: "item-1", Project: Project{ID: "project-1"}}}
+	authoritative := ProjectItems{Nodes: []ProjectItem{{ID: "item-1", Project: Project{ID: "project-1"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Done"))}}}
+	updated := ReplaceProjectItems(old, authoritative)
+	field, ok := updated[0].Field("Status")
+	if !ok || field.Value != "Done" {
+		t.Fatalf("authoritative replacement = %#v, ok=%v", field, ok)
+	}
+}
+
+func TestProjectUpdateTargetsUsesContentIdentityAndSectionScopedRouting(t *testing.T) {
+	if !ProjectUpdateTargets("issue-b", "owner/two", 7, "issue-b", "owner/two", 7) {
+		t.Fatal("expected matching content identity")
+	}
+	if ProjectUpdateTargets("issue-b", "owner/two", 7, "issue-a", "owner/one", 7) {
+		t.Fatal("duplicate issue number must not match a different repository/content node")
+	}
+	if !ProjectUpdateTargets("", "owner/two", 7, "", "owner/two", 7) {
+		t.Fatal("repository and number fallback should match when content identity is unavailable")
+	}
+}
+
+func TestProjectQueryFallsBackWithoutProjectScope(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := queryGraphQL
+	defer func() { queryGraphQL = original }()
+	calls := 0
+	queryGraphQL = func(_ *gh.GraphQLClient, _ string, _ interface{}, variables map[string]interface{}) error {
+		calls++
+		if calls == 1 {
+			return errors.New("projects scope required")
+		}
+		if variables["includeProjects"] != graphql.Boolean(false) {
+			t.Fatalf("fallback query did not disable Projects: %#v", variables["includeProjects"])
+		}
+		return nil
+	}
+	variables := map[string]interface{}{"includeProjects": graphql.Boolean(true)}
+	if err := queryWithOptionalProjects(&gh.GraphQLClient{}, "SearchIssues", &struct{}{}, variables, true); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 2 {
+		t.Fatalf("query attempts = %d, want 2", calls)
+	}
+}
+
+func TestProjectEnrichmentBatchesStockListSizes(t *testing.T) {
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	for _, testCase := range []struct {
+		size    int
+		batches []int
+	}{
+		{size: 20, batches: []int{20}},
+		{size: 21, batches: []int{20, 1}},
+		{size: 50, batches: []int{20, 20, 10}},
+	} {
+		resetProjectItemsState()
+		t.Run(fmt.Sprintf("%d-items", testCase.size), func(t *testing.T) {
+			var batches []int
+			fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+				batches = append(batches, len(contentIDs))
+				items := make(map[string]ProjectItems, len(contentIDs))
+				for _, contentID := range contentIDs {
+					items[contentID] = ProjectItems{Nodes: []ProjectItem{{ID: "item-" + contentID, Project: Project{ID: "project-1"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Ready"))}}}
+				}
+				return items, nil
+			}
+			issues := make([]IssueData, testCase.size)
+			for index := range issues {
+				issues[index].ID = fmt.Sprintf("issue-%d", index)
+			}
+			require.NoError(t, enrichIssueProjects(issues))
+			require.Equal(t, testCase.batches, batches)
+			for _, issue := range issues {
+				field, ok := issue.ProjectItems.Nodes[0].Field("Status")
+				require.True(t, ok)
+				require.Equal(t, "Ready", field.Value)
+			}
+		})
+	}
+}
+
+func TestProjectEnrichmentDeduplicatesContentIDs(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	var batches [][]string
+	fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+		batches = append(batches, append([]string(nil), contentIDs...))
+		return projectItemsFor(contentIDs), nil
+	}
+	issues := []IssueData{{ID: "issue-a"}, {ID: "issue-a"}, {ID: "issue-b"}, {ID: "issue-b"}}
+	require.NoError(t, enrichIssueProjects(issues))
+	require.Equal(t, [][]string{{"issue-a", "issue-b"}}, batches)
+	for _, issue := range issues {
+		require.Len(t, issue.ProjectItems.Nodes, 1)
+	}
+}
+
+func TestProjectItemsCacheCoalescesOverlappingCalls(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	started := make(chan []string, 1)
+	release := make(chan struct{})
+	fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+		started <- append([]string(nil), contentIDs...)
+		<-release
+		return projectItemsFor(contentIDs), nil
+	}
+	firstDone := make(chan error, 1)
+	go func() {
+		_, err := FetchProjectItemsBatched([]string{"issue-a", "issue-b"})
+		firstDone <- err
+	}()
+	require.Equal(t, []string{"issue-a", "issue-b"}, <-started)
+	secondDone := make(chan error, 1)
+	go func() {
+		_, err := FetchProjectItemsBatched([]string{"issue-b"})
+		secondDone <- err
+	}()
+	select {
+	case duplicate := <-started:
+		t.Fatalf("overlapping request started a duplicate Project fetch for %v", duplicate)
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	require.NoError(t, <-firstDone)
+	require.NoError(t, <-secondDone)
+}
+
+func TestProjectEnrichmentPreservesEarlierBatchesOnFailure(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	calls := 0
+	fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+		calls++
+		if calls == 2 {
+			return nil, errors.New("temporary Project network failure")
+		}
+		return projectItemsFor(contentIDs), nil
+	}
+	issues := make([]IssueData, 21)
+	for index := range issues {
+		issues[index].ID = fmt.Sprintf("issue-%d", index)
+	}
+	err := enrichIssueProjects(issues)
+	require.Error(t, err)
+	require.Len(t, issues[0].ProjectItems.Nodes, 1)
+	require.Empty(t, issues[20].ProjectItems.Nodes)
+}
+
+func TestProjectEnrichmentBreakerStopsRepeatedAvailabilityFailures(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	calls := 0
+	fetchProjectItemsBatch = func([]string) (map[string]ProjectItems, error) {
+		calls++
+		return nil, errors.New("API rate limit exceeded for ProjectV2")
+	}
+	_, firstErr := FetchProjectItemsBatched([]string{"issue-a"})
+	require.Error(t, firstErr)
+	_, secondErr := FetchProjectItemsBatched([]string{"issue-b"})
+	require.ErrorIs(t, secondErr, ErrProjectEnrichmentUnavailable)
+	require.Equal(t, 1, calls)
+}
+
+func TestProjectItemsInvalidationForcesAuthoritativeRefetch(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+	original := fetchProjectItemsBatch
+	defer func() { fetchProjectItemsBatch = original }()
+	var mu sync.Mutex
+	calls := 0
+	fetchProjectItemsBatch = func(contentIDs []string) (map[string]ProjectItems, error) {
+		mu.Lock()
+		calls++
+		version := calls
+		mu.Unlock()
+		items := projectItemsFor(contentIDs)
+		for contentID := range items {
+			items[contentID].Nodes[0].Project.Title = fmt.Sprintf("Version %d", version)
+		}
+		return items, nil
+	}
+	first, err := FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	_, err = FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+	InvalidateProjectItems("issue-a")
+	authoritative, err := FetchProjectItems([]string{"issue-a"})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+	require.Equal(t, "Version 1", first["issue-a"].Nodes[0].Project.Title)
+	require.Equal(t, "Version 2", authoritative["issue-a"].Nodes[0].Project.Title)
+}
+
+func projectItemsFor(contentIDs []string) map[string]ProjectItems {
+	items := make(map[string]ProjectItems, len(contentIDs))
+	for _, contentID := range contentIDs {
+		items[contentID] = ProjectItems{Nodes: []ProjectItem{{ID: "item-" + contentID, Project: Project{ID: "project-1", Title: "Roadmap"}, FieldValues: ProjectFieldValues(singleSelect("Status", "Ready"))}}}
+	}
+	return items
+}
+
+func TestUpdateProjectFieldRejectsInvalidNumberBeforeNetwork(t *testing.T) {
+	if err := UpdateProjectField("content", "project", "item", "field", "NUMBER", "not-a-number"); err == nil || !strings.Contains(err.Error(), "numeric") {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func singleSelect(name, value string) ProjectFieldValue {
+	var ref ProjectFieldRef
+	ref.Common.Name = name
+	return ProjectFieldValue{Typename: "ProjectV2ItemFieldSingleSelectValue", SingleSelectValue: struct {
+		Field    ProjectFieldRef
+		Name     string
+		OptionID string
+	}{ref, value, value + "-id"}}
+}
+
+func projectOwner(login string) ProjectOwner {
+	return ProjectOwner{User: struct{ Login string }{Login: login}}
+}
+
+func ProjectFieldValues(values ...ProjectFieldValue) struct{ Nodes []ProjectFieldValue } {
+	return struct{ Nodes []ProjectFieldValue }{values}
+}
