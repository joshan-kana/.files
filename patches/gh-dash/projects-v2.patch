+			resetProjectItemsState()
+			calls := 0
+			projectGraphQLDo = func(_ *gh.GraphQLClient, query string, variables map[string]interface{}, result interface{}) error {
+				calls++
+				page := 0
+				if strings.Contains(query, "ProjectMembershipOverflow") {
+					after := variables["after"].(*string)
+					if *after == "cursor-20" {
+						page = 1
+					} else {
+						page = 2
+					}
+				}
+				start := page * 20
+				end := start + 20
+				if end > testCase.count {
+					end = testCase.count
+				}
+				if start > testCase.count {
+					start = testCase.count
+				}
+				nodes := make([]map[string]interface{}, 0, end-start)
+				for index := start; index < end; index++ {
+					nodes = append(nodes, map[string]interface{}{
+						"id":      "item-" + fmt.Sprint(index),
+						"project": map[string]interface{}{"id": "project-" + fmt.Sprint(index), "number": index + 1, "title": "Project", "owner": map[string]interface{}{"login": "owner"}},
+					})
+				}
+				pageInfo := map[string]interface{}{"hasNextPage": end < testCase.count, "endCursor": ""}
+				if end < testCase.count {
+					pageInfo["endCursor"] = "cursor-" + fmt.Sprint(end)
+				}
+				if strings.Contains(query, "ProjectMemberships") {
+					return json.Unmarshal(mustJSON(map[string]interface{}{"nodes": []interface{}{map[string]interface{}{"id": "issue-1", "projectItems": map[string]interface{}{"nodes": nodes, "pageInfo": pageInfo}}}}), result)
+				}
+				return json.Unmarshal(mustJSON(map[string]interface{}{"node": map[string]interface{}{"projectItems": map[string]interface{}{"nodes": nodes, "pageInfo": pageInfo}}}), result)
+			}
+			items, err := fetchProjectItemsNetwork([]string{"issue-1"}, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if calls != testCase.calls || len(items["issue-1"].Nodes) != testCase.count {
+				t.Fatalf("calls=%d items=%d, want calls=%d items=%d", calls, len(items["issue-1"].Nodes), testCase.calls, testCase.count)
+			}
+		})
+	}
