@@ -1,12 +1,85 @@
 package data
 
 import (
+	"encoding/json"
+	"reflect"
 	"testing"
 
 	gh "github.com/cli/go-gh/v2/pkg/api"
 	"github.com/stretchr/testify/require"
 )
 
+func TestFetchPullRequestOrdinaryQueryHasNoProjectConnections(t *testing.T) {
+	originalClient, originalQuery := client, queryGraphQL
+	defer func() {
+		client = originalClient
+		queryGraphQL = originalQuery
+	}()
+	client = &gh.GraphQLClient{}
+	queryGraphQL = func(_ *gh.GraphQLClient, _ string, result interface{}, _ map[string]interface{}) error {
+		typ := reflect.TypeOf(result)
+		if typ.Kind() == reflect.Pointer {
+			typ = typ.Elem()
+		}
+		if hasFieldNamed(typ, "ProjectItems") || hasFieldNamed(typ, "FieldValues") {
+			t.Fatalf("ordinary PR query shape contains Project fields: %s", typ)
+		}
+		return json.Unmarshal(
+			[]byte(
+				`{"resource":{"pullRequest":{"id":"pr-1","url":"https://github.com/o/r/pull/1"}}}`,
+			),
+			result,
+		)
+	}
+	pr, err := FetchPullRequest("https://github.com/o/r/pull/1")
+	require.NoError(t, err)
+	require.Equal(t, "pr-1", pr.ID)
+}
+
+func TestEnrichPullRequestProjectsPassesConfiguredVisibleColumns(t *testing.T) {
+	resetProjectItemsState()
+	defer resetProjectItemsState()
+
+	original := fetchProjectItemsBatchWithColumns
+	defer func() { fetchProjectItemsBatchWithColumns = original }()
+
+	var got []ProjectColumn
+	fetchProjectItemsBatchWithColumns = func(contentIDs []string, columns []ProjectColumn) (map[string]ProjectItems, error) {
+		got = append([]ProjectColumn(nil), columns...)
+		return map[string]ProjectItems{
+			"pr-1": {Nodes: []ProjectItem{{ID: "item-1"}}},
+		}, nil
+	}
+
+	prs := []PullRequestData{{ID: "pr-1"}}
+	err := enrichPullRequestProjects(prs, []ProjectColumn{
+		{Name: "Status"},
+		{Name: "Priority", FieldID: "PVTF_priority"},
+		{Name: "Area", Project: "owner/1"},
+	})
+	require.NoError(t, err)
+	require.Equal(t, []ProjectColumn{
+		{Name: "Status"},
+		{Name: "Priority", FieldID: "PVTF_priority"},
+		{Name: "Area", Project: "owner/1"},
+	}, got)
+	require.Len(t, prs[0].ProjectItems.Nodes, 1)
+}
+
+func hasFieldNamed(typ reflect.Type, name string) bool {
+	for index := 0; index < typ.NumField(); index++ {
+		field := typ.Field(index)
+		if field.Name == name {
+			return true
+		}
+		fieldType := field.Type
+		if fieldType.Kind() == reflect.Struct && hasFieldNamed(fieldType, name) {
+			return true
+		}
+	}
+	return false
+}
+
 func TestClearEnrichmentCache(t *testing.T) {
