+func TestProjectSchemaSingleflightCoalescesSuccessAndError(t *testing.T) {
+	original := projectGraphQLDo
+	originalClient := projectGraphQLClient
+	defer func() { projectGraphQLDo = original }()
+	defer func() { projectGraphQLClient = originalClient }()
+	projectGraphQLClient = func() (*gh.GraphQLClient, error) { return &gh.GraphQLClient{}, nil }
+
+	resetProjectItemsState()
+	started := make(chan struct{})
+	release := make(chan struct{})
+	var startedOnce sync.Once
+	var mu sync.Mutex
+	calls := 0
+	projectGraphQLDo = func(_ *gh.GraphQLClient, _ string, _ map[string]interface{}, result interface{}) error {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+		startedOnce.Do(func() { close(started) })
+		<-release
+		return json.Unmarshal([]byte(`{"node":{"fields":{"nodes":[{"__typename":"ProjectV2Field","id":"field-1","name":"Status"}],"pageInfo":{"hasNextPage":false,"endCursor":""}}}}`), result)
+	}
+	results := make(chan []ProjectField, 2)
+	errorsCh := make(chan error, 2)
+	for range 2 {
+		go func() {
+			fields, err := FetchProjectSchema("project-1")
+			results <- fields
+			errorsCh <- err
+		}()
+	}
+	<-started
+	close(release)
+	for range 2 {
+		if err := <-errorsCh; err != nil {
+			t.Fatal(err)
+		}
+		if fields := <-results; len(fields) != 1 || fields[0].ID != "field-1" {
+			t.Fatalf("schema result = %#v", fields)
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("schema network calls = %d, want 1", calls)
+	}
+
+	resetProjectItemsState()
+	projectGraphQLDo = func(_ *gh.GraphQLClient, _ string, _ map[string]interface{}, _ interface{}) error {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+		return errors.New("temporary network failure")
+	}
+	firstErr := make(chan error, 1)
+	secondErr := make(chan error, 1)
+	go func() { _, err := FetchProjectSchema("project-error"); firstErr <- err }()
+	go func() { _, err := FetchProjectSchema("project-error"); secondErr <- err }()
+	if err := <-firstErr; err == nil || err.Error() != "temporary network failure" {
+		t.Fatalf("first schema error = %v", err)
+	}
+	if err := <-secondErr; err == nil || err.Error() != "temporary network failure" {
+		t.Fatalf("second schema error = %v", err)
+	}
+	resetProjectItemsState()
+}
+
+func mustJSON(value interface{}) []byte {
+	data, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	return data
+}
