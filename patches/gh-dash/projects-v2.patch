+// FetchProjectItemsFull is used only for the selected preview/editor path. It
+// follows both nested connections rather than imposing the list page sizes as
+// a silent metadata cap.
+func FetchProjectItemsFull(contentID string) (ProjectItems, error) {
+	if contentID == "" {
+		return ProjectItems{}, nil
+	}
+	client, err := projectGraphQLClient()
+	if err != nil {
+		return ProjectItems{}, err
+	}
+	log.Debug("Fetching full Project preview", "contentID", contentID)
+	result := ProjectItems{}
+	var after *string
+	for {
+		query := `query FullProjectMemberships($id: ID!, $after: String) {
+  node(id: $id) {
+    ... on Issue { projectItems(first: 20, after: $after) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+    ... on PullRequest { projectItems(first: 20, after: $after) { nodes { id project { id number title owner { ... on User { login } ... on Organization { login } } } } pageInfo { hasNextPage endCursor } } }
+  }
+}`
+		var response struct {
+			Node struct {
+				ProjectItems struct {
+					Nodes []struct {
+						ID      string `json:"id"`
+						Project struct {
+							ID     string `json:"id"`
+							Number int    `json:"number"`
+							Title  string `json:"title"`
+							Owner  struct {
+								Login string `json:"login"`
+							} `json:"owner"`
+						} `json:"project"`
+					} `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"projectItems"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(client, query, map[string]interface{}{"id": contentID, "after": after}, &response); err != nil {
+			return ProjectItems{}, err
+		}
+		for _, rawItem := range response.Node.ProjectItems.Nodes {
+			item := ProjectItem{ID: rawItem.ID, Project: Project{ID: rawItem.Project.ID, Number: rawItem.Project.Number, Title: rawItem.Project.Title, Owner: ProjectOwner{User: struct{ Login string }{Login: rawItem.Project.Owner.Login}}}}
+			values, valuesErr := fetchFullProjectFieldValues(client, rawItem.ID)
+			if valuesErr != nil {
+				return ProjectItems{}, valuesErr
+			}
+			item.FieldValues.Nodes = values
+			result.Nodes = appendProjectItem(result, item).Nodes
+		}
+		if !response.Node.ProjectItems.PageInfo.HasNextPage {
+			break
+		}
+		cursor := response.Node.ProjectItems.PageInfo.EndCursor
+		after = &cursor
+	}
+	return result, nil
+}
+
+func fetchFullProjectFieldValues(client *gh.GraphQLClient, itemID string) ([]ProjectFieldValue, error) {
+	var values []ProjectFieldValue
+	var after *string
+	for {
+		query := `query FullProjectFieldValues($id: ID!, $after: String) {
+  node(id: $id) { ... on ProjectV2Item {
+    fieldValues(first: 50, after: $after) { nodes {
+      __typename
+      ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldSingleSelectValue { name optionId field { ... on ProjectV2SingleSelectField { id name } } }
+      ... on ProjectV2ItemFieldIterationValue { title iterationId field { ... on ProjectV2IterationField { id name } } }
+      ... on ProjectV2ItemFieldUserValue { users(first: 20) { nodes { login name } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldLabelValue { labels(first: 20) { nodes { name } } field { ... on ProjectV2Field { id name } } }
+      ... on ProjectV2ItemFieldRepositoryValue { repository { nameWithOwner } field { ... on ProjectV2Field { id name } } }
+    } pageInfo { hasNextPage endCursor } }
+  } }
+}`
+		var response struct {
+			Node struct {
+				FieldValues struct {
+					Nodes    []json.RawMessage `json:"nodes"`
+					PageInfo struct {
+						HasNextPage bool   `json:"hasNextPage"`
+						EndCursor   string `json:"endCursor"`
+					} `json:"pageInfo"`
+				} `json:"fieldValues"`
+			} `json:"node"`
+		}
+		if err := projectGraphQLRead(client, query, map[string]interface{}{"id": itemID, "after": after}, &response); err != nil {
+			return nil, err
+		}
+		for _, raw := range response.Node.FieldValues.Nodes {
+			value, err := projectValueFromJSON(raw)
+			if err != nil {
+				return nil, err
+			}
+			values = append(values, value)
+		}
+		if !response.Node.FieldValues.PageInfo.HasNextPage {
+			return values, nil
+		}
+		cursor := response.Node.FieldValues.PageInfo.EndCursor
+		after = &cursor
+	}
+}
