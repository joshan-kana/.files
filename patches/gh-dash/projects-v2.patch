@@ -0,0 +1,57 @@
+package projecteditor
+
+import (
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/config"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/keys"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/theme"
+)
+
+func newEditorTestContext(t *testing.T) *context.ProgramContext {
+	t.Helper()
+	cfg, err := config.ParseConfig(config.Location{
+		ConfigFlag:       "../../../config/testdata/test-config.yml",
+		SkipGlobalConfig: true,
+	})
+	require.NoError(t, err)
+	thm := theme.ParseTheme(&cfg)
+	return &context.ProgramContext{Config: &cfg, Theme: thm, Styles: context.InitStyles(thm)}
+}
+
+func TestEditorFlowChoosesProjectThenSingleSelectOption(t *testing.T) {
+	ctx := newEditorTestContext(t)
+	item := data.ProjectItem{ID: "item-1", Project: data.Project{ID: "project-1", Number: 1, Title: "Roadmap"}}
+	m := New(ctx, "issue", 3, 7, "issue-1", "owner/repo", []data.ProjectItem{item})
+
+	var cmd tea.Cmd
+	m, cmd = m.Update(tea.KeyPressMsg{Text: "enter"})
+	require.NotNil(t, cmd)
+	require.Equal(t, modeLoadingFields, m.mode)
+
+	m, _ = m.Update(FieldsFetchedMsg{
+		ProjectID: "project-1",
+		Fields: []data.ProjectField{{
+			ID: "field-1", Name: "Status", Type: "SINGLE_SELECT",
+			Options: []data.ProjectOption{{ID: "todo", Name: "Todo"}, {ID: "done", Name: "Done"}},
+		}},
+	})
+	require.Equal(t, modeFields, m.mode)
+
+	m, _ = m.Update(tea.KeyPressMsg{Text: "enter"})
+	require.Equal(t, modeOptions, m.mode)
+
+	m, cmd = m.Update(tea.KeyPressMsg{Text: "down"})
+	require.Nil(t, cmd)
+	require.Equal(t, 1, m.option)
+}
+
+func TestDefaultProjectEditorKeyIsE(t *testing.T) {
+	require.Equal(t, []string{"E"}, keys.PRKeys.EditProject.Keys())
+	require.Equal(t, []string{"E"}, keys.IssueKeys.EditProject.Keys())
+}
