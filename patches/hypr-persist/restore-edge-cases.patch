diff --git a/src/core/snapshot.rs b/src/core/snapshot.rs
index c4d662d..1eea1e0 100644
--- a/src/core/snapshot.rs
+++ b/src/core/snapshot.rs
@@ -176,9 +176,24 @@ impl SnapshotEngine {
         self.session_dir.join(".restore-next").exists()
     }
 
+    /// A request saved in this boot must survive compositor crashes until the
+    /// next clean graphical login. The boot ID distinguishes it after reboot.
+    pub fn restore_requested_this_boot(&self) -> bool {
+        let path = self.session_dir.join(".restore-next");
+        let Ok(saved_boot) = std::fs::read_to_string(path) else {
+            return false;
+        };
+        let Ok(current_boot) = std::fs::read_to_string("/proc/sys/kernel/random/boot_id") else {
+            return false;
+        };
+        !saved_boot.trim().is_empty() && saved_boot.trim() == current_boot.trim()
+    }
+
     pub fn mark_restore_pending(&self) -> Result<()> {
         let path = self.session_dir.join(".restore-next");
-        std::fs::write(&path, b"")
+        let boot_id = std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+            .context("reading current boot ID for next-login restoration")?;
+        std::fs::write(&path, boot_id)
             .with_context(|| format!("marking next-login restoration at {}", path.display()))
     }
 
