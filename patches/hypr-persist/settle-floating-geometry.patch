+/// Give newly opened floating clients time to apply their own first configure.
+/// Their initial size requests can otherwise overwrite the restored geometry.
+async fn restore_floating_geometry(
+    ctl: &HyprCtl,
+    address: &str,
+    position: (i32, i32),
+    size: (i32, i32),
+) -> Result<()> {
+    let (x, y) = position;
+    let (w, h) = size;
+    // Window mode requests may arrive after the first open event. Re-check
+    // fullscreen and floating state on each bounded geometry correction.
+    let mut stable_checks = 0;
+    for attempt in 0..6 {
+        let client = ctl.get_client_by_address(address).await.ok().flatten();
+        if let Some(ref client) = client {
+            let mode = match client.fullscreen_mode {
+                1 => Some(1), // maximized
+                2 => Some(0), // fullscreen
+                _ => None,
+            };
+            if let Some(mode) = mode {
+                ctl.dispatch(&format!("fullscreen {mode},address:0x{address}"))
+                    .await?;
+            }
+        }
+        if client.as_ref().is_some_and(|client| !client.floating)
+            || (attempt == 0 && client.is_none())
+        {
+            ctl.dispatch(&format!("setfloating address:0x{address}"))
+                .await?;
+        }
+        ctl.dispatch(&format!(
+            "resizewindowpixel exact {w} {h},address:0x{address}"
+        ))
+        .await?;
+        ctl.dispatch(&format!(
+            "movewindowpixel exact {x} {y},address:0x{address}"
+        ))
+        .await?;
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        let Ok(Some(client)) = ctl.get_client_by_address(address).await else {
+            break;
+        };
+        if client.fullscreen_mode == 0
+            && client.floating
+            && client.at == position
+            && client.size == size
+        {
+            stable_checks += 1;
+            if stable_checks >= 4 {
+                break;
+            }
+        } else {
+            stable_checks = 0;
+        }
+    }
+    Ok(())
+}
