+/// Give newly opened floating clients time to apply their own first configure.
+/// Their initial size requests can otherwise overwrite the restored geometry.
+async fn restore_floating_geometry(
+    ctl: &HyprCtl,
+    address: &str,
+    position: (i32, i32),
+    size: (i32, i32),
+) -> Result<()> {
+    let (x, y) = position;
+    let (w, h) = size;
+    ctl.dispatch(&format!("setfloating address:0x{address}"))
+        .await?;
+    for _ in 0..3 {
+        ctl.dispatch(&format!(
+            "resizewindowpixel exact {w} {h},address:0x{address}"
+        ))
+        .await?;
+        ctl.dispatch(&format!(
+            "movewindowpixel exact {x} {y},address:0x{address}"
+        ))
+        .await?;
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        if let Ok(Some(client)) = ctl.get_client_by_address(address).await
+            && client.at == position
+            && client.size == size
+        {
+            break;
+        }
+    }
+    Ok(())
+}
