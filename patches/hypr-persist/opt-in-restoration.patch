+    #[test]
+    fn explicit_restoration_requires_a_pending_request() {
+        let dir = tempfile::tempdir().unwrap();
+        let engine = SnapshotEngine::new_with_dir(dir.path().to_path_buf(), true).unwrap();
+        let state = make_state_with_windows(vec![("0xa", "kitty", "1", true)]);
+
+        // A legacy or automatically written last.toml is not opt-in.
+        engine.save(&state, "last").unwrap();
+        assert!(!engine.restore_pending());
+
+        engine.mark_restore_pending().unwrap();
+        assert!(engine.restore_pending());
+        engine.clear_restore_pending().unwrap();
+        assert!(!engine.restore_pending());
+        assert!(engine.exists("last"));
+
+        engine.mark_restore_pending().unwrap();
+        engine.delete("last").unwrap();
+        assert!(!engine.restore_pending());
+        assert!(!engine.exists("last"));
+    }
+
