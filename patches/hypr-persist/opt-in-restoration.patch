+        let runtime = SnapshotEngine::new_with_dir(dir.path().join("runtime"), true).unwrap();
+        let fresh_runtime =
+            SnapshotEngine::new_with_dir(dir.path().join("next-boot"), true).unwrap();
+        let state = make_state_with_windows(vec![("0xa", "kitty", "1", true)]);
+
+        runtime.save(&state, "last").unwrap();
+        assert!(runtime.exists("last"));
+        assert!(!saved.exists("last"));
+        assert!(!saved.restore_pending());
+        assert!(!fresh_runtime.exists("last"));
+
+        saved.save(&state, "last").unwrap();
+        saved.mark_restore_pending().unwrap();
+        runtime.delete("last").unwrap();
+        assert!(!runtime.exists("last"));
+        assert!(saved.exists("last"));
+        assert!(saved.restore_pending());
+    }
