+    pub fn restore_pending(&self) -> bool {
+        self.session_dir.join(".restore-next").exists()
+    }
+
+    pub fn mark_restore_pending(&self) -> Result<()> {
+        let path = self.session_dir.join(".restore-next");
+        std::fs::write(&path, b"")
+            .with_context(|| format!("marking next-login restoration at {}", path.display()))
+    }
+
+    pub fn clear_restore_pending(&self) -> Result<()> {
+        let path = self.session_dir.join(".restore-next");
+        match std::fs::remove_file(&path) {
+            Ok(()) => Ok(()),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(e) => {
+                Err(e).with_context(|| format!("clearing restore request {}", path.display()))
+            }
+        }
+    }
+
     pub fn delete(&self, name: &str) -> Result<()> {
