+void NetworkManager::onServiceRegistered(const QString& service) {
+	Q_UNUSED(service);
+	qCDebug(logNetworkManager) << "NetworkManager appeared on DBus. Reconnecting.";
+	this->clearDevices();
+	this->connectToService();
+}
+
+void NetworkManager::onServiceUnregistered(const QString& service) {
+	Q_UNUSED(service);
+	qCDebug(logNetworkManager) << "NetworkManager disappeared from DBus. Clearing stale state.";
+	this->clearDevices();
+	this->bWifiEnabled = false;
+	this->bWifiHardwareEnabled = false;
+	this->bConnectivity = NMConnectivityState::Unknown;
+	this->bConnectivityCheckAvailable = false;
+	this->bConnectivityCheckEnabled = false;
+}
+
+void NetworkManager::clearDevices() {
+	for (auto* device: std::as_const(this->mDevices)) {
+		if (device == nullptr) continue;
+		emit this->deviceRemoved(device->frontend());
+		delete device;
+	}
+
+	this->mDevices.clear();
+}
